---
/**
 * ScrollProgressRail.astro
 * Thin right-edge vertical bar (desktop only) that fills as the page scrolls.
 * Uses the scroll-driven-animations spec (scroll-timeline) with a
 * transform-scaleY fallback via JS for browsers without support.
 * aria-hidden — purely decorative.
 */
---
<div
  aria-hidden="true"
  class="scroll-rail pointer-events-none fixed top-0 right-0 z-[60] h-screen w-[3px] hidden lg:block"
>
  <div class="scroll-rail__track absolute inset-0 opacity-[0.08]" style="background: var(--text);"></div>
  <div class="scroll-rail__fill absolute top-0 right-0 w-full origin-top" style="height: 100%; background: linear-gradient(to bottom, var(--ac-teal), var(--ac-indigo), var(--ac-pink));"></div>
</div>

<style>
  .scroll-rail__fill {
    transform: scaleY(var(--p, 0));
    transform-origin: top;
    transition: transform 80ms linear;
  }
  @supports (animation-timeline: scroll()) {
    @keyframes scroll-rail-grow {
      from { transform: scaleY(0); }
      to   { transform: scaleY(1); }
    }
    .scroll-rail__fill {
      animation: scroll-rail-grow linear;
      animation-timeline: scroll(root);
      transition: none;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .scroll-rail__fill { transition: none !important; animation: none !important; }
  }
</style>

<script is:inline>
  // Fallback for browsers without scroll-timeline
  (() => {
    if (CSS && CSS.supports && CSS.supports('animation-timeline: scroll()')) return;
    const fill = document.querySelector('.scroll-rail__fill');
    if (!fill) return;
    let raf = 0;
    const update = () => {
      const h = document.documentElement;
      const max = h.scrollHeight - h.clientHeight;
      const p = max > 0 ? Math.min(1, Math.max(0, h.scrollTop / max)) : 0;
      fill.style.setProperty('--p', String(p));
      raf = 0;
    };
    const onScroll = () => {
      if (raf) return;
      raf = requestAnimationFrame(update);
    };
    update();
    window.addEventListener('scroll', onScroll, { passive: true });
    window.addEventListener('resize', onScroll, { passive: true });
  })();
</script>
