---
// Older service-page data shape (CRM/ERP, DPDP, Headless CMS, Payload/Directus), rendered through the
// shared ServicePage block so every service page has the same structure and card style (27 Nov 2026).
import ServicePage from './service/ServicePage.astro';

interface Card { title: string; text: string }
interface Step { number: string; title: string; text: string }
interface FAQ { question: string; answer: string }

interface Props {
  eyebrow: string;
  heading: string;
  intro: string;
  features: string[];
  outcomes: Card[];
  deliverables: Card[];
  process: Step[];
  suitableFor: string[];
  responsibilities: string[];
  faqs: FAQ[];
  accentVar: string;
  disclaimer: string;
  offersTitle?: string;
  faqTitle?: string;
  ctaTitle?: string;
  ctaText?: string;
  guides?: { label: string; title: string; href: string }[];
}

const { eyebrow, heading, intro, features, outcomes, deliverables, process, suitableFor, responsibilities, faqs, accentVar, disclaimer, offersTitle, faqTitle, ctaTitle, ctaText, guides } = Astro.props;
---
<ServicePage
  accentVar={accentVar}
  eyebrow={eyebrow}
  heading={heading}
  intro={intro}
  highlights={features}
  primaryCta={{ label: 'Discuss the requirement', href: '/schedule-consultation/' }}
  secondaryCta={{ label: 'Request a scoped quote', href: '/get-quote/' }}
  offersTitle={offersTitle ?? 'What you get'}
  offers={[...outcomes, ...deliverables]}
  process={process.map(({ title, text }) => ({ title, text }))}
  fit={suitableFor}
  needs={responsibilities}
  note={disclaimer}
  guides={guides}
  faqTitle={faqTitle ?? 'Frequently asked questions'}
  faqs={faqs}
  cta={{ title: ctaTitle ?? 'Talk to us about your project', text: ctaText ?? 'Share your goals and current setup. We will recommend a practical scope and quote it in writing.' }}
/>
