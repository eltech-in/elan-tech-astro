---
// Site-wide notice for the Dubai visit. It is left out of the build once the
// visit is over, and hides itself in the browser after the end date in case
// the site has not been rebuilt by then.
import { dubaiTrip } from '../data/trip';

const visitOver = Date.now() > new Date(dubaiTrip.endsAt).getTime();
const onTripPage = Astro.url.pathname.replace(/\/$/, '') === dubaiTrip.pageUrl.replace(/\/$/, '');
const show = !visitOver && !onTripPage;
---

{show && (
  <aside id="trip-banner" data-ends-at={dubaiTrip.endsAt} aria-label="Announcement" class="relative z-40 border-b border-white/10 bg-[#0b1220] px-4 py-2 text-center text-sm text-white">
    <p>
      <span class="font-semibold">We are in {dubaiTrip.city}, {dubaiTrip.dateLabel}.</span>
      <a href={dubaiTrip.pageUrl} class="ml-1 inline-flex min-h-6 items-center font-bold underline underline-offset-4 hover:no-underline">Book a meeting</a>
    </p>
  </aside>
)}

<script>
  const banner = document.getElementById('trip-banner');
  if (banner) {
    const endsAt = Date.parse(banner.dataset.endsAt ?? '');
    if (Number.isFinite(endsAt) && Date.now() > endsAt) banner.remove();
  }
</script>
