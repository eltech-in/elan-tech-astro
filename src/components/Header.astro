---
import ThemeToggle from '../islands/ThemeToggle';
import MobileNav from '../islands/MobileNav';
import MegaMenu from '../islands/MegaMenu';

const navLinks = [
  { label: 'Home', href: '/' },
  { label: 'About', href: '/about/' },
  { label: 'Portfolio', href: '/portfolio/' },
  { label: 'Blog', href: '/blog/' },
  { label: 'Pricing', href: '/pricing/' },
  { label: 'Contact', href: '/contact/' },
];

const currentPath = Astro.url.pathname;
const offerActive = new Date() <= new Date('2026-06-30T18:29:59Z');
---
<header
  class="header-island sticky top-3 sm:top-4 z-50 w-full px-3 sm:px-4 mb-3 sm:mb-4 pointer-events-none"
>
  <div class="header-island__inner relative mx-auto flex max-w-7xl items-center justify-between gap-3 rounded-full border border-[var(--border)] bg-[var(--bg-card)] shadow-xl shadow-black/10 px-3 py-2 sm:px-4 sm:py-2.5 pointer-events-auto">

    <!-- Logo (dual: full logo ↔ horizontal stamp on scroll) -->
    <a href="/" class="flex shrink-0 items-center gap-2" aria-label="eLan Technology — home">
      <span class="relative block" style="width:140px;height:40px;">
        <!-- Full logo — visible by default, fades out on scroll -->
        <img
          id="logo-full"
          src="/images/elan-tech-logo.svg"
          alt="eLan Technology"
          width="140"
          height="40"
          loading="eager"
          decoding="async"
          fetchpriority="high"
          class="absolute inset-0 h-10 w-auto transition-all duration-500 ease-in-out"
          style="opacity:1;transform:scale(1);"
        />
        <!-- Horizontal compact logo — hidden by default, fades in on scroll -->
        <img
          id="logo-scrolled"
          src="/images/elan-tech-logoh.svg"
          alt="eLan Technology"
          width="140"
          height="40"
          loading="eager"
          decoding="async"
          class="absolute inset-0 h-10 w-auto transition-all duration-500 ease-in-out"
          style="opacity:0;transform:scale(1.1);"
        />
      </span>
    </a>

    <!-- Desktop Navigation -->
    <nav aria-label="Main navigation" class="hidden lg:flex items-center gap-1">
      <a
        href="/"
        class:list={[
          'px-3 py-2 rounded-md text-sm font-medium transition-colors duration-150',
          currentPath === '/'
            ? 'text-[var(--accent)]'
            : 'text-[var(--text-dim)] hover:text-[var(--text)]',
        ]}
      >
        Home
      </a>

      <a
        href="/about/"
        class:list={[
          'px-3 py-2 rounded-md text-sm font-medium transition-colors duration-150',
          currentPath === '/about/' || currentPath === '/about'
            ? 'text-[var(--accent)]'
            : 'text-[var(--text-dim)] hover:text-[var(--text)]',
        ]}
      >
        About
      </a>

      <!-- Services — triggers MegaMenu island -->
      <a
        href="/services/"
        data-mega="services"
        aria-haspopup="true"
        aria-expanded="false"
        class:list={[
          'flex items-center gap-1 px-3 py-2 rounded-md text-sm font-medium transition-colors duration-150',
          currentPath.startsWith('/services') 
            ? 'text-[var(--accent)]' 
            : 'text-[var(--text-dim)] hover:text-[var(--text)]'
        ]}
      >
        Services
        <svg
          xmlns="http://www.w3.org/2000/svg"
          width="14"
          height="14"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"
          stroke-linejoin="round"
          aria-hidden="true"
          class="mt-px transition-transform duration-150"
        >
          <polyline points="6 9 12 15 18 9" />
        </svg>
      </a>

      <!-- Products — triggers MegaMenu island -->
      <a
        href="/products/"
        data-mega="products"
        aria-haspopup="true"
        aria-expanded="false"
        class:list={[
          'flex items-center gap-1 px-3 py-2 rounded-md text-sm font-medium transition-colors duration-150',
          currentPath.startsWith('/products') 
            ? 'text-[var(--accent)]' 
            : 'text-[var(--text-dim)] hover:text-[var(--text)]'
        ]}
      >
        Products
        <svg
          xmlns="http://www.w3.org/2000/svg"
          width="14"
          height="14"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"
          stroke-linejoin="round"
          aria-hidden="true"
          class="mt-px transition-transform duration-150"
        >
          <polyline points="6 9 12 15 18 9" />
        </svg>
      </a>

      {navLinks.slice(2).map((link) => (
        <a
          href={link.href}
          class:list={[
            'relative flex items-center gap-1.5 px-3 py-2 rounded-md text-sm font-medium transition-colors duration-150',
            currentPath === link.href || (link.href !== '/' && currentPath.startsWith(link.href))
              ? 'text-[var(--accent)]'
              : 'text-[var(--text-dim)] hover:text-[var(--text)]',
          ]}
        >
          {link.label}
          {link.href === '/pricing/' && offerActive && (
            <span
              class="inline-flex items-center rounded-full px-1.5 py-0.5 text-[9px] font-bold uppercase tracking-wide text-white leading-none"
              style="background:#F26722;"
              aria-label="New offer available"
            >
              NEW
            </span>
          )}
        </a>
      ))}
    </nav>

    <!-- Right-side actions -->
    <div class="flex items-center gap-2">
      <!-- Search -->
      <a
        href="/search/"
        class="flex h-9 w-9 items-center justify-center rounded-md text-[var(--text-muted)] hover:text-[var(--text)] transition-colors duration-150 focus-visible:outline focus-visible:outline-2 focus-visible:outline-[var(--accent)]"
        aria-label="Search site"
      >
        <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <circle cx="11" cy="11" r="8"/>
          <line x1="21" y1="21" x2="16.65" y2="16.65"/>
        </svg>
      </a>

      <!-- Island: ThemeToggle -->
      <ThemeToggle client:idle />

      <!-- Get Quote — desktop -->
      <a
        href="/get-quote/"
        class="hidden lg:inline-flex items-center gap-2 rounded-full border border-[var(--border)] px-4 py-2 text-sm font-semibold text-[var(--text-dim)] transition-all duration-150 hover:border-[var(--accent)] hover:text-[var(--accent)] focus-visible:outline focus-visible:outline-2 focus-visible:outline-[var(--accent)]"
      >
        Get Quote
      </a>

      <!-- Get Free Audit CTA — desktop -->
      <a
        href="/free-website-audit/"
        class="hidden sm:inline-flex items-center gap-2 rounded-full bg-[var(--accent)] px-4 py-2 text-sm font-semibold text-[var(--bg)] transition-opacity duration-150 hover:opacity-90 focus-visible:outline focus-visible:outline-2 focus-visible:outline-[var(--accent)]"
      >
        Get Free Audit
      </a>

      <!-- Island: MobileNav -->
      <MobileNav client:media="(max-width: 1023px)" />
    </div>

    <!-- Island: MegaMenu — kept INSIDE the inner island so its absolute
         positioning anchors to the island's bounds (not the full-width
         outer wrapper). Without this, the dropdown would stretch the full
         viewport width and look detached from the island. -->
    <MegaMenu client:media="(min-width: 1024px)" />
  </div>
</header>

<script>
  (function () {
    const island = document.querySelector('.header-island__inner') as HTMLElement | null;
    const logoFull = document.getElementById('logo-full') as HTMLImageElement | null;
    const logoScrolled = document.getElementById('logo-scrolled') as HTMLImageElement | null;
    if (!island || !logoFull || !logoScrolled) return;

    let ticking = false;

    function onScroll() {
      if (!ticking) {
        requestAnimationFrame(() => {
          const scrolled = window.scrollY > 20;
          if (scrolled) {
            island!.classList.add('header-island__inner--scrolled');
          } else {
            island!.classList.remove('header-island__inner--scrolled');
          }
          // Logo swap
          logoFull!.style.opacity = scrolled ? '0' : '1';
          logoFull!.style.transform = scrolled ? 'scale(0.9)' : 'scale(1)';
          logoScrolled!.style.opacity = scrolled ? '1' : '0';
          logoScrolled!.style.transform = scrolled ? 'scale(1)' : 'scale(1.1)';
          ticking = false;
        });
        ticking = true;
      }
    }

    window.addEventListener('scroll', onScroll, { passive: true });
  })();
</script>

<style>
  /* Boost shadow once scrolled past hero so the island feels lifted off the page */
  .header-island__inner--scrolled {
    box-shadow: 0 12px 36px rgba(0, 0, 0, 0.2);
  }
</style>
