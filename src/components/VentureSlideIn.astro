<aside
  id="digibizid-slide"
  class="digibizid-slide fixed bottom-[calc(5.75rem+env(safe-area-inset-bottom))] right-3 z-40 w-[calc(100%-1.5rem)] max-w-sm translate-x-[120%] opacity-0 lg:bottom-8 lg:right-24"
  aria-label="DigiBizID, an eLan Technology venture"
  hidden
>
  <div class="relative overflow-hidden rounded-2xl border border-blue-500/30 bg-[var(--bg-card)] p-5 shadow-2xl shadow-black/20">
    <div aria-hidden="true" class="pointer-events-none absolute -right-10 -top-16 h-40 w-40 rounded-full bg-blue-500/20 blur-3xl"></div>
    <button
      id="digibizid-slide-close"
      type="button"
      class="absolute right-2 top-2 flex h-11 w-11 items-center justify-center rounded-xl text-[var(--text-muted)] transition-colors hover:bg-[var(--bg)] hover:text-[var(--text)]"
      aria-label="Close DigiBizID announcement"
    >
      <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
        <path d="M18 6 6 18" />
        <path d="m6 6 12 12" />
      </svg>
    </button>

    <div class="relative pr-9">
      <p class="text-xs font-bold uppercase tracking-[0.16em] text-[var(--ac-blue)]">New eLan venture</p>
      <h2 class="mt-2 font-heading text-xl font-bold text-[var(--text)]">Meet DigiBizID</h2>
      <p class="mt-2 text-sm leading-relaxed text-[var(--text-dim)]">Your business identity in one mobile-friendly link and QR code.</p>
      <a href="/ventures/digibizid/" class="mt-4 inline-flex min-h-11 items-center gap-2 rounded-xl bg-[var(--ac-blue)] px-5 py-2.5 text-sm font-bold text-white transition-transform hover:-translate-y-0.5">
        Discover DigiBizID <span aria-hidden="true">→</span>
      </a>
    </div>
    <div class="digibizid-timer absolute inset-x-0 bottom-0 h-1 origin-left bg-[var(--ac-blue)]" aria-hidden="true"></div>
  </div>
</aside>

<script is:inline>
  (function () {
    var card = document.getElementById('digibizid-slide');
    var close = document.getElementById('digibizid-slide-close');
    if (!card || !close) return;

    try {
      if (sessionStorage.getItem('digibizid-slide-seen') === '1') return;
      sessionStorage.setItem('digibizid-slide-seen', '1');
    } catch (e) {}

    var hideTimer;
    function hideCard() {
      window.clearTimeout(hideTimer);
      card.classList.remove('is-visible');
      window.setTimeout(function () { card.hidden = true; }, 450);
    }

    card.hidden = false;
    window.requestAnimationFrame(function () {
      window.requestAnimationFrame(function () { card.classList.add('is-visible'); });
    });
    hideTimer = window.setTimeout(hideCard, 8000);
    close.addEventListener('click', hideCard);
  })();
</script>

<style>
  .digibizid-slide {
    transition: transform 450ms cubic-bezier(0.2, 0.8, 0.2, 1), opacity 300ms ease;
  }
  .digibizid-slide.is-visible {
    transform: translateX(0);
    opacity: 1;
  }
  .digibizid-slide.is-visible .digibizid-timer {
    animation: digibizid-countdown 8s linear forwards;
  }
  @keyframes digibizid-countdown {
    from { transform: scaleX(1); }
    to { transform: scaleX(0); }
  }
  @media (prefers-reduced-motion: reduce) {
    .digibizid-slide { transition: none; }
    .digibizid-slide.is-visible .digibizid-timer { animation: none; }
  }
</style>
