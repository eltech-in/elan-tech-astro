---
// BookingForm - privacy-aware WhatsApp handoff. No website backend storage.
// On submit, constructs a wa.me URL from the minimum necessary fields and opens
// it in a new tab only after the visitor acknowledges the third-party transfer.
// WCAG 2.1 AA: every input has a visible <label> with for/id association,
// required fields use aria-required="true", inline errors use role="alert",
// submit button is ≥ 44px height.
import { PLANS } from '../../data/digitalLaunchpad';

const formatPrice = (price: number) => price.toLocaleString('en-IN');
const planLabel = `${PLANS[0].name} - ₹${formatPrice(PLANS[0].price)} + GST`;
---

<form
  id="lp-form"
  data-plan={planLabel}
  role="form"
  aria-label="Request Digital Launchpad booking details"
  novalidate
  class="space-y-5"
>
  <!-- Row 1: Name + Business -->
  <div class="grid gap-5 sm:grid-cols-2">
    <div class="flex flex-col gap-1.5">
      <label for="lp-name" class="text-sm font-semibold text-[var(--text)]">
        Full Name <span aria-hidden="true" class="text-[#F26722]">*</span>
      </label>
      <input
        type="text"
        id="lp-name"
        name="name"
        autocomplete="name"
        required
        aria-required="true"
        aria-describedby="lp-name-err"
        placeholder="Ramesh Sharma"
        class="lp-input rounded-xl border border-[var(--border)] bg-[var(--bg)] px-4 py-3 text-sm text-[var(--text)] placeholder-[var(--text-muted)] transition-colors focus:border-[#F26722] focus:outline-none focus:ring-2 focus:ring-[#F26722]/30"
      />
      <span id="lp-name-err" role="alert" class="lp-error hidden text-xs text-[#EF4444]">
        Please enter your full name.
      </span>
    </div>

    <div class="flex flex-col gap-1.5">
      <label for="lp-biz" class="text-sm font-semibold text-[var(--text)]">
        Business Name <span aria-hidden="true" class="text-[#F26722]">*</span>
      </label>
      <input
        type="text"
        id="lp-biz"
        name="business"
        autocomplete="organization"
        required
        aria-required="true"
        aria-describedby="lp-biz-err"
        placeholder="Sharma Clinic"
        class="lp-input rounded-xl border border-[var(--border)] bg-[var(--bg)] px-4 py-3 text-sm text-[var(--text)] placeholder-[var(--text-muted)] transition-colors focus:border-[#F26722] focus:outline-none focus:ring-2 focus:ring-[#F26722]/30"
      />
      <span id="lp-biz-err" role="alert" class="lp-error hidden text-xs text-[#EF4444]">
        Please enter your business name.
      </span>
    </div>
  </div>

  <!-- Row 2: Email + optional domain -->
  <div class="grid gap-5 sm:grid-cols-2">
    <div class="flex flex-col gap-1.5">
      <label for="lp-email" class="text-sm font-semibold text-[var(--text)]">
        Email Address <span aria-hidden="true" class="text-[#F26722]">*</span>
      </label>
      <input
        type="email"
        id="lp-email"
        name="email"
        autocomplete="email"
        required
        aria-required="true"
        aria-describedby="lp-email-err"
        placeholder="ramesh@clinic.in"
        class="lp-input rounded-xl border border-[var(--border)] bg-[var(--bg)] px-4 py-3 text-sm text-[var(--text)] placeholder-[var(--text-muted)] transition-colors focus:border-[#F26722] focus:outline-none focus:ring-2 focus:ring-[#F26722]/30"
      />
      <span id="lp-email-err" role="alert" class="lp-error hidden text-xs text-[#EF4444]">
        Please enter a valid email address.
      </span>
    </div>
    <div class="flex flex-col gap-1.5">
      <label for="lp-domain" class="text-sm font-semibold text-[var(--text)]">
        Preferred Domain Name
        <span class="ml-1 text-xs font-normal text-[var(--text-muted)]">(optional)</span>
      </label>
      <input
        type="text"
        id="lp-domain"
        name="domain"
        placeholder="yourbusiness.in"
        class="rounded-xl border border-[var(--border)] bg-[var(--bg)] px-4 py-3 text-sm text-[var(--text)] placeholder-[var(--text-muted)] transition-colors focus:border-[#F26722] focus:outline-none focus:ring-2 focus:ring-[#F26722]/30"
      />
    </div>
  </div>

  <div class="rounded-2xl border border-[#F26722]/25 bg-[#F26722]/[0.06] p-4 sm:p-5" id="lp-privacy-notice">
    <h3 class="text-sm font-semibold text-[var(--text)]">Before opening WhatsApp</h3>
    <p class="mt-2 text-xs leading-relaxed text-[var(--text-dim)]">
      We use these details only to respond and prepare the requested written scope. This website does not store the form. Continuing transfers the prepared details to WhatsApp/Meta under its privacy terms. Unconverted enquiry details under our control may be retained for up to 12 months; we do not add you to a marketing list.
      <a href="/privacy-policy/" class="font-semibold underline underline-offset-2" target="_blank" rel="noopener noreferrer">Privacy Policy</a>
      <span aria-hidden="true"> · </span>
      <a href="https://www.whatsapp.com/legal/privacy-policy" class="font-semibold underline underline-offset-2" target="_blank" rel="noopener noreferrer">WhatsApp Privacy Policy</a>
    </p>
    <label for="lp-privacy" class="mt-4 flex cursor-pointer items-start gap-3 text-sm leading-relaxed text-[var(--text)]">
      <input
        id="lp-privacy"
        name="privacyAccepted"
        type="checkbox"
        required
        aria-required="true"
        aria-describedby="lp-privacy-notice lp-privacy-err"
        class="mt-0.5 h-5 w-5 shrink-0 accent-[#F26722]"
      />
      <span>I agree to this enquiry use and the transfer of the prepared details to WhatsApp. <span aria-hidden="true" class="text-[#F26722]">*</span></span>
    </label>
    <span id="lp-privacy-err" role="alert" class="lp-error mt-2 hidden text-xs text-[#EF4444]">
      Please confirm the privacy notice before opening WhatsApp.
    </span>
  </div>

  <!-- Submit -->
  <button
    type="submit"
    aria-label="Review Digital Launchpad details in WhatsApp"
    class="w-full rounded-full py-4 text-base font-bold text-white transition-all duration-200 hover:opacity-90 hover:-translate-y-0.5 focus-visible:outline focus-visible:outline-2 focus-visible:outline-[#F26722] flex items-center justify-center gap-2"
    style="background:#F26722; min-height:44px;"
  >
    <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
      <path d="M21 11.5a8.38 8.38 0 0 1-.9 3.8 8.5 8.5 0 0 1-7.6 4.7 8.38 8.38 0 0 1-3.8-.9L3 21l1.9-5.7a8.38 8.38 0 0 1-.9-3.8 8.5 8.5 0 0 1 4.7-7.6 8.38 8.38 0 0 1 3.8-.9h.5a8.48 8.48 0 0 1 8 8v.5z"/>
    </svg>
    Review details in WhatsApp
  </button>

  <!-- Trust note below submit -->
  <p class="text-center text-xs text-[var(--text-muted)] leading-relaxed">
    eLan Technology receives nothing until you send the prepared WhatsApp message.<br />
    An enquiry does not reserve the offer or create a booking.
  </p>
</form>

<script>
(function () {
  const form = document.getElementById('lp-form') as HTMLFormElement | null;
  if (!form) return;

  // ── Validation helpers ──────────────────────────────────────────────────
  function showErr(id: string) {
    const el = document.getElementById(id);
    if (el) { el.classList.remove('hidden'); }
  }
  function hideErr(id: string) {
    const el = document.getElementById(id);
    if (el) { el.classList.add('hidden'); }
  }
  function markInvalid(inputId: string, errId: string) {
    const input = document.getElementById(inputId) as HTMLInputElement | null;
    if (input) {
      input.setAttribute('aria-invalid', 'true');
      input.classList.add('border-[#EF4444]');
    }
    showErr(errId);
  }
  function clearInvalid(inputId: string, errId: string) {
    const input = document.getElementById(inputId) as HTMLInputElement | null;
    if (input) {
      input.removeAttribute('aria-invalid');
      input.classList.remove('border-[#EF4444]');
    }
    hideErr(errId);
  }

  // ── Clear error on input ────────────────────────────────────────────────
  [
    ['lp-name',  'lp-name-err'],
    ['lp-biz',   'lp-biz-err'],
    ['lp-email', 'lp-email-err'],
    ['lp-privacy', 'lp-privacy-err'],
  ].forEach(([inputId, errId]) => {
    const el = document.getElementById(inputId);
    if (el) el.addEventListener('input', () => clearInvalid(inputId, errId));
  });

  // ── Submit ──────────────────────────────────────────────────────────────
  form.addEventListener('submit', (e) => {
    e.preventDefault();

    const name   = (document.getElementById('lp-name')   as HTMLInputElement).value.trim();
    const biz    = (document.getElementById('lp-biz')    as HTMLInputElement).value.trim();
    const email  = (document.getElementById('lp-email')  as HTMLInputElement).value.trim();
    const domain = (document.getElementById('lp-domain') as HTMLInputElement).value.trim();
    const privacy = document.getElementById('lp-privacy') as HTMLInputElement;
    const plan = form.dataset.plan || 'Digital Launchpad - ₹32,000 + GST';

    // ── Validate required fields ──────────────────────────────────────────
    let valid = true;
    if (!name)  { markInvalid('lp-name',  'lp-name-err');  valid = false; }
    else        { clearInvalid('lp-name', 'lp-name-err'); }

    if (!biz)   { markInvalid('lp-biz',   'lp-biz-err');   valid = false; }
    else        { clearInvalid('lp-biz',  'lp-biz-err'); }

    const emailRe = /^[^\s@]+@[^\s@]+\.[^\s@]+$/;
    if (!email || !emailRe.test(email)) {
      markInvalid('lp-email', 'lp-email-err'); valid = false;
    } else { clearInvalid('lp-email', 'lp-email-err'); }

    if (!privacy.checked) { markInvalid('lp-privacy', 'lp-privacy-err'); valid = false; }
    else                  { clearInvalid('lp-privacy', 'lp-privacy-err'); }

    if (!valid) {
      // Focus first invalid input
      const first = form.querySelector('[aria-invalid="true"]') as HTMLElement | null;
      first?.focus();
      return;
    }

    // ── Build WhatsApp message ────────────────────────────────────────────
    const msg = encodeURIComponent(
      `Hi eLan Technology! I would like the Digital Launchpad booking details.\n\n` +
      `Name: ${name}\n` +
      `Business: ${biz}\n` +
      `Email: ${email}\n` +
      `Plan: ${plan}\n` +
      `Domain: ${domain || 'To be decided'}\n` +
      `Privacy acknowledgement: Digital Launchpad notice 2026-09-24`
    );
    window.open(`https://wa.me/918788834630?text=${msg}`, '_blank', 'noopener,noreferrer');
  });
})();
</script>

<style>
  /* Input focus ring colour matches brand orange in both themes */
  .lp-input:focus {
    border-color: #F26722;
  }
</style>
