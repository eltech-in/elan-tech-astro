---
// Cross-link block: lists every service + key conversion pages.
// Used on city / country landing pages to ensure each service page receives
// a static SSR inbound link from every location page.

interface Props {
  location?: string; // e.g. "Nagpur", "USA" - interpolated into heading
}

const { location } = Astro.props;
const heading = location ? `Our Services in ${location}` : 'Our Services';

const services: Array<{ label: string; href: string }> = [
  { label: 'Website Design', href: '/services/website-design/' },
  { label: 'Web Development', href: '/services/web-development/' },
  { label: 'eCommerce', href: '/services/ecommerce/' },
  { label: 'SEO Services', href: '/services/seo/' },
  { label: 'Digital Marketing', href: '/services/digital-marketing/' },
  { label: 'Mobile App Development', href: '/services/mobile-app-development/' },
  { label: 'Branding', href: '/services/branding/' },
  { label: 'Maintenance & Security', href: '/services/maintenance-security/' },
  { label: 'API Integrations', href: '/services/integrations/' },
  { label: 'ADA & WCAG Compliance', href: '/services/ada-compliant-web-design/' },
  { label: 'Free Website Audit', href: '/free-website-audit/' },
];
---
<section
  aria-labelledby="services-cloud-heading"
  class="border-t border-[var(--border)] bg-[var(--bg-card)] px-4 py-12 sm:px-6 lg:px-8"
>
  <div class="mx-auto max-w-7xl">
    <h2
      id="services-cloud-heading"
      class="font-heading text-2xl font-bold text-[var(--text)] sm:text-3xl"
    >
      {heading}
    </h2>
    <p class="mt-3 max-w-3xl text-base text-[var(--text-dim)]">
      Every service we deliver in-house, available {location ? `to businesses in ${location}` : 'wherever you operate'}.
    </p>

    <nav aria-label="Services offered" class="mt-6">
      <ul class="grid grid-cols-2 gap-x-4 gap-y-2 text-sm sm:grid-cols-3 lg:grid-cols-4">
        {services.map((service) => (
          <li>
            <a
              href={service.href}
              class="block rounded-md px-2 py-1.5 text-[var(--text-dim)] transition-colors duration-150 hover:bg-[var(--bg)] hover:text-[var(--accent)]"
            >
              {service.label}
            </a>
          </li>
        ))}
      </ul>
    </nav>
  </div>
</section>
