---
// One explanatory block for a service page (27 Nov 2026): "what you receive", "which page fits",
// "how one workflow runs" and similar. Same .tilt-card style and Tailwind default radii as the rest.
interface Col { title: string; text?: string; items?: string[] }
interface Props {
  id?: string;
  eyebrow?: string;
  title: string;
  intro?: string;
  color?: string;
  columns: Col[];
  numbered?: boolean;
  note?: string;
  links?: { href: string; label: string }[];
}
const { id, eyebrow, title, intro, color = '--accent', columns, numbered = false, note, links } = Astro.props;
const c = `var(${color})`;
const cols = columns.length >= 4 ? 'sm:grid-cols-2 lg:grid-cols-4' : columns.length === 3 ? 'md:grid-cols-3' : 'md:grid-cols-2';
const titleId = id ? `${id}-title` : undefined;
---
<section id={id} class="tilt-card tilt-card--lg scroll-mt-28 p-6 sm:p-8" style={`--card-color: ${c};`} aria-labelledby={titleId}>
  {eyebrow && <p class="text-xs font-bold uppercase tracking-[0.16em]" style={`color: ${c};`}>{eyebrow}</p>}
  <h2 id={titleId} class="mt-2 font-heading text-2xl font-bold text-[var(--text)] sm:text-3xl">{title}</h2>
  {intro && <p class="mt-3 max-w-3xl leading-relaxed text-[var(--text-dim)]">{intro}</p>}
  <div class:list={['mt-6 grid gap-6', cols]}>
    {columns.map((col, i) => (
      <div>
        {numbered && <span class="mb-3 inline-grid h-8 w-8 place-items-center rounded-lg text-xs font-black" style={`color: ${c}; background: color-mix(in srgb, ${c} 15%, transparent);`}>{String(i + 1).padStart(2, '0')}</span>}
        <h3 class="font-semibold text-[var(--text)]">{col.title}</h3>
        {col.text && <p class="mt-1.5 text-sm leading-relaxed text-[var(--text-dim)]">{col.text}</p>}
        {col.items && (
          <ul class="mt-2.5 space-y-2" role="list">
            {col.items.map((item) => <li class="flex gap-2.5 text-sm leading-relaxed text-[var(--text-dim)]"><span style={`color: ${c};`} aria-hidden="true">✓</span><span>{item}</span></li>)}
          </ul>
        )}
      </div>
    ))}
  </div>
  {note && <p class="mt-6 text-sm text-[var(--text-muted)]">{note}</p>}
  {links && links.length > 0 && (
    <p class="mt-4 flex flex-wrap gap-x-5 gap-y-2">
      {links.map((l) => <a href={l.href} class="text-sm font-semibold text-[var(--text)] underline underline-offset-4">{l.label} →</a>)}
    </p>
  )}
</section>
