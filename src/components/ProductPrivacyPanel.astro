---
interface PrivacyItem { title: string; text: string; }
interface Props {
  title: string;
  intro: string;
  items: PrivacyItem[];
  note: string;
  accentVar?: string;
  subject?: string;
}
const { title, intro, items, note, accentVar = '--accent', subject = 'Product privacy enquiry' } = Astro.props;
---

<section class="mx-auto max-w-7xl px-4 pb-12 sm:px-6 lg:px-8" aria-labelledby="product-privacy-heading">
  <div class="relative overflow-hidden rounded-3xl border border-[var(--border)] p-6 sm:p-8 lg:p-10" style={`background: linear-gradient(135deg, color-mix(in srgb, var(${accentVar}) 10%, var(--bg-card)) 0%, var(--bg-card) 68%);`}>
    <span aria-hidden="true" class="absolute inset-x-0 top-0 h-1" style={`background: var(${accentVar});`}></span>
    <span aria-hidden="true" class="absolute -right-20 -top-20 h-64 w-64 rounded-full opacity-20 blur-3xl" style={`background: var(${accentVar});`}></span>
    <div class="relative">
      <p class="text-xs font-bold uppercase tracking-[0.18em]" style={`color: var(${accentVar});`}>Privacy built into the product scope</p>
      <h2 id="product-privacy-heading" class="mt-2 max-w-3xl font-heading text-2xl font-bold text-[var(--text)] sm:text-3xl">{title}</h2>
      <p class="mt-3 max-w-4xl leading-relaxed text-[var(--text-dim)]">{intro}</p>
      <ul class="mt-7 grid gap-4 md:grid-cols-2" role="list">
        {items.map((item, index) => (
          <li class="rounded-2xl border border-[var(--border)] bg-[var(--bg)]/70 p-5">
            <div class="flex items-start gap-3">
              <span class="flex h-8 w-8 shrink-0 items-center justify-center rounded-lg text-xs font-black" style={`color: var(${accentVar}); background: color-mix(in srgb, var(${accentVar}) 14%, transparent);`}>{String(index + 1).padStart(2, '0')}</span>
              <div>
                <h3 class="font-heading text-base font-bold text-[var(--text)]">{item.title}</h3>
                <p class="mt-1 text-sm leading-relaxed text-[var(--text-dim)]">{item.text}</p>
              </div>
            </div>
          </li>
        ))}
      </ul>
      <div class="mt-6 flex flex-col gap-4 rounded-2xl border border-[var(--border)] bg-[var(--bg-card)] p-5 sm:flex-row sm:items-center sm:justify-between">
        <p class="max-w-4xl text-sm leading-relaxed text-[var(--text-dim)]"><strong class="text-[var(--text)]">Scope note:</strong> {note}</p>
        <div class="flex shrink-0 flex-wrap gap-2">
          <a href="/privacy-policy/" class="inline-flex items-center justify-center rounded-full border border-[var(--border)] px-4 py-2 text-sm font-bold text-[var(--text)] transition-colors hover:border-[var(--accent)] hover:text-[var(--accent)]">Privacy policy</a>
          <a href={`mailto:privacy@elan-tech.net?subject=${encodeURIComponent(subject)}`} class="inline-flex items-center justify-center rounded-full px-4 py-2 text-sm font-bold text-white transition-all hover:brightness-110" style={`background: var(${accentVar});`}>Ask about product privacy</a>
        </div>
      </div>
    </div>
  </div>
</section>
