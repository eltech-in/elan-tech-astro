---
import { Image } from 'astro:assets';
import type { CountryData } from '../../data/countries';
import { internationalProjects } from '../../data/portfolioShowcase';
import { getProjectImage } from '../../lib/images';

interface Props {
  country: CountryData;
}

const { country } = Astro.props;
const countryProjects = internationalProjects.filter((item) => item.countrySlug === country.slug);
---

{countryProjects.length > 0 && (
  <section class="border-y border-[var(--border)] bg-[var(--bg-card)] px-4 py-16 sm:px-6 sm:py-20 lg:px-8" aria-labelledby={`${country.slug}-project-title`}>
    <div class="mx-auto max-w-6xl">
      <div class="mx-auto mb-9 max-w-3xl text-center">
        <p class="text-xs font-black uppercase tracking-[0.2em] text-[var(--accent)]">Real project proof</p>
        <h2 id={`${country.slug}-project-title`} class="mt-3 scroll-mt-32 font-heading text-3xl font-black leading-tight text-[var(--text)] sm:text-4xl">
          {countryProjects.length === 1 ? 'Project' : 'Projects'} delivered for {country.name} clients
        </h2>
      </div>
      <div class:list={['grid gap-6', countryProjects.length > 1 && 'lg:grid-cols-2']}>
      {countryProjects.map((project) => (
      <article class="overflow-hidden rounded-[2rem] border border-[var(--border)] bg-[var(--bg)] shadow-[0_24px_70px_rgba(15,23,42,0.08)]">
        <div class="relative min-h-[260px] overflow-hidden bg-slate-950 sm:min-h-[360px] lg:min-h-[430px]">
          <Image
            src={getProjectImage(project.image)}
            alt={`${project.title} website created by eLan Technology`}
            widths={[640, 960, 1280]}
            sizes="(max-width: 1023px) 100vw, 55vw"
            format="avif"
            loading="lazy"
            decoding="async"
            class="absolute inset-0 h-full w-full object-cover object-top"
          />
          <div class="absolute inset-0 bg-gradient-to-t from-slate-950/75 via-transparent to-transparent" aria-hidden="true"></div>
          <div class="absolute bottom-5 left-5 right-5 flex flex-wrap items-center gap-2">
            {project.stack?.map((item) => (
              <span class="rounded-full border border-white/25 bg-slate-950/70 px-3 py-1.5 text-[11px] font-bold text-white backdrop-blur">{item}</span>
            ))}
          </div>
        </div>

        <div class="relative flex flex-col justify-center overflow-hidden p-7 sm:p-9">
          <p class="relative text-xl font-black text-[var(--text)]">{project.title}</p>
          {project.location && <p class="relative mt-1 text-xs text-[var(--text-muted)]">{project.location}</p>}
          <p class="relative mt-4 text-base leading-7 text-[var(--text-dim)]">{project.description}</p>
          <p class="relative mt-5 text-sm leading-6 text-[var(--text-muted)]">
            This is client work delivered from our India studio. It shows how we collaborate across borders without suggesting a local eLan office in {country.name}.
          </p>
          <div class="relative mt-7 flex flex-wrap gap-3">
            <a href={project.liveUrl} target="_blank" rel="noopener noreferrer" class="inline-flex items-center gap-2 rounded-full bg-[var(--accent)] px-5 py-2.5 text-sm font-bold text-white transition hover:-translate-y-0.5 hover:brightness-110" aria-label={`Visit ${project.title}, opens in a new tab`}>
              Visit live website <span aria-hidden="true">↗</span>
            </a>
            <a href="/portfolio/" class="inline-flex items-center rounded-full border border-[var(--border)] px-5 py-2.5 text-sm font-bold text-[var(--text)] transition hover:border-[var(--accent)] hover:text-[var(--accent)]">
              View portfolio
            </a>
          </div>
        </div>
      </article>
      ))}
      </div>
    </div>
  </section>
)}
