---
import type { CountryData } from '../../data/countries';

interface Props {
  country: CountryData;
}

const { country } = Astro.props;
---

<section class="py-16 md:py-20">
  <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
    <div class="mb-12 text-center">
      <h2 class="font-heading text-2xl sm:text-3xl font-bold text-[var(--text)] mb-4">
        Compare the Scope, Not Only the Price
      </h2>
      <p class="text-[var(--text-dim)] max-w-2xl mx-auto">
        Website prices vary with scope in every market. A useful proposal makes the following responsibilities clear before a {country.name} business commits.
      </p>
    </div>
    <div class="mx-auto max-w-3xl">
      <div class="rounded-2xl border border-[var(--border)] bg-[var(--bg-card)] overflow-hidden">
        <table class="w-full text-left">
          <thead>
            <tr class="border-b border-[var(--border)]">
              <th class="px-6 py-4 text-sm font-semibold text-[var(--text)]">Decision</th>
              <th class="px-6 py-4 text-sm font-semibold text-[var(--text)]">What to confirm</th>
              <th class="px-6 py-4 text-sm font-semibold text-[var(--accent)]">How we handle it</th>
            </tr>
          </thead>
          <tbody>
            <tr class="border-b border-[var(--border)]">
              <td class="px-6 py-4 text-sm text-[var(--text-dim)]">Scope</td>
              <td class="px-6 py-4 text-sm text-[var(--text-dim)]">Pages, templates, content and integrations</td>
              <td class="px-6 py-4 text-sm font-semibold text-[var(--accent)]">Written deliverables and exclusions</td>
            </tr>
            <tr class="border-b border-[var(--border)]">
              <td class="px-6 py-4 text-sm text-[var(--text-dim)]">Ownership</td>
              <td class="px-6 py-4 text-sm text-[var(--text-dim)]">Code, design files, domain and accounts</td>
              <td class="px-6 py-4 text-sm font-bold text-[var(--accent)]">Defined by proposal and payment terms</td>
            </tr>
            <tr class="border-b border-[var(--border)]">
              <td class="px-6 py-4 text-sm text-[var(--text-dim)]">Accessibility</td>
              <td class="px-6 py-4 text-sm text-[var(--text-dim)]">Target standard, journeys and evidence</td>
              <td class="px-6 py-4 text-sm text-[var(--accent)]">Accessibility-first; formal testing is scoped</td>
            </tr>
            <tr class="border-b border-[var(--border)]">
              <td class="px-6 py-4 text-sm text-[var(--text-dim)]">Ongoing costs</td>
              <td class="px-6 py-4 text-sm text-[var(--text-dim)]">Hosting, maintenance, licences and APIs</td>
              <td class="px-6 py-4 text-sm text-[var(--accent)]">Itemised separately where applicable</td>
            </tr>
            <tr>
              <td class="px-6 py-4 text-sm text-[var(--text-dim)]">Collaboration</td>
              <td class="px-6 py-4 text-sm text-[var(--text-dim)]">Meetings, updates, approvals and response windows</td>
              <td class="px-6 py-4 text-sm text-[var(--accent)]">{country.timezoneOverlap}</td>
            </tr>
          </tbody>
        </table>
      </div>
    </div>
  </div>
</section>
