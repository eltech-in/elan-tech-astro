---
import type { CountryData } from '../../data/countries';

interface Props {
  country: CountryData;
}

const { country } = Astro.props;

const services = [
  { title: 'Website Design', desc: `Custom, mobile-first websites for ${country.name} businesses, with performance and accessibility requirements defined in the project scope.`, href: '/services/website-design/' },
  { title: 'Web Development', desc: `Custom web development using an appropriate stack selected after discovery, with responsibilities and acceptance criteria agreed in writing.`, href: '/services/web-development/' },
  { title: 'eCommerce', desc: `Shopify, WooCommerce and Medusa commerce solutions. Currency, tax, payment and fulfilment providers are confirmed for the actual market and merchant account.`, href: '/services/ecommerce/' },
  { title: 'SEO & Digital Marketing', desc: `Search, content and campaign work informed by ${country.name} audience requirements and available evidence. Rankings, reach and enquiries are not guaranteed.`, href: '/services/seo/' },
  { title: 'Mobile Apps', desc: `iOS and Android app development with permissions, SDKs, store accounts and regional requirements documented during discovery.`, href: '/services/mobile-app-development/' },
  { title: 'Branding', desc: `Identity systems covering agreed logos, colours, typography and guidelines. Translation, cultural review and trademark clearance are separately scoped where needed.`, href: '/services/branding/' },
  { title: 'Maintenance & Security', desc: 'Maintenance, monitoring, backups and performance work under an agreed plan. Coverage, response windows and included work depend on that plan.', href: '/services/maintenance-security/' },
  { title: 'Custom CRM & ERP', desc: `Custom business workflows and ERPNext customisation for ${country.name} organisations. Data regions, migration, access, licences and continuing support are agreed for the actual deployment.`, href: '/services/custom-crm-erp-solutions/' },
  { title: 'Privacy & Data Governance', desc: `Technical implementation for forms, consent, analytics, retention and rights workflows. Applicable ${country.name} requirements and India DPDP responsibilities are scoped separately; this is not legal advice or certification.`, href: '/services/dpdp-compliance-implementation/' },
  { title: 'Headless CMS Development', desc: 'Composable content systems for websites and applications, including Payload CMS and Directus, with editorial roles, protected APIs, migration, deployment and handover defined in writing.', href: '/services/headless-cms-development/' },
];
---

<section class="py-16 md:py-20 bg-[var(--bg-card)]">
  <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
    <div class="mb-12 text-center">
      <h2 class="font-heading text-2xl sm:text-3xl font-bold text-[var(--text)] mb-4">
        Services for {country.name} Businesses
      </h2>
      <p class="text-[var(--text-dim)] max-w-2xl mx-auto">
        Website, development and digital services delivered from India through agreed communication, approval and support arrangements.
      </p>
    </div>
    <div class="grid gap-6 sm:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4">
      {services.map((s) => (
        <a href={s.href} class="group rounded-2xl border border-[var(--border)] bg-[var(--bg)] p-6 transition-colors hover:border-[var(--accent)]">
          <h3 class="font-heading font-semibold text-[var(--text)] mb-2 group-hover:text-[var(--accent)] transition-colors">{s.title}</h3>
          <p class="text-sm text-[var(--text-dim)] leading-relaxed">{s.desc}</p>
        </a>
      ))}
    </div>
  </div>
</section>
