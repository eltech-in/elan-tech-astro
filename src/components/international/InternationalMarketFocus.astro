---
import { testimonials } from '../../data/testimonials';
interface Props { market: 'usa' | 'canada'; }
const { market } = Astro.props;
const isUS = market === 'usa';
const testimonial = testimonials.find((item) => item.id === (isUS ? 2 : 15))!;
const services = isUS ? [
  { number: '01', title: 'Code-level ADA & WCAG remediation', text: 'Find barriers with automated and manual testing, fix them in templates, components and content, then retest the journeys that matter. Technical evidence supports accessibility work; it is not a legal-outcome guarantee.', href: '/services/ada-compliant-web-design/', label: 'Explore remediation services', extra: { href: '/services/ada-compliant-web-design/emergency-remediation/', label: 'Demand letter or deadline? Urgent route' } },
  { number: '02', title: 'Technical implementation', text: 'Rebuild a brittle template, replace an inaccessible component, or connect the systems a fix depends on. Scope, responsibilities and handover are written down before development.', href: '/services/web-development/', label: 'Explore web development' },
  { number: '03', title: 'Custom ecommerce', text: 'A Shopify storefront or a Medusa.js implementation when the store itself needs rebuilding, with checkout and account journeys tested for accessibility.', href: '/services/ecommerce/', label: 'Explore ecommerce development' },
] : [
  { number: '01', title: 'WCAG audits and reporting', text: 'Test agreed pages and journeys against WCAG, with findings mapped to criteria, ranked by impact and written up for your team and procurement. AODA or Accessible Canada Act applicability is assessed for the organisation, not assumed.', href: '/blog/accessibility/website-accessibility-audit-deliverables-canada/', label: 'What a Canadian audit should deliver', extra: { href: '/services/ada-compliant-web-design/#options-title', label: 'Audit and remediation prices' } },
  { number: '02', title: 'Remediation and retesting', text: 'Fix the barriers in code, design and content, then retest and record what passed and what remains.', href: '/services/ada-compliant-web-design/', label: 'Explore audit and remediation' },
  { number: '03', title: 'Websites and ongoing care', text: 'A clearer service website or store, with a separate plan for updates, monitoring and support. Translation and bilingual review can be scoped explicitly.', href: '/services/website-design/', label: 'Explore website design' },
];
---
<section class="px-4 py-14 sm:px-6 sm:py-20 lg:px-8" aria-labelledby={`${market}-focus-title`}>
  <div class="mx-auto max-w-6xl">
    <div class="max-w-3xl">
      <p class="text-xs font-bold uppercase tracking-[.18em] text-[var(--accent)]">A focused delivery partner, not another generic agency pitch</p>
      <h2 id={`${market}-focus-title`} class="mt-3 font-heading text-3xl font-bold leading-tight sm:text-4xl">{isUS ? 'Accessibility fixed in the code, with the development to back it.' : 'WCAG audits, clear reporting and remediation for Canadian organisations.'}</h2>
      <p class="mt-5 leading-7 text-[var(--text-dim)]">{isUS ? 'For US businesses and teams that need a capable implementation partner: eLan Technology delivers remotely from Nagpur, India, with written scope, practical review windows and transparent handover terms.' : 'For Canadian service businesses and organisations improving an existing website or planning a new one: work directly with an India-based studio, with responsibilities and communication agreed before the project starts.'}</p>
    </div>
    <div class="mt-8 grid gap-5 lg:grid-cols-3">
      {services.map((service) => <article class="flex flex-col rounded-xl border border-[var(--border)] bg-[var(--bg-card)] p-6 sm:p-7">
        <span class="font-heading text-sm font-bold text-[var(--accent)]">{service.number}</span>
        <h3 class="mt-4 font-heading text-xl font-bold">{service.title}</h3>
        <p class="mt-3 flex-1 text-sm leading-7 text-[var(--text-dim)]">{service.text}</p>
        <a href={service.href} class="mt-5 inline-flex min-h-11 items-center gap-2 text-sm font-bold text-[var(--accent)]">{service.label}<span aria-hidden="true">→</span></a>
        {'extra' in service && service.extra && <a href={service.extra.href} class="inline-flex min-h-11 items-center text-sm font-semibold text-[var(--text)] underline underline-offset-4">{service.extra.label} →</a>}
      </article>)}
    </div>
    <figure class="mt-7 rounded-xl border border-[var(--border)] bg-[var(--bg-card)] p-6 sm:p-8">
      <p class="text-xs font-bold uppercase tracking-wider text-[var(--accent)]">Client perspective · {testimonial.source}</p>
      <blockquote class="mt-4 max-w-4xl font-heading text-lg font-medium leading-8">“{testimonial.quote}”</blockquote>
      <figcaption class="mt-4 text-sm text-[var(--text-dim)]"><span class="font-bold text-[var(--text)]">{isUS ? testimonial.author : 'Eric H.'}</span> · {testimonial.role}, {testimonial.company}{testimonial.datePublished && <span> · {testimonial.datePublished}</span>}</figcaption>
      <a href="/testimonials/" class="mt-3 inline-flex min-h-11 items-center text-sm font-bold text-[var(--accent)]">Read more client feedback →</a>
    </figure>
  </div>
</section>
