---
// How pricing works for a country: projects are quoted per scope (no package prices on country pages,
// owner, 27 Nov 2026); paid audits and the booking advance show in the country's own currency.
import type { CountryData } from '../../data/countries';
import { currencyForCountry } from '../../data/auditPricing';
import AuditPrice from '../AuditPrice.astro';
import BookingAdvance from '../payments/BookingAdvance.astro';

interface Props {
  country: CountryData;
}
const { country } = Astro.props;
const currency = currencyForCountry(country.slug);
const place = country.name === 'United States' ? 'the United States' : country.name === 'United Kingdom' ? 'the United Kingdom' : country.name;
---
<section id="pricing" class="scroll-mt-28 border-t border-[var(--border)] py-14 md:py-16" aria-labelledby="country-pricing-title">
  <div class="mx-auto grid max-w-7xl gap-8 px-4 sm:px-6 lg:grid-cols-[1fr_1fr] lg:items-center lg:px-8">
    <div>
      <p class="text-xs font-bold uppercase tracking-[0.18em] text-[var(--accent)]">Pricing for {place}</p>
      <h2 id="country-pricing-title" class="mt-2 font-heading text-2xl font-bold text-[var(--text)] sm:text-3xl">Every project is quoted to its scope</h2>
      <p class="mt-3 leading-relaxed text-[var(--text-dim)]">After a short discovery we send a written scope and quotation in {currency}, with deliverables, milestones and costs broken down. Taxes and gateway charges, where they apply, are stated on the invoice.</p>
      <a href="/get-quote/" class="mt-5 inline-flex min-h-11 items-center rounded-lg bg-[var(--accent)] px-5 py-2.5 font-semibold text-white transition hover:brightness-110">Request a quote</a>
    </div>
    <ul class="grid gap-3 sm:grid-cols-2" role="list">
      <li class="rounded-xl border border-[var(--border)] bg-[var(--bg-card)] p-5">
        <p class="text-xs font-bold uppercase tracking-[0.14em] text-[var(--text-muted)]">Website audit</p>
        <p class="mt-1 font-heading text-3xl font-bold text-[var(--text)]"><AuditPrice kind="website" currency={currency} /></p>
        <p class="mt-1 text-sm text-[var(--text-dim)]">Prioritised findings for one domain.</p>
        <a href="/website-audit/" class="mt-3 inline-block text-sm font-semibold text-[var(--accent)] underline underline-offset-2">Book an audit</a>
      </li>
      <li class="rounded-xl border border-[var(--border)] bg-[var(--bg-card)] p-5">
        <p class="text-xs font-bold uppercase tracking-[0.14em] text-[var(--text-muted)]">Accessibility audit</p>
        <p class="mt-1 font-heading text-3xl font-bold text-[var(--text)]"><AuditPrice kind="accessibility" currency={currency} /></p>
        <p class="mt-1 text-sm text-[var(--text-dim)]">WCAG 2.2 AA testing and evidence.</p>
        <a href="/website-audit/#paid-wcag-audit" class="mt-3 inline-block text-sm font-semibold text-[var(--accent)] underline underline-offset-2">See the package</a>
      </li>
    </ul>
  </div>
</section>

<BookingAdvance currency={currency} id="book-online" />
