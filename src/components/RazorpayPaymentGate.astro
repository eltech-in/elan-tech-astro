---
interface Props {
  instanceId: string;
  inrButtonId: string;
  usdButtonId: string;
  eyebrow?: string;
  noticeLead?: string;
  currencyHelp?: string;
  noticeVersion?: string;
}

const {
  instanceId,
  inrButtonId,
  usdButtonId,
  eyebrow = 'Agreed booking advance',
  noticeLead = 'Load payment options only after eLan Technology has confirmed the written scope and payment reference.',
  currencyHelp = 'Choose the currency shown in your confirmed payment instructions.',
  noticeVersion = 'pricing-payment-2026-09-24',
} = Astro.props;
const consentId = `rzp-consent-${instanceId}`;
const errorId = `rzp-error-${instanceId}`;
const noticeId = `rzp-notice-${instanceId}`;
---

<div
  class="razorpay-gate rounded-xl border border-[var(--border)] bg-[var(--bg)] p-4"
  data-rzp-gate
  data-notice-version={noticeVersion}
>
  <p class="text-center text-[11px] font-bold uppercase tracking-[0.16em] text-[var(--text-muted)]">
    {eyebrow}
  </p>
  <div id={noticeId} class="mt-3 text-xs leading-relaxed text-[var(--text-dim)]">
    <p>
      {noticeLead} Razorpay is not contacted before you choose to load it. When loaded, Razorpay may receive connection, browser and device information and will process payment details under its own terms.
    </p>
    <p class="mt-2">
      <a href="/privacy-policy/" target="_blank" rel="noopener noreferrer" class="font-semibold underline underline-offset-2">Privacy Policy</a>
      <span aria-hidden="true"> · </span>
      <a href="https://razorpay.com/privacy/" target="_blank" rel="noopener noreferrer" class="font-semibold underline underline-offset-2">Razorpay Privacy Policy</a>
      <span aria-hidden="true"> · </span>
      <a href="/cancellation-refund-policy/" target="_blank" rel="noopener noreferrer" class="font-semibold underline underline-offset-2">Refund Policy</a>
    </p>
  </div>

  <label for={consentId} class="mt-3 flex cursor-pointer items-start gap-2.5 text-xs leading-relaxed text-[var(--text)]">
    <input
      id={consentId}
      type="checkbox"
      data-rzp-consent
      aria-describedby={`${noticeId} ${errorId}`}
      class="mt-0.5 h-4 w-4 shrink-0 accent-[var(--accent)]"
    />
    <span>I agree to load Razorpay for this payment step.</span>
  </label>
  <p id={errorId} data-rzp-error role="alert" class="mt-2 hidden text-xs text-red-500">
    Please confirm before loading Razorpay.
  </p>

  <button
    type="button"
    data-rzp-load
    class="mt-4 inline-flex min-h-11 w-full items-center justify-center rounded-xl border border-[var(--border)] px-4 py-2.5 text-sm font-bold text-[var(--text)] transition hover:border-[var(--accent)] hover:text-[var(--accent)] focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-[var(--accent)]"
  >
    Load secure payment options
  </button>

  <div data-rzp-options class="mt-4 hidden space-y-3" aria-live="polite">
    <p class="text-center text-xs text-[var(--text-muted)]">{currencyHelp}</p>
    <div class="grid gap-3 sm:grid-cols-2">
      <div class="rounded-lg border border-[var(--border)] p-3 text-center">
        <p class="mb-2 text-xs font-semibold text-[var(--text)]">Pay ₹9,999 INR</p>
        <form data-rzp-form data-button-id={inrButtonId}></form>
      </div>
      <div class="rounded-lg border border-[var(--border)] p-3 text-center">
        <p class="mb-2 text-xs font-semibold text-[var(--text)]">Pay $99 USD</p>
        <form data-rzp-form data-button-id={usdButtonId}></form>
      </div>
    </div>
  </div>

  <noscript>
    <p class="mt-3 text-xs text-[var(--text-muted)]">JavaScript is required to load Razorpay. Contact us for an alternative payment method.</p>
  </noscript>
</div>

<script>
  document.querySelectorAll<HTMLElement>('[data-rzp-gate]').forEach((gate) => {
    if (gate.dataset.bound === 'true') return;
    gate.dataset.bound = 'true';

    const consent = gate.querySelector<HTMLInputElement>('[data-rzp-consent]');
    const error = gate.querySelector<HTMLElement>('[data-rzp-error]');
    const loadButton = gate.querySelector<HTMLButtonElement>('[data-rzp-load]');
    const options = gate.querySelector<HTMLElement>('[data-rzp-options]');
    if (!consent || !error || !loadButton || !options) return;

    consent.addEventListener('change', () => {
      if (consent.checked) {
        error.classList.add('hidden');
        consent.removeAttribute('aria-invalid');
      }
    });

    loadButton.addEventListener('click', () => {
      if (!consent.checked) {
        error.classList.remove('hidden');
        consent.setAttribute('aria-invalid', 'true');
        consent.focus();
        return;
      }

      error.classList.add('hidden');
      loadButton.disabled = true;
      loadButton.textContent = 'Loading secure payment options…';
      options.classList.remove('hidden');

      gate.querySelectorAll<HTMLFormElement>('[data-rzp-form]').forEach((form) => {
        if (form.dataset.loaded === 'true') return;
        form.dataset.loaded = 'true';
        const buttonId = form.dataset.buttonId;
        if (!buttonId) return;

        const script = document.createElement('script');
        script.src = 'https://checkout.razorpay.com/v1/payment-button.js';
        script.async = true;
        script.setAttribute('data-payment_button_id', buttonId);
        script.addEventListener('error', () => {
          form.textContent = 'Payment option could not load. Please contact eLan Technology.';
          form.classList.add('text-xs', 'text-red-500');
        });
        form.appendChild(script);
      });

      loadButton.classList.add('hidden');
    });
  });
</script>
