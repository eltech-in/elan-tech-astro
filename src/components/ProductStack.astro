---
// Technology stack block for product pages. Renders nothing when a product
// has no confirmed stack, so an unverified product never shows a guess.
import type { Product } from '../data/products';

interface Props {
  product: Product;
}

const { product } = Astro.props;
const groups = product.stack ?? [];
---

{groups.length > 0 && (
  <section class="bg-[var(--bg-card)] py-14 md:py-16 border-t border-[var(--border)]" aria-labelledby="product-stack-heading">
    <div class="mx-auto max-w-4xl px-4 sm:px-6 lg:px-8">
      <p class="text-xs font-bold uppercase tracking-widest mb-1" style={`color: var(${product.cssVar});`}>Technology</p>
      <h2 id="product-stack-heading" class="font-heading text-2xl sm:text-3xl font-bold text-[var(--text)]">What the {product.title} is built with</h2>
      <p class="mt-3 max-w-2xl text-sm leading-relaxed text-[var(--text-dim)]">
        This is the stack of the current product build. Hosting and further integrations are agreed for each implementation.
      </p>
      <dl class="mt-7 grid gap-4 sm:grid-cols-2">
        {groups.map((group) => (
          <div class="rounded-2xl border border-[var(--border)] bg-[var(--bg)] p-5">
            <dt class="text-xs font-bold uppercase tracking-wider text-[var(--text-muted)]">{group.group}</dt>
            <dd class="mt-3">
              <ul class="flex flex-wrap gap-2" role="list">
                {group.items.map((item) => (
                  <li class="rounded-full border border-[var(--border)] px-3 py-1 text-sm font-semibold text-[var(--text)]">{item}</li>
                ))}
              </ul>
            </dd>
          </div>
        ))}
      </dl>
      <p class="mt-6 text-sm">
        <a href="/technologies/" class="font-semibold underline underline-offset-4 hover:no-underline" style={`color: var(${product.cssVar});`}>See all the technologies we build with</a>
      </p>
    </div>
  </section>
)}
