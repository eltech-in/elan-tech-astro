---
import SchemaMarkup from './SchemaMarkup.astro';

interface Props {
  title: string;
  description: string;
  canonical?: string;
  ogImage?: string;
  ogType?: string;
  noindex?: boolean;
  schema?: object | object[];
  geo?: { region: string; placename: string; lat: number; lng: number };
}

const {
  title,
  description,
  canonical,
  ogImage = '/images/elantech-00.jpg',
  ogType = 'website',
  noindex = false,
  schema,
  geo,
} = Astro.props;

const SITE_URL = 'https://elan-tech.net';

/**
 * Canonical URL resolution
 * Policy: NO trailing slash on any URL except root "/", NO .html extension.
 * Accepts:
 *   - absolute URL (https://...): used as-is
 *   - path (/foo/bar or foo/bar): prefixed with SITE_URL
 *   - undefined: derived from Astro.url.pathname
 * Always strips trailing slash, .html, and any query string for stability.
 *
 * The .html strip matters under `build.format: 'file'` — Astro.url.pathname
 * during build is "/about.html", but the canonical URL we expose is "/about".
 */
function normalizePath(p: string): string {
  // Strip trailing slash (except root) and trailing .html
  let out = p === '/' ? '/' : p.replace(/\/+$/, '');
  out = out.replace(/\.html$/i, '');
  // /index → / (Astro emits index.html for root)
  if (out === '/index') out = '/';
  return out || '/';
}

function buildCanonical(input?: string): string {
  const raw = input ?? Astro.url.pathname;
  // strip query / hash
  const pathOnly = raw.split('?')[0].split('#')[0];
  if (pathOnly.startsWith('http')) {
    const url = new URL(pathOnly);
    return `${url.origin}${normalizePath(url.pathname)}`;
  }
  const path = pathOnly.startsWith('/') ? pathOnly : `/${pathOnly}`;
  return `${SITE_URL}${normalizePath(path)}`;
}

const canonicalURL = buildCanonical(canonical);
const pageTitle = title.includes('eLan Technology')
  ? title
  : `${title} | eLan Technology`;
const robotsContent = noindex ? 'noindex,nofollow' : 'index,follow';
const absoluteOgImage = ogImage.startsWith('http') ? ogImage : `${SITE_URL}${ogImage}`;
---
<meta charset="UTF-8" />
<meta name="viewport" content="width=device-width, initial-scale=1.0" />
<title>{pageTitle}</title>
<meta name="description" content={description} />
<link rel="canonical" href={canonicalURL} />
<meta name="robots" content={robotsContent} />
<link rel="icon" href="/favicon.svg" type="image/svg+xml" />
<link rel="icon" href="/favicon.ico" sizes="32x32" />
<link rel="apple-touch-icon" href="/images/et-sym.png" />

<!-- Open Graph -->
<meta property="og:title" content={pageTitle} />
<meta property="og:description" content={description} />
<meta property="og:url" content={canonicalURL} />
<meta property="og:type" content={ogType} />
<meta property="og:image" content={absoluteOgImage} />
<meta property="og:image:width" content="1200" />
<meta property="og:image:height" content="630" />
<meta property="og:image:alt" content={pageTitle} />
<meta property="og:site_name" content="eLan Technology" />
<meta property="og:locale" content="en_US" />

<!-- Twitter / X Card -->
<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:site" content="@eLanTechnology" />
<meta name="twitter:creator" content="@eLanTechnology" />
<meta name="twitter:title" content={pageTitle} />
<meta name="twitter:description" content={description} />
<meta name="twitter:image" content={absoluteOgImage} />
<meta name="twitter:image:alt" content={pageTitle} />

{/* Geo meta tags for local SEO (city pages) */}
{geo && (
  <>
    <meta name="geo.region" content={geo.region} />
    <meta name="geo.placename" content={geo.placename} />
    <meta name="geo.position" content={`${geo.lat};${geo.lng}`} />
    <meta name="ICBM" content={`${geo.lat}, ${geo.lng}`} />
  </>
)}

<!-- Self-hosted fonts — preload critical WOFF2 files -->
<link rel="preload" as="font" type="font/woff2" crossorigin href="/fonts/dm-sans-latin.woff2" />
<link rel="preload" as="font" type="font/woff2" crossorigin href="/fonts/sora-latin.woff2" />

{schema && <SchemaMarkup schema={schema} />}
