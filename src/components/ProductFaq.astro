---
// Visible FAQ block for product pages. The same array is passed to faqSchema()
// by the page, so the markup always matches what a visitor can read.
interface FaqItem {
  question: string;
  answer: string;
}

interface Props {
  items: FaqItem[];
  title?: string;
  accentVar?: string;
}

const { items, title = 'Frequently asked questions', accentVar = '--accent' } = Astro.props;
---

<section class="bg-[var(--bg)] py-14 md:py-16 border-t border-[var(--border)]" aria-labelledby="product-faq-heading">
  <div class="mx-auto max-w-4xl px-4 sm:px-6 lg:px-8">
    <p class="text-xs font-bold uppercase tracking-widest mb-1" style={`color: var(${accentVar});`}>FAQs</p>
    <h2 id="product-faq-heading" class="font-heading text-2xl sm:text-3xl font-bold text-[var(--text)]">{title}</h2>
    <div class="mt-7 divide-y divide-[var(--border)] overflow-hidden rounded-2xl border border-[var(--border)]">
      {items.map((faq) => (
        <details class="bg-[var(--bg-card)] p-6">
          <summary class="cursor-pointer font-semibold text-[var(--text)]">{faq.question}</summary>
          <p class="mt-3 text-sm leading-relaxed text-[var(--text-dim)]">{faq.answer}</p>
        </details>
      ))}
    </div>
  </div>
</section>
