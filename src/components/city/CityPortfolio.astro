---
import type { CityData } from '../../data/cities';

interface Props {
  city: CityData;
}

const { city } = Astro.props;

const hasLocalClients = city.nearbyClients.length > 0;
const heading = hasLocalClients
  ? `Our Work in ${city.name}`
  : `Relevant Project Experience for ${city.name} Businesses`;

// Use city portfolio data, fall back to generic showcase
const projects = city.portfolio.length > 0
  ? city.portfolio
  : [
      { name: 'Aastha Hospital', category: 'Healthcare', desc: 'A healthcare website that helps patients understand services, find doctors and take the next step.', href: '/portfolio/case-study/aastha-hospital/' },
      { name: 'Trimit Architects', category: 'Architecture and real estate', desc: 'A visual portfolio website that organises projects and creates a clearer path for prospective clients.', href: '/portfolio/case-study/trimit-architects/' },
      { name: 'CIPL Corporate Portal', category: 'Enterprise operations', desc: 'A role-based internal portal supporting HR workflows, document access and more than 500 staff members.', href: '/portfolio/case-study/cipl-corporate-portal/' },
    ];
---

<section class="py-16 md:py-20 bg-[var(--bg-card)]">
  <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
    <div class="mb-12 text-center">
      <h2 class="font-heading text-2xl sm:text-3xl font-bold text-[var(--text)] mb-4">
        {heading}
      </h2>
      <p class="text-[var(--text-dim)] max-w-2xl mx-auto">
        {hasLocalClients
          ? `A selection of websites and digital solutions delivered for organisations in and around ${city.name}.`
          : `These are real eLan projects from comparable sectors. They demonstrate relevant capabilities and are not presented as local ${city.name} clients.`}
      </p>
    </div>
    <div class="grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
      {projects.map((p) => (
        <article class="rounded-lg border border-[var(--border)] bg-[var(--bg)] p-6">
          <div class="text-xs font-semibold uppercase tracking-widest text-[var(--accent)] mb-2">
            {p.category}
          </div>
          <h3 class="font-heading font-bold text-[var(--text)] text-lg mb-3">{p.name}</h3>
          <p class="text-sm text-[var(--text-dim)] leading-relaxed">{p.desc}</p>
          {p.href && (
            <a class="mt-5 inline-flex items-center gap-2 text-sm font-semibold text-[var(--text)] hover:text-[var(--accent)]" href={p.href}>
              Read case study
              <svg xmlns="http://www.w3.org/2000/svg" width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="m9 18 6-6-6-6"/></svg>
            </a>
          )}
        </article>
      ))}
    </div>
    <div class="mt-10 text-center">
      <a
        href="/portfolio/"
        class="inline-flex items-center gap-2 rounded-full border border-[var(--border)] bg-[var(--bg-card)] px-8 py-3 font-semibold text-[var(--text)] hover:border-[var(--accent)] hover:text-[var(--accent)] transition-colors"
      >
        View Full Portfolio
        <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><line x1="5" y1="12" x2="19" y2="12"/><polyline points="12 5 19 12 12 19"/></svg>
      </a>
    </div>
  </div>
</section>
