---
import type { CityData } from '../../data/cities';

interface Props {
  city: CityData;
}

const { city } = Astro.props;

const reasons = city.isHQ
  ? [
      {
        title: 'Visit Our Nagpur Office',
        desc: 'Meet the team for discovery, design reviews and project discussions at our headquarters.',
      },
      {
        title: 'Operating Since 2002',
        desc: 'Our long-running Nagpur presence supports projects across business websites, eCommerce and custom applications.',
      },
      {
        title: 'Direct Team Access',
        desc: 'Speak with the designers, developers and project leads responsible for your website.',
      },
      {
        title: 'Accessibility Expertise',
        desc: 'Accessibility can be scoped from the start, with WCAG-aligned design, development and testing matched to your requirements.',
      },
    ]
  : [
      {
        title: 'Published Starting Prices',
        desc: 'Business website packages start at ₹21,000. We confirm deliverables, exclusions, timeline and payment milestones before development.',
      },
      {
        title: 'Technology Matched to the Project',
        desc: 'We work with Astro, React, Next.js, Node.js, WordPress and Shopify, selecting the stack around content, integrations and maintenance.',
      },
      {
        title: 'Structured Remote Delivery',
        desc: `${city.name} projects are managed from our Nagpur headquarters through scheduled calls, shared reviews, milestone approvals and documented handover.`,
      },
      {
        title: 'Accessibility Can Be Built In',
        desc: 'Where accessibility is part of the scope, we apply WCAG-aligned design, development and testing instead of relying on a one-click overlay.',
      },
    ];
---

<section class="py-16 md:py-20">
  <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
    <div class="mb-12 text-center">
      <h2 class="mb-4 font-heading text-2xl font-bold text-[var(--text)] sm:text-3xl">
        Why {city.name} Businesses Choose eLan Technology
      </h2>
      <p class="mx-auto max-w-2xl text-[var(--text-dim)]">
        {city.whyChooseContent}
      </p>
    </div>
    <ul role="list" class="grid gap-6 sm:grid-cols-2">
      {reasons.map((reason) => (
        <li class="rounded-lg border border-[var(--border)] bg-[var(--bg-card)] p-8">
          <svg class="mb-4 text-[var(--accent)]" xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M20 6 9 17l-5-5"/></svg>
          <h3 class="mb-3 font-heading text-lg font-bold text-[var(--text)]">{reason.title}</h3>
          <p class="leading-relaxed text-[var(--text-dim)]">{reason.desc}</p>
        </li>
      ))}
    </ul>
  </div>
</section>
