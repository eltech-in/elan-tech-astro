---
// What moves a website quote (27 Nov 2026): location pages explain the cost drivers and link to current
// pricing instead of repeating package amounts. Primary action: Request a Website Quote; secondary: paid audit.
interface Props {
  cityName: string;
  chapter?: string;
}
const { cityName, chapter } = Astro.props;
const factors = [
  { title: 'Content', text: 'How many pages, who writes the copy, and whether photography or translation is needed.', color: '--ac-cyan' },
  { title: 'Page types', text: 'Unique templates such as product, service, project or blog pages, rather than the raw page count.', color: '--ac-violet' },
  { title: 'Integrations', text: 'Payments, catalogues, CRM hand-off, WhatsApp, bookings or a customer portal.', color: '--ac-amber' },
  { title: 'Support', text: 'Hosting, maintenance, content updates and SEO after launch.', color: '--ac-emerald' },
];
---
<section aria-labelledby="quote-factors-heading" class="border-y border-[var(--border)] bg-[var(--bg-card)] py-16 md:py-20">
  <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
    {chapter && <p class="mb-4 text-xs font-bold uppercase tracking-[0.18em] text-[var(--accent)]">{chapter}</p>}
    <h2 id="quote-factors-heading" class="font-heading text-3xl font-bold text-[var(--text)] sm:text-4xl">What affects the cost of a website for a {cityName} business</h2>
    <p class="mt-3 max-w-2xl text-lg text-[var(--text-dim)]">Every quote is written for the agreed scope. These four things move it most.</p>
    <ul class="mt-8 grid gap-5 sm:grid-cols-2 lg:grid-cols-4" role="list">
      {factors.map((f) => (
        <li class="tilt-card p-6" style={`--card-color: var(${f.color});`}>
          <h3 class="font-heading text-lg font-bold text-[var(--text)]">{f.title}</h3>
          <p class="mt-2 text-sm leading-relaxed text-[var(--text-dim)]">{f.text}</p>
        </li>
      ))}
    </ul>
    <div class="mt-8 flex flex-wrap items-center gap-3">
      <a href="/get-quote/" class="inline-flex min-h-11 items-center rounded-lg bg-[var(--accent)] px-6 py-3 font-semibold text-white transition hover:brightness-110">Request a Website Quote</a>
      <a href="/pricing/" class="inline-flex min-h-11 items-center rounded-lg border border-[var(--border)] bg-[var(--bg)] px-6 py-3 font-semibold text-[var(--text)] transition hover:border-[var(--accent)]">See current pricing</a>
      <a href="/website-audit/" class="text-sm font-semibold text-[var(--text)] underline underline-offset-4">Or book a paid audit of your current website</a>
    </div>
  </div>
</section>
