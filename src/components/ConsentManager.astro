---
// First-party consent UI. Optional analytics remain blocked until the visitor
// makes an affirmative choice. The saved record contains no visitor identity.
interface Props { standalone?: boolean }
const { standalone = false } = Astro.props;
---

<aside
  id="privacy-consent-banner"
  class:list={['privacy-banner', { 'privacy-banner--standalone': standalone }]}
  aria-labelledby="privacy-consent-title"
  aria-describedby="privacy-consent-description"
  hidden
>
  <div class="privacy-banner__copy">
    <p class="privacy-banner__eyebrow">Privacy choices</p>
    <h2 id="privacy-consent-title">You decide whether analytics are used.</h2>
    <p id="privacy-consent-description">
      Necessary storage keeps preferences working. Optional analytics help us improve the website
      and stay off unless you choose to allow them.
      <a href="/cookie-policy/">Read the cookie policy</a>.
    </p>
    <p id="privacy-signal-note" class="privacy-banner__signal" hidden>
      Your browser privacy signal is active, so analytics stay off by default. You may still make an explicit analytics choice here.
    </p>
  </div>
  <div class="privacy-banner__actions">
    <button type="button" id="privacy-reject" class="privacy-button privacy-button--secondary">
      Reject optional
    </button>
    <button type="button" id="privacy-manage" class="privacy-button privacy-button--secondary">
      Manage choices
    </button>
    <button type="button" id="privacy-accept" class="privacy-button privacy-button--primary">
      Accept analytics
    </button>
  </div>
</aside>

<button
  type="button"
  id="privacy-choices-float"
  class:list={['privacy-choices-float', { 'privacy-choices-float--standalone': standalone }]}
  aria-label="Open privacy and cookie choices"
  aria-haspopup="dialog"
  hidden
>
  <svg viewBox="0 0 24 24" aria-hidden="true">
    <path d="M12 3 5 6v5c0 4.6 2.9 8.7 7 10 4.1-1.3 7-5.4 7-10V6l-7-3Z" />
    <path d="M9.5 12 11 13.5l3.8-4" />
  </svg>
  Privacy choices
</button>

<dialog
  id="privacy-preferences"
  class="privacy-dialog"
  aria-labelledby="privacy-preferences-title"
  aria-describedby="privacy-preferences-description"
>
  <form method="dialog" class="privacy-dialog__panel">
    <div class="privacy-dialog__header">
      <div>
        <p class="privacy-banner__eyebrow">eLan Technology</p>
        <h2 id="privacy-preferences-title">Privacy preferences</h2>
      </div>
      <button type="button" id="privacy-close" class="privacy-dialog__close" aria-label="Close privacy preferences">×</button>
    </div>

    <p id="privacy-preferences-description" class="privacy-dialog__intro">
      Optional technologies are disabled until you allow them. You can change this choice at any time.
    </p>

    <div class="privacy-choice">
      <div>
        <h3>Necessary storage</h3>
        <p>Remembers display, campaign-dismissal and privacy preferences. It does not profile you.</p>
      </div>
      <span class="privacy-choice__status">Always on</span>
    </div>

    <label class="privacy-choice privacy-choice--interactive" for="privacy-analytics-toggle">
      <div>
        <h3>Analytics</h3>
        <p>Allows Google Tag Manager/Analytics and Microsoft Clarity to measure site use.</p>
        <small id="privacy-analytics-lock" hidden>Your browser privacy signal is active. Turning this on is an explicit override for analytics only; advertising remains off.</small>
      </div>
      <span class="privacy-switch">
        <input id="privacy-analytics-toggle" type="checkbox" />
        <span aria-hidden="true"></span>
      </span>
    </label>

    <div class="privacy-dialog__links">
      <a href="/privacy-policy/">Privacy Policy</a>
      <a href="/cookie-policy/">Cookie Policy</a>
    </div>

    <div class="privacy-dialog__actions">
      <button type="button" id="privacy-save" class="privacy-button privacy-button--primary">Save my choices</button>
      <button type="button" id="privacy-dialog-reject" class="privacy-button privacy-button--secondary">Reject optional</button>
    </div>
  </form>
</dialog>

<style>
  .privacy-banner {
    position: fixed;
    z-index: 10000;
    right: 1rem;
    bottom: 1rem;
    left: auto;
    display: grid;
    gap: 1.25rem;
    width: min(32rem, calc(100% - 2rem));
    max-width: 32rem;
    margin: 0;
    padding: 1rem;
    border: 1px solid color-mix(in srgb, var(--accent) 28%, var(--border));
    border-radius: 1.25rem;
    background: color-mix(in srgb, var(--bg-card) 96%, transparent);
    box-shadow: 0 24px 70px rgb(2 6 23 / 28%);
    color: var(--text);
    backdrop-filter: blur(18px);
  }
  .privacy-banner[hidden], .privacy-choices-float[hidden] { display: none; }
  .privacy-banner__copy { max-width: 30rem; }
  .privacy-banner__eyebrow { margin: 0 0 .35rem; color: var(--accent); font-size: .68rem; font-weight: 800; letter-spacing: .16em; text-transform: uppercase; }
  .privacy-banner h2, .privacy-dialog h2 { margin: 0; font-family: var(--font-heading); font-size: clamp(1.15rem, 2vw, 1.45rem); font-weight: 800; line-height: 1.2; }
  .privacy-banner__copy > p:not(.privacy-banner__eyebrow):not(.privacy-banner__signal) { margin: .55rem 0 0; color: var(--text-dim); font-size: .88rem; line-height: 1.6; }
  .privacy-banner a, .privacy-dialog a { color: var(--accent); font-weight: 700; text-decoration: underline; text-underline-offset: 3px; }
  .privacy-banner__signal { margin: .65rem 0 0; color: var(--accent); font-size: .78rem; font-weight: 700; }
  .privacy-banner__actions { display: grid; grid-template-columns: 1fr 1fr; gap: .55rem; }
  .privacy-banner__actions .privacy-button--primary { grid-column: 1 / -1; }
  .privacy-dialog__actions { display: grid; gap: .65rem; }
  .privacy-button { min-height: 44px; border: 1px solid var(--border); border-radius: .8rem; padding: .7rem 1rem; font-size: .82rem; font-weight: 800; cursor: pointer; transition: transform .15s ease, opacity .15s ease, border-color .15s ease; }
  .privacy-button:hover { transform: translateY(-1px); }
  .privacy-button:focus-visible, .privacy-dialog__close:focus-visible, .privacy-choices-float:focus-visible, .privacy-switch input:focus-visible + span { outline: 3px solid color-mix(in srgb, var(--accent) 55%, transparent); outline-offset: 3px; }
  .privacy-button--primary { border-color: var(--accent); background: var(--accent); color: var(--bg); }
  .privacy-button--primary:disabled { cursor: not-allowed; opacity: .45; transform: none; }
  .privacy-button--secondary { background: var(--bg); color: var(--text); }
  .privacy-choices-float { position: fixed; z-index: 9990; left: 1rem; bottom: 5.5rem; display: inline-flex; align-items: center; gap: .5rem; min-height: 42px; border: 1px solid var(--border); border-radius: 999px; padding: .55rem .8rem; background: var(--bg-card); box-shadow: 0 12px 34px rgb(2 6 23 / 18%); color: var(--text); font-size: .72rem; font-weight: 800; cursor: pointer; }
  .privacy-choices-float--standalone { left: auto; right: 1rem; bottom: calc(8rem + env(safe-area-inset-bottom)); }
  .privacy-choices-float svg { width: 1rem; height: 1rem; fill: none; stroke: var(--accent); stroke-width: 1.8; stroke-linecap: round; stroke-linejoin: round; }
  .privacy-dialog { width: min(36rem, calc(100% - 2rem)); max-height: calc(100vh - 2rem); margin: auto; padding: 0; overflow: auto; border: 1px solid var(--border); border-radius: 1.25rem; background: var(--bg-card); color: var(--text); box-shadow: 0 30px 90px rgb(2 6 23 / 38%); }
  .privacy-dialog::backdrop { background: rgb(2 6 23 / 68%); backdrop-filter: blur(5px); }
  .privacy-dialog__panel { padding: 1.25rem; }
  .privacy-dialog__header { display: flex; align-items: flex-start; justify-content: space-between; gap: 1rem; }
  .privacy-dialog__close { width: 44px; height: 44px; flex: 0 0 auto; border: 1px solid var(--border); border-radius: 50%; background: var(--bg); color: var(--text); font-size: 1.7rem; line-height: 1; cursor: pointer; }
  .privacy-dialog__intro { margin: .8rem 0 1rem; color: var(--text-dim); font-size: .86rem; line-height: 1.55; }
  .privacy-choice { display: flex; align-items: center; justify-content: space-between; gap: 1rem; padding: 1rem 0; border-top: 1px solid var(--border); }
  .privacy-choice h3 { margin: 0; font-size: .92rem; font-weight: 800; }
  .privacy-choice p { margin: .25rem 0 0; color: var(--text-muted); font-size: .76rem; line-height: 1.45; }
  .privacy-choice small { display: block; margin-top: .35rem; color: var(--accent); font-weight: 700; }
  .privacy-choice__status { flex: 0 0 auto; border-radius: 999px; padding: .35rem .55rem; background: color-mix(in srgb, var(--accent) 12%, transparent); color: var(--accent); font-size: .65rem; font-weight: 800; }
  .privacy-switch { position: relative; flex: 0 0 auto; }
  .privacy-switch input { position: absolute; width: 1px; height: 1px; opacity: 0; }
  .privacy-switch span { position: relative; display: block; width: 3rem; height: 1.65rem; border: 1px solid var(--border); border-radius: 999px; background: var(--bg); transition: background .15s ease; }
  .privacy-switch span::after { content: ''; position: absolute; top: 3px; left: 3px; width: 1.15rem; height: 1.15rem; border-radius: 50%; background: var(--text-muted); transition: transform .15s ease, background .15s ease; }
  .privacy-switch input:checked + span { border-color: var(--accent); background: color-mix(in srgb, var(--accent) 28%, var(--bg)); }
  .privacy-switch input:checked + span::after { transform: translateX(1.28rem); background: var(--accent); }
  .privacy-switch input:disabled + span { opacity: .45; cursor: not-allowed; }
  .privacy-dialog__links { display: flex; flex-wrap: wrap; gap: 1rem; margin: .85rem 0 1.1rem; font-size: .76rem; }
  @media (min-width: 760px) {
    .privacy-banner { padding: 1.2rem 1.3rem; }
    .privacy-dialog__actions { grid-template-columns: 1fr auto; }
    .privacy-choices-float { bottom: 1rem; }
  }
  @media (max-width: 759px) {
    .privacy-banner { bottom: 5.5rem; }
    .privacy-banner--standalone { bottom: calc(8rem + env(safe-area-inset-bottom)); }
  }
</style>

<script is:inline>
  (function () {
    var STORAGE_KEY = 'elan:privacy-consent';
    var CONSENT_VERSION = 2;
    var banner = document.getElementById('privacy-consent-banner');
    var dialog = document.getElementById('privacy-preferences');
    var floatButton = document.getElementById('privacy-choices-float');
    var acceptButton = document.getElementById('privacy-accept');
    var rejectButton = document.getElementById('privacy-reject');
    var manageButton = document.getElementById('privacy-manage');
    var closeButton = document.getElementById('privacy-close');
    var saveButton = document.getElementById('privacy-save');
    var dialogRejectButton = document.getElementById('privacy-dialog-reject');
    var analyticsToggle = document.getElementById('privacy-analytics-toggle');
    var privacySignalNote = document.getElementById('privacy-signal-note');
    var analyticsLock = document.getElementById('privacy-analytics-lock');

    if (!banner || !dialog || !floatButton || !analyticsToggle) return;

    function privacySignalActive() {
      return navigator.globalPrivacyControl === true ||
        navigator.doNotTrack === '1' ||
        window.doNotTrack === '1';
    }

    function readConsent() {
      try {
        var parsed = JSON.parse(localStorage.getItem(STORAGE_KEY) || 'null');
        return parsed && parsed.version === CONSENT_VERSION && typeof parsed.analytics === 'boolean' ? parsed : null;
      } catch (_) { return null; }
    }

    function persistConsent(analytics, source) {
      var previous = readConsent();
      var now = new Date().toISOString();
      var signal = privacySignalActive();
      var record = {
        version: CONSENT_VERSION,
        analytics: Boolean(analytics),
        source: source,
        decidedAt: previous && previous.decidedAt ? previous.decidedAt : now,
        updatedAt: now,
        privacySignal: signal,
        signalOverride: Boolean(analytics) && signal
      };
      try { localStorage.setItem(STORAGE_KEY, JSON.stringify(record)); } catch (_) {}
      return record;
    }

    function applyConsent(record, previousAnalytics) {
      if (record.analytics) {
        if (typeof window.__elanLoadOptionalAnalytics === 'function') window.__elanLoadOptionalAnalytics();
      } else if (typeof window.__elanRevokeOptionalAnalytics === 'function') {
        window.__elanRevokeOptionalAnalytics();
      }

      banner.hidden = true;
      floatButton.hidden = false;
      analyticsToggle.checked = record.analytics;
      if (dialog.open) dialog.close();

      // Unload already-running optional scripts after consent is withdrawn.
      if (previousAnalytics === true && record.analytics === false) window.location.reload();
    }

    function choose(analytics, source) {
      var previous = readConsent();
      var record = persistConsent(analytics, source);
      applyConsent(record, previous ? previous.analytics : false);
    }

    function openPreferences() {
      var record = readConsent();
      analyticsToggle.checked = Boolean(record && record.analytics);
      dialog.showModal();
    }

    var signal = privacySignalActive();
    if (signal) {
      privacySignalNote.hidden = false;
      analyticsLock.hidden = false;
    }

    var existing = readConsent();
    if (existing) {
      analyticsToggle.checked = existing.analytics;
      floatButton.hidden = false;
    } else {
      banner.hidden = false;
      floatButton.hidden = true;
    }

    acceptButton.addEventListener('click', function () { choose(true, 'banner-accept'); });
    rejectButton.addEventListener('click', function () { choose(false, 'banner-reject'); });
    manageButton.addEventListener('click', openPreferences);
    floatButton.addEventListener('click', openPreferences);
    document.querySelectorAll('[data-open-privacy-choices]').forEach(function (button) {
      button.addEventListener('click', openPreferences);
    });
    closeButton.addEventListener('click', function () { dialog.close(); });
    saveButton.addEventListener('click', function () { choose(analyticsToggle.checked, 'preferences-save'); });
    dialogRejectButton.addEventListener('click', function () { choose(false, 'preferences-reject'); });
    dialog.addEventListener('click', function (event) { if (event.target === dialog) dialog.close(); });
  })();
</script>
