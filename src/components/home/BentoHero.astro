---
// Homepage hero, bento-grid option. The pre-heading, H1 wording and subheading are unchanged
// (the H1 and title are frozen for SEO until the 10 December 2026 review). Light by default and
// built on the theme tokens, so it also follows the dark-mode toggle.
import { Image } from 'astro:assets';
import { homepageSeoBaseline } from '../../data/seoStability';
import { navProducts } from '../../data/navigation';
import { indexedCountries } from '../../data/countries';
import AuditPrice from '../AuditPrice.astro';
import shotTrimit from '../../assets/portfolio/trimitarch.avif';
import shotDizviz from '../../assets/portfolio/dizviz.avif';
import shotAbhay from '../../assets/portfolio/abhay-tembhurne.avif';
import shotAsbim from '../../assets/portfolio/asbim.avif';

const yearsExp = new Date().getFullYear() - 2002;
const work = [
  { img: shotTrimit, name: 'Trimit Architects', kind: 'Architecture · Astro' },
  { img: shotDizviz, name: 'Dizviz', kind: 'Creative education · Astro' },
  { img: shotAbhay, name: 'Abhay Tembhurne', kind: 'Land surveying · Astro' },
  { img: shotAsbim, name: 'ASBIM Consulting', kind: 'BIM consulting' },
];
const productNames = navProducts.map((p) => p.label.replace(/ (Portal|Management System|System)$/, ''));
const countries = indexedCountries.filter((c) => c.code !== 'IN');
---
<section aria-labelledby="hero-heading" class="bento-hero">
  <div class="bg" aria-hidden="true"></div>
  <div class="grid">
    <div class="tile t-hero">
      <p class="pill"><span class="dot" aria-hidden="true"></span>Web design · eCommerce · Accessibility · Since 2002</p>
      <h1 id="hero-heading" class="h1">
        <span class="block">{homepageSeoBaseline.h1Lead}</span>
        <span class="block grad">{homepageSeoBaseline.h1Proof}</span>
      </h1>
      <p class="sub">
        We create fast, accessible websites and custom online stores on{' '}
        <a href="/services/ecommerce/shopify-development/">Shopify</a>,{' '}
        <a href="/services/ecommerce/medusa-js-development/">Medusa.js</a>{' '}
        and WooCommerce. Based in <a href="/web-design-company-nagpur/">Nagpur</a>, trusted by 500+ businesses since 2002.
      </p>
      <div class="ctas">
        <a href="/get-quote/" class="btn">Request a Quote <span aria-hidden="true">→</span></a>
        <a href="/portfolio/" class="ghost">Explore Our Work</a>
      </div>
    </div>

    <div class="tile t-stat">
      <p class="big">500+</p>
      <p class="cap">businesses trusted us since 2002</p>
    </div>

    <a class="tile t-commerce" href="/services/ecommerce/">
      <p class="label">Online stores</p>
      <ul class="stores" role="list">
        <li><b>Shopify</b></li><li><b>Medusa.js</b></li><li><b>WooCommerce</b></li>
      </ul>
      <p class="cap">Custom online stores, designed, built and looked after by one team.</p>
      <span class="more">eCommerce <span aria-hidden="true">→</span></span>
    </a>

    <a class="tile t-work" href="/portfolio/" aria-label="Recent work: see the portfolio">
      <div class="shots" aria-hidden="true">
        {work.map((w, i) => (
          <figure class="shot" style={`--d:${i}`}>
            <Image src={w.img} alt="" widths={[480, 720, 960]} sizes="(min-width: 1024px) 34vw, 92vw" loading={i === 0 ? 'eager' : 'lazy'} />
            <figcaption><b>{w.name}</b><span>{w.kind}</span></figcaption>
          </figure>
        ))}
      </div>
      <span class="badge">Recent work</span>
    </a>

    <a class="tile t-products" href="/products/">
      <p class="label">Products</p>
      <p class="num">{navProducts.length}<span> ready-to-adapt products</span></p>
      <ul class="chips" role="list">
        {productNames.slice(0, 5).map((n) => <li>{n}</li>)}
        <li>+{navProducts.length - 5} more</li>
      </ul>
    </a>

    <a class="tile t-audit" href="/website-audit/">
      <p class="label">Website audit</p>
      <p class="num"><AuditPrice kind="website" /></p>
      <p class="cap">SEO, speed, mobile and security signals, reviewed by a person.</p>
      <span class="more">Book an audit <span aria-hidden="true">→</span></span>
    </a>

    <div class="tile t-world">
      <p class="label">Clients worldwide</p>
      <ul class="flags" role="list">
        {countries.map((c) => (
          <li><a href={`/web-design-company-${c.slug}/`}><span aria-hidden="true">{c.flag}</span>{c.name.replace('United Arab Emirates', 'UAE').replace('United States', 'USA')}</a></li>
        ))}
      </ul>
    </div>

    <div class="tile t-years">
      <p class="label">Accessibility-first</p>
      <p class="num">{yearsExp}+<span> years · 1,500+ projects</span></p>
      <ul class="chips" role="list"><li>WCAG Testing</li><li>Keyboard checks</li><li>Screen readers</li></ul>
    </div>
  </div>
</section>

<style>
  .bento-hero { position: relative; overflow: hidden; background: var(--bg); padding: 2.2rem 1rem 3.5rem; }
  .bg { position: absolute; inset: 0; pointer-events: none;
    background:
      radial-gradient(40rem 26rem at 8% 0%, rgba(99,102,241,.12), transparent 70%),
      radial-gradient(36rem 24rem at 100% 30%, rgba(242,103,34,.10), transparent 70%),
      radial-gradient(circle, rgba(15,23,42,.07) 1px, transparent 1.2px) 0 0 / 22px 22px; }
  :global(.dark) .bg { background:
      radial-gradient(40rem 26rem at 8% 0%, rgba(99,102,241,.22), transparent 70%),
      radial-gradient(36rem 24rem at 100% 30%, rgba(242,103,34,.12), transparent 70%),
      radial-gradient(circle, rgba(255,255,255,.06) 1px, transparent 1.2px) 0 0 / 22px 22px; }

  .grid { position: relative; max-width: 78rem; margin: 0 auto; display: grid; gap: 1rem;
    grid-template-columns: repeat(12, minmax(0, 1fr)); grid-auto-rows: minmax(10.5rem, auto); }

  .tile { position: relative; overflow: hidden; border-radius: 1.5rem; padding: 1.4rem 1.5rem;
    background: var(--bg-card); border: 1px solid var(--border); color: var(--text); text-decoration: none;
    box-shadow: 0 1px 2px rgba(15,23,42,.04), 0 12px 32px -18px rgba(15,23,42,.18);
    animation: rise .7s cubic-bezier(.2,.7,.2,1) both; animation-delay: calc(var(--n, 0) * 70ms); }
  a.tile { transition: transform .25s ease, box-shadow .25s ease, border-color .25s ease; }
  a.tile:hover { transform: translateY(-3px); border-color: rgba(99,102,241,.35); box-shadow: 0 2px 4px rgba(15,23,42,.05), 0 22px 44px -20px rgba(79,70,229,.35); }
  a.tile:focus-visible { outline: 3px solid #6366f1; outline-offset: 3px; }
  @keyframes rise { from { opacity: 0; transform: translateY(14px); } to { opacity: 1; transform: none; } }

  .label { font-size: .72rem; font-weight: 700; letter-spacing: .16em; text-transform: uppercase; color: var(--text-muted); }
  .num { margin-top: .5rem; font-family: var(--font-heading); font-size: 2.1rem; font-weight: 800; letter-spacing: -.03em; line-height: 1.05; }
  .num span { font-family: inherit; font-size: .95rem; font-weight: 600; letter-spacing: 0; color: var(--text-dim); }
  .cap { margin-top: .45rem; font-size: .88rem; line-height: 1.5; color: var(--text-dim); }
  .more { position: absolute; left: 1.5rem; bottom: 1.2rem; font-size: .85rem; font-weight: 700; color: var(--accent); }

  /* Headline */
  .t-hero { --n: 0; grid-column: span 7; grid-row: span 2; padding: 2.4rem 2.4rem 2.2rem; display: flex; flex-direction: column; justify-content: center; }
  .pill { align-self: flex-start; display: inline-flex; align-items: center; gap: .5rem; padding: .4rem .85rem; border-radius: 999px;
    font-size: .8rem; font-weight: 600; color: var(--text-dim); background: var(--bg); border: 1px solid var(--border); }
  .dot { width: .5rem; height: .5rem; border-radius: 50%; background: #F26722; box-shadow: 0 0 0 4px rgba(242,103,34,.18); }
  .h1 { margin-top: 1.4rem; font-family: var(--font-heading); font-weight: 800; font-size: clamp(2.3rem, 4.5vw, 4.1rem); line-height: 1.02; letter-spacing: -.045em; }
  .grad { background: linear-gradient(92deg, #4f46e5 0%, #7c3aed 45%, #F26722 100%); -webkit-background-clip: text; background-clip: text; color: transparent; }
  :global(.dark) .grad { background-image: linear-gradient(92deg, #a5b4fc 0%, #c4b5fd 45%, #fdba74 100%); }
  .sub { margin-top: 1.2rem; max-width: 36rem; font-size: 1.05rem; line-height: 1.65; color: var(--text-dim); }
  .sub a { color: var(--text); font-weight: 600; text-decoration: underline; text-decoration-color: rgba(99,102,241,.45); text-underline-offset: 3px; }
  .sub a:hover { text-decoration-color: currentColor; }
  .ctas { display: flex; flex-wrap: wrap; gap: .75rem; margin-top: 1.8rem; }
  .btn, .ghost { display: inline-flex; align-items: center; gap: .5rem; padding: .85rem 1.4rem; border-radius: 999px; font-weight: 700; font-size: .95rem; text-decoration: none; transition: transform .2s, box-shadow .2s, background .2s; }
  .btn { color: #fff; background: linear-gradient(135deg, #4f46e5, #7c3aed); box-shadow: 0 10px 24px -10px rgba(79,70,229,.7); }
  .btn:hover { transform: translateY(-2px); box-shadow: 0 14px 30px -10px rgba(79,70,229,.8); }
  .ghost { color: var(--text); background: var(--bg); border: 1px solid var(--border); }
  .ghost:hover { border-color: rgba(99,102,241,.45); }

  /* 500+ */
  .t-stat { --n: 1; grid-column: span 2; display: flex; flex-direction: column; justify-content: flex-end; color: #fff; border: 0;
    background: radial-gradient(120% 90% at 100% 0%, #a78bfa 0%, transparent 55%), linear-gradient(150deg, #4f46e5, #312e81); }
  .t-stat .big { font-family: var(--font-heading); font-size: 2.6rem; font-weight: 800; letter-spacing: -.04em; line-height: 1; }
  .t-stat .cap { color: rgba(255,255,255,.82); }

  /* Stores */
  .t-commerce { --n: 2; grid-column: span 3; background: linear-gradient(160deg, rgba(4,120,87,.10), transparent 60%), var(--bg-card); }
  .stores { margin-top: .7rem; display: grid; gap: .3rem; }
  .stores b { font-family: var(--font-heading); font-size: 1.15rem; font-weight: 700; letter-spacing: -.02em; }
  .stores li::before { content: ''; display: inline-block; width: .45rem; height: .45rem; margin-right: .55rem; border-radius: 2px; background: var(--accent); vertical-align: middle; }
  .t-commerce .more { position: static; display: inline-block; margin-top: .6rem; }

  /* Recent work: cross-fading screenshots */
  .t-work { --n: 3; grid-column: span 5; padding: 0; min-height: 15rem; background: #0f172a; }
  .shots, .shot { position: absolute; inset: 0; margin: 0; }
  .shot { opacity: 0; animation: swap 16s infinite; animation-delay: calc(var(--d) * 4s); }
  .shot :global(img) { width: 100%; height: 100%; object-fit: cover; object-position: top; transform: scale(1.02); transition: transform .6s ease; }
  .t-work:hover .shot :global(img) { transform: scale(1.06); }
  .shot figcaption { position: absolute; left: 0; right: 0; bottom: 0; padding: 2.4rem 1.2rem .9rem; display: flex; flex-direction: column;
    background: linear-gradient(0deg, rgba(2,6,23,.85), transparent); color: #fff; font-size: .8rem; }
  .shot figcaption b { font-family: var(--font-heading); font-size: 1.05rem; }
  .shot figcaption span { color: rgba(255,255,255,.75); }
  @keyframes swap { 0% { opacity: 0; } 4%, 25% { opacity: 1; } 29%, 100% { opacity: 0; } }
  .badge { position: absolute; top: .9rem; left: .9rem; padding: .3rem .7rem; border-radius: 999px; font-size: .72rem; font-weight: 700;
    color: #0f172a; background: rgba(255,255,255,.92); box-shadow: 0 4px 14px rgba(0,0,0,.2); }

  /* Bottom row */
  .t-products { --n: 4; grid-column: span 3; }
  .chips { display: flex; flex-wrap: wrap; gap: .35rem; margin-top: .8rem; }
  .chips li { padding: .22rem .6rem; border-radius: 999px; font-size: .74rem; font-weight: 600; color: var(--text-dim); background: var(--bg); border: 1px solid var(--border); }
  .t-audit { --n: 5; grid-column: span 3; padding-bottom: 3rem; background: linear-gradient(160deg, rgba(242,103,34,.12), transparent 60%), var(--bg-card); }
  .t-world { --n: 6; grid-column: span 3; }
  .flags { display: grid; grid-template-columns: 1fr 1fr; gap: .35rem .6rem; margin-top: .8rem; }
  .flags a { display: inline-flex; align-items: center; gap: .45rem; font-size: .86rem; font-weight: 600; color: var(--text); text-decoration: none; }
  .flags a:hover { color: var(--accent); }
  .flags span { font-size: 1.1rem; }
  .t-years { --n: 7; grid-column: span 3; }

  @media (max-width: 1023px) {
    .grid { grid-template-columns: repeat(6, minmax(0, 1fr)); grid-auto-rows: auto; }
    .t-hero { grid-column: span 6; grid-row: auto; padding: 2rem 1.6rem; }
    .t-stat { grid-column: span 2; min-height: 10rem; }
    .t-commerce { grid-column: span 4; }
    .t-work { grid-column: span 6; min-height: 0; aspect-ratio: 16 / 9; }
    .t-products, .t-audit, .t-world, .t-years { grid-column: span 3; }
  }
  @media (max-width: 639px) {
    .bento-hero { padding: 1.2rem 1rem 2.5rem; }
    .grid { grid-template-columns: repeat(2, minmax(0, 1fr)); gap: .75rem; }
    .t-hero, .t-work, .t-products, .t-audit, .t-world, .t-years { grid-column: span 2; }
    .t-stat, .t-commerce { grid-column: span 1; min-height: 0; padding: 1.1rem 1rem; }
    .t-commerce .cap { display: none; }
    .stores li { white-space: nowrap; }
    .stores b { font-size: .9rem; }
    .stores li::before { width: .35rem; height: .35rem; margin-right: .35rem; }
    .t-stat .big { font-size: 2.2rem; }
    .t-hero { padding: 1.6rem 1.25rem; }
    .pill { font-size: .72rem; }
    .tile { border-radius: 1.2rem; }
  }
  @media (prefers-reduced-motion: reduce) {
    .tile { animation: none; }
    .shot { animation: none; }
    .shot:first-child { opacity: 1; }
  }
</style>
