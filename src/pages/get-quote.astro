---
import BaseLayout from '../layouts/BaseLayout.astro';
import { breadcrumbSchema } from '../utils/schema';
import GetQuoteForm from '../islands/GetQuoteForm';
import { COMPANY } from '../data/company';

const schema = breadcrumbSchema([
  { name: 'Home', url: '/' },
  { name: 'Get Quote', url: '/get-quote/' },
]);

const steps = [
  { title: 'Share the essentials', text: 'Project type, contact details and a short description. Four quick steps, no account needed.' },
  { title: 'We review it', text: 'Normally within one business day, Monday to Saturday (India time). If something needs clarifying, we contact you first.' },
  { title: 'Scope and quote in writing', text: 'Deliverables, milestones and costs broken down clearly, so you know exactly what you would be getting.' },
];
const points = ['No obligation to proceed', 'Detailed breakdown, not a vague estimate', 'Not added to any marketing list', 'Privacy explained before you submit'];
const tick = '<svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polyline points="20 6 9 17 4 12"/></svg>';
---

<BaseLayout
  ogImage="/images/og/contact.png"
  title="Get a Project Quote - eLan Technology"
  description="Tell eLan Technology about your website, application, eCommerce or digital project and request a clear, no-obligation project quote."
  schema={schema}
  noindex={true}
>
  <section class="relative bg-gradient-to-br from-[var(--bg)] to-[var(--bg-card)] py-12 md:py-16" aria-labelledby="quote-heading">
    <div class="quote-grid mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
      <!-- Intro (first on every screen) -->
      <div class="area-intro">
        <p class="text-xs font-bold uppercase tracking-[0.18em] text-[var(--accent)]">Get a Quote</p>
        <h1 id="quote-heading" class="mt-3 font-heading text-4xl font-bold leading-tight text-[var(--text)] sm:text-5xl">Tell Us About Your Project</h1>
        <p class="mt-4 text-lg leading-relaxed text-[var(--text-dim)]">Share the essentials needed for us to assess your requirements. We normally review quote requests within one business day, without adding you to a marketing list.</p>
      </div>

      <!-- What happens next (beside the form on desktop, after it on phones) -->
      <div class="area-info">

        <ol class="space-y-5" role="list" aria-label="What happens after you submit">
          {steps.map((s, i) => (
            <li class="step">
              <span aria-hidden="true">{i + 1}</span>
              <div>
                <h2 class="font-heading text-base font-bold text-[var(--text)]">{s.title}</h2>
                <p class="mt-1 text-sm leading-relaxed text-[var(--text-dim)]">{s.text}</p>
              </div>
            </li>
          ))}
        </ol>

        <ul class="mt-8 grid gap-2 sm:grid-cols-2" role="list">
          {points.map((p) => (
            <li class="flex items-start gap-2 text-sm text-[var(--text)]"><span class="mt-0.5 shrink-0 text-[var(--accent)]" set:html={tick} />{p}</li>
          ))}
        </ul>

        <div class="mt-8 max-w-xl border-t border-[var(--border)] pt-6 text-sm text-[var(--text-dim)]">
          <p class="font-semibold text-[var(--text)]">Prefer to talk first?</p>
          <p class="mt-1">{COMPANY.hours.weekdayLabel}. {COMPANY.hours.saturdayLabel}.</p>
          <div class="mt-3 flex flex-wrap gap-2">
            <a href={COMPANY.whatsapp.href} target="_blank" rel="noopener noreferrer" data-analytics-placement="quote-page" class="inline-flex min-h-10 items-center rounded-lg border border-[var(--border)] bg-[var(--bg)] px-3.5 py-2 font-semibold text-[var(--text)] transition hover:border-[var(--accent)]">WhatsApp<span class="sr-only"> (opens in a new tab)</span></a>
            <a href={COMPANY.officePhone.href} data-analytics-placement="quote-page" class="inline-flex min-h-10 items-center rounded-lg border border-[var(--border)] bg-[var(--bg)] px-3.5 py-2 font-semibold text-[var(--text)] transition hover:border-[var(--accent)]">Call {COMPANY.officePhone.display}</a>
            <a href="/schedule-consultation/" class="inline-flex min-h-10 items-center rounded-lg border border-[var(--border)] bg-[var(--bg)] px-3.5 py-2 font-semibold text-[var(--text)] transition hover:border-[var(--accent)]">Schedule a meeting</a>
          </div>
        </div>
      </div>

      <!-- The form -->
      <div class="area-form tilt-card tilt-card--lg p-5 shadow-sm sm:p-8" style="--card-color: var(--ac-teal);" aria-labelledby="quote-form-heading">
        <h2 id="quote-form-heading" class="mb-6 font-heading text-2xl font-bold text-[var(--text)]">Project Quote Request</h2>
        <GetQuoteForm client:load />
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .quote-grid { display: grid; gap: 2rem; grid-template-areas: "intro" "form" "info"; }
  .area-intro { grid-area: intro; } .area-form { grid-area: form; } .area-info { grid-area: info; }
  @media (min-width: 1024px) {
    .quote-grid { grid-template-columns: 0.9fr 1.1fr; column-gap: 2.5rem; row-gap: 2rem; grid-template-areas: "intro form" "info form"; align-items: start; }
    .area-form { position: sticky; top: 7rem; }
  }
  .step { display: grid; grid-template-columns: 2.25rem 1fr; gap: .9rem; }
  .step > span { display: grid; place-items: center; width: 2.25rem; height: 2.25rem; border-radius: var(--radius-lg); background: color-mix(in srgb, var(--accent) 12%, transparent); color: var(--accent); font-weight: 800; }
</style>
