          <div class="absolute -right-32 -top-40 h-96 w-96 rounded-full bg-cyan-400/20 blur-[100px]" aria-hidden="true"></div>
          <div class="absolute inset-0 bg-gradient-to-r from-slate-950 via-slate-950/95 to-slate-950/70"></div>
          <div class="relative grid gap-8 p-7 sm:p-10 lg:grid-cols-[1fr_auto] lg:items-end lg:p-14">
            <div class="max-w-3xl">
