---
import { Image } from 'astro:assets';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getProjectImage } from '../../lib/images';
import {
  ecommerceProjects,
  internationalProjects,
  latestLaunch,
  launchingSoon,
  legacyProject,
  recentLaunches,
  selectedProjects,
  type PortfolioShowcaseItem,
} from '../../data/portfolioShowcase';
import { breadcrumbSchema } from '../../utils/schema';
import { projects } from '../../data/portfolio';

const schema = breadcrumbSchema([
  { name: 'Home', url: '/' },
  { name: 'Portfolio', url: '/portfolio/' },
]);

const isLogo = (project: PortfolioShowcaseItem) => project.image.includes('/elan-client-logos/');
const destinationLabel = (url: string) => new URL(url).hostname.replace(/^www\./, '');
const [shopifyProject, medusaProject, ...wooCommerceProjects] = ecommerceProjects;
const internationalPortfolioProjects = internationalProjects.filter((project) => project.title !== 'Stems Flower Studio');
const broaderSelectedProjects = [...internationalPortfolioProjects, ...selectedProjects];
const normalizedUrl = (url: string) => {
  const parsed = new URL(url);
  const host = parsed.hostname.toLowerCase().replace(/^www\./, '');
  const path = parsed.pathname.toLowerCase().replace(/\/$/, '');
  return `${host}${path}`;
};
const showcaseUrls = new Set([
  latestLaunch,
  ...recentLaunches,
  ...ecommerceProjects,
  ...internationalProjects,
  ...launchingSoon,
  ...selectedProjects,
  legacyProject,
].map(project => normalizedUrl(project.liveUrl)));
const archiveProjects = projects.filter(project => !project.liveUrl || !showcaseUrls.has(normalizedUrl(project.liveUrl)));
---

<BaseLayout
  ogImage="/images/og/services.png"
  title="Website Design, eCommerce and Development Portfolio | eLan Technology"
  description="Explore recent eLan Technology website launches, custom Shopify and Medusa.js eCommerce work, upcoming projects and selected client websites."
  schema={schema}
>
  <main>
    <section class="portfolio-hero relative overflow-hidden border-b border-[var(--border)] bg-[var(--bg)] py-12 sm:py-16 lg:py-20" aria-labelledby="portfolio-title">
      <div class="portfolio-grid" aria-hidden="true"></div>
      <div class="portfolio-glow portfolio-glow-one" aria-hidden="true"></div>
      <div class="portfolio-glow portfolio-glow-two" aria-hidden="true"></div>

      <div class="relative mx-auto grid max-w-7xl gap-8 px-4 sm:px-6 lg:grid-cols-[0.88fr_1.12fr] lg:items-center lg:px-8">
        <div class="max-w-2xl">
          <p class="mb-4 flex items-center gap-2 text-xs font-bold uppercase tracking-[0.28em] text-[var(--ac-teal)]">
            <span class="h-2 w-2 rounded-full bg-[var(--ac-teal)] shadow-[0_0_18px_var(--ac-teal)]"></span>
            Selected work by eLan Technology
          </p>
          <h1 id="portfolio-title" class="font-heading text-4xl font-black leading-[1.02] tracking-[-0.04em] text-[var(--text)] sm:text-5xl lg:text-[3.6rem]">
            Real websites for businesses ready to move forward.
          </h1>
          <p class="mt-6 max-w-xl text-base leading-7 text-[var(--text-dim)] sm:text-lg">
            From a first idea to a growing online store, we design digital experiences that feel clear, look distinctive and make it easier for customers to take the next step.
          </p>
          <div class="mt-7 flex flex-wrap gap-3">
            <a href="#recent-work" class="inline-flex items-center gap-2 rounded-full bg-[var(--accent)] px-6 py-3 text-sm font-bold text-white shadow-lg shadow-[var(--accent)]/20 transition hover:-translate-y-0.5 hover:brightness-110">
              Explore recent work
              <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" aria-hidden="true"><path d="M12 5v14M19 12l-7 7-7-7"/></svg>
            </a>
            <a href="/get-quote/" class="inline-flex items-center rounded-full border border-[var(--border)] bg-[var(--bg-card)] px-6 py-3 text-sm font-bold text-[var(--text)] transition hover:border-[var(--accent)] hover:text-[var(--accent)]">
              Request a quote
            </a>
          </div>
          <dl class="mt-10 hidden max-w-lg grid-cols-3 gap-3 sm:grid">
            <div class="rounded-2xl border border-[var(--border)] bg-[var(--bg-card)]/75 p-4 backdrop-blur">
              <dt class="text-[10px] font-bold uppercase tracking-wider text-[var(--text-muted)]">Building since</dt>
              <dd class="mt-1 font-heading text-xl font-black text-[var(--ac-indigo)]">2002</dd>
            </div>
            <div class="rounded-2xl border border-[var(--border)] bg-[var(--bg-card)]/75 p-4 backdrop-blur">
              <dt class="text-[10px] font-bold uppercase tracking-wider text-[var(--text-muted)]">Commerce work</dt>
              <dd class="mt-1 font-heading text-xl font-black text-[var(--ac-pink)]">5 featured</dd>
            </div>
            <div class="rounded-2xl border border-[var(--border)] bg-[var(--bg-card)]/75 p-4 backdrop-blur">
              <dt class="text-[10px] font-bold uppercase tracking-wider text-[var(--text-muted)]">Coming next</dt>
              <dd class="mt-1 font-heading text-xl font-black text-[var(--ac-amber)]">{launchingSoon.length} launches</dd>
            </div>
          </dl>
        </div>

        <article class="hero-project group relative min-h-[420px] overflow-hidden rounded-[2rem] border border-[var(--border)] bg-[var(--bg-card)] shadow-2xl shadow-black/10 sm:min-h-[500px]">
          <Image
            src={getProjectImage(latestLaunch.image)}
            alt={`Homepage preview of ${latestLaunch.title}`}
            widths={[640, 960, 1280]}
            sizes="(max-width: 1023px) 100vw, 56vw"
            format="avif"
            loading="eager"
            decoding="async"
            class="absolute inset-0 h-full w-full object-cover object-top transition duration-700 group-hover:scale-[1.025]"
          />
          <div class="absolute inset-0 bg-gradient-to-t from-slate-950 via-slate-950/35 to-transparent"></div>
          <div class="absolute left-5 top-5 flex items-center gap-2 rounded-full border border-white/30 bg-slate-950/60 px-3 py-1.5 text-xs font-bold text-white backdrop-blur-md sm:left-7 sm:top-7">
            <span class="h-2 w-2 animate-pulse rounded-full bg-emerald-400"></span>
            {latestLaunch.note}
          </div>
          <div class="absolute inset-x-0 bottom-0 p-6 sm:p-8">
            <p class="text-xs font-bold uppercase tracking-[0.2em] text-emerald-300">{latestLaunch.label}</p>
            <div class="mt-2 flex flex-col gap-4 sm:flex-row sm:items-end sm:justify-between">
              <div>
                <h2 class="font-heading text-3xl font-black text-white sm:text-4xl">{latestLaunch.title}</h2>
                <p class="mt-2 max-w-xl text-sm leading-6 text-slate-200 sm:text-base">{latestLaunch.description}</p>
              </div>
              <a href={latestLaunch.liveUrl} target="_blank" rel="noopener noreferrer" class="inline-flex shrink-0 items-center justify-center gap-2 rounded-full bg-white px-5 py-2.5 text-sm font-bold text-slate-950 transition hover:bg-emerald-300" aria-label={`Visit ${latestLaunch.title}, opens in a new tab`}>
                View live site
                <span aria-hidden="true">↗</span>
              </a>
            </div>
          </div>
        </article>
      </div>
    </section>

    <section id="portfolio-publication-note" class="border-b border-[var(--border)] bg-[var(--bg)] py-7" aria-labelledby="portfolio-publication-title">
      <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
        <div class="portfolio-publication overflow-hidden rounded-3xl border border-[var(--border)] bg-[var(--bg-card)] shadow-sm">
          <div class="grid gap-5 p-5 sm:p-6 lg:grid-cols-[minmax(0,.72fr)_minmax(0,1.65fr)] lg:items-center lg:p-7">
            <div>
              <p class="text-[10px] font-black uppercase tracking-[0.2em] text-[var(--ac-teal)]">Portfolio publication</p>
              <h2 id="portfolio-publication-title" class="mt-2 font-heading text-xl font-black text-[var(--text)] sm:text-2xl">Project context without unnecessary personal data</h2>
            </div>
            <div class="grid gap-3 text-xs leading-relaxed text-[var(--text-muted)] sm:grid-cols-2 sm:text-sm">
              <p><strong class="text-[var(--text)]">What is shown:</strong> project or business names, brand marks, website previews, public destinations and concise descriptions needed to identify the work.</p>
              <p><strong class="text-[var(--text)]">Visual accuracy:</strong> screenshots represent a captured version of a project. Content, ownership, technology and availability may change after launch or handover.</p>
              <p><strong class="text-[var(--text)]">External websites:</strong> live-site and preview links open only when selected. The destination may then receive ordinary connection, browser and device information under its own privacy practices.</p>
              <p><strong class="text-[var(--text)]">Brand ownership:</strong> client names, logos and trademarks remain the property of their respective owners and are presented only to identify project work.</p>
            </div>
          </div>
          <div class="flex flex-col gap-2 border-t border-[var(--border)] bg-[var(--bg)]/70 px-5 py-4 text-xs leading-relaxed text-[var(--text-muted)] sm:flex-row sm:items-center sm:justify-between sm:px-6 lg:px-7">
            <p>Represent a featured project and need its name, description, image, link or attribution corrected or removed?</p>
            <a href="mailto:privacy@elan-tech.net?subject=Portfolio%20correction%20or%20removal%20request" class="shrink-0 font-bold text-[var(--text)] underline decoration-[var(--ac-teal)] underline-offset-4">Write to privacy@elan-tech.net</a>
          </div>
        </div>
      </div>
    </section>

    <nav class="portfolio-nav sticky top-[var(--header-height,0px)] z-30 border-b border-[var(--border)] bg-[var(--bg)]/90 backdrop-blur-xl" aria-label="Portfolio sections">
      <div class="mx-auto flex max-w-7xl gap-2 overflow-x-auto px-4 py-3 sm:px-6 lg:px-8">
        <a href="#recent-work">Recent launches</a>
        <a href="#ecommerce-work">eCommerce</a>
        <a href="#launching-soon">Launching soon</a>
        <a href="#selected-work">Selected work</a>
        <a href="#project-archive">Earlier projects</a>
        <a href="#long-running-work">Built to last</a>
      </div>
    </nav>

    <section id="recent-work" class="scroll-mt-28 bg-[var(--bg)] py-16 sm:py-20" aria-labelledby="recent-title">
      <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
        <div class="mb-9 grid gap-4 md:grid-cols-[1fr_auto] md:items-end">
          <div>
            <p class="section-kicker text-[var(--ac-teal)]">Fresh from the studio</p>
            <h2 id="recent-title" class="section-title">Recently launched</h2>
            <p class="section-intro">New work across healthcare, interiors, real estate, marketing and product-led businesses.</p>
          </div>
          <p class="rounded-full border border-[var(--border)] bg-[var(--bg-card)] px-4 py-2 text-xs font-semibold text-[var(--text-muted)]">{recentLaunches.length} recent live websites</p>
        </div>

        <div class="grid gap-5 sm:grid-cols-2 lg:grid-cols-12">
          {recentLaunches.map((project, index) => (
            <article class:list={['visual-card group', index < 2 ? 'lg:col-span-6' : 'lg:col-span-4']}>
              <a href={project.liveUrl} target="_blank" rel="noopener noreferrer" class="block h-full" aria-label={`Visit ${project.title}, opens in a new tab`}>
                <div class="relative aspect-[16/10] overflow-hidden bg-white">
                  <Image
                    src={getProjectImage(project.image)}
                    alt={`Website preview for ${project.title}`}
                    widths={[480, 720, 960]}
                    sizes={index < 2 ? '(max-width: 1023px) 100vw, 50vw' : '(max-width: 1023px) 50vw, 33vw'}
                    format={getProjectImage(project.image).format === 'svg' ? undefined : 'avif'}
                    loading="lazy"
                    decoding="async"
                    class:list={['h-full w-full transition duration-500 group-hover:scale-[1.035]', isLogo(project) ? 'object-contain p-12' : 'object-cover object-top']}
                  />
                  <span class="absolute right-4 top-4 grid h-10 w-10 place-items-center rounded-full border border-white/50 bg-slate-950/65 text-sm font-bold text-white opacity-0 backdrop-blur transition group-hover:opacity-100" aria-hidden="true">↗</span>
                </div>
                <div class="p-5 sm:p-6">
                  <p class="text-[11px] font-bold uppercase tracking-[0.18em] text-[var(--ac-teal)]">{project.label}</p>
                  <h3 class="mt-2 font-heading text-xl font-bold text-[var(--text)]">{project.title}</h3>
                  <p class="mt-2 text-sm leading-6 text-[var(--text-dim)]">{project.description}</p>
                  <div class="mt-4 flex flex-wrap gap-1.5">
                    {project.stack?.map(item => <span class="project-pill">{item}</span>)}
                  </div>
                </div>
              </a>
            </article>
          ))}
        </div>
      </div>
    </section>

    <section id="ecommerce-work" class="scroll-mt-28 overflow-hidden border-y border-[var(--border)] bg-[var(--bg-card)] py-16 sm:py-20" aria-labelledby="commerce-title">
      <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
        <div class="mb-9 max-w-3xl">
          <p class="section-kicker text-[var(--ac-pink)]">Three strong commerce foundations</p>
          <h2 id="commerce-title" class="section-title">Shopify, Medusa.js and WooCommerce</h2>
          <p class="section-intro">The platform should fit the way you sell. Our portfolio includes custom Shopify storefronts, fully owned Medusa.js commerce and flexible WooCommerce stores.</p>
        </div>

        <div class="commerce-platforms mb-6 grid gap-3 md:grid-cols-3" aria-label="eCommerce technology experience">
          <a href="/services/ecommerce/shopify-development/" class="platform-card platform-shopify">
            <span class="platform-index">01</span>
            <span class="platform-name">Shopify</span>
            <span class="platform-detail">Custom themes and storefront UX</span>
            <span class="platform-proof">Featured work: Rangresha</span>
          </a>
          <a href="/services/ecommerce/medusa-js-development/" class="platform-card platform-medusa">
            <span class="platform-index">02</span>
            <span class="platform-name">Medusa.js</span>
            <span class="platform-detail">Owned commerce and custom modules</span>
            <span class="platform-proof">Featured work: Puritas</span>
          </a>
          <a href="/services/ecommerce/" class="platform-card platform-woo">
            <span class="platform-index">03</span>
            <span class="platform-name">WooCommerce</span>
            <span class="platform-detail">Flexible stores on WordPress</span>
            <span class="platform-proof">3 selected stores below</span>
          </a>
        </div>

        <div class="grid gap-5 lg:grid-cols-2">
          {[shopifyProject, medusaProject].map((project, index) => (
            <article class:list={['commerce-feature group', index === 0 ? 'commerce-shopify' : 'commerce-medusa']}>
              <div class="grid h-full sm:grid-cols-[190px_1fr]">
                <div class="commerce-logo-panel relative grid min-h-[190px] place-items-center overflow-hidden bg-white p-7 sm:min-h-full">
                  <Image
                    src={getProjectImage(project.image)}
                    alt={`${project.title} brand mark`}
                    widths={[320, 480]}
                    sizes="(max-width: 639px) 100vw, 190px"
                    format={getProjectImage(project.image).format === 'svg' ? undefined : 'avif'}
                    loading="lazy"
                    decoding="async"
                    class="max-h-36 w-full object-contain transition duration-500 group-hover:scale-105"
                  />
                </div>
                <div class="flex flex-col p-5 sm:p-6">
                  <div class="commerce-tech-lockup">
                    <span class="commerce-tech-icon" aria-hidden="true">{index === 0 ? 'S' : 'M'}</span>
                    <div>
                      <p class="commerce-tech-eyebrow">Built with</p>
                      <p class="commerce-tech-name">{index === 0 ? 'Shopify' : 'Medusa.js'}</p>
                    </div>
                  </div>
                  <h3 class="mt-5 font-heading text-2xl font-black text-[var(--text)]">{project.title}</h3>
                  <p class="mt-2 flex-1 text-sm leading-6 text-[var(--text-dim)]">{project.description}</p>
                  <div class="mt-4 flex flex-wrap gap-1.5">
                    {project.stack?.map(item => <span class="project-pill">{item}</span>)}
                  </div>
                  <a href={project.liveUrl} target="_blank" rel="noopener noreferrer" class="mt-3 inline-flex min-h-11 items-center gap-2 self-start text-sm font-bold text-[var(--text)] hover:text-[var(--accent)]" aria-label={`Visit ${project.title}, opens in a new tab`}>
                    Visit {project.title} <span aria-hidden="true">↗</span>
                  </a>
                </div>
              </div>
            </article>
          ))}
        </div>

        <div class="mt-8 flex items-center gap-4">
          <div class="h-px flex-1 bg-[var(--border)]"></div>
          <div class="woo-heading text-center">
            <p class="text-[10px] font-bold uppercase tracking-[0.18em] text-[#96588a]">Built with</p>
            <h3 class="font-heading text-2xl font-black text-[var(--text)]">WooCommerce</h3>
          </div>
          <div class="h-px flex-1 bg-[var(--border)]"></div>
        </div>

        <div class="mt-6 grid gap-5 md:grid-cols-3">
          {wooCommerceProjects.map(project => (
            <article class="woo-project group overflow-hidden rounded-2xl border border-[var(--border)] bg-[var(--bg)]">
              <a href={project.liveUrl} target="_blank" rel="noopener noreferrer" class="block h-full" aria-label={`Visit ${project.title}, opens in a new tab`}>
                <div class="relative aspect-[16/8] overflow-hidden bg-white">
                  <Image
                    src={getProjectImage(project.image)}
                    alt={`${project.title} WooCommerce website`}
                    widths={[480, 720]}
                    sizes="(max-width: 767px) 100vw, 33vw"
                    format="avif"
                    loading="lazy"
                    decoding="async"
                    class="h-full w-full object-cover transition duration-500 group-hover:scale-[1.04]"
                  />
                  <span class="absolute left-3 top-3 rounded-full bg-[#96588a] px-3 py-1 text-[10px] font-bold uppercase tracking-wider text-white">WooCommerce</span>
                </div>
                <div class="p-5">
                  <h4 class="font-heading text-lg font-black text-[var(--text)]">{project.title}</h4>
                  <p class="mt-2 text-sm leading-6 text-[var(--text-dim)]">{project.description}</p>
                  <span class="mt-4 inline-flex min-h-10 items-center gap-2 text-sm font-bold text-[#96588a]">Visit store <span aria-hidden="true">↗</span></span>
                </div>
              </a>
            </article>
          ))}
        </div>

        <div class="mt-8 flex flex-col items-start justify-between gap-4 rounded-2xl border border-[var(--ac-pink)]/25 bg-[var(--ac-pink)]/5 p-5 sm:flex-row sm:items-center sm:p-6">
          <div>
            <p class="font-heading text-lg font-bold text-[var(--text)]">Planning a new online store or replacing one that holds you back?</p>
            <p class="mt-1 text-sm text-[var(--text-dim)]">We will help you choose the platform that fits your products, team and growth plans.</p>
          </div>
          <a href="/services/ecommerce/" class="inline-flex shrink-0 items-center gap-2 rounded-full bg-[var(--ac-pink)] px-5 py-2.5 text-sm font-bold text-white transition hover:-translate-y-0.5 hover:brightness-110">Explore eCommerce services <span aria-hidden="true">→</span></a>
        </div>
      </div>
    </section>

    <section id="launching-soon" class="scroll-mt-28 bg-[var(--bg)] py-16 sm:py-20" aria-labelledby="soon-title">
      <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
        <div class="mb-9 flex flex-col gap-4 md:flex-row md:items-end md:justify-between">
          <div class="max-w-3xl">
            <p class="section-kicker text-[var(--ac-amber)]">Currently in the launch studio</p>
            <h2 id="soon-title" class="section-title">Launching soon</h2>
            <p class="section-intro">A first look at websites now being prepared for their permanent domains.</p>
          </div>
          <span class="inline-flex self-start items-center gap-2 rounded-full border border-amber-500/25 bg-amber-500/10 px-4 py-2 text-xs font-bold text-amber-700 dark:text-amber-300">
            <span class="h-2 w-2 animate-pulse rounded-full bg-amber-500"></span>
            {launchingSoon.length} projects in progress
          </span>
        </div>

        <ol class="grid gap-5 md:grid-cols-2 lg:grid-cols-3">
          {launchingSoon.map((project, index) => (
            <li class:list={['soon-card group', index === 0 && 'lg:col-span-2']}>
              <div class:list={['grid h-full', index === 0 && 'sm:grid-cols-[1.15fr_0.85fr]']}>
                <div class="relative min-h-[220px] overflow-hidden">
                  <Image
                    src={getProjectImage(project.image)}
                    alt={`Preview of the upcoming ${project.title} website`}
                    widths={[480, 720, 960, 1280]}
                    sizes={index === 0 ? '(max-width: 1023px) 100vw, 42vw' : '(max-width: 1023px) 50vw, 33vw'}
                    format="avif"
                    loading="lazy"
                    decoding="async"
                    class="absolute inset-0 h-full w-full object-cover object-top transition duration-500 group-hover:scale-[1.035]"
                  />
                  <div class="absolute inset-0 bg-gradient-to-t from-slate-950/70 to-transparent"></div>
                  <span class="absolute left-4 top-4 rounded-full border border-white/30 bg-slate-950/65 px-3 py-1 text-[10px] font-bold uppercase tracking-wider text-white backdrop-blur">Preview {String(index + 1).padStart(2, '0')}</span>
                </div>
                <div class="flex flex-col bg-[var(--bg-card)] p-5 sm:p-6">
                  <p class="text-[11px] font-bold uppercase tracking-[0.16em] text-[var(--ac-amber)]">{project.label}</p>
                  <h3 class="mt-2 font-heading text-xl font-black text-[var(--text)]">{project.title}</h3>
                  <p class="mt-2 flex-1 text-sm leading-6 text-[var(--text-dim)]">{project.description}</p>
                  {project.launchUrl && (
                    <p class="mt-4 text-xs text-[var(--text-muted)]">Launching at <strong class="text-[var(--text)]">{destinationLabel(project.launchUrl)}</strong></p>
                  )}
                  <a href={project.liveUrl} target="_blank" rel="noopener noreferrer" class="mt-3 inline-flex min-h-11 items-center gap-2 self-start text-sm font-bold text-[var(--ac-amber)] hover:underline" aria-label={`Preview ${project.title}, opens in a new tab`}>
                    View preview <span aria-hidden="true">↗</span>
                  </a>
                </div>
              </div>
            </li>
          ))}
        </ol>
      </div>
    </section>

    <section id="selected-work" class="scroll-mt-28 border-y border-[var(--border)] bg-[var(--bg-card)] py-16 sm:py-20" aria-labelledby="selected-title">
      <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
        <div class="mb-9 max-w-3xl">
          <p class="section-kicker text-[var(--ac-indigo)]">International and selected work</p>
          <h2 id="selected-title" class="section-title">Websites built across borders and industries</h2>
          <p class="section-intro">Real work for businesses in the USA, Canada and Australia, followed by more relationships we value across legal education, healthcare, consulting, architecture and digital platforms. Our New Zealand work is featured above with Stems Flower Studio.</p>
        </div>

        <ul class="grid gap-4 sm:grid-cols-2 lg:grid-cols-4" role="list">
          {broaderSelectedProjects.map(project => (
            <li>
              <a href={project.liveUrl} target="_blank" rel="noopener noreferrer" class="selected-card group" aria-label={`Visit ${project.title}, opens in a new tab`}>
                <div class="relative aspect-[4/3] overflow-hidden bg-white">
                  <Image
                    src={getProjectImage(project.image)}
                    alt={`${project.title} project`}
                    widths={[320, 480, 640]}
                    sizes="(max-width: 639px) 100vw, (max-width: 1023px) 50vw, 20vw"
                    format={getProjectImage(project.image).format === 'svg' ? undefined : 'avif'}
                    loading="lazy"
                    decoding="async"
                    class:list={['h-full w-full transition duration-500 group-hover:scale-[1.04]', isLogo(project) ? 'object-contain p-8' : 'object-cover']}
                  />
                </div>
                <div class="p-4">
                  <div class="flex flex-wrap items-center gap-2">
                    <p class="text-[10px] font-bold uppercase tracking-wider text-[var(--ac-indigo)]">{project.label}</p>
                    {project.country && <span class="rounded-full bg-[var(--ac-indigo)]/10 px-2 py-0.5 text-[9px] font-black uppercase tracking-wider text-[var(--ac-indigo)]">{project.country}</span>}
                  </div>
                  <h3 class="mt-1 font-heading text-base font-bold leading-snug text-[var(--text)]">{project.title}</h3>
                  <p class="mt-2 text-xs leading-5 text-[var(--text-dim)]">{project.description}</p>
                  {project.location && <p class="mt-2 text-[10px] font-semibold text-[var(--text-muted)]">{project.location}</p>}
                  <span class="mt-3 inline-flex items-center gap-1 text-xs font-bold text-[var(--text-muted)] group-hover:text-[var(--ac-indigo)]">View website <span aria-hidden="true">↗</span></span>
                </div>
              </a>
            </li>
          ))}
        </ul>
      </div>
    </section>

    <section id="project-archive" class="scroll-mt-28 bg-[var(--bg)] py-16 sm:py-20" aria-labelledby="archive-title">
      <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
        <div class="mb-9 flex flex-col gap-4 md:flex-row md:items-end md:justify-between">
