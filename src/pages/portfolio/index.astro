---
import { Image } from 'astro:assets';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getProjectImage } from '../../lib/images';
import {
  ecommerceProjects,
  internationalProjects,
  latestLaunch,
  launchingSoon,
  legacyProject,
  recentLaunches,
  recentRedesigns,
  selectedProjects,
  type PortfolioShowcaseItem,
} from '../../data/portfolioShowcase';
import { breadcrumbSchema } from '../../utils/schema';
import { projects } from '../../data/portfolio';
import ArchiveCard from '../../components/portfolio/ArchiveCard.astro';

const schema = breadcrumbSchema([
  { name: 'Home', url: '/' },
  { name: 'Portfolio', url: '/portfolio/' },
]);

const isLogo = (project: PortfolioShowcaseItem) => project.image.includes('/elan-client-logos/');
const destinationLabel = (url: string) => new URL(url).hostname.replace(/^www\./, '');
const [shopifyProject, medusaProject, ...wooCommerceProjects] = ecommerceProjects;
const internationalPortfolioProjects = internationalProjects.filter((project) => project.title !== 'Stems Flower Studio');
const broaderSelectedProjects = [...internationalPortfolioProjects, ...selectedProjects];
const normalizedUrl = (url: string) => {
  const parsed = new URL(url);
  const host = parsed.hostname.toLowerCase().replace(/^www\./, '');
  const path = parsed.pathname.toLowerCase().replace(/\/$/, '');
  return `${host}${path}`;
};
const showcaseUrls = new Set([
  latestLaunch,
  ...recentLaunches,
  ...recentRedesigns,
  ...ecommerceProjects,
  ...internationalProjects,
  ...launchingSoon,
  ...selectedProjects,
  legacyProject,
].filter(project => project.liveUrl).map(project => normalizedUrl(project.liveUrl)));
const archiveProjects = projects.filter(project => !project.liveUrl || !showcaseUrls.has(normalizedUrl(project.liveUrl)));
// Compact portfolio (owner, 27 Nov 2026): every project stays, the archive shows eight and folds the rest.
const archiveFirst = archiveProjects.slice(0, 8);
// Strongest completed work first (27 Nov 2026): one per service, with what eLan delivered and the matching service.
const byTitle = (title: string) => [...ecommerceProjects, ...recentLaunches, ...recentRedesigns, ...internationalProjects, ...selectedProjects].find((p) => p.title === title)!;
const featured = [
  { project: byTitle('Healthy Genie'), color: '--svc-medusa', image: '/portfolio/healthy-genie.avif', delivered: 'We redesigned and rebuilt the meal-commerce website on Medusa.js with a Next.js storefront: meal plans, subscriptions, customer accounts and corporate meal enquiries.', service: { href: '/services/ecommerce/medusa-js-development/#work', label: 'Medusa.js development service' } },
  { project: byTitle('Rangresha'), color: '--svc-shopify', image: '/elan-client-logos/rangresha.avif', delivered: 'We designed and built a custom Shopify storefront for handcrafted products, with cultural storytelling, retail shopping and corporate gifting.', service: { href: '/services/ecommerce/#shopify', label: 'Custom Shopify development' } },
  { project: byTitle('KEN Global Designs'), color: '--ac-pink', image: '/portfolio/ken-global.avif', delivered: 'We designed and built a corporate website for an apparel manufacturer, presenting its manufacturing expertise, responsible practices and sampling technology.', service: { href: '/services/website-design/', label: 'Website design services' } },
];
const archiveMore = archiveProjects.slice(8);
---

<BaseLayout
  ogImage="/images/og/portfolio.png"
  title="Website Design, eCommerce and Development Portfolio | eLan Technology"
  description="Explore recent eLan Technology website launches, custom Shopify and Medusa.js eCommerce work, upcoming projects and selected client websites."
  schema={schema}
>
  <main>
    <section class="relative border-b border-[var(--border)] bg-gradient-to-br from-[var(--bg)] to-[var(--bg-card)] py-10 sm:py-14" aria-labelledby="portfolio-title">
      <div class="mx-auto grid max-w-7xl gap-8 px-4 sm:px-6 lg:grid-cols-[0.9fr_1.1fr] lg:items-center lg:px-8">
        <div>
          <p class="section-kicker text-[var(--accent)]">Selected work by eLan Technology</p>
          <h1 id="portfolio-title" class="mt-3 font-heading text-4xl font-bold leading-tight tracking-tight text-[var(--text)] md:text-5xl">Website Design &amp; eCommerce Portfolio</h1>
          <p class="mt-4 max-w-xl font-heading text-xl font-semibold leading-snug text-[var(--text)]">Real websites for businesses ready to move forward.</p>
          <p class="mt-2 max-w-xl text-lg text-[var(--text-dim)]">From a first idea to a growing online store, we design websites that look distinctive and make the next step easy for customers.</p>
          <ul class="mt-5 flex flex-wrap gap-x-5 gap-y-2 text-sm text-[var(--text-dim)]" role="list">
            <li><strong class="text-[var(--text)]">Since 2002</strong></li>
            <li><strong class="text-[var(--text)]">5</strong> featured stores</li>
            <li><strong class="text-[var(--text)]">{launchingSoon.length}</strong> launches coming</li>
          </ul>
          <div class="mt-6 flex flex-wrap gap-3">
            <a href="/get-quote/" class="inline-flex min-h-11 items-center rounded-lg bg-[var(--accent)] px-5 py-2.5 font-semibold text-white transition hover:brightness-110">Request a quote</a>
            <a href="/technologies/" class="inline-flex min-h-11 items-center rounded-lg border border-[var(--border)] bg-[var(--bg)] px-5 py-2.5 font-semibold text-[var(--text)] transition hover:border-[var(--accent)]">Technologies we use</a>
          </div>
        </div>

        <article class="hero-project group relative min-h-[300px] overflow-hidden rounded-xl border border-[var(--border)] bg-[var(--bg-card)] shadow-xl shadow-black/10 sm:min-h-[380px]">
          <Image
            src={getProjectImage(latestLaunch.image)}
            alt={isLogo(latestLaunch) ? `${latestLaunch.title} brand mark` : `Homepage preview of ${latestLaunch.title}`}
            widths={[640, 960, 1280]}
            sizes="(max-width: 1023px) 100vw, 56vw"
            format="avif"
            loading="eager"
            decoding="async"
            class:list={['absolute inset-0 h-full w-full transition duration-700 group-hover:scale-[1.025]', isLogo(latestLaunch) ? 'object-contain bg-white p-12 pb-44' : 'object-cover object-top']}
          />
          <div class="absolute inset-0 bg-gradient-to-t from-slate-950 via-slate-950/75 to-slate-950/10"></div>
          <div class="absolute left-4 top-4 flex items-center gap-2 rounded-md border border-white/30 bg-slate-950/60 px-3 py-1.5 text-xs font-bold text-white backdrop-blur-md">
            <span class="h-2 w-2 animate-pulse rounded-full bg-emerald-400"></span>
            {latestLaunch.note}
          </div>
          <div class="absolute inset-x-0 bottom-0 p-5 sm:p-7">
            <p class="text-xs font-bold uppercase tracking-[0.2em] text-emerald-300">{latestLaunch.label}</p>
            <div class="mt-2 flex flex-col gap-3 sm:flex-row sm:items-end sm:justify-between">
              <div>
                <h2 class="font-heading text-2xl font-black text-white sm:text-3xl">{latestLaunch.title}</h2>
                <p class="mt-1 max-w-xl text-sm leading-6 text-slate-200">{latestLaunch.description}</p>
              </div>
              <a href={latestLaunch.liveUrl} target="_blank" rel="noopener noreferrer" class="inline-flex shrink-0 items-center justify-center gap-2 rounded-lg bg-white px-4 py-2 text-sm font-bold text-slate-950 transition hover:bg-emerald-300" aria-label={`Visit ${latestLaunch.title}, opens in a new tab`}>
                Visit the {latestLaunch.title} website <span aria-hidden="true">↗</span>
              </a>
            </div>
          </div>
        </article>
      </div>
    </section>

    <nav class="portfolio-nav sticky top-[72px] z-30 border-b border-[var(--border)] bg-[var(--bg)]/90 backdrop-blur-xl" aria-label="Portfolio sections">
      <div class="mx-auto flex max-w-7xl gap-2 overflow-x-auto px-4 py-3 sm:px-6 lg:px-8">
        <a href="/portfolio/#featured-work">Featured work</a>
        <a href="/portfolio/#recent-work">Recent launches</a>
        <a href="/portfolio/#redesigned-work">Redesigns</a>
        <a href="/portfolio/#ecommerce-work">eCommerce</a>
        <a href="/portfolio/#launching-soon">Launching soon</a>
        <a href="/portfolio/#selected-work">Selected work</a>
        <a href="/portfolio/#project-archive">Earlier projects</a>
      </div>
    </nav>

    <section id="featured-work" class="pf-section" aria-labelledby="featured-title">
      <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
        <header class="pf-head">
          <div>
            <p class="section-kicker text-[var(--accent)]">Completed and live</p>
            <h2 id="featured-title" class="section-title">Featured work</h2>
            <p class="section-intro">One project for each kind of work we are hired for most: Medusa.js commerce, Shopify and business web design.</p>
          </div>
        </header>
        <div class="grid gap-5 lg:grid-cols-3">
          {featured.map(({ project, color, image, delivered, service }) => (
            <article class="tilt-card flex flex-col overflow-hidden" style={`--card-color: var(${color});`}>
              <div class="relative aspect-[16/10] overflow-hidden border-b border-[var(--border)] bg-white">
                <Image
                  src={getProjectImage(image)}
                  alt={isLogo(project) ? `${project.title} brand mark` : `Homepage of the ${project.title} website`}
                  widths={[480, 720, 960]}
                  sizes="(max-width: 1023px) 100vw, 33vw"
                  format="avif"
                  loading="lazy"
                  decoding="async"
                  class:list={['h-full w-full', isLogo(project) ? 'object-contain p-10' : 'object-cover object-top']}
                />
              </div>
              <div class="flex flex-1 flex-col p-5 sm:p-6">
                <p class="text-xs font-bold uppercase tracking-[0.16em]" style={`color: var(${color});`}>{project.label}</p>
                <h3 class="mt-1.5 font-heading text-xl font-bold text-[var(--text)]">{project.title}</h3>
                <p class="mt-2 text-sm leading-relaxed text-[var(--text-dim)]">{delivered}</p>
                <div class="mt-auto flex flex-col gap-1.5 pt-5">
                  <a href={service.href} class="text-sm font-semibold text-[var(--text)] underline underline-offset-4">{service.label} →</a>
                  <a href={project.liveUrl} target="_blank" rel="noopener noreferrer" class="text-sm font-semibold text-[var(--text-dim)] underline underline-offset-4">Visit the {project.title} website ↗<span class="sr-only"> (opens in a new tab)</span></a>
                </div>
              </div>
            </article>
          ))}
        </div>
      </div>
    </section>

    <section id="recent-work" class="pf-section" aria-labelledby="recent-title">
      <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
        <header class="pf-head">
          <div>
            <p class="section-kicker text-[var(--ac-teal)]">Fresh from the studio</p>
            <h2 id="recent-title" class="section-title">Recently launched</h2>
          </div>
          <p class="pf-count">{recentLaunches.length} recent live websites</p>
        </header>
        <div class="pf-grid">
          {recentLaunches.map((project, index) => (
            <article class:list={['visual-card tilt-card group', index === 0 && 'is-wide']} style="--card-color: var(--ac-teal);">
              <a href={project.liveUrl} target="_blank" rel="noopener noreferrer" class="block h-full" aria-label={`Visit ${project.title}, opens in a new tab`}>
                <div class="relative aspect-[16/10] overflow-hidden bg-white">
                  <Image
                    src={getProjectImage(project.image)}
                    alt={`Website preview for ${project.title}`}
                    widths={[360, 540, 720, 960]}
                    sizes={index === 0 ? '(max-width: 639px) 100vw, 28vw' : '(max-width: 639px) 50vw, (max-width: 1023px) 33vw, 25vw'}
                    format={getProjectImage(project.image).format === 'svg' ? undefined : 'avif'}
                    loading="lazy"
                    decoding="async"
                    class:list={['h-full w-full transition duration-500 group-hover:scale-[1.035]', isLogo(project) ? 'object-contain p-8' : 'object-cover object-top']}
                  />
                </div>
                <div class="pf-body">
                  <p class="pf-label text-[var(--ac-teal)]">{project.label}</p>
                  <h3 class="pf-title">{project.title}</h3>
                  <p class="pf-desc">{project.description}</p>
                  {project.note && <p class="mt-2 text-xs font-semibold text-[var(--text-muted)]">{project.note}</p>}
                  <div class="pf-pills">{project.stack?.map(item => <span class="project-pill">{item}</span>)}</div>
                </div>
              </a>
            </article>
          ))}
        </div>
      </div>
    </section>

    <section id="redesigned-work" class="pf-section border-t border-[var(--border)]" aria-labelledby="redesigned-title">
      <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
        <header class="pf-head">
          <div>
            <p class="section-kicker text-[var(--ac-teal)]">New look, same partnership</p>
            <h2 id="redesigned-title" class="section-title">Recently redesigned</h2>
            <p class="section-intro">Three long-standing clients moved from earlier WordPress websites to new designs, rebuilt in Astro.</p>
          </div>
          <p class="pf-count">{recentRedesigns.length} redesigned live websites</p>
        </header>
        <div class="grid gap-4 sm:grid-cols-3">
          {recentRedesigns.map((project) => (
            <article class="visual-card tilt-card group" style="--card-color: var(--ac-cyan);">
              <a href={project.liveUrl} target="_blank" rel="noopener noreferrer" class="block h-full" aria-label={`Visit ${project.title}, opens in a new tab`}>
                <div class="relative aspect-[16/10] overflow-hidden bg-white">
                  <Image
                    src={getProjectImage(project.image)}
                    alt={`Homepage of the redesigned ${project.title} website`}
                    widths={[480, 720, 960]}
                    sizes="(max-width: 639px) 100vw, 33vw"
                    format="avif"
                    loading="lazy"
                    decoding="async"
                    class="h-full w-full object-cover object-top transition duration-500 group-hover:scale-[1.035]"
                  />
                </div>
                <div class="pf-body">
                  <p class="pf-label text-[var(--ac-teal)]">{project.label}</p>
                  <h3 class="pf-title">{project.title}</h3>
                  <p class="pf-desc">{project.description}</p>
                  {project.note && <p class="mt-2 text-xs font-semibold text-[var(--text-muted)]">{project.note}</p>}
                  <div class="pf-pills">{project.stack?.map(item => <span class="project-pill">{item}</span>)}</div>
                </div>
              </a>
            </article>
          ))}
        </div>
      </div>
    </section>

    <section id="ecommerce-work" class="pf-section border-y border-[var(--border)] bg-[var(--bg-card)]" aria-labelledby="commerce-title">
      <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
        <header class="pf-head">
          <div>
            <p class="section-kicker text-[var(--ac-pink)]">Three strong commerce foundations</p>
            <h2 id="commerce-title" class="section-title">Shopify, Medusa.js and WooCommerce</h2>
            <p class="section-intro">The platform should fit the way you sell: custom Shopify storefronts, fully owned Medusa.js commerce and flexible WooCommerce stores.</p>
          </div>
          <a href="/services/ecommerce/" class="pf-count hover:border-[var(--ac-pink)]">Explore eCommerce services →</a>
        </header>

        <div class="mb-4 grid gap-3 sm:grid-cols-3" aria-label="eCommerce technology experience">
          <a href="/services/ecommerce/#shopify" class="platform-card platform-shopify">
            <span class="platform-name">Shopify</span>
            <span class="platform-detail">Custom themes and storefront UX</span>
            <span class="platform-proof">Featured work: Rangresha</span>
          </a>
          <a href="/services/ecommerce/medusa-js-development/" class="platform-card platform-medusa">
            <span class="platform-name">Medusa.js</span>
            <span class="platform-detail">Owned commerce and custom modules</span>
            <span class="platform-proof">Featured work: Healthy Genie</span>
          </a>
          <a href="/services/ecommerce/" class="platform-card platform-woo">
            <span class="platform-name">WooCommerce</span>
            <span class="platform-detail">Flexible stores on WordPress</span>
            <span class="platform-proof">3 selected stores below</span>
          </a>
        </div>

        <div class="grid gap-4 lg:grid-cols-2">
          {[shopifyProject, medusaProject].map((project, index) => (
            <article class:list={['commerce-feature tilt-card tilt-card--bg group', index === 0 ? 'commerce-shopify' : 'commerce-medusa']} style={`--card-color: ${index === 0 ? '#008060' : '#6366f1'};`}>
              <div class="grid h-full grid-cols-[110px_1fr] sm:grid-cols-[150px_1fr]">
                <div class="relative grid place-items-center overflow-hidden bg-white p-4">
                  <Image
                    src={getProjectImage(project.image)}
                    alt={`${project.title} brand mark`}
                    widths={[240, 320]}
                    sizes="150px"
                    format={getProjectImage(project.image).format === 'svg' ? undefined : 'avif'}
                    loading="lazy"
                    decoding="async"
                    class="max-h-24 w-full object-contain"
                  />
                </div>
                <div class="flex flex-col p-4 sm:p-5">
                  <p class="commerce-tech-eyebrow">Built with <span class="commerce-tech-name">{index === 0 ? 'Shopify' : 'Medusa.js'}</span></p>
                  <h3 class="mt-1 font-heading text-lg font-black text-[var(--text)]">{project.title}</h3>
                  <p class="mt-1 line-clamp-3 text-sm leading-6 text-[var(--text-dim)]">{project.description}</p>
                  <div class="pf-pills">{project.stack?.map(item => <span class="project-pill">{item}</span>)}</div>
                  <a href={project.liveUrl} target="_blank" rel="noopener noreferrer" class="mt-2 inline-flex min-h-10 items-center gap-2 self-start text-sm font-bold text-[var(--text)] hover:text-[var(--accent)]" aria-label={`Visit ${project.title}, opens in a new tab`}>
                    Visit {project.title} <span aria-hidden="true">↗</span>
                  </a>
                  <a href={index === 0 ? '/services/ecommerce/#shopify' : '/services/ecommerce/medusa-js-development/#work'} class="self-start text-sm font-semibold text-[var(--accent)] underline underline-offset-4">{index === 0 ? 'Shopify development service' : 'Medusa.js development service'} →</a>
                </div>
              </div>
            </article>
          ))}
        </div>

        <div class="mt-4 grid gap-4 sm:grid-cols-3">
          {wooCommerceProjects.map(project => (
            <article class="woo-project tilt-card tilt-card--bg group" style="--card-color: #96588a;">
              <a href={project.liveUrl} target="_blank" rel="noopener noreferrer" class="block h-full" aria-label={`Visit ${project.title}, opens in a new tab`}>
                <div class="relative aspect-[16/7] overflow-hidden bg-white">
                  <Image
                    src={getProjectImage(project.image)}
                    alt={`${project.title} WooCommerce website`}
                    widths={[480, 720]}
                    sizes="(max-width: 639px) 100vw, 33vw"
                    format="avif"
                    loading="lazy"
                    decoding="async"
                    class="h-full w-full object-cover transition duration-500 group-hover:scale-[1.04]"
                  />
                  <span class="absolute left-3 top-3 rounded-md bg-[#96588a] px-2.5 py-1 text-[10px] font-bold uppercase tracking-wider text-white">WooCommerce</span>
                </div>
                <div class="pf-body">
                  <h3 class="pf-title">{project.title}</h3>
                  <p class="pf-desc">{project.description}</p>
                  <span class="mt-2 inline-flex items-center gap-2 text-sm font-bold text-[#96588a]">Visit the {project.title} store <span aria-hidden="true">↗</span></span>
                </div>
              </a>
            </article>
          ))}
        </div>
        <p class="mt-5 text-sm text-[var(--text-dim)]">Planning a store? <a href="/services/ecommerce/" class="font-semibold text-[var(--text)] underline underline-offset-4">Compare Shopify, Medusa.js, WooCommerce and Zoho on our eCommerce development page</a>.</p>
      </div>
    </section>

    <section id="launching-soon" class="pf-section" aria-labelledby="soon-title">
      <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
        <header class="pf-head">
          <div>
            <p class="section-kicker text-[var(--ac-amber)]">Currently in the launch studio</p>
            <h2 id="soon-title" class="section-title">Launching soon</h2>
            <p class="section-intro">Websites in development, not completed launches. Previews can change before release; projects without an approved public link have no preview button.</p>
          </div>
          <p class="pf-count">{launchingSoon.length} projects in progress</p>
        </header>
        <ol class="pf-grid" role="list">
          {launchingSoon.map((project, index) => (
            <li class="soon-card tilt-card group" style="--card-color: var(--ac-amber);">
              <div class="relative aspect-[16/10] overflow-hidden">
                {project.image ? <Image
                  src={getProjectImage(project.image)}
                  alt={isLogo(project) ? `${project.title} logo` : `Preview of the upcoming ${project.title} website`}
                  widths={[360, 540, 720]}
                  sizes="(max-width: 639px) 50vw, (max-width: 1023px) 33vw, 25vw"
                  format="avif"
                  loading="lazy"
                  decoding="async"
                  class:list={['absolute inset-0 h-full w-full transition duration-500 group-hover:scale-[1.035]', isLogo(project) ? 'object-contain bg-white p-6' : 'object-cover object-top']}
                /> : <div class="absolute inset-0 flex flex-col justify-center bg-gradient-to-br from-slate-900 via-indigo-950 to-slate-800 p-4 text-white">
                  <span class="text-[9px] font-bold uppercase tracking-[.2em] text-cyan-200">In development</span>
                  <span class="mt-2 font-heading text-lg font-bold leading-tight">{project.title}</span>
                </div>}
                <span class="absolute left-2 top-2 rounded-md bg-slate-950/70 px-2 py-0.5 text-[10px] font-bold uppercase tracking-wider text-white">Preview {String(index + 1).padStart(2, '0')}</span>
              </div>
              <div class="pf-body">
                <p class="pf-label text-[var(--ac-amber)]">{project.label}</p>
                <h3 class="pf-title">{project.title}</h3>
                <p class="pf-desc">{project.description}</p>
                {project.note && <p class="mt-2 text-xs font-bold text-[var(--ac-amber)]">{project.note}</p>}
                {project.launchUrl && (
                  <a href={project.launchUrl} target="_blank" rel="noopener noreferrer" class="mt-2 block break-words text-xs font-semibold text-[var(--text)] hover:underline">{project.title === 'Healthy Genie' ? 'Visit current website' : 'Production destination'}: {destinationLabel(project.launchUrl)} ↗</a>
                )}
                {project.liveUrl ? <a href={project.liveUrl} target="_blank" rel="noopener noreferrer" class="mt-2 inline-flex min-h-10 items-center gap-2 text-sm font-bold text-[var(--ac-amber)] hover:underline" aria-label={`Preview ${project.title}, opens in a new tab`}>
                  View preview <span aria-hidden="true">↗</span>
                </a> : <p class="mt-2 inline-flex min-h-10 items-center text-sm font-semibold text-[var(--text-muted)]">Preview link coming soon</p>}
              </div>
            </li>
          ))}
        </ol>
      </div>
    </section>

    <section id="selected-work" class="pf-section border-y border-[var(--border)] bg-[var(--bg-card)]" aria-labelledby="selected-title">
      <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
        <header class="pf-head">
          <div>
            <p class="section-kicker text-[var(--ac-indigo)]">International and selected work</p>
            <h2 id="selected-title" class="section-title">Websites built across borders and industries</h2>
            <p class="section-intro">Work for businesses in the USA, Canada and Australia, then more relationships across legal education, healthcare, consulting, architecture and digital platforms. Our New Zealand work is featured above with Stems Flower Studio.</p>
          </div>
        </header>
        <ul class="pf-grid" role="list">
          {broaderSelectedProjects.map(project => (
            <li>
              <a href={project.liveUrl} target="_blank" rel="noopener noreferrer" class="selected-card tilt-card tilt-card--bg group" style="--card-color: var(--ac-indigo);" aria-label={`Visit ${project.title}, opens in a new tab`}>
                <div class="relative aspect-[16/10] overflow-hidden bg-white">
                  <Image
                    src={getProjectImage(project.image)}
                    alt={`${project.title} project`}
                    widths={[320, 480, 640]}
                    sizes="(max-width: 639px) 50vw, (max-width: 1023px) 33vw, 25vw"
                    format={getProjectImage(project.image).format === 'svg' ? undefined : 'avif'}
                    loading="lazy"
                    decoding="async"
                    class:list={['h-full w-full transition duration-500 group-hover:scale-[1.04]', isLogo(project) ? 'object-contain p-6' : 'object-cover']}
                  />
                </div>
                <div class="pf-body">
                  <div class="flex flex-wrap items-center gap-2">
                    <p class="pf-label text-[var(--ac-indigo)]">{project.label}</p>
                    {project.country && <span class="rounded bg-[var(--ac-indigo)]/10 px-1.5 py-0.5 text-[9px] font-black uppercase tracking-wider text-[var(--ac-indigo)]">{project.country}</span>}
                  </div>
                  <h3 class="pf-title">{project.title}</h3>
                  <p class="pf-desc">{project.description}</p>
                  {project.location && <p class="mt-1 text-[10px] font-semibold text-[var(--text-muted)]">{project.location}</p>}
                </div>
              </a>
            </li>
          ))}
        </ul>
      </div>
    </section>

    <section id="project-archive" class="pf-section" aria-labelledby="archive-title">
      <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
        <header class="pf-head">
          <div>
            <p class="section-kicker text-[var(--ac-violet)]">The wider portfolio</p>
            <h2 id="archive-title" class="section-title">Earlier projects and long-term client work</h2>
          </div>
          <p class="pf-count">{archiveProjects.length} additional projects</p>
        </header>
        <ul class="pf-grid" role="list">
          {archiveFirst.map(project => <ArchiveCard project={project} />)}
        </ul>
        {archiveMore.length > 0 && (
          <details class="more mt-4">
            <summary class="inline-flex min-h-11 cursor-pointer list-none items-center gap-2 rounded-lg border border-[var(--border)] bg-[var(--bg-card)] px-5 py-2.5 text-sm font-semibold text-[var(--text)] hover:border-[var(--accent)]">
              <span class="when-closed">Show all {archiveProjects.length} earlier projects</span><span class="when-open">Show fewer projects</span>
              <svg class="chev" xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polyline points="6 9 12 15 18 9"/></svg>
            </summary>
            <ul class="pf-grid mt-4" role="list">
              {archiveMore.map(project => <ArchiveCard project={project} />)}
            </ul>
          </details>
        )}

        <article id="long-running-work" class="mt-10 scroll-mt-28 flex flex-col gap-4 rounded-xl border border-[var(--border)] bg-slate-950 p-6 text-white sm:p-8 lg:flex-row lg:items-center lg:justify-between" aria-labelledby="legacy-title">
          <div class="max-w-3xl">
            <p class="section-kicker text-cyan-300">Built to remain useful</p>
            <h2 id="legacy-title" class="mt-2 font-heading text-2xl font-black sm:text-3xl">{legacyProject.title}</h2>
            <p class="mt-2 text-sm leading-6 text-slate-300 sm:text-base">{legacyProject.description}</p>
            <div class="mt-3 flex flex-wrap gap-2">
              {legacyProject.stack?.map(item => <span class="rounded-md border border-white/20 bg-white/10 px-2.5 py-1 text-xs font-semibold text-slate-200">{item}</span>)}
            </div>
          </div>
          <a href={legacyProject.liveUrl} target="_blank" rel="noopener noreferrer" class="inline-flex shrink-0 items-center justify-center gap-2 rounded-lg bg-cyan-300 px-5 py-2.5 text-sm font-bold text-slate-950 transition hover:bg-white" aria-label={`Visit ${legacyProject.title}, opens in a new tab`}>
            Visit long-running project <span aria-hidden="true">↗</span>
          </a>
        </article>

        <details id="portfolio-publication-note" class="note mt-6 rounded-xl border border-[var(--border)] bg-[var(--bg-card)]">
          <summary class="flex cursor-pointer list-none items-center justify-between gap-4 px-5 py-4">
            <span id="portfolio-publication-title" class="font-semibold text-[var(--text)]">Portfolio publication: project context without unnecessary personal data</span>
            <svg class="chev shrink-0 text-[var(--text-muted)]" xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polyline points="6 9 12 15 18 9"/></svg>
          </summary>
          <div class="grid gap-3 border-t border-[var(--border)] px-5 py-5 text-sm leading-relaxed text-[var(--text-dim)] sm:grid-cols-2">
            <p><strong class="text-[var(--text)]">What is shown:</strong> project or business names, brand marks, website previews, public destinations and concise descriptions needed to identify the work.</p>
            <p><strong class="text-[var(--text)]">Visual accuracy:</strong> screenshots represent a captured version of a project. Content, ownership, technology and availability may change after launch or handover.</p>
            <p><strong class="text-[var(--text)]">External websites:</strong> live-site and preview links open only when selected. The destination may then receive ordinary connection, browser and device information under its own privacy practices.</p>
            <p><strong class="text-[var(--text)]">Brand ownership:</strong> client names, logos and trademarks remain the property of their respective owners and are presented only to identify project work.</p>
            <p class="sm:col-span-2">Represent a featured project and need its name, description, image, link or attribution corrected or removed? <a href="mailto:privacy@elan-tech.net?subject=Portfolio%20correction%20or%20removal%20request" class="font-semibold text-[var(--accent)] underline underline-offset-4">Write to privacy@elan-tech.net</a></p>
          </div>
        </details>
      </div>
    </section>

    <section class="border-t border-[var(--border)] bg-[var(--bg-card)] py-12" aria-labelledby="portfolio-cta-title">
      <div class="mx-auto flex max-w-7xl flex-col gap-5 px-4 sm:px-6 lg:flex-row lg:items-center lg:justify-between lg:px-8">
        <div>
          <p class="section-kicker text-[var(--accent)]">Your project can be next</p>
          <h2 id="portfolio-cta-title" class="mt-2 font-heading text-2xl font-bold text-[var(--text)] sm:text-3xl">Let’s create something people enjoy using.</h2>
          <p class="mt-2 max-w-xl text-[var(--text-dim)]">Tell us what you want to launch, improve or sell online. We will recommend a practical way forward in plain language.</p>
        </div>
        <div class="flex flex-wrap gap-3">
          <a href="/get-quote/" class="inline-flex min-h-11 items-center rounded-lg bg-[var(--accent)] px-5 py-2.5 font-semibold text-white transition hover:brightness-110">Request a quote</a>
          <a href="/schedule-consultation/" class="inline-flex min-h-11 items-center rounded-lg border border-[var(--border)] bg-[var(--bg)] px-5 py-2.5 font-semibold text-[var(--text)] transition hover:border-[var(--accent)]">Schedule a consultation</a>
        </div>
      </div>
    </section>
  </main>
</BaseLayout>

<style>
  .portfolio-nav a { flex: 0 0 auto; border: 1px solid var(--border); border-radius: var(--radius-md); padding: .45rem .85rem; background: var(--bg-card); color: var(--text-dim); font-size: .75rem; font-weight: 700; white-space: nowrap; transition: border-color 180ms ease, color 180ms ease; }
  .portfolio-nav > div { scrollbar-width: none; }
  .portfolio-nav > div::-webkit-scrollbar { display: none; }
  .portfolio-nav a:hover, .portfolio-nav a:focus-visible { border-color: var(--accent); color: var(--accent); }

  .pf-section { scroll-margin-top: 7rem; padding: 3rem 0; }
  .pf-head { display: flex; flex-wrap: wrap; align-items: flex-end; justify-content: space-between; gap: .75rem 1.5rem; margin-bottom: 1.5rem; }
  .pf-count { display: inline-flex; border: 1px solid var(--border); border-radius: var(--radius-md); background: var(--bg-card); padding: .4rem .8rem; font-size: .75rem; font-weight: 600; color: var(--text-muted); }
  .section-kicker { font-size: .7rem; font-weight: 800; letter-spacing: .2em; text-transform: uppercase; }
  .section-title { margin-top: .4rem; font-family: var(--font-heading); font-size: clamp(1.6rem, 3vw, 2.25rem); font-weight: 800; line-height: 1.1; letter-spacing: -.02em; color: var(--text); }
  .section-intro { max-width: 46rem; margin-top: .5rem; color: var(--text-dim); font-size: .95rem; line-height: 1.6; }

  .pf-grid { display: grid; gap: 1rem; grid-template-columns: repeat(4, minmax(0, 1fr)); }
  .pf-grid > .is-wide { grid-column: span 2; }
  .is-wide > a { display: grid; grid-template-columns: 1.1fr 1fr; }
  .is-wide > a > div:first-child { aspect-ratio: auto; height: 100%; min-height: 11rem; }
  .pf-body { padding: .9rem 1rem 1rem; }
  .pf-label { font-size: .65rem; font-weight: 700; text-transform: uppercase; letter-spacing: .14em; }
  .pf-title { margin-top: .3rem; font-family: var(--font-heading); font-size: 1rem; font-weight: 800; line-height: 1.3; color: var(--text); }
  .is-wide .pf-title { font-size: 1.35rem; }
  .pf-desc { margin-top: .35rem; font-size: .8rem; line-height: 1.5; color: var(--text-dim); display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden; }
  .is-wide .pf-desc { -webkit-line-clamp: 5; font-size: .875rem; }
  .pf-pills { margin-top: .6rem; display: flex; flex-wrap: wrap; gap: .3rem; }

  .visual-card:hover, .commerce-feature:hover, .woo-project:hover, .soon-card:hover, .selected-card:hover, .archive-card:hover { transform: translateY(-3px); border-color: color-mix(in srgb, var(--accent) 48%, var(--border)); box-shadow: 0 14px 36px color-mix(in srgb, var(--text) 10%, transparent); }
  .selected-card { display: block; height: 100%; }

  .platform-card { position: relative; display: grid; gap: .25rem; overflow: hidden; border-radius: var(--radius-xl); padding: 1rem 1.1rem; color: white; isolation: isolate; transition: transform 200ms ease; }
  .platform-card::after { content: ''; position: absolute; width: 7rem; height: 4rem; right: -1.4rem; bottom: -1.35rem; border: 1px solid rgba(255,255,255,.28); border-radius: var(--radius-lg); background: rgba(255,255,255,.1); transform: rotate(-12deg); z-index: -1; }
  .platform-card:hover { transform: translateY(-2px); }
  .platform-shopify { background: linear-gradient(135deg, #006e52, #008060); }
  .platform-medusa { background: linear-gradient(135deg, #172554, #4338ca); }
  .platform-woo { background: linear-gradient(135deg, #573f8c, #96588a); }
  .platform-name { font-family: var(--font-heading); font-size: 1.4rem; font-weight: 900; line-height: 1.1; }
  .platform-detail { font-size: .8rem; color: rgba(255,255,255,.85); }
  .platform-proof { margin-top: .35rem; font-size: .66rem; font-weight: 800; text-transform: uppercase; letter-spacing: .08em; }
  .commerce-tech-eyebrow { font-size: .62rem; font-weight: 800; letter-spacing: .15em; text-transform: uppercase; color: var(--text-muted); }
  .commerce-tech-name { margin-left: .25rem; letter-spacing: .05em; color: var(--text); }

  .project-pill { display: inline-flex; border: 1px solid var(--border); border-radius: var(--radius-md); background: color-mix(in srgb, var(--bg-card) 78%, transparent); padding: .2rem .5rem; color: var(--text-muted); font-size: .62rem; font-weight: 700; }

  .more summary::-webkit-details-marker, .note summary::-webkit-details-marker { display: none; }
  .more .when-open { display: none; }
  .more[open] .when-open { display: inline; }
  .more[open] .when-closed { display: none; }
  .chev { transition: transform .2s; }
  .more[open] .chev, .note[open] .chev { transform: rotate(180deg); }

  @media (max-width: 1023px) { .pf-grid { grid-template-columns: repeat(3, minmax(0, 1fr)); } }
  @media (max-width: 639px) {
    .pf-section { padding: 2.25rem 0; }
    .pf-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); gap: .6rem; }
    .is-wide > a { display: block; }
    .is-wide > a > div:first-child { aspect-ratio: 16 / 10; height: auto; min-height: 0; }
    .pf-body { padding: .6rem .7rem .75rem; }
    .pf-title { font-size: .875rem; }
    .pf-grid > :not(.is-wide) .pf-desc, .pf-grid > :not(.is-wide) .pf-pills { display: none; }
    .soon-card .pf-body > a:first-of-type { font-size: .7rem; }
  }
  @media (prefers-reduced-motion: reduce) {
    .hero-project img, .visual-card, .visual-card img, .commerce-feature, .woo-project, .woo-project img, .soon-card, .soon-card img, .selected-card, .selected-card img, .archive-card, .archive-card img { transition: none; }
  }
</style>
