          <a href="/schedule-consultation/" class="inline-flex items-center justify-center rounded-full border border-[var(--border)] bg-[var(--bg)] px-7 py-3 text-sm font-bold text-[var(--text)] transition hover:border-[var(--accent)] hover:text-[var(--accent)]">Schedule a consultation</a>
        </div>
      </div>
    </section>
  </main>
</BaseLayout>

