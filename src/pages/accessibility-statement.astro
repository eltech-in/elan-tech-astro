---
import LegalLayout from '../layouts/LegalLayout.astro';
import SchemaMarkup from '../components/SchemaMarkup.astro';
import { webPageSchema, breadcrumbSchema } from '../utils/schema';

const schema = [
  webPageSchema('Accessibility Statement', 'eLan Technology accessibility statement - our accessibility-first approach, feedback channel and current limitations.', '/accessibility-statement/'),
  breadcrumbSchema([{ name: 'Home', url: '/' }, { name: 'Accessibility Statement', url: '/accessibility-statement/' }]),
];

// Compact statement (owner, 27 Nov 2026): same commitments and caveats, tighter wording.
const measures = [
  ['Semantic landmarks', 'header, main, nav and footer define page regions for screen readers.'],
  ['Skip link', '"Skip to main content" comes before the primary navigation.'],
  ['Image alternatives', 'meaningful images carry text alternatives; decorative images are hidden.'],
  ['Colour contrast', 'the design system targets WCAG 2.1 AA thresholds.'],
  ['Keyboard use', 'navigation, forms and custom controls work from the keyboard.'],
  ['Visible focus', 'a visible focus treatment marks keyboard position.'],
  ['Labelled fields', 'first-party form fields have associated labels, not placeholders alone.'],
  ['Error messages', 'validation names the affected field and the correction needed.'],
  ['Reflow and zoom', 'layouts reflow at increased zoom; complex tables or long strings may scroll.'],
  ['No flashing', 'we do not publish content that flashes at seizure-risk frequencies.'],
  ['Reduced motion', 'animations are minimised under prefers-reduced-motion.'],
  ['Reading order', 'visual order matches the DOM order.'],
  ['Page language', 'templates declare English as the page language.'],
  ['Link text', 'links use meaningful, context-aware wording.'],
];
const methods = [
  ['Automated checks', 'find a subset of detectable issues; scores are not proof of conformance.'],
  ['Lighthouse reviews', 'one development signal on selected templates and key journeys.'],
  ['Manual keyboard review', 'focus order, visibility and operability, repeated after material changes.'],
  ['Assistive technology', 'representative journeys with tools such as NVDA and VoiceOver, not every combination.'],
];
---
<LegalLayout
  title="Accessibility Statement"
  description="eLan Technology accessibility statement - our accessibility-first approach, feedback channel and current limitations."
  lastUpdated="2026-09-24"
>
  <SchemaMarkup schema={schema} />

  <dl class="a11y-facts">
    <div class="tilt-card" style="--card-color: var(--ac-indigo);"><dt>Target</dt><dd>WCAG 2.1 Level AA</dd></div>
    <div class="tilt-card" style="--card-color: var(--ac-teal);"><dt>Report a barrier</dt><dd><a href="mailto:accessibility@elan-tech.net">accessibility@elan-tech.net</a></dd></div>
    <div class="tilt-card" style="--card-color: var(--ac-amber);"><dt>Response</dt><dd>Acknowledged within 2 business days</dd></div>
  </dl>

  <h2>Our Commitment</h2>
  <p>
    eLan Technology is committed to digital accessibility for people with disabilities. We use an
    accessibility-first approach for this website and keep reviewing barriers as content, code and
    third-party services change. Requirements and testing for client projects are defined separately
    in each accepted scope.
  </p>

  <h2>Conformance Status</h2>
  <p>
    Our target for this website is <strong>WCAG 2.1 Level AA</strong> (W3C), the primary technical
    reference for review and remediation. It is a target, not a certification or a claim that every
    page, third-party component or future change is free from barriers. Applicability of the <strong>ADA</strong> and <strong>Section 508</strong> is fact-specific: WCAG-informed work supports
    accessibility but is not by itself legal certification, and Section 508 applies to particular
    United States federal contexts.
  </p>
  <p>
    The site is built with HTML5, CSS (Tailwind CSS v4), minimal JavaScript (Astro islands) and WAI-ARIA.
  </p>

  <h2>Measures Taken</h2>
  <ul class="a11y-list">
    {measures.map(([title, text]) => <li><strong>{title}:</strong> {text}</li>)}
  </ul>
  <p class="a11y-note">New content, images, embedded tools and third-party components may need separate verification.</p>

  <h2>Known Limitations</h2>
  <ul>
    <li><strong>Legacy PDFs:</strong> some older PDFs may not be fully accessible to screen readers. Ask us and we will provide an alternative format.</li>
    <li><strong>Third-party embeds:</strong> Calendly (scheduling) and Google Maps are outside our direct control. Contact us directly for an accessible alternative.</li>
  </ul>

  <h2>Feedback and Contact</h2>
  <p>
    If you meet a barrier or have difficulty accessing content, email <a href="mailto:accessibility@elan-tech.net">accessibility@elan-tech.net</a>, WhatsApp <a href="https://wa.me/918788834630">+91 8788834630</a>, call <a href="tel:+919822231642">+91 9822231642</a>,
    or write to <a href="https://share.google/PklD3tFGBBqsPHjli" target="_blank" rel="noopener noreferrer">eLan Technology, Basement Floor, PTG IT Park, Plot No. 21, IT Park Rd, Gayatri Nagar, Nagpur, Maharashtra 440022, India</a>.
  </p>
  <p>
    We aim to acknowledge accessibility enquiries within <strong>2 business days</strong>. Investigation
    and remediation time depends on the barrier, the affected content and any third-party involvement.
    If you are not satisfied with our response or timeline, you may contact the relevant regulatory
    authority or disability rights body in your jurisdiction.
  </p>

  <h2>Assessment Approach</h2>
  <p>We self-assess this website using:</p>
  <ul class="a11y-list">
    {methods.map(([title, text]) => <li><strong>{title}:</strong> {text}</li>)}
  </ul>

  <h2>Statement Date</h2>
  <p>
    This statement was last reviewed and updated on <strong>24 September 2026</strong>. We review it at
    least annually and whenever the website changes significantly.
  </p>
</LegalLayout>

<style>
  .a11y-facts { display: grid; gap: .75rem; margin: 0 0 2rem; }
  .a11y-facts > div { padding: .8rem 1rem; }
  .a11y-facts dt { font-size: .7rem; font-weight: 700; text-transform: uppercase; letter-spacing: .14em; color: var(--text-muted); }
  .a11y-facts dd { margin: .15rem 0 0; font-weight: 600; color: var(--text); line-height: 1.5; overflow-wrap: anywhere; }
  .a11y-note { font-size: .875rem; }
  @media (min-width: 640px) { .a11y-facts { grid-template-columns: repeat(3, minmax(0, 1fr)); } }
  @media (min-width: 768px) { .a11y-list { columns: 2; column-gap: 2.5rem; } .a11y-list > li { break-inside: avoid; } }
</style>
