---
import BaseLayout from '../layouts/BaseLayout.astro';
import { breadcrumbSchema } from '../utils/schema';

const schema = breadcrumbSchema([
  { name: 'Home', url: '/' },
  { name: 'Careers', url: '/careers/' },
]);

const generalInterestMailto = (() => {
  const subject = encodeURIComponent('General career interest');
  const body = encodeURIComponent(
    `Hello eLan Technology,\n\nI would like to be considered for suitable future roles. I understand that this general-interest application may be retained for up to 12 months.\n\nName:\nArea of work:\nCurrent city:\nPortfolio or LinkedIn (optional):\n\nI have attached my CV without government IDs, bank details, passwords or unnecessary sensitive information.`,
  );
  return `mailto:careers@elan-tech.net?subject=${subject}&body=${body}`;
})();

const perks = [
  {
    title: 'Remote-Friendly',
    desc: 'Work from anywhere in India. We trust our team to deliver quality work from wherever they are most productive.',
    icon: `<svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M3 9l9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"/><polyline points="9 22 9 12 15 12 15 22"/></svg>`,
  },
  {
    title: 'Learning Culture',
    desc: 'Conferences, online courses, and certifications are sponsored. We invest in your growth because your skills are our strength.',
    icon: `<svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M2 3h6a4 4 0 0 1 4 4v14a3 3 0 0 0-3-3H2z"/><path d="M22 3h-6a4 4 0 0 0-4 4v14a3 3 0 0 1 3-3h7z"/></svg>`,
  },
  {
    title: 'Meaningful Work',
    desc: 'Real products, real clients, real impact. Your work goes live and is used by thousands of users across India and internationally.',
    icon: `<svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polyline points="22 12 18 12 15 21 9 3 6 12 2 12"/></svg>`,
  },
  {
    title: 'Competitive Pay',
    desc: 'Market-rate salaries plus performance bonuses. We believe in rewarding excellence and sharing success.',
    icon: `<svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><line x1="12" y1="1" x2="12" y2="23"/><path d="M17 5H9.5a3.5 3.5 0 0 0 0 7h5a3.5 3.5 0 0 1 0 7H6"/></svg>`,
  },
];
---

<BaseLayout
  title="Careers at eLan Technology - Join Our Team in Nagpur"
  description="Careers at eLan Technology in Nagpur. We have no open positions at the moment, but you can share your CV for future roles. Learn what it is like to work with our team."
  schema={schema}
>

  <!-- ═══════════════════════════════════════════════════════════════════════
       HERO
  ════════════════════════════════════════════════════════════════════════ -->
  <section aria-labelledby="careers-hero-heading" class="relative overflow-hidden bg-gradient-to-br from-[var(--bg)] to-[var(--bg-card)] py-24 md:py-36">
    <div aria-hidden="true" class="pointer-events-none absolute inset-0 overflow-hidden">
      <div class="absolute -top-40 -left-40 h-[600px] w-[600px] rounded-full bg-[var(--accent)]/6 blur-[120px]"></div>
      <div class="absolute -bottom-40 -right-20 h-[500px] w-[500px] rounded-full bg-[#6366F1]/6 blur-[100px]"></div>
    </div>

    <div class="relative mx-auto max-w-7xl px-4 sm:px-6 lg:px-8 text-center">
      <div class="mb-6 inline-flex items-center gap-2 rounded-full border border-[var(--border)] bg-[var(--bg-card)]/60 px-4 py-2 text-sm text-[var(--text-muted)] backdrop-blur-sm">
        <span class="h-2 w-2 rounded-full bg-[var(--accent)] animate-pulse" aria-hidden="true"></span>
        No open positions at the moment
      </div>

      <h1
        id="careers-hero-heading"
        class="font-heading text-4xl sm:text-5xl lg:text-6xl font-bold leading-tight text-[var(--text)] mb-6"
      >
        Build the Web With Us
      </h1>
      <p class="mx-auto max-w-2xl text-lg text-[var(--text-dim)] leading-relaxed">
        We're a tight-knit team of craftspeople who care deeply about quality, accessibility, and the impact of digital work. Come build things that matter.
      </p>
    </div>
  </section>


  <!-- ═══════════════════════════════════════════════════════════════════════
       WHY JOIN ELAN
  ════════════════════════════════════════════════════════════════════════ -->
  <section aria-labelledby="perks-heading" class="bg-[var(--bg)] py-16 md:py-20">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
      <p class="text-center text-sm font-semibold uppercase tracking-widest text-[var(--accent)] mb-3">Why Join eLan</p>
      <h2 id="perks-heading" class="font-heading text-2xl sm:text-3xl font-bold text-[var(--text)] text-center mb-12">
        More Than Just a Job
      </h2>

      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-6">
        {perks.map((perk) => (
          <div class="rounded-2xl border border-[var(--border)] bg-[var(--bg-card)] p-6">
            <div class="mb-4 flex h-12 w-12 items-center justify-center rounded-xl bg-[var(--accent)]/10 text-[var(--accent)]" set:html={perk.icon} />
            <h3 class="font-semibold text-[var(--text)] mb-2">{perk.title}</h3>
            <p class="text-sm text-[var(--text-dim)] leading-relaxed">{perk.desc}</p>
          </div>
        ))}
      </div>
    </div>
  </section>


  <!-- ═══════════════════════════════════════════════════════════════════════
       OPEN POSITIONS
  ════════════════════════════════════════════════════════════════════════ -->
  <section aria-labelledby="positions-heading" class="bg-[var(--bg-card)] py-16 md:py-20 border-y border-[var(--border)]">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
      <p class="text-center text-sm font-semibold uppercase tracking-widest text-[var(--accent)] mb-3">Current Openings</p>
      <h2 id="positions-heading" class="font-heading text-2xl sm:text-3xl font-bold text-[var(--text)] text-center mb-4">
        No Open Positions Right Now
      </h2>
      <p class="mx-auto mb-10 max-w-2xl text-center text-[var(--text-dim)] leading-relaxed">
        Thank you for your interest in eLan Technology. We are not recruiting for any role at the moment. We grow our team as our project work grows, and any future openings will be listed on this page. If you would like us to consider you when a suitable role opens, please share your CV below.
      </p>

      <aside id="applicant-privacy-note" class="mx-auto mb-10 max-w-5xl rounded-2xl border border-[var(--border)] bg-[var(--bg)] p-6 sm:p-8" aria-labelledby="applicant-privacy-heading">
        <div class="grid gap-6 md:grid-cols-[0.85fr_1.15fr] md:items-start">
          <div>
            <p class="text-xs font-bold uppercase tracking-[0.18em] text-[var(--accent)]">Applicant privacy</p>
            <h3 id="applicant-privacy-heading" class="mt-2 font-heading text-xl font-bold text-[var(--text)] sm:text-2xl">Apply with only what we need</h3>
            <p id="application-email-note" class="mt-3 text-sm leading-relaxed text-[var(--text-dim)]">The application link below opens your email app. Nothing is sent to eLan Technology until you choose to send the email.</p>
          </div>
          <ul class="space-y-3 text-sm leading-relaxed text-[var(--text-dim)]">
            <li><strong class="text-[var(--text)]">Purpose:</strong> we use your CV, contact details, work history, skills and optional portfolio only to assess and communicate about employment opportunities. We do not use solely automated hiring decisions.</li>
            <li><strong class="text-[var(--text)]">Retention:</strong> role-specific unsuccessful applications are normally removed within six months after that recruitment process closes. We retain an application for other suitable roles for up to 12 months only when you select that preference. General-interest applications are retained for up to 12 months.</li>
            <li><strong class="text-[var(--text)]">Please do not send:</strong> Aadhaar, PAN, passport, bank or card details, passwords, full home address, medical records, family information or other unnecessary sensitive documents at the application stage.</li>
          </ul>
        </div>
        <p class="mt-5 border-t border-[var(--border)] pt-4 text-xs leading-relaxed text-[var(--text-muted)]">Access is limited to people involved in recruitment. Email transmission also involves your email provider and ours. You may request access, correction, withdrawal or deletion by writing to <a href="mailto:privacy@elan-tech.net?subject=Applicant%20privacy%20request" class="font-semibold text-[var(--text)] underline underline-offset-2">privacy@elan-tech.net</a>. See our <a href="/privacy-policy/" class="font-semibold text-[var(--text)] underline underline-offset-2">Privacy Policy</a>.</p>
      </aside>

    </div>
  </section>


  <!-- ═══════════════════════════════════════════════════════════════════════
       NO MATCHING ROLE
  ════════════════════════════════════════════════════════════════════════ -->
  <section class="bg-[var(--bg)] py-16 md:py-20">
    <div class="mx-auto max-w-3xl px-4 sm:px-6 lg:px-8">
      <div class="rounded-2xl border border-[var(--border)] bg-[var(--bg-card)] p-8 text-center">
        <h2 class="font-heading text-2xl font-bold text-[var(--text)] mb-4">
          Interested in Future Opportunities?
        </h2>
        <p class="text-[var(--text-dim)] mb-6 leading-relaxed">
          Send us a general-interest application and tell us the area you work in. We will use it only to consider you for suitable openings and retain it for up to 12 months, after which we remove it unless another lawful need applies.
        </p>
        <a
          href={generalInterestMailto}
          aria-describedby="application-email-note"
          class="inline-flex items-center gap-2 rounded-full bg-[var(--accent)] px-8 py-3 text-base font-semibold text-[var(--bg)] hover:opacity-90 transition-opacity"
        >
          Send a General-Interest Application →
        </a>
        <p class="mt-4 text-xs leading-relaxed text-[var(--text-muted)]">The email template records your 12-month talent-pool preference. Please review the applicant privacy notice above before sending.</p>
      </div>
    </div>
  </section>

</BaseLayout>
