---
import BaseLayout from '../layouts/BaseLayout.astro';
import { breadcrumbSchema } from '../utils/schema';

const schema = breadcrumbSchema([
  { name: 'Home', url: '/' },
  { name: 'Careers', url: '/careers/' },
]);

const generalInterestMailto = (() => {
  const subject = encodeURIComponent('General career interest');
  const body = encodeURIComponent(
    `Hello eLan Technology,\n\nI would like to be considered for suitable future roles. I understand that this general-interest application may be retained for up to 12 months.\n\nName:\nArea of work:\nCurrent city:\nPortfolio or LinkedIn (optional):\n\nI have attached my CV without government IDs, bank details, passwords or unnecessary sensitive information.`,
  );
  return `mailto:careers@elan-tech.net?subject=${subject}&body=${body}`;
})();

// Compact careers page (owner, 27 Nov 2026).
const perks = [
  {
    title: 'Remote-Friendly',
    color: '--ac-teal',
    desc: 'Work from anywhere in India, wherever you do your best work.',
    icon: `<svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M3 9l9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"/><polyline points="9 22 9 12 15 12 15 22"/></svg>`,
  },
  {
    title: 'Learning Culture',
    color: '--ac-indigo',
    desc: 'Sponsored courses, conferences and certifications.',
    icon: `<svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M2 3h6a4 4 0 0 1 4 4v14a3 3 0 0 0-3-3H2z"/><path d="M22 3h-6a4 4 0 0 0-4 4v14a3 3 0 0 1 3-3h7z"/></svg>`,
  },
  {
    title: 'Meaningful Work',
    color: '--ac-pink',
    desc: 'Real clients and products used in India and abroad.',
    icon: `<svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polyline points="22 12 18 12 15 21 9 3 6 12 2 12"/></svg>`,
  },
  {
    title: 'Competitive Pay',
    color: '--ac-amber',
    desc: 'Market-rate salaries plus performance bonuses.',
    icon: `<svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><line x1="12" y1="1" x2="12" y2="23"/><path d="M17 5H9.5a3.5 3.5 0 0 0 0 7h5a3.5 3.5 0 0 1 0 7H6"/></svg>`,
  },
];
---

<BaseLayout
  title="Careers at eLan Technology - Join Our Team in Nagpur"
  description="Careers at eLan Technology in Nagpur. We have no open positions at the moment, but you can share your CV for future roles. Learn what it is like to work with our team."
  schema={schema}
>
  <section class="bg-gradient-to-br from-[var(--bg)] to-[var(--bg-card)] py-12 md:py-16" aria-labelledby="careers-hero-heading">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
      <p class="inline-flex items-center gap-2 text-xs font-bold uppercase tracking-[0.18em] text-[var(--accent)]"><span class="h-2 w-2 rounded-full bg-[var(--accent)]" aria-hidden="true"></span>No open positions at the moment</p>
      <h1 id="careers-hero-heading" class="mt-3 font-heading text-4xl font-bold leading-tight text-[var(--text)] md:text-5xl">Build the Web With Us</h1>
      <p class="mt-4 max-w-2xl text-lg text-[var(--text-dim)]">We're a tight-knit team who care about quality, accessibility and the impact of digital work.</p>

      <h2 id="perks-heading" class="sr-only">More Than Just a Job</h2>
      <ul class="mt-8 grid gap-3 sm:grid-cols-2 lg:grid-cols-4" role="list" aria-labelledby="perks-heading">
        {perks.map((perk) => (
          <li class="tilt-card flex items-start gap-3 p-4" style={`--card-color: var(${perk.color});`}>
            <span class="tilt-card__icon" set:html={perk.icon} />
            <div>
              <h3 class="font-semibold text-[var(--text)]">{perk.title}</h3>
              <p class="mt-0.5 text-sm leading-relaxed text-[var(--text-dim)]">{perk.desc}</p>
            </div>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <section class="border-t border-[var(--border)] py-12 md:py-14" aria-labelledby="positions-heading">
    <div class="mx-auto grid max-w-7xl gap-8 px-4 sm:px-6 lg:grid-cols-2 lg:items-start lg:px-8">
      <div>
        <p class="text-xs font-bold uppercase tracking-[0.18em] text-[var(--accent)]">Current Openings</p>
        <h2 id="positions-heading" class="mt-2 font-heading text-2xl font-bold text-[var(--text)] sm:text-3xl">No Open Positions Right Now</h2>
        <p class="mt-3 leading-relaxed text-[var(--text-dim)]">We are not recruiting for any role at the moment. We grow the team as project work grows, and future openings will be listed here.</p>
        <h3 class="mt-6 font-heading text-lg font-bold text-[var(--text)]">Interested in Future Opportunities?</h3>
        <p class="mt-2 text-sm leading-relaxed text-[var(--text-dim)]">Send a general-interest application and tell us the area you work in. We use it only to consider you for suitable openings and keep it for up to 12 months, after which we remove it unless another lawful need applies.</p>
        <a href={generalInterestMailto} aria-describedby="application-email-note" class="mt-5 inline-flex min-h-11 items-center gap-2 rounded-lg bg-[var(--accent)] px-5 py-2.5 font-semibold text-[var(--bg)] transition hover:opacity-90">Send a General-Interest Application →</a>
        <p id="application-email-note" class="mt-3 text-xs leading-relaxed text-[var(--text-muted)]">The link opens your email app with a template that records your 12-month talent-pool preference. Nothing is sent to eLan Technology until you choose to send the email.</p>
      </div>

      <aside id="applicant-privacy-note" class="tilt-card tilt-card--lg p-5 sm:p-6" style="--card-color: var(--ac-violet);" aria-labelledby="applicant-privacy-heading">
        <p class="text-xs font-bold uppercase tracking-[0.18em] text-[var(--accent)]">Applicant privacy</p>
        <h3 id="applicant-privacy-heading" class="mt-1 font-heading text-lg font-bold text-[var(--text)]">Apply with only what we need</h3>
        <ul class="mt-3 space-y-2.5 text-sm leading-relaxed text-[var(--text-dim)]">
          <li><strong class="text-[var(--text)]">Purpose:</strong> we use your CV, contact details, work history, skills and optional portfolio only to assess and communicate about employment opportunities. We do not use solely automated hiring decisions.</li>
          <li><strong class="text-[var(--text)]">Retention:</strong> unsuccessful role-specific applications are normally removed within six months after that recruitment closes, or kept for other suitable roles for up to 12 months only when you choose that. General-interest applications are kept for up to 12 months.</li>
          <li><strong class="text-[var(--text)]">Please do not send:</strong> Aadhaar, PAN, passport, bank or card details, passwords, full home address, medical records, family information or other unnecessary sensitive documents.</li>
        </ul>
        <p class="mt-4 border-t border-[var(--border)] pt-3 text-xs leading-relaxed text-[var(--text-muted)]">Access is limited to people involved in recruitment. Email transmission also involves your email provider and ours. To request access, correction, withdrawal or deletion, write to <a href="mailto:privacy@elan-tech.net?subject=Applicant%20privacy%20request" class="font-semibold text-[var(--text)] underline underline-offset-2">privacy@elan-tech.net</a>. See our <a href="/privacy-policy/" class="font-semibold text-[var(--text)] underline underline-offset-2">Privacy Policy</a>.</p>
      </aside>
    </div>
  </section>
</BaseLayout>
