---
import BaseLayout from '../layouts/BaseLayout.astro';
import { testimonials } from '../data/testimonials';
import { breadcrumbSchema } from '../utils/schema';

const schema = [
  breadcrumbSchema([
    { name: 'Home', url: '/' },
    { name: 'Testimonials', url: '/testimonials/' },
  ]),
];

const featured = testimonials.filter((t) => t.isFeatured);
const all = testimonials;

function formatPublishedDate(date?: string) {
  if (!date) return null;
  return new Intl.DateTimeFormat('en-IN', {
    day: 'numeric',
    month: 'short',
    year: 'numeric',
    timeZone: 'UTC',
  }).format(new Date(`${date}T00:00:00Z`));
}

function getInitials(name: string) {
  return name
    .split(' ')
    .map((n) => n[0])
    .join('')
    .toUpperCase()
    .slice(0, 2);
}

const industries = ['Healthcare', 'Real Estate', 'Hospitality', 'Education', 'Manufacturing', 'Retail', 'NGO', 'Government'];
---

<BaseLayout
  title="Client Testimonials & Reviews - eLan Technology"
  description="Read selected, source-identified client feedback, LinkedIn recommendations and Google reviews for eLan Technology's web design, development and digital marketing work."
  schema={schema}
>

  <!-- ═══════════════════════════════════════════════════════════════════════
       HERO
  ════════════════════════════════════════════════════════════════════════ -->
  <section aria-labelledby="testimonials-hero-heading" class="relative overflow-hidden bg-gradient-to-br from-[var(--bg)] to-[var(--bg-card)] py-24 md:py-32">
    <div aria-hidden="true" class="pointer-events-none absolute inset-0 overflow-hidden">
      <div class="absolute -top-40 left-1/2 -translate-x-1/2 h-[500px] w-[500px] rounded-full bg-[var(--accent)]/6 blur-[120px]"></div>
    </div>

    <div class="relative mx-auto max-w-7xl px-4 sm:px-6 lg:px-8 text-center">
      <div class="mb-6 inline-flex items-center gap-2 rounded-full border border-[var(--border)] bg-[var(--bg-card)]/60 px-4 py-2 text-sm text-[var(--text-muted)] backdrop-blur-sm">
        <span class="h-2 w-2 rounded-full bg-[var(--accent)] animate-pulse" aria-hidden="true"></span>
        Selected, source-identified feedback
      </div>

      <h1
        id="testimonials-hero-heading"
        class="font-heading text-4xl sm:text-5xl font-bold text-[var(--text)] mb-6"
      >
        What Our Clients Say
      </h1>
      <p class="mx-auto max-w-2xl text-lg text-[var(--text-dim)] leading-relaxed mb-4">
        Client feedback, LinkedIn recommendations and public Google reviews. Names are abbreviated for privacy, and each item identifies its source.
      </p>
    </div>
  </section>

  <section aria-labelledby="review-publication-heading" class="bg-[var(--bg)] pb-6">
    <div class="mx-auto max-w-5xl px-4 sm:px-6 lg:px-8">
      <div class="review-publication-card overflow-hidden rounded-3xl border border-[var(--border)] bg-[var(--bg-card)] shadow-sm">
        <div class="grid gap-6 p-6 md:grid-cols-[minmax(0,.85fr)_minmax(0,1.5fr)] md:p-8">
          <div>
            <p class="text-xs font-bold uppercase tracking-[0.18em] text-[var(--accent)]">Review publication</p>
            <h2 id="review-publication-heading" class="mt-2 font-heading text-2xl font-black text-[var(--text)]">Real feedback, clearly attributed</h2>
            <p class="mt-3 text-sm leading-relaxed text-[var(--text-dim)]">We publish only the professional context needed to understand the feedback.</p>
          </div>
          <div class="grid gap-3 text-sm leading-relaxed text-[var(--text-muted)] sm:grid-cols-2">
            <p><strong class="text-[var(--text)]">Identity:</strong> names are shortened by default. A full professional name appears only when that attribution was supplied for publication.</p>
            <p><strong class="text-[var(--text)]">Wording:</strong> recommendations may be lightly edited for length, spelling and clarity without intentionally changing their meaning.</p>
            <p><strong class="text-[var(--text)]">Source:</strong> every item is labelled as direct feedback, a LinkedIn recommendation or a public Google review. Available original publication dates are shown.</p>
            <p><strong class="text-[var(--text)]">Results:</strong> any outcome described is that client’s experience, has not been independently audited by us and is not a promise of similar results.</p>
          </div>
        </div>
        <div class="flex flex-col gap-2 border-t border-[var(--border)] bg-[var(--bg)]/70 px-6 py-4 text-xs leading-relaxed text-[var(--text-muted)] sm:flex-row sm:items-center sm:justify-between md:px-8">
          <p>Featured here and want an attribution corrected, shortened or removed?</p>
          <a href="mailto:privacy@elan-tech.net?subject=Testimonial%20correction%20or%20removal%20request" class="font-bold text-[var(--text)] underline decoration-[var(--accent)] underline-offset-4">Write to privacy@elan-tech.net</a>
        </div>
      </div>
    </div>
  </section>

  <!-- ═══════════════════════════════════════════════════════════════════════
       FEATURED TESTIMONIALS
  ════════════════════════════════════════════════════════════════════════ -->
  <section aria-labelledby="featured-testimonials-heading" class="bg-[var(--bg)] py-16 md:py-20">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
      <p class="text-center text-sm font-semibold uppercase tracking-widest text-[var(--accent)] mb-3">Featured</p>
      <h2 id="featured-testimonials-heading" class="font-heading text-2xl sm:text-3xl font-bold text-[var(--text)] text-center mb-12">
        Stories That Stand Out
      </h2>

      <div class="grid grid-cols-1 lg:grid-cols-3 gap-8">
        {featured.map((t) => (
          <blockquote class="rounded-2xl border border-[var(--border)] bg-[var(--bg-card)] p-8 flex flex-col">
            {t.rating ? (
              <div class="flex gap-0.5 mb-6" role="img" aria-label={`${t.rating} out of 5 stars`}>
                {Array.from({ length: t.rating }).map(() => (
                  <span class="text-[var(--accent)] text-lg" aria-hidden="true">★</span>
                ))}
              </div>
            ) : (
              <p class="mb-6 text-xs font-bold uppercase tracking-wider text-[var(--accent)]">{t.source}</p>
            )}
            <p class="text-base italic text-[var(--text)] mb-6 flex-1 leading-relaxed">"{t.quote}"</p>
            <footer class="flex items-center gap-4">
              <div
                class="w-12 h-12 rounded-full bg-[var(--accent)]/20 flex items-center justify-center font-bold text-[var(--accent)] shrink-0"
                aria-hidden="true"
              >
                {getInitials(t.author)}
              </div>
              <div class="min-w-0">
                <cite class="font-semibold text-[var(--text)] not-italic block truncate">{t.author}</cite>
                <p class="text-sm text-[var(--text-muted)] truncate">{t.role}, {t.company}</p>
                <p class="mt-1 text-xs font-semibold text-[var(--accent)]">{t.source}</p>
                {t.datePublished && <p class="mt-0.5 text-[11px] text-[var(--text-muted)]">Published {formatPublishedDate(t.datePublished)}</p>}
              </div>
            </footer>
          </blockquote>
        ))}
      </div>
    </div>
  </section>


  <!-- ═══════════════════════════════════════════════════════════════════════
       ALL TESTIMONIALS GRID
  ════════════════════════════════════════════════════════════════════════ -->
  <section aria-labelledby="all-testimonials-heading" class="bg-[var(--bg-card)] py-16 md:py-20 border-y border-[var(--border)]">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
      <p class="text-center text-sm font-semibold uppercase tracking-widest text-[var(--accent)] mb-3">All Reviews</p>
      <h2 id="all-testimonials-heading" class="font-heading text-2xl sm:text-3xl font-bold text-[var(--text)] text-center mb-12">
        More Happy Clients
      </h2>

      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-4">
        {all.map((t) => (
          <blockquote class="rounded-2xl border border-[var(--border)] bg-[var(--bg)] p-6 flex flex-col">
            <div class="flex items-center gap-3 mb-4">
              <div
                class="w-10 h-10 rounded-full bg-[var(--accent)]/20 flex items-center justify-center font-bold text-[var(--accent)] text-sm shrink-0"
                aria-hidden="true"
              >
                {getInitials(t.author)}
              </div>
              <div class="min-w-0">
                <cite class="font-semibold text-[var(--text)] not-italic text-sm block truncate">{t.author}</cite>
                <p class="text-xs text-[var(--text-muted)] truncate">{t.role}, {t.company}</p>
              </div>
              {t.rating ? (
                <div class="ml-auto flex gap-0.5 shrink-0" role="img" aria-label={`${t.rating} stars`}>
                  {Array.from({ length: t.rating }).map(() => (
                    <span class="text-[var(--accent)] text-sm" aria-hidden="true">★</span>
                  ))}
                </div>
              ) : (
                <span class="ml-auto text-[10px] font-bold uppercase tracking-wide text-[var(--accent)]">LinkedIn</span>
              )}
            </div>
            <p class="text-sm text-[var(--text-dim)] leading-relaxed flex-1">"{t.quote}"</p>
            <p class="mt-3 text-xs text-[var(--text-muted)] font-medium">{t.industry}</p>
            <p class="mt-1 text-xs font-semibold text-[var(--accent)]">Source: {t.source}</p>
            {t.datePublished && <p class="mt-1 text-[11px] text-[var(--text-muted)]">Published {formatPublishedDate(t.datePublished)}</p>}
          </blockquote>
        ))}
      </div>
    </div>
  </section>


  <!-- ═══════════════════════════════════════════════════════════════════════
       INDUSTRIES SERVED
  ════════════════════════════════════════════════════════════════════════ -->
  <section aria-labelledby="industries-heading" class="bg-[var(--bg)] py-16 md:py-20">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8 text-center">
      <p class="text-sm font-semibold uppercase tracking-widest text-[var(--accent)] mb-3">Our Clients Come From</p>
      <h2 id="industries-heading" class="font-heading text-2xl sm:text-3xl font-bold text-[var(--text)] mb-8">
        Industries We Serve
      </h2>
      <div class="flex flex-wrap justify-center gap-3">
        {industries.map((industry) => (
          <span class="rounded-full border border-[var(--border)] bg-[var(--bg-card)] px-5 py-2 text-sm font-medium text-[var(--text-dim)] hover:border-[var(--accent)] hover:text-[var(--accent)] transition-colors cursor-default">
            {industry}
          </span>
        ))}
      </div>
    </div>
  </section>


  <!-- ═══════════════════════════════════════════════════════════════════════
       CTA
  ════════════════════════════════════════════════════════════════════════ -->
  <section aria-labelledby="testimonials-cta-heading" class="bg-[var(--bg-card)] py-16 md:py-20 border-t border-[var(--border)]">
    <div class="mx-auto max-w-3xl px-4 sm:px-6 lg:px-8 text-center">
      <h2 id="testimonials-cta-heading" class="font-heading text-3xl sm:text-4xl font-bold text-[var(--text)] mb-4">
        Start a Conversation About Your Project
      </h2>
      <p class="text-lg text-[var(--text-dim)] mb-8 leading-relaxed">
        Share what you need, and we will recommend a practical scope with clear responsibilities and commercial terms.
      </p>
      <a
        href="/get-quote/"
        class="inline-flex items-center gap-2 rounded-full bg-[var(--accent)] px-8 py-4 text-base font-semibold text-[var(--bg)] shadow-lg shadow-[var(--accent)]/25 transition-all duration-300 hover:brightness-110 hover:-translate-y-0.5"
      >
        Get a Free Quote
        <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
      </a>
    </div>
  </section>

</BaseLayout>
