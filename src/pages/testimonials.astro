---
import BaseLayout from '../layouts/BaseLayout.astro';
import { testimonials, type Testimonial } from '../data/testimonials';
import { breadcrumbSchema } from '../utils/schema';

const schema = [
  breadcrumbSchema([
    { name: 'Home', url: '/' },
    { name: 'Testimonials', url: '/testimonials/' },
  ]),
];

// Featured reviews lead in a 2x2 grid; every other review appears once, below. Kedar A. first (newest).
const featured = [...testimonials.filter((t) => t.isFeatured)].sort((a, b) => (b.datePublished ?? '').localeCompare(a.datePublished ?? '')).slice(0, 4);
const rest = testimonials.filter((t) => !featured.includes(t));

const sourceKey = (t: Testimonial) => (t.source === 'Google review' ? 'google' : t.source === 'LinkedIn recommendation' ? 'linkedin' : 'client');
const sourceLabel = { google: 'Google review', linkedin: 'LinkedIn', client: 'Client feedback' } as const;
const counts = {
  all: testimonials.length,
  google: testimonials.filter((t) => sourceKey(t) === 'google').length,
  linkedin: testimonials.filter((t) => sourceKey(t) === 'linkedin').length,
  client: testimonials.filter((t) => sourceKey(t) === 'client').length,
};
const industries = [...new Set(testimonials.map((t) => t.industry))].sort();

function formatPublishedDate(date?: string) {
  if (!date) return null;
  return new Intl.DateTimeFormat('en-IN', { day: 'numeric', month: 'short', year: 'numeric', timeZone: 'UTC' }).format(new Date(`${date}T00:00:00Z`));
}
const initials = (name: string) => name.replace(/\./g, '').split(/\s+/).filter(Boolean).slice(0, 2).map((w) => w[0]).join('').toUpperCase();
---

<BaseLayout
  title="Client Testimonials & Reviews - eLan Technology"
  description="Read selected, source-identified client feedback, LinkedIn recommendations and Google reviews for eLan Technology's web design, development and digital marketing work."
  schema={schema}
>
  <!-- Hero with review counts -->
  <section aria-labelledby="testimonials-hero-heading" class="relative overflow-hidden border-b border-[var(--border)] bg-gradient-to-br from-[var(--bg)] to-[var(--bg-card)] py-14 md:py-20">
    <div class="relative mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
      <div class="grid gap-8 lg:grid-cols-[1.2fr_1fr] lg:items-end">
        <div>
          <p class="text-xs font-bold uppercase tracking-[0.18em] text-[var(--accent)]">Selected, source-identified feedback</p>
          <h1 id="testimonials-hero-heading" class="mt-3 font-heading text-4xl font-bold text-[var(--text)] sm:text-5xl">What Our Clients Say</h1>
          <p class="mt-4 max-w-2xl text-lg leading-relaxed text-[var(--text-dim)]">Client feedback, LinkedIn recommendations and public Google reviews from businesses in India, the USA, Canada and beyond. Names are abbreviated for privacy, and each review shows its source.</p>
        </div>
        <dl class="grid grid-cols-2 gap-3 sm:grid-cols-4 lg:grid-cols-2">
          <div class="stat"><dt>Reviews</dt><dd>{counts.all}</dd></div>
          <div class="stat"><dt>Google</dt><dd>{counts.google}</dd></div>
          <div class="stat"><dt>LinkedIn</dt><dd>{counts.linkedin}</dd></div>
          <div class="stat"><dt>Direct feedback</dt><dd>{counts.client}</dd></div>
        </dl>
      </div>
    </div>
  </section>

  <!-- Featured: 2x2 -->
  <section aria-labelledby="featured-testimonials-heading" class="py-14 md:py-20">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
      <p class="text-xs font-bold uppercase tracking-[0.18em] text-[var(--accent)]">Featured</p>
      <h2 id="featured-testimonials-heading" class="mt-2 font-heading text-3xl font-bold text-[var(--text)]">Stories That Stand Out</h2>
      <div class="mt-8 grid gap-4 md:grid-cols-2">
        {featured.map((t) => (
          <figure class="feature service-card relative overflow-hidden rounded-xl border border-[var(--border)] p-7">
            <span aria-hidden="true" class="service-card__stripe pointer-events-none absolute -bottom-10 -left-10 h-40 w-40 rotate-[-20deg] opacity-[0.07]" style="background: var(--ac-indigo);"></span>
            <svg class="mark relative" viewBox="0 0 32 24" aria-hidden="true"><path d="M0 24V14C0 6 4.5 1.2 12 0l1.3 3.4C8.8 4.9 6.7 8 6.6 12H12v12H0Zm19 0V14c0-8 4.5-12.8 12-14l1 3.4C27.8 4.9 25.7 8 25.6 12H31v12H19Z" fill="currentColor"/></svg>
            <blockquote class="relative mt-4 text-lg leading-relaxed text-[var(--text)]">{t.quote}</blockquote>
            <figcaption class="relative mt-6 flex items-center gap-3 border-t border-[var(--border)] pt-5">
              <span class="avatar" aria-hidden="true">{initials(t.author)}</span>
              <span class="min-w-0">
                <span class="block font-bold text-[var(--text)]">{t.author}</span>
                <span class="block text-sm text-[var(--text-muted)]">{t.role}, {t.company}</span>
              </span>
              <span class="ml-auto text-right">
                <span class:list={['src', `src-${sourceKey(t)}`]}>{sourceLabel[sourceKey(t)]}</span>
                {t.datePublished && <span class="mt-1 block text-[11px] text-[var(--text-muted)]">{formatPublishedDate(t.datePublished)}</span>}
              </span>
            </figcaption>
          </figure>
        ))}
      </div>
    </div>
  </section>

  <!-- All other reviews, filterable by source (pure CSS radio filter, no script) -->
  <section aria-labelledby="all-testimonials-heading" class="border-y border-[var(--border)] bg-[var(--bg-card)] py-14 md:py-20">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
      <div class="flex flex-col gap-4 md:flex-row md:items-end md:justify-between">
        <div>
          <p class="text-xs font-bold uppercase tracking-[0.18em] text-[var(--accent)]">All reviews</p>
          <h2 id="all-testimonials-heading" class="mt-2 font-heading text-3xl font-bold text-[var(--text)]">More Happy Clients</h2>
        </div>
      </div>

      <div class="reviews-filter mt-6">
        <fieldset class="filters">
          <legend class="sr-only">Show reviews from</legend>
          <input type="radio" name="review-source" id="f-all" value="all" checked /><label for="f-all">All</label>
          <input type="radio" name="review-source" id="f-google" value="google" /><label for="f-google">Google</label>
          <input type="radio" name="review-source" id="f-linkedin" value="linkedin" /><label for="f-linkedin">LinkedIn</label>
          <input type="radio" name="review-source" id="f-client" value="client" /><label for="f-client">Client feedback</label>
        </fieldset>

        <ul class="masonry mt-6" role="list">
          {rest.map((t) => (
            <li class="review" data-source={sourceKey(t)}>
              <figure class="rounded-xl border border-[var(--border)] bg-[var(--bg)] p-5">
                <figcaption class="flex items-center gap-3">
                  <span class="avatar avatar-sm" aria-hidden="true">{initials(t.author)}</span>
                  <span class="min-w-0">
                    <span class="block truncate text-sm font-bold text-[var(--text)]">{t.author}</span>
                    <span class="block truncate text-xs text-[var(--text-muted)]">{t.role}, {t.company}</span>
                  </span>
                  {t.rating ? (
                    <span class="ml-auto shrink-0 text-sm tracking-tight text-amber-500" role="img" aria-label={`${t.rating} out of 5 stars`}>{'★'.repeat(t.rating)}</span>
                  ) : null}
                </figcaption>
                <blockquote class="mt-4 text-sm leading-relaxed text-[var(--text-dim)]">{t.quote}</blockquote>
                <p class="mt-4 flex flex-wrap items-center gap-x-2 gap-y-1 text-xs text-[var(--text-muted)]">
                  <span class:list={['src', `src-${sourceKey(t)}`]}>{sourceLabel[sourceKey(t)]}</span>
                  <span>{t.industry}</span>
                  {t.datePublished && <span>· {formatPublishedDate(t.datePublished)}</span>}
                </p>
              </figure>
            </li>
          ))}
        </ul>
      </div>

      <details class="policy mt-10 rounded-xl border border-[var(--border)] bg-[var(--bg)]">
        <summary class="flex cursor-pointer list-none items-center justify-between gap-4 px-5 py-4 text-sm font-semibold text-[var(--text)]">
          How we publish reviews
          <svg class="chev shrink-0 text-[var(--text-muted)]" xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polyline points="6 9 12 15 18 9"/></svg>
        </summary>
        <div class="grid gap-3 border-t border-[var(--border)] px-5 py-4 text-sm leading-relaxed text-[var(--text-muted)] sm:grid-cols-2">
          <p><strong class="text-[var(--text)]">Identity:</strong> names are shortened by default. A full professional name appears only when that attribution was supplied for publication.</p>
          <p><strong class="text-[var(--text)]">Wording:</strong> recommendations may be lightly edited for length, spelling and clarity without intentionally changing their meaning. Google reviews are shown as written.</p>
          <p><strong class="text-[var(--text)]">Source:</strong> every item is labelled as direct feedback, a LinkedIn recommendation or a public Google review. Available original publication dates are shown.</p>
          <p><strong class="text-[var(--text)]">Results:</strong> any outcome described is that client’s experience, has not been independently audited by us and is not a promise of similar results.</p>
          <p class="sm:col-span-2">Featured here and want an attribution corrected, shortened or removed? <a href="mailto:privacy@elan-tech.net?subject=Testimonial%20correction%20or%20removal%20request" class="font-semibold text-[var(--text)] underline decoration-[var(--accent)] underline-offset-4">Write to privacy@elan-tech.net</a></p>
        </div>
      </details>
    </div>
  </section>

  <!-- CTA with the industries behind these reviews -->
  <section aria-labelledby="testimonials-cta-heading" class="py-14 md:py-20">
    <div class="mx-auto max-w-3xl px-4 text-center sm:px-6 lg:px-8">
      <h2 id="testimonials-cta-heading" class="font-heading text-3xl font-bold text-[var(--text)] sm:text-4xl">Start a Conversation About Your Project</h2>
      <p class="mt-4 text-lg leading-relaxed text-[var(--text-dim)]">Share what you need, and we will recommend a practical scope with clear responsibilities and commercial terms.</p>
      <div class="mt-7 flex flex-wrap justify-center gap-3">
        <a href="/get-quote/" class="inline-flex min-h-11 items-center gap-2 rounded-lg bg-[var(--accent)] px-6 py-3 font-semibold text-white transition hover:brightness-110">Get a Quote <span aria-hidden="true">→</span></a>
        <a href="/portfolio/" class="inline-flex min-h-11 items-center rounded-lg border border-[var(--border)] px-6 py-3 font-semibold text-[var(--text)] transition hover:border-[var(--accent)]">See the portfolio</a>
      </div>
      <p class="mt-10 text-xs font-bold uppercase tracking-[0.18em] text-[var(--text-muted)]">Reviews from clients in</p>
      <ul class="mt-3 flex flex-wrap justify-center gap-2" role="list">
        {industries.map((industry) => (
          <li class="rounded-md border border-[var(--border)] bg-[var(--bg-card)] px-3 py-1.5 text-sm text-[var(--text-dim)]">{industry}</li>
        ))}
      </ul>
    </div>
  </section>
</BaseLayout>

<style>
  .stat { border: 1px solid var(--border); border-radius: var(--radius-xl); background: var(--bg-card); padding: .9rem 1rem; }
  .stat dt { font-size: .7rem; font-weight: 700; text-transform: uppercase; letter-spacing: .14em; color: var(--text-muted); }
  .stat dd { margin-top: .2rem; font-family: var(--font-heading); font-size: 2rem; font-weight: 800; color: var(--text); }
  .feature { background: linear-gradient(135deg, color-mix(in srgb, var(--ac-indigo) 8%, var(--bg-card)) 0%, var(--bg-card) 65%); }
  .mark { width: 2rem; height: 1.5rem; color: #6366f1; opacity: .5; }
  .avatar { display: grid; place-items: center; width: 2.75rem; height: 2.75rem; flex-shrink: 0; border-radius: 999px; font-size: .85rem; font-weight: 800; color: #fff; background: linear-gradient(135deg, #4f46e5, #7c3aed); }
  .avatar-sm { width: 2.25rem; height: 2.25rem; font-size: .75rem; }
  .src { display: inline-block; border-radius: var(--radius-md); padding: .15rem .5rem; font-size: .68rem; font-weight: 700; letter-spacing: .04em; text-transform: uppercase; }
  .src-google { background: color-mix(in srgb, #ea4335 12%, transparent); color: #b3261e; }
  .src-linkedin { background: color-mix(in srgb, #0a66c2 12%, transparent); color: #0a66c2; }
  .src-client { background: color-mix(in srgb, var(--accent) 12%, transparent); color: var(--accent); }
  :global(.dark) .src-google { color: #f28b82; } :global(.dark) .src-linkedin { color: #70b5f9; }

  .filters { display: flex; flex-wrap: wrap; gap: .5rem; border: 0; padding: 0; margin: 0; }
  .filters input { position: absolute; opacity: 0; pointer-events: none; }
  .filters label { cursor: pointer; border: 1px solid var(--border); border-radius: var(--radius-lg); background: var(--bg); padding: .45rem .9rem; font-size: .85rem; font-weight: 600; color: var(--text-dim); transition: border-color .2s, color .2s, background .2s; }
  .filters input:checked + label { border-color: var(--accent); color: var(--text); background: color-mix(in srgb, var(--accent) 10%, var(--bg)); }
  .filters input:focus-visible + label { outline: 2px solid var(--accent); outline-offset: 2px; }
  .reviews-filter:has(#f-google:checked) .review:not([data-source="google"]),
  .reviews-filter:has(#f-linkedin:checked) .review:not([data-source="linkedin"]),
  .reviews-filter:has(#f-client:checked) .review:not([data-source="client"]) { display: none; }

  .masonry { columns: 3 18rem; column-gap: 1rem; }
  .review { break-inside: avoid; margin-bottom: 1rem; }
  .policy[open] .chev { transform: rotate(180deg); }
  .chev { transition: transform .2s; }
</style>
