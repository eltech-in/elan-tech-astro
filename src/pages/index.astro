---
import BaseLayout from '../layouts/BaseLayout.astro';
import BentoHero from '../components/home/BentoHero.astro';
import HomeServices from '../components/home/HomeServices.astro';
import HomeProductGrid from '../components/home/HomeProductGrid.astro';
import StartHere from '../components/home/StartHere.astro';
import HomeTestimonials from '../components/home/HomeTestimonials.astro';
import { faqs } from '../data/faq';
import { indexedCities } from '../data/cities';
import { indexedCountries } from '../data/countries';
import { webSiteSchema, organizationSchema, localBusinessSchema, faqSchema, breadcrumbSchema, speakableSchema } from '../utils/schema';
import ProjectCarousel from '../components/ProjectCarousel.astro';
import { Image } from 'astro:assets';
import { getClientLogo } from '../lib/images';
import TechStackCarousel from '../components/TechStackCarousel.astro';
import { getCollection } from 'astro:content';
import { isPublishedPost } from '../utils/blog';
import { COMPANY } from '../data/company';
import ScrollProgressRail from '../components/ScrollProgressRail.astro';
import { homepageSeoBaseline } from '../data/seoStability';

// Data prep
const homeFaqs = faqs.filter(f => f.category === 'general').slice(0, 5);
const latestPosts = (await getCollection('blog', ({ data }) => isPublishedPost(data)))
  .sort((a, b) => b.data.publishDate.valueOf() - a.data.publishDate.valueOf())
  .slice(0, 3);
// Only indexable location pages are linked from the homepage (see
// src/data/indexPolicy.ts). De-indexed city and country pages stay reachable
// by URL but are not promoted here.
const featuredCities = indexedCities;
const featuredCountries = indexedCountries;

// Emoji flag helper - converts ISO 3166-1 alpha-2 code to flag emoji
const flagEmoji = (code: string) =>
  [...code.toUpperCase()].map(c => String.fromCodePoint(c.charCodeAt(0) + 127397)).join('');

// Schemas
const schemas = [
  webSiteSchema(),
  organizationSchema(),
  localBusinessSchema('Nagpur'),
  faqSchema(homeFaqs),
  breadcrumbSchema([{ name: 'Home', url: '/' }]),
  // AEO: tell answer engines which DOM regions to lift for voice / featured snippets
  speakableSchema('/', ['h1', '[data-speakable]', '.faq-answer']),
];


// Derives a per-logo alt string from its filename so the client-logo carousel
// doesn't repeat generic "Client logo" 100+ times. Filenames carry the real
// client name; this just turns hyphens into spaces for readable alt text.
function logoAlt(filename: string): string {
  const stem = filename
    .replace(/\.(avif|svg|webp|png|jpe?g)$/i, '')
    .replace(/^cl-/i, '')
    .replace(/-logo$/i, '');
  const words = stem.split(/[-_]/).filter(Boolean).map((w) => w.charAt(0).toUpperCase() + w.slice(1));
  return `${words.join(' ')} - eLan Technology client`;
}
---

<BaseLayout
  title={homepageSeoBaseline.title}
  description={homepageSeoBaseline.description}
  schema={schemas}
>

  <!-- Scroll progress rail (decorative, desktop-only) -->
  <ScrollProgressRail />

  <!-- 1. Hero (bento grid; H1 wording frozen until the 10 Dec 2026 SEO review) -->
  <BentoHero />

  <!-- 2. Clients and technology -->
  <section aria-labelledby="clients-heading" class="relative overflow-hidden bg-[var(--bg)] pt-10 md:pt-14">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8 mb-8 text-center">
      <h2
        id="clients-heading"
        class="font-heading text-2xl sm:text-3xl font-bold text-[var(--text)] mb-2"
      >
        Trusted by Businesses Across India &amp; Worldwide
      </h2>
      <p class="text-base text-[var(--text-dim)] max-w-2xl mx-auto">
        From local Nagpur enterprises to international organisations
      </p>
    </div>

    <!-- Scrolling carousel track (logos duplicated for seamless loop) -->
    <div class="relative w-full" aria-hidden="true">
      <!-- Edge fades -->
      <div class="pointer-events-none absolute inset-y-0 left-0 z-10 w-24 md:w-40 bg-gradient-to-r from-[var(--bg)] to-transparent"></div>
      <div class="pointer-events-none absolute inset-y-0 right-0 z-10 w-24 md:w-40 bg-gradient-to-l from-[var(--bg)] to-transparent"></div>

      <div class="flex w-fit animate-scroll-ltr items-center">
        {(() => {
          const logos = [
            'Phoenix-Luminaries.avif', '6simplex.avif', '77mishti-packaging.avif', 'Aarch-Meraki.svg', 'Abhirama.svg',
            'Alessandra-Ramos.avif', 'Astha-Hospital.avif', 'Avani-Associates.avif', 'Bakre-Associates.svg',
            'Blue-Ladder.avif', 'CBBF.avif', 'Cambian.avif', 'Chandak-Instruments.avif',
            'DFyne.avif', 'Geo-Spatial-Studio.avif', 'GlenEGrant.avif', 'Guru-Nanak-College.avif',
            'IAPM.avif', 'IFBB-Elite-PRO.avif', 'ISA-Nagpur.avif', 'Indo-Advisors.avif',
            'Mahavir-Mevawala.avif', 'Ontario-Amateur-Fitness-Association.avif', 'Opthalmological-Society-Nagpur.avif', 'PM-Industries.avif',
            'Pinakk-Digital-Media.svg', 'Pradnyalok.avif', 'Production-Modeling-India.avif', 'PropertyCab.avif',
            'Psychiatric-Society-Nagpur.avif', 'healthy-genie.avif', 'SS-Carmen.avif', 'Sakhi-Products.avif',
            'Silaris.avif', 'The-Material-Palette.svg', 'The-Natural-Farms.avif', 'The-People.avif',
            'YogForYourself.avif', 'ZestRenew.avif', 'abc-wiindo.svg', 'brandear.avif',
            'Rushmore-Group.avif', 'deetya-allaboutinteriors.svg', 'dizviz.avif', 'elite-wealth.avif',
            'eminent-tech.avif', 'gokhale-insurance.svg', 'hotel-manomay-homes.avif', 'icon-hospital.avif',
            'jpdata.avif', 'lotus-care-exim.svg', 'media-flow-house.svg', 'merraki-expert.svg',
            'msmehub.svg', 'navsamaj.avif', 'new-earth-infra.svg', 'nexus-cowork.svg',
            'patel-rcm-analytics.svg', 'rangresha.avif', 'shrikrupa-prakashan.avif', 'Swami-Vivekanand.avif',
            'team-agrotech.avif', 'the-core-pench.avif', 'the-free-media.avif', 'trimit-architects.avif',
            'vasundhara-pariwar.avif', 'we4change.avif', 'yashoda-maternity.avif',
          ];
          return [...logos, ...logos].map((logo) => (
            <div class="mx-2 flex h-16 w-36 shrink-0 items-center justify-center px-3 py-2 opacity-90 transition-opacity duration-300 hover:opacity-100 md:mx-3 md:h-[4.5rem] md:w-44 md:px-4">
              <Image
                src={getClientLogo(`/elan-client-logos/${logo}`)}
                alt={logoAlt(logo)}
                width={180}
                format={getClientLogo(`/elan-client-logos/${logo}`).format === 'svg' ? undefined : 'avif'}
                loading="lazy"
                decoding="async"
                class="block h-auto max-h-full w-auto max-w-full object-contain"
              />
            </div>
          ));
        })()}
      </div>
    </div>
  </section>
  <TechStackCarousel compact />

  <!-- 3. Recent work -->
  <ProjectCarousel />

  <!-- 4. Services (compact; full detail on each service page) -->
  <HomeServices />

  <!-- 5. Products (compact; screens and demos on each product page) -->
  <HomeProductGrid />

  <!-- 6. Start here: audit, booking advance, quote -->
  <StartHere />

  <!-- 7. Testimonials (open row of quote cards) -->
  <HomeTestimonials />

  <!-- 8. FAQ (5 questions; FAQPage schema uses the same list) -->
  <section aria-labelledby="faq-heading" class="bg-[var(--bg)] py-14 md:py-20" style="content-visibility:auto;contain-intrinsic-size:auto 500px">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
      <h2
        id="faq-heading"
        class="font-heading text-3xl sm:text-4xl font-bold text-[var(--text)] text-center mb-3"
      >
        Frequently Asked Questions
      </h2>
      <p class="text-lg text-[var(--text-dim)] text-center mb-8 max-w-2xl mx-auto">
        Answers to the most common questions about working with eLan Technology
      </p>

      <div class="mx-auto max-w-3xl space-y-3">
        {homeFaqs.map((faq) => (
          <details
            class="group rounded-xl border border-[var(--border)] bg-[var(--bg-card)] overflow-hidden transition-colors duration-200 hover:border-[var(--accent)]/30"
          >
            <summary
              class="flex cursor-pointer list-none items-center justify-between gap-4 px-6 py-5 font-medium text-[var(--text)] hover:text-[var(--accent)] transition-colors duration-200 focus-visible:outline focus-visible:outline-2 focus-visible:outline-[var(--accent)] focus-visible:outline-offset-2"
            >
              <span>{faq.question}</span>
              <!-- Chevron icon - rotates via CSS when open -->
              <svg
                class="flex-shrink-0 text-[var(--text-muted)] transition-transform duration-200 group-open:rotate-180"
                xmlns="http://www.w3.org/2000/svg"
                width="18"
                height="18"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
                stroke-linecap="round"
                stroke-linejoin="round"
                aria-hidden="true"
              >
                <polyline points="6 9 12 15 18 9"/>
              </svg>
            </summary>
            <div class="border-t border-[var(--border)] px-6 pb-5 pt-4">
              <p class="text-[var(--text-dim)] leading-relaxed text-sm" set:html={faq.answer} />
            </div>
          </details>
        ))}
      </div>
    </div>
  </section>

  <!-- 9. Final call to action, where we serve, latest guides -->
  <section aria-labelledby="final-cta-heading" class="border-t border-[var(--border)] bg-[var(--bg-card)] py-14 md:py-20">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
      <div class="text-center">
        <h2 id="final-cta-heading" class="font-heading text-3xl font-bold text-[var(--text)] sm:text-4xl">Ready to get started?</h2>
        <p class="mx-auto mt-3 max-w-2xl text-[var(--text-dim)]">Tell us about your project, message us on WhatsApp, or book a call. Replies within one business day.</p>
        <div class="mt-7 flex flex-wrap justify-center gap-3">
          <a href="/get-quote/" class="inline-flex min-h-11 items-center rounded-lg bg-[var(--accent)] px-6 py-3 text-sm font-bold text-white transition hover:brightness-110">Request a Quote</a>
          <a href={COMPANY.whatsapp.href} target="_blank" rel="noopener noreferrer" data-analytics-placement="home-final-cta" class="inline-flex min-h-11 items-center rounded-lg border border-[var(--border)] bg-[var(--bg)] px-6 py-3 text-sm font-bold text-[var(--text)] transition hover:border-[var(--accent)]">WhatsApp {COMPANY.whatsapp.display}<span class="sr-only"> (opens in a new tab)</span></a>
          <a href="/schedule-consultation/" class="inline-flex min-h-11 items-center rounded-lg border border-[var(--border)] bg-[var(--bg)] px-6 py-3 text-sm font-bold text-[var(--text)] transition hover:border-[var(--accent)]">Book a Consultation</a>
        </div>
      </div>

      <div class="mt-12 grid gap-8 border-t border-[var(--border)] pt-10 lg:grid-cols-[1.1fr_0.9fr]">
        <div>
          <h3 id="where-we-serve-heading" class="font-heading text-lg font-bold text-[var(--text)]">Local craft, global reach</h3>
          <p class="mt-1 text-sm text-[var(--text-dim)]">Based in Nagpur, delivering remotely for clients across India and abroad.</p>
          <ul class="mt-4 flex flex-wrap gap-2" role="list">
            {featuredCities.map((city) => (
              <li><a href={city.hasLandingPage ? `/web-design-company-${city.slug}/` : '/contact/'} class="inline-flex items-center gap-1.5 rounded-lg border border-[var(--border)] bg-[var(--bg)] px-3.5 py-1.5 text-sm text-[var(--text-dim)] transition hover:border-[var(--accent)] hover:text-[var(--text)]"><span aria-hidden="true">{flagEmoji('IN')}</span>{city.name}</a></li>
            ))}
            {featuredCountries.map((country) => (
              <li><a href={country.hasLandingPage ? `/web-design-company-${country.slug}/` : '/contact/'} class="inline-flex items-center gap-1.5 rounded-lg border border-[var(--border)] bg-[var(--bg)] px-3.5 py-1.5 text-sm text-[var(--text-dim)] transition hover:border-[var(--accent)] hover:text-[var(--text)]"><span aria-hidden="true">{flagEmoji(country.code)}</span>{country.name}</a></li>
            ))}
          </ul>
        </div>
        <div>
          <h3 class="font-heading text-lg font-bold text-[var(--text)]">Latest guides</h3>
          <ul class="mt-4 grid gap-3" role="list">
            {latestPosts.map((post) => (
              <li><a href={`/blog/${post.data.category}/${post.id}/`} class="group block rounded-lg border border-[var(--border)] bg-[var(--bg)] px-4 py-3 transition hover:border-[var(--accent)]"><span class="block text-sm font-semibold text-[var(--text)] group-hover:text-[var(--accent)]">{post.data.title}</span><span class="text-xs text-[var(--text-muted)]">{post.data.publishDate.toLocaleDateString('en-US', { year: 'numeric', month: 'short', day: 'numeric' })}</span></a></li>
            ))}
          </ul>
          <a href="/blog/" class="mt-3 inline-block text-sm font-bold text-[var(--accent)] underline-offset-4 hover:underline">All articles <span aria-hidden="true">→</span></a>
        </div>
      </div>
    </div>
  </section>

</BaseLayout>
