---
// Share page for the BNI Conclave, Raipur (21 November 2026): the video, the interactive
// presentation and a contact card. Not indexed and not in the sitemap; it is shared by link.
// The presentation and video files are in public/bni-raipur/ and are generated by
// outputs/dubai-trip/presentation/build.mjs bni-raipur --site (see PRESENTING.md there).
import BaseLayout from '../layouts/BaseLayout.astro';

const base = '/bni-raipur/';
const video = `${base}elan-bni-raipur-presentation.mp4`;
const poster = `${base}poster.jpg`;
const deck = `${base}presentation/`;
const vcf = `${base}nishant-barde.vcf`;
const whatsapp = 'https://wa.me/918788834630?text=' + encodeURIComponent('Hi Nishant, we connected at the BNI Conclave in Raipur.');

const build = [
  { title: 'Websites', text: 'Clear, fast websites your team can edit.', href: '/services/website-design/', tone: 'from-[#ffb547] to-[#ff6a00] text-[#24100a]' },
  { title: 'Online stores', text: 'Shopify, WooCommerce or Medusa.js, built around your products.', href: '/services/ecommerce/', tone: 'from-[#ff6fb0] to-[#b5179e] text-white' },
  { title: 'Ready-made products', text: 'Insurance, real estate, resort, conference and society portals.', href: '/products/', tone: 'from-[#a78bfa] to-[#4c1d95] text-white' },
  { title: 'Business software', text: 'CRM, ERP and project systems shaped around your team.', href: '/services/custom-crm-erp-solutions/', tone: 'from-[#ffb547] via-[#ff2e88] to-[#7c3aed] text-white' },
];
const refer = [
  ['01', 'Introduce', 'Share this page, or our WhatsApp number, with the business owner.'],
  ['02', 'Talk', 'A short video or phone call to understand what the business needs.'],
  ['03', 'Scope', 'A written proposal, quoted per project, before any work starts.'],
];
---

<BaseLayout
  title="eLan Technology at the BNI Conclave, Raipur: Presentation and Video"
  description="The eLan Technology presentation from the BNI Conclave in Raipur, 21 November 2026: a 100-second video, the interactive presentation and our contact card."
  canonical="/bni-raipur/"
  ogImage="/images/og/bni-raipur.jpg"
  noindex={true}
>
  <section class="relative isolate overflow-hidden bg-[#0a0612] py-12 text-[#fff8f0] sm:py-16" aria-labelledby="bni-title">
    <div aria-hidden="true" class="pointer-events-none absolute inset-0 -z-10">
      <div class="absolute -left-40 -top-40 h-[34rem] w-[34rem] rounded-full bg-[radial-gradient(circle,rgba(255,122,0,.55),transparent_62%)]"></div>
      <div class="absolute -right-40 top-1/3 h-[38rem] w-[38rem] rounded-full bg-[radial-gradient(circle,rgba(255,46,136,.45),transparent_62%)]"></div>
      <div class="absolute -bottom-56 left-1/3 h-[40rem] w-[40rem] rounded-full bg-[radial-gradient(circle,rgba(124,58,237,.55),transparent_62%)]"></div>
    </div>
    <div class="mx-auto max-w-6xl px-4 sm:px-6 lg:px-8">
      <p class="text-xs font-bold uppercase tracking-[.24em] text-[#ffb547]">BNI Conclave · Raipur · 21 November 2026</p>
      <h1 id="bni-title" class="mt-4 max-w-3xl font-heading text-4xl font-extrabold leading-[1.05] tracking-tight sm:text-6xl">
        Thank you for <span class="bg-gradient-to-r from-[#ffc15e] via-[#ff4d9d] to-[#b794ff] bg-clip-text text-transparent">connecting.</span>
      </h1>
      <p class="mt-5 max-w-2xl text-lg leading-relaxed text-[#fff4e6]/80">
        Here is our presentation from the conclave. Websites, online stores and business software, built in Nagpur since 2002 and delivered to businesses in Raipur and beyond.
      </p>
      <p class="mt-3 text-base font-semibold text-[#fff4e6]/90" lang="hi">आपसे मिलकर खुशी हुई</p>

      <div class="mt-8 overflow-hidden rounded-3xl bg-black shadow-[0_30px_80px_-20px_rgba(0,0,0,.7)] ring-1 ring-white/15">
        <video class="block aspect-video w-full" controls playsinline preload="metadata" poster={poster}>
          <source src={video} type="video/mp4" />
          <a href={video}>Download the video (MP4)</a>
        </video>
      </div>

      <div class="mt-6 grid gap-3 sm:grid-cols-2 lg:grid-cols-[1.5fr_1fr_1.2fr_1fr]">
        <a href={deck} target="_blank" rel="noopener" class="inline-flex min-h-[3.25rem] items-center justify-center rounded-full bg-gradient-to-r from-[#ffb547] via-[#ff6a00] to-[#ff2e88] px-6 font-bold text-[#1b0710] transition hover:brightness-110 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-white">
          Open the interactive presentation ↗
        </a>
        <a href={vcf} download="Nishant-Barde-eLan-Technology.vcf" class="inline-flex min-h-[3.25rem] items-center justify-center rounded-full border border-white/25 bg-white/10 px-6 font-semibold transition hover:bg-white/20 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-white">
          Save our contact
        </a>
        <a href={whatsapp} target="_blank" rel="noopener" data-analytics-placement="bni-raipur" class="inline-flex min-h-[3.25rem] items-center justify-center rounded-full border border-white/25 bg-white/10 px-6 font-semibold transition hover:bg-white/20 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-white">
          Message us on WhatsApp
        </a>
        <button type="button" id="bni-share" class="inline-flex min-h-[3.25rem] items-center justify-center rounded-full border border-white/25 bg-white/10 px-6 font-semibold transition hover:bg-white/20 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-white">
          Share this page
        </button>
      </div>
      <p id="bni-share-status" class="mt-3 min-h-[1.5rem] text-sm text-[#fff4e6]/75" role="status" aria-live="polite"></p>
    </div>
  </section>

  <section class="border-b border-[var(--border)] bg-[var(--bg)] py-14 sm:py-16" aria-labelledby="bni-build">
    <div class="mx-auto max-w-6xl px-4 sm:px-6 lg:px-8">
      <p class="text-xs font-bold uppercase tracking-widest text-[var(--accent)]">What we build</p>
      <h2 id="bni-build" class="mt-3 font-heading text-3xl font-bold text-[var(--text)] sm:text-4xl">From your first website to the software your team runs on</h2>
      <ul class="mt-8 grid gap-4 sm:grid-cols-2 lg:grid-cols-4" role="list">
        {build.map((item) => (
          <li>
            <a href={item.href} class={`flex h-full min-h-[12rem] flex-col rounded-3xl bg-gradient-to-br p-6 shadow-lg transition hover:-translate-y-1 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-[var(--accent)] ${item.tone}`}>
              <span class="font-heading text-2xl font-bold">{item.title}</span>
              <span class="mt-auto pt-6 text-sm leading-relaxed opacity-90">{item.text}</span>
            </a>
          </li>
        ))}
      </ul>
      <p class="mt-6 text-sm text-[var(--text-dim)]">Every project is quoted per project. See our <a href="/portfolio/" class="font-semibold text-[var(--accent)] underline underline-offset-2">portfolio</a> and the <a href="/technologies/" class="font-semibold text-[var(--accent)] underline underline-offset-2">technologies we build with</a>.</p>
    </div>
  </section>

  <section class="bg-[var(--bg-card)] py-14 sm:py-16" aria-labelledby="bni-refer">
    <div class="mx-auto max-w-6xl px-4 sm:px-6 lg:px-8">
      <p class="text-xs font-bold uppercase tracking-widest text-[var(--accent)]">How to refer us</p>
      <h2 id="bni-refer" class="mt-3 font-heading text-3xl font-bold text-[var(--text)] sm:text-4xl">Know a business owner who needs a website, a store or software?</h2>
      <ol class="mt-8 grid gap-4 md:grid-cols-3" role="list">
        {refer.map(([n, title, text]) => (
          <li class="rounded-3xl border border-[var(--border)] bg-[var(--bg)] p-6">
            <span class="font-heading text-4xl font-extrabold text-[var(--accent)]">{n}</span>
            <h3 class="mt-4 font-heading text-xl font-bold text-[var(--text)]">{title}</h3>
            <p class="mt-2 text-[var(--text-dim)]">{text}</p>
          </li>
        ))}
      </ol>
      <p class="mt-6 text-sm text-[var(--text-dim)]">Nagpur is 285 km from Raipur. Raipur projects use video discovery, shared design reviews, written approvals and project tracking.</p>
    </div>
  </section>

  <script is:inline>
    (function () {
      var button = document.getElementById('bni-share');
      var status = document.getElementById('bni-share-status');
      if (!button || !status) return;
      var url = location.origin + '/bni-raipur/';
      button.addEventListener('click', function () {
        var data = { title: 'eLan Technology at the BNI Conclave, Raipur', text: 'Our 100-second presentation from the BNI Conclave, Raipur.', url: url };
        if (navigator.share) {
          navigator.share(data).catch(function () {});
          return;
        }
        if (navigator.clipboard && navigator.clipboard.writeText) {
          navigator.clipboard.writeText(url).then(function () { status.textContent = 'Link copied: ' + url; }, function () { status.textContent = url; });
        } else {
          status.textContent = url;
        }
      });
    })();
  </script>
</BaseLayout>
