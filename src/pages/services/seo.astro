---
import ServiceLayout from '../../layouts/ServiceLayout.astro';
import ServicePage from '../../components/service/ServicePage.astro';
import ServiceExplainer from '../../components/service/ServiceExplainer.astro';
import { services } from '../../data/services';
import { serviceSchema, faqSchema, breadcrumbSchema } from '../../utils/schema';

// Rewritten 27 Nov 2026: compact, search-literal page in the shared service layout.
const service = services.find((s) => s.slug === 'seo')!;
const title = "SEO Services in India: Technical, Local & Content SEO";
const description = "SEO services from India: technical SEO, on-page optimisation, keyword strategy, local SEO and Google Business Profile, content SEO and clear Search Console reporting. No ranking guarantees, just evidence.";

const serviceFaqs = [
  {
    question: 'How long before I see SEO results?',
    answer: 'SEO is normally a medium-to-long-term activity. The time needed to observe meaningful change depends on the site, market, competition, search demand, content, technical constraints and search-engine updates. We establish a baseline and agreed reporting measures, but do not promise a ranking or a fixed results date.',
  },
  {
    question: "What's included in your SEO audit?",
    answer: "Our SEO audit covers four pillars: technical SEO (crawlability, site speed, Core Web Vitals, mobile-friendliness, structured data), on-page SEO (title tags, meta descriptions, heading structure, content gaps, keyword targeting), backlink analysis (quality, toxicity, opportunities), and competitive analysis (what your top competitors rank for and how). You receive a prioritised action plan, not just a report.",
  },
  {
    question: 'Do you guarantee first-page rankings?',
    answer: "No ethical SEO provider can guarantee specific rankings because search results depend on competition, relevance, authority, technical quality and changing systems. We define the work, reporting and measurement in the proposal, then review progress against the agreed goals.",
  },
  {
    question: 'What is the difference between local SEO and regular SEO?',
    answer: "Local SEO focuses on improving visibility for location-based searches (\"web design company Nagpur\", \"near me\" searches). It involves Google Business Profile optimization, local citations, review management, and geo-targeted content. Regular (organic) SEO targets broader, non-location-specific keywords and involves technical optimisation, content strategy, and link building on a national or global scale.",
  },
  {
    question: 'Do you provide monthly SEO reports?',
    answer: 'Reporting frequency and included review meetings are stated in the selected retainer or proposal. A report can cover agreed keyword visibility, Search Console data, analytics, technical health, completed work, content performance and recommended priorities without implying guaranteed growth.',
  },
];

const breadcrumbs = [
  { name: 'Home', href: '/' },
  { name: 'Services', href: '/services/' },
  { name: service.title, href: `/services/${service.slug}/` },
];
const schemas = [
  serviceSchema(title, description, `/services/${service.slug}/`),
  faqSchema(serviceFaqs),
  breadcrumbSchema(breadcrumbs.map((b) => ({ name: b.name, url: b.href }))),
];
---
<ServiceLayout title={title} description={description} breadcrumbs={breadcrumbs} schema={schemas}>
  <ServicePage
    accentVar={service.cssVar}
    highlights={service.features.slice(0, 6)}
    eyebrow={"SEO services · technical, local and content"}
    heading={"SEO Services That Help Customers Find You"}
    intro={"We fix what stops search engines understanding your website, then build the pages and local presence that match what your customers actually search for. Every month you see the Search Console evidence, not vanity numbers."}
    offersTitle={"What our SEO service includes"}
    offers={[{"title": "Technical SEO", "text": "Speed, Core Web Vitals, crawlability, sitemaps, robots.txt, structured data and mobile checks."}, {"title": "On-page optimisation", "text": "Titles, descriptions, headings, internal links, image alt text and content matched to search intent."}, {"title": "Keyword research and mapping", "text": "Realistic, high-intent keywords from Search Console and research tools, mapped to pages."}, {"title": "Local SEO", "text": "Google Business Profile, local citations, reviews and city pages for the places you serve."}, {"title": "Content SEO", "text": "Guides, FAQs and pillar pages structured to answer real questions and earn featured answers."}, {"title": "Ethical link building", "text": "Digital PR and relevant outreach; no paid link schemes."}, {"title": "Competitor analysis", "text": "Keyword targets, content and technical gaps among the competitors you actually face."}, {"title": "Reporting and analytics", "text": "GA4 and Search Console reports in plain English, with agreed measures and next steps."}]}
    process={[{"title": "Audit", "text": "Technical audit, keyword gaps, backlinks and competitor benchmarks."}, {"title": "Roadmap", "text": "A 90-day plan of fixes, pages and targets you approve before work starts."}, {"title": "Implement", "text": "Technical fixes first, then on-page work and content, tracked on a shared board."}, {"title": "Measure and refine", "text": "Monthly reports; keep what works, change what does not."}]}
    fit={["Your website gets impressions but few clicks.", "You serve specific cities and want to appear in local results.", "A redesign or migration put your rankings at risk.", "You want evidence-led SEO, not ranking promises."]}
    faqTitle={"SEO FAQs"}
    cta={{"title": "Find out what is holding your rankings back", "text": "Start with a paid website audit or a short call. We will show the Search Console evidence and the fixes that matter first.", "label": "Book a website audit", "href": "/website-audit/"}}
    note={"Search rankings, traffic, impressions, clicks and enquiries depend on search engines, competitors and demand and cannot be guaranteed."}
    guides={[{"label": "Local SEO", "title": "SEO guide for small businesses in Nagpur", "href": "/blog/seo/seo-guide-small-business-nagpur/"}, {"label": "AI search", "title": "Generative engine optimisation for AI search", "href": "/blog/technology-trends/generative-engine-optimization-ai-search-2026/"}, {"label": "Audit", "title": "Website audit findings explained", "href": "/blog/web-design/website-audit-findings-explained/"}]}
    faqs={serviceFaqs}
  >
    <ServiceExplainer
      id="receive"
      color="--ac-emerald"
      eyebrow="What you receive"
      title="What you receive from our SEO service"
      columns={[{"title": "A baseline", "text": "Search Console, analytics, technical health and the searches you appear for, recorded at the start so progress can be measured."}, {"title": "Prioritised fixes", "text": "A 90-day roadmap of technical fixes, page improvements and new pages, ranked by likely impact and approved by you."}, {"title": "Reporting", "text": "Search Console and analytics evidence, the work completed and what changed, at the frequency stated in the proposal."}, {"title": "Follow-up", "text": "A review of what worked, what did not and the next priorities, so the roadmap keeps up with your results."}]}
      numbered
    />
    <ServiceExplainer
      id="audit-or-seo"
      color="--ac-teal"
      eyebrow="One-off audit or ongoing SEO?"
      title="Start with an audit, or with ongoing SEO"
      columns={[{"title": "Paid website audit", "items": ["A one-off review of one domain: SEO, speed, security and accessibility", "Prioritised findings you can act on yourself or with any team", "Paid online before booking"]}, {"title": "Ongoing SEO", "items": ["Monthly work on the roadmap: fixes, content and local SEO", "Search Console reporting and review calls", "Scope and reporting frequency agreed in the proposal"]}]}
      links={[{"href": "/website-audit/", "label": "Book a website audit"}, {"href": "/services/digital-marketing/", "label": "Need paid ads as well? Digital marketing"}]}
    />
  </ServicePage>
</ServiceLayout>
