---
import ServiceLayout from '../../layouts/ServiceLayout.astro';
import ServicePage from '../../components/service/ServicePage.astro';
import { services } from '../../data/services';
import { serviceSchema, faqSchema, breadcrumbSchema } from '../../utils/schema';

// Rewritten 27 Nov 2026: compact, search-literal page in the shared service layout.
const service = services.find((s) => s.slug === 'branding')!;
const title = "Branding & Logo Design Services: Brand Identity and Style Guides";
const description = "Branding services from India: logo design, brand identity systems, style guides, rebranding, brand strategy, marketing collateral, digital assets and packaging design.";

const serviceFaqs = [
  {
    question: 'What do I receive at the end of a branding project?',
    answer: 'The accepted proposal lists the final brand assets, formats, guidelines, editable source files and usage rights included. Font files, stock assets, mockups and other third-party materials remain subject to their licences and are transferred only when the applicable licence permits it.',
  },
  {
    question: 'How many logo concepts do you present?',
    answer: 'The proposal specifies the number of initial directions, included revision rounds, decision-makers and charges for additional work. This keeps the creative process and approval responsibilities clear before design begins.',
  },
  {
    question: 'Can you rebrand an existing business?',
    answer: "Yes - rebranding is a large part of our branding practice. We begin with a strategic discovery phase: understanding why the current brand isn't working, auditing brand perception, reviewing competitor positioning, and interviewing stakeholders. From there, we develop a brand strategy before touching a single logo - ensuring the visual identity is built on the right strategic foundation.",
  },
  {
    question: 'Do you handle print materials?',
    answer: 'Print and digital collateral can be included or quoted separately. The proposal identifies the required items, sizes, formats, printer specifications, copy and image responsibilities, proof approvals and any licensed assets. Final production should be checked against the selected printer or manufacturer’s requirements.',
  },
  {
    question: 'How long does a branding project take?',
    answer: 'Timing depends on discovery, deliverables, stakeholder availability, concept and revision rounds, asset licensing and approval speed. The proposal includes the working schedule and client dependencies for the selected scope.',
  },
];

const breadcrumbs = [
  { name: 'Home', href: '/' },
  { name: 'Services', href: '/services/' },
  { name: service.title, href: `/services/${service.slug}/` },
];
const schemas = [
  serviceSchema(title, description, `/services/${service.slug}/`),
  faqSchema(serviceFaqs),
  breadcrumbSchema(breadcrumbs.map((b) => ({ name: b.name, url: b.href }))),
];
const files = ['Logo in SVG and PNG', 'Reversed and mono versions', 'Print-ready PDF and EPS', 'Editable source files', 'Brand guidelines PDF', 'HEX, RGB, CMYK, Pantone', 'Typography system', 'Supporting graphics'];
---
<ServiceLayout title={title} description={description} breadcrumbs={breadcrumbs} schema={schemas}>
  <ServicePage
    accentVar={service.cssVar}
    highlights={service.features.slice(0, 6)}
    eyebrow={"Branding · logo design and brand identity"}
    heading={"Branding and Logo Design That Makes You Memorable"}
    intro={"We build brands from strategy to every touchpoint: positioning, logo, colours, typography and a style guide your team, printers and agencies can follow. Distinctive in your market and designed to last."}
    offersTitle={"What our branding service includes"}
    offers={[{"title": "Logo design", "text": "Distinctive, versatile logos that work from app icons to signage."}, {"title": "Brand identity systems", "text": "Colours, type, icons, illustration and photography direction."}, {"title": "Brand style guides", "text": "Clear usage rules for logos, spacing, colour and typography."}, {"title": "Brand strategy", "text": "Positioning, value proposition, audience and brand voice."}, {"title": "Rebranding", "text": "A managed move from an outdated identity to one that fits who you serve."}, {"title": "Marketing collateral", "text": "Cards, letterheads, brochures, presentations and banners."}, {"title": "Digital brand assets", "text": "Social profiles, email signatures, ad templates and web UI guidance."}, {"title": "Packaging design", "text": "Retail-ready packaging that stands out and explains the product."}]}
    process={[{"title": "Discovery and strategy", "text": "Workshop on goals, audience, competitors, values and positioning."}, {"title": "Concepts", "text": "Three distinct logo directions with mood boards and rationale."}, {"title": "Refine and build", "text": "Up to three feedback rounds, then the full brand system."}, {"title": "Deliver and hand over", "text": "Organised files in every format plus a brand guidelines PDF."}]}
    fit={["You are launching a new business or product.", "Your current brand no longer reflects who you are.", "Different teams use your logo and colours inconsistently.", "You need packaging or collateral to match your website."]}
    faqTitle={"Branding FAQs"}
    cta={{"title": "Ready to build a brand people remember?", "text": "Tell us about your business and audience. We will propose a branding scope and timeline in writing."}}
    note={"Creative work does not confirm trademark availability or registration; formal clearance should be handled by a qualified trademark professional."}
    faqs={serviceFaqs}
  >
    <section class="tilt-card p-5 sm:p-6" style={`--card-color: var(${service.cssVar});`} aria-labelledby="files-title">
      <h2 id="files-title" class="font-heading text-lg font-bold text-[var(--text)]">What you receive at handover</h2>
      <ul class="mt-3 grid gap-2 text-sm text-[var(--text-dim)] sm:grid-cols-2 lg:grid-cols-4" role="list">
        {files.map((f) => <li>✓ {f}</li>)}
      </ul>
    </section>
  </ServicePage>
</ServiceLayout>
