---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { services } from '../../data/services';
import { breadcrumbSchema, serviceSchema } from '../../utils/schema';
import TechStackCarousel from '../../components/TechStackCarousel.astro';
import BookingAdvance from '../../components/payments/BookingAdvance.astro';

const breadcrumbs = [
  { name: 'Home', url: '/' },
  { name: 'Services', url: '/services/' },
];

const schemas = [
  breadcrumbSchema(breadcrumbs),
  ...services.map((s) =>
    serviceSchema(s.title, s.description, `/services/${s.slug}/`)
  ),
];

// One bento grid for every service (owner, 27 Nov 2026): eCommerce large, the rest compact cards.
const order = ['ecommerce', 'website-design', 'web-development', 'ada-compliant-web-design', 'seo', 'digital-marketing', 'mobile-app-development', 'branding', 'maintenance-security', 'custom-crm-erp-solutions', 'dpdp-compliance-implementation', 'headless-cms-development'];
const grid = order.map((slug) => services.find((s) => s.slug === slug)!).filter(Boolean).map((s) => ({ href: `/services/${s.slug}/`, title: s.title, tagline: s.tagline, description: s.description, cssVar: s.cssVar, icon: s.iconSvg, slug: s.slug }));
grid.push({ href: '/services/integrations/', title: 'API & Integrations', tagline: 'Payment, shipping, CRM and custom software connections', description: '', cssVar: '--svc-integrations', slug: 'integrations', icon: '<svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M21 8a2 2 0 0 0-1-1.73l-7-4a2 2 0 0 0-2 0l-7 4A2 2 0 0 0 3 8v8a2 2 0 0 0 1 1.73l7 4a2 2 0 0 0 2 0l7-4A2 2 0 0 0 21 16Z"/><path d="m3.3 7 8.7 5 8.7-5"/><path d="M12 22V12"/></svg>' });
const ecommerceLinks = [
  { label: 'Shopify', href: '/services/ecommerce/#shopify' },
  { label: 'Medusa.js', href: '/services/ecommerce/medusa-js-development/' },
  { label: 'WooCommerce', href: '/services/ecommerce/' },
  { label: 'Zoho Commerce', href: '/services/ecommerce/#zoho-commerce' },
];
// Choose by need (27 Nov 2026): buyers start from the problem; each link names the specialist page.
const needs = [
  { title: 'Build a website, app or brand', color: '--ac-pink', links: [
    { label: 'Custom website design and redesign', href: '/services/website-design/' },
    { label: 'Web apps, portals and custom builds', href: '/services/web-development/' },
    { label: 'Mobile apps for iOS and Android', href: '/services/mobile-app-development/' },
    { label: 'Logo and brand identity', href: '/services/branding/' },
  ] },
  { title: 'Sell online', color: '--ac-amber', links: [
    { label: 'Choose an ecommerce platform', href: '/services/ecommerce/' },
    { label: 'Custom Shopify store development', href: '/services/ecommerce/#shopify' },
    { label: 'Medusa.js development agency', href: '/services/ecommerce/medusa-js-development/' },
  ] },
  { title: 'Connect your systems', color: '--svc-integrations', links: [
    { label: 'Payment, shipping and API integrations', href: '/services/integrations/' },
    { label: 'Custom CRM, ERP and ERPNext', href: '/services/custom-crm-erp-solutions/' },
    { label: 'Headless CMS with Payload or Directus', href: '/services/headless-cms-development/' },
  ] },
  { title: 'Fix accessibility', color: '--ac-blue', links: [
    { label: 'ADA and WCAG remediation', href: '/services/ada-compliant-web-design/' },
    { label: 'Emergency help for a demand letter', href: '/services/ada-compliant-web-design/emergency-remediation/' },
    { label: 'Accessibility quick check', href: '/website-audit/#paid-wcag-audit' },
  ] },
  { title: 'Improve an existing website', color: '--ac-emerald', links: [
    { label: 'Paid website audit', href: '/website-audit/' },
    { label: 'SEO services', href: '/services/seo/' },
    { label: 'Google Ads and lead generation', href: '/services/digital-marketing/' },
    { label: 'Maintenance and security plans', href: '/services/maintenance-security/' },
    { label: 'DPDP consent and privacy implementation', href: '/services/dpdp-compliance-implementation/' },
  ] },
];
const steps = [
  { title: 'Discover', desc: 'Goals, audience, competitors and technical requirements.' },
  { title: 'Strategy', desc: 'Sitemap, wireframes, stack, timeline and success measures.' },
  { title: 'Design', desc: 'Responsive, accessible mock-ups with agreed review rounds.' },
  { title: 'Develop', desc: 'Clean, maintainable code on the right platform for you.' },
  { title: 'Test', desc: 'Browsers, devices, accessibility and Core Web Vitals.' },
  { title: 'Launch', desc: 'Deployment, redirects, backups and post-launch checks.' },
];
const reasons = [
  { title: 'Experience since 2002', desc: '24+ years and 1,500+ projects for organisations in India and abroad.' },
  { title: 'Accessibility-first', desc: 'Considered from the start; formal WCAG scope and evidence agreed when required.' },
  { title: 'Full-stack in one team', desc: 'Design, development and marketing in one engagement, with clear responsibilities.' },
  { title: 'Support after launch', desc: 'Maintenance, response channels and service levels set out in your proposal.' },
];
---
<BaseLayout
  title="Web Design & Digital Services | eLan Technology"
  description="Web design, ecommerce, custom CRM and ERP, ERPNext, DPDP implementation, Payload CMS, Directus, SEO and digital services from India."
  ogImage="/images/og/services.png"
  schema={schemas}
>
  <!-- Hero -->
  <section class="relative bg-gradient-to-br from-[var(--bg)] to-[var(--bg-card)] py-12 md:py-16">
    <div class="mx-auto grid max-w-7xl gap-8 px-4 sm:px-6 lg:grid-cols-[1.4fr_0.6fr] lg:items-end lg:px-8">
      <div>
        <p class="text-xs font-bold uppercase tracking-[0.18em] text-[var(--accent)]">Full-Service Digital Agency</p>
        <h1 class="mt-3 font-heading text-4xl font-bold leading-tight tracking-tight text-[var(--text)] md:text-5xl">Digital Services for Growing Businesses</h1>
        <p class="mt-4 max-w-2xl text-lg text-[var(--text-dim)]">We design websites and stores, build CRM and ERP workflows, customise ERPNext, implement privacy controls, and connect modern content platforms including Payload CMS and Directus.</p>
        <ul class="mt-5 flex flex-wrap gap-x-5 gap-y-2 text-sm text-[var(--text-dim)]" role="list">
          <li class="flex items-center gap-1.5"><span class="text-[var(--accent)]" aria-hidden="true">✓</span>24+ years experience</li>
          <li class="flex items-center gap-1.5"><span class="text-[var(--accent)]" aria-hidden="true">✓</span>1,500+ projects delivered</li>
          <li class="flex items-center gap-1.5"><span class="text-[var(--accent)]" aria-hidden="true">✓</span>Accessibility-first development</li>
          <li class="flex items-center gap-1.5"><span class="text-[var(--accent)]" aria-hidden="true">✓</span>Scope-based support</li>
        </ul>
      </div>
      <div class="flex flex-col gap-3 sm:flex-row lg:flex-col">
        <a href="/schedule-consultation/" class="inline-flex items-center justify-center rounded-lg bg-[var(--accent)] px-6 py-3 font-semibold text-white transition hover:brightness-110">Book a Consultation</a>
        <a href="/get-quote/" class="inline-flex items-center justify-center rounded-lg border border-[var(--border)] bg-[var(--bg)] px-6 py-3 font-semibold text-[var(--text)] transition hover:border-[var(--accent)]">Get a Quote</a>
        <p class="text-center text-xs text-[var(--text-muted)] lg:text-left">Not sure which service you need? A 30-minute consultation helps; no obligation to proceed.</p>
      </div>
    </div>
  </section>

  <!-- Choose by need -->
  <section class="pt-12 md:pt-16" aria-labelledby="needs-heading">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
      <h2 id="needs-heading" class="font-heading text-3xl font-bold text-[var(--text)]">What do you need to do?</h2>
      <p class="mt-2 max-w-2xl text-[var(--text-dim)]">Start with the job, and we will point you to the right service.</p>
      <ul class="mt-7 grid gap-4 sm:grid-cols-2 lg:grid-cols-5" role="list">
        {needs.map((n) => (
          <li class="tilt-card p-5" style={`--card-color: var(${n.color});`}>
            <h3 class="font-heading text-lg font-bold leading-snug text-[var(--text)]">{n.title}</h3>
            <ul class="mt-3 space-y-2.5" role="list">
              {n.links.map((l) => <li><a href={l.href} class="text-sm font-semibold leading-snug text-[var(--text)] underline decoration-[var(--border)] underline-offset-4 transition hover:decoration-[var(--card-color)]">{l.label} →</a></li>)}
            </ul>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <!-- All services: one bento grid -->
  <section class="py-12 md:py-16" aria-labelledby="all-services-heading">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
      <h2 id="all-services-heading" class="font-heading text-3xl font-bold text-[var(--text)]">All services</h2>
      <p class="mt-2 max-w-2xl text-[var(--text-dim)]">Design, development, commerce, visibility and support services shaped around the agreed business requirement.</p>
      <ul class="svc-bento mt-7" role="list">
        {grid.map((s, i) => {
          const large = s.slug === 'ecommerce';
          const num = String(i + 1).padStart(2, '0');
          return (
            <li class:list={[large ? 'is-large' : 'is-small']}>
              <article class:list={['service-card group relative flex h-full flex-col overflow-hidden rounded-xl border border-[var(--border)] transition hover:-translate-y-1 hover:shadow-xl', large ? 'p-6 md:p-8' : 'p-5']} style={`background: linear-gradient(135deg, color-mix(in srgb, var(${s.cssVar}) 10%, var(--bg-card)) 0%, var(--bg-card) 65%); --card-color: var(${s.cssVar});`}>
                <span aria-hidden="true" class="service-card__num pointer-events-none absolute right-4 top-3 select-none font-heading font-black leading-none" style={`color: var(${s.cssVar}); font-size: ${large ? '6rem' : '3.4rem'};`}>{num}</span>
                <span aria-hidden="true" class:list={['service-card__stripe pointer-events-none absolute rotate-[-20deg] opacity-[0.08]', large ? '-bottom-12 -left-12 h-64 w-64' : '-bottom-8 -left-8 h-32 w-32']} style={`background: var(${s.cssVar});`}></span>
                <span class="relative flex h-11 w-11 items-center justify-center rounded-md" style={`background: color-mix(in srgb, var(${s.cssVar}) 16%, transparent); color: var(${s.cssVar});`} aria-hidden="true" set:html={s.icon} />
                <h3 class:list={['relative mt-4 font-heading font-bold text-[var(--text)]', large ? 'text-2xl md:text-3xl' : 'text-lg']}>{s.title}</h3>
                <p class:list={['relative mt-1.5 text-[var(--text-dim)]', large ? 'text-base' : 'text-sm']}>{s.tagline}</p>
                {large && <p class="relative mt-3 text-sm leading-relaxed text-[var(--text-muted)]">{s.description}</p>}
                {large && (
                  <p class="relative mt-5 flex flex-wrap gap-2">
                    {ecommerceLinks.map((l) => (
                      <a href={l.href} class="rounded-md border border-[var(--border)] bg-[var(--bg-card)] px-3 py-1.5 text-sm font-semibold text-[var(--text)] transition hover:border-[var(--accent)]">{l.label}</a>
                    ))}
                  </p>
                )}
                <a href={s.href} class="relative mt-auto inline-flex items-center gap-1 pt-4 text-sm font-semibold transition-transform duration-200 group-hover:translate-x-0.5" style={`color: var(${s.cssVar});`} aria-label={`Learn more about ${s.title}`}>Learn More <span aria-hidden="true">→</span></a>
              </article>
            </li>
          );
        })}
      </ul>
      <p class="mt-5 text-sm text-[var(--text-dim)]">Also: <a href="/services/ada-compliant-web-design/emergency-remediation/" class="font-semibold underline underline-offset-2">Emergency ADA remediation</a> · <a href="/services/payload-directus-development/" class="font-semibold underline underline-offset-2">Payload CMS &amp; Directus</a> · <a href="/website-audit/" class="font-semibold underline underline-offset-2">Website audit</a></p>
    </div>
  </section>

  <!-- How we work + why eLan -->
  <section class="border-y border-[var(--border)] bg-[var(--bg-card)] py-12 md:py-16" aria-labelledby="how-heading">
    <div class="mx-auto grid max-w-7xl gap-10 px-4 sm:px-6 lg:grid-cols-2 lg:px-8">
      <div>
        <h2 id="how-heading" class="font-heading text-3xl font-bold text-[var(--text)]">How We Work</h2>
        <p class="mt-2 text-[var(--text-dim)]">Documented scope, responsibilities, review points and change control.</p>
        <ol class="mt-6 grid gap-2 sm:grid-cols-2" role="list">
          {steps.map((st, i) => (
            <li class="step"><span aria-hidden="true">{String(i + 1).padStart(2, '0')}</span><div><h3 class="font-heading font-bold text-[var(--text)]">{st.title}</h3><p class="text-sm text-[var(--text-dim)]">{st.desc}</p></div></li>
          ))}
        </ol>
      </div>
      <div>
        <h2 class="font-heading text-3xl font-bold text-[var(--text)]">Why Choose eLan Technology?</h2>
        <p class="mt-2 text-[var(--text-dim)]">Technical depth and creative craft, focused on business outcomes.</p>
        <ul class="mt-6 grid gap-3 sm:grid-cols-2" role="list">
          {reasons.map((r) => (
            <li class="rounded-xl border border-[var(--border)] bg-[var(--bg)] p-4"><h3 class="font-heading font-bold text-[var(--text)]">{r.title}</h3><p class="mt-1 text-sm text-[var(--text-dim)]">{r.desc}</p></li>
          ))}
        </ul>
      </div>
    </div>
  </section>

  <TechStackCarousel compact />

  <div class="mx-auto max-w-7xl px-4 py-12 sm:px-6 lg:px-8">

    <details class="note rounded-xl border border-[var(--border)] bg-[var(--bg-card)]" aria-labelledby="service-privacy-title">
      <summary class="flex cursor-pointer list-none items-center justify-between gap-4 px-5 py-4">
        <span id="service-privacy-title" class="font-semibold text-[var(--text)]">How we handle your project information</span>
        <svg class="chev shrink-0 text-[var(--text-muted)]" xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polyline points="6 9 12 15 18 9"/></svg>
      </summary>
      <div class="border-t border-[var(--border)] px-5 py-5 text-sm leading-relaxed text-[var(--text-dim)]">
        <p>Your information should match the stage of the conversation. This page collects nothing; the consultation and quote pages explain their fields, purpose and retention before you submit.</p>
        <ol class="mt-4 grid gap-3 sm:grid-cols-2" aria-label="Service information lifecycle">
          <li><strong class="text-[var(--text)]">1. Initial enquiry:</strong> share only contact and high-level business information. Never send passwords, production data, identity documents or confidential databases through an enquiry form.</li>
          <li><strong class="text-[var(--text)]">2. Discovery and proposal:</strong> before asking for more, we identify the purpose, access, systems, third parties, retention and confidentiality needs.</li>
          <li><strong class="text-[var(--text)]">3. Delivery access:</strong> role-based, time-bound and limited to the agreed work, with live personal data minimised or replaced by test data where practical.</li>
          <li><strong class="text-[var(--text)]">4. Handover and closure:</strong> credentials returned or removed, client-controlled accounts, retained records, backups and any maintenance access identified.</li>
        </ol>
        <p class="mt-4"><strong class="text-[var(--text)]">Controller and processor roles are confirmed per project.</strong> The client commonly decides why its data is processed, while eLan Technology may process limited data on the client’s instructions. The proposal, contract or data-processing terms record the actual roles, people, hosting region, subprocessors, security measures, incident route and deletion arrangements. A service description alone is not a DPDP, GDPR, ADA or WCAG compliance guarantee.</p>
        <p class="mt-3">Privacy questions: <a class="font-semibold text-[var(--accent)] underline underline-offset-4" href="mailto:privacy@elan-tech.net?subject=Service%20privacy%20question">privacy@elan-tech.net</a> · <a class="font-semibold text-[var(--accent)] underline underline-offset-4" href="/privacy-policy/">Privacy policy</a></p>
      </div>
    </details>
  </div>

  <div class="border-t border-[var(--border)] bg-[var(--bg-card)]"><BookingAdvance /></div>
</BaseLayout>

<style>
  .svc-bento { display: grid; gap: 1rem; grid-template-columns: repeat(4, minmax(0, 1fr)); }
  .is-large { grid-column: span 2; grid-row: span 2; }
  .step { display: grid; grid-template-columns: 2.25rem 1fr; gap: .75rem; padding: .7rem; border-radius: var(--radius-xl); border: 1px solid var(--border); background: var(--bg); }
  .step > span { display: grid; place-items: center; width: 2.25rem; height: 2.25rem; border-radius: var(--radius-lg); background: color-mix(in srgb, var(--accent) 12%, transparent); color: var(--accent); font-weight: 800; font-size: .8rem; }
  .note[open] .chev { transform: rotate(180deg); } .chev { transition: transform .2s; }
  .note summary::-webkit-details-marker { display: none; }
  @media (max-width: 1023px) { .svc-bento { grid-template-columns: repeat(2, minmax(0, 1fr)); gap: .75rem; } .is-large { grid-column: span 2; grid-row: auto; } }
  @media (max-width: 639px) { .is-small :global(.service-card) { padding: 1rem; } .is-small :global(.service-card p) { display: none; } .is-small :global(.service-card h3) { font-size: 1rem; } .is-small :global(.service-card__num) { font-size: 2.4rem !important; } }
</style>
