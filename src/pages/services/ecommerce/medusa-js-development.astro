---
import ServiceLayout from '../../../layouts/ServiceLayout.astro';
import ServicePage from '../../../components/service/ServicePage.astro';
import { serviceSchema, faqSchema, breadcrumbSchema } from '../../../utils/schema';

// Rewritten 27 Nov 2026 around the Search Console queries this page already appears for:
// "medusajs development agency", "implementation partner", "medusajs cost", "medusa vs shopify",
// "shopify to medusa migration", "medusa js hosting", "medusajs consultancy", UK / Europe / US partners.
const title = 'Medusa.js Development Agency & Implementation Partner';
const description =
  'Medusa.js development agency and remote implementation partner: custom modules, subscriptions, payments, ERP and PIM integrations, Shopify to Medusa migration, hosting and costs explained.';

const breadcrumbs = [
  { name: 'Home', href: '/' },
  { name: 'Services', href: '/services/' },
  { name: 'eCommerce Development', href: '/services/ecommerce/' },
  { name: 'Medusa.js Development', href: '/services/ecommerce/medusa-js-development/' },
];

const faqs = [
  {
    question: 'What does a Medusa.js development agency do?',
    answer: 'A Medusa.js agency designs and builds custom commerce on Medusa: the storefront, custom modules and workflows, payment and shipping providers, integrations with ERP, PIM or warehouse systems, data migration, and the hosting and support model after launch. We do all of these, from discovery to ongoing engineering.',
  },
  {
    question: 'Can you be our Medusa.js implementation partner in the UK, Europe or the US?',
    answer: 'Yes. We work as a remote Medusa.js implementation partner, either directly with the merchant or white-label behind an agency, with NDA available. Our India working day overlaps the UK and European morning and the US evening, and scope, ownership and handover are agreed in writing before work starts.',
  },
  {
    question: 'How much does a Medusa.js implementation cost?',
    answer: 'There is no single figure, because cost follows scope: the number of custom modules, payment and shipping providers, ERP or PIM integrations, data migration, storefront design and the support model after launch. We quote after a discovery conversation. Medusa is open source, but hosting, monitoring, security updates and ongoing engineering are real running costs and are part of the discussion.',
  },
  {
    question: 'Medusa Cloud or self-hosting: which costs less?',
    answer: "A Medusa backend needs a Node.js server and a PostgreSQL database, usually with Redis, plus hosting for the storefront. Medusa's managed cloud reduces operations work; your own cloud account gives more control but someone must run updates, backups and monitoring. We compare both for your traffic and team, and our running-costs guide breaks down the budget.",
  },
  {
    question: 'Medusa.js vs Shopify: when does Medusa make more sense?',
    answer: 'Shopify is usually better when a hosted platform covers your needs and you want the fastest setup with the least operational responsibility. Medusa makes more sense when custom workflows, B2B or subscription logic, owned code and data, or deep integrations are central to the business, and you have a team or partner to operate the application.',
  },
  {
    question: 'Can you migrate a Shopify or WooCommerce store to Medusa.js?',
    answer: 'Yes. Migration covers products, variants, customers, orders, URL redirects and integrations, planned in stages to protect search visibility. We also say plainly when staying on Shopify is the better choice.',
  },
  {
    question: 'Can Medusa.js connect to ERP, PIM or warehouse systems?',
    answer: "Yes. We build integrations for inventory, PIM, CRM, accounting, warehouse (WMS) and customer-service systems. The approach depends on the other system's API, how often data must sync, and what should happen when a sync fails.",
  },
  {
    question: 'Can you build subscriptions and Indian payment gateways on Medusa.js?',
    answer: 'Yes. For Puritas we built a custom Medusa.js subscription module alongside Razorpay, PhonePe and shipping modules: plans, billing state, recurring orders, webhooks, retries, refunds and customer controls.',
  },
  {
    question: 'Who operates and maintains a Medusa.js platform after launch?',
    answer: 'A Medusa implementation is a custom application, so the merchant or its technology partner is responsible for hosting, monitoring, security updates, backups, integrations and continued engineering. We agree this operating model before recommending Medusa, and can provide ongoing support.',
  },
  {
    question: 'What is Medusa.js?',
    answer: 'Medusa.js is an open-source, modular commerce platform. It provides products, carts, orders, inventory, pricing, payments and fulfilment, and lets developers extend data models, workflows, APIs, the admin and integrations.',
  },
];

// Delivered Medusa.js work (owner, 27 Nov 2026: Puritas shown again on this page only).
// Facts only: what the business needed and what we built; no sales or performance claims.
const work = [
  {
    label: 'Medusa.js meal commerce · Launched',
    name: 'Healthy Genie',
    color: '--svc-medusa',
    needed: 'A meal-commerce website in Pune for meals, snacks and subscription plans, with food preferences and corporate meal enquiries.',
    built: ['Custom storefront design', 'Medusa.js commerce backend with a Next.js storefront', 'Meal plans and subscriptions', 'Customer accounts and cart', 'Corporate and party order enquiries'],
    href: 'https://healthygenie.in/',
    link: 'Visit launched website',
  },
  {
    label: 'Medusa.js subscriptions · Indian payments',
    name: 'Puritas',
    color: '--ac-emerald',
    needed: 'Recurring orders paid through Indian payment gateways, with its own shipping workflow.',
    built: ['Custom Medusa.js subscription module', 'Razorpay and PhonePe payment integrations', 'Shipping modules for fulfilment'],
    href: 'https://puritas.in/',
    link: 'Visit puritas.in',
    guide: { href: '/blog/ecommerce/building-subscription-ecommerce-medusa-js-india/', label: 'How we approach Medusa.js subscriptions' },
  },
];
const erpSteps = [
  ['Which system updates stock', 'If your ERP owns inventory, Medusa reads stock from it and does not overwrite it. We agree this for every field that both systems hold.'],
  ['How often changes sync', 'Instantly through webhooks, every few minutes, or overnight, depending on how fast stock moves and what the ERP allows.'],
  ['What happens when an update fails', 'Retries, an alert to a named person, and a rule for whether the product stays on sale until the stock figure is confirmed.'],
];

const schemas = [
  serviceSchema(title, description, '/services/ecommerce/medusa-js-development/'),
  faqSchema(faqs),
  breadcrumbSchema(breadcrumbs.map(({ name, href }) => ({ name, url: href }))),
];
---

<ServiceLayout
  title={title}
  description={description}
  canonical="/services/ecommerce/medusa-js-development/"
  ogImage="/images/ecommerce-og-2026.png"
  breadcrumbs={breadcrumbs}
  schema={schemas}
>
  <ServicePage
    accentVar="--svc-medusa"
    eyebrow="Medusa.js development agency · remote implementation partner"
    heading="Medusa.js Development Agency and Implementation Partner"
    intro="We design, build and run custom Medusa.js commerce: modules, subscriptions, payments, ERP and PIM integrations, and migrations from Shopify or WooCommerce. Available directly to merchants or white-label for agencies in the UK, Europe, the US and India."
    highlights={['Healthy Genie and Puritas built on Medusa.js', 'Custom modules, workflows and subscriptions', 'Razorpay, PhonePe and shipping modules', 'Shopify and WooCommerce to Medusa migration', 'ERP, PIM and warehouse integrations', 'White-label for agencies, NDA available']}
    primaryCta={{ label: 'Discuss your Medusa build', href: '/schedule-consultation/' }}
    secondaryCta={{ label: 'Visit the Healthy Genie website', href: 'https://healthygenie.in/', external: true }}
    offersTitle="Medusa.js development services"
    offersIntro="Medusa gives us core commerce plus a framework for extending it, so essential business logic does not end up in brittle workarounds."
    offers={[
      { title: 'Architecture and consulting', text: 'Domain model, modules, workflows, infrastructure, security and a staged delivery plan.' },
      { title: 'Custom storefronts', text: 'Accessible, fast customer experiences connected through the Medusa Store API.' },
      { title: 'Custom modules and workflows', text: 'Business-specific data models, validation, events, automations and recoverable processes.' },
      { title: 'Payments and subscriptions', text: 'Gateway modules, webhooks, subscription state, retries, refunds and recurring orders.' },
      { title: 'Fulfilment and shipping', text: 'Serviceability, rates, shipments, carrier connections, tracking and exceptions.' },
      { title: 'B2B and marketplaces', text: 'Company accounts, buyer permissions, quotes, account pricing, vendors and commissions.' },
      { title: 'ERP, PIM and WMS integration', text: 'Inventory, product data, CRM, accounting, warehouse and customer-service systems.' },
      { title: 'Migration', text: 'Products, customers, orders and URL redirects moved from Shopify or WooCommerce in stages.' },
      { title: 'Hosting and ongoing engineering', text: 'Medusa Cloud or your own cloud, monitoring, backups, releases and a support model.' },
    ]}
    processTitle="How we deliver a Medusa.js project"
    process={[
      { title: 'Model the business', text: 'Products, customers, orders, subscriptions, payments, fulfilment and exceptions.' },
      { title: 'Define the architecture', text: 'Modules, workflows, APIs, storefront, hosting, integrations and security.' },
      { title: 'Build and validate', text: 'Incremental delivery with real gateway and fulfilment scenarios and your testing.' },
      { title: 'Launch and operate', text: 'Migration, monitoring, backups, documentation and ongoing engineering.' },
    ]}
    fit={['Your products, pricing, subscriptions or fulfilment do not fit a standard platform.', 'Custom workflows and integrations are part of your competitive advantage.', 'You want owned code, data, deployment and platform evolution.', 'B2B, marketplace, multi-region or multi-channel logic needs a tailored model.', 'You have a team or partner able to operate a custom application.']}
    guides={[
      { label: 'Comparison', title: 'Shopify vs Medusa.js in 2026', href: '/blog/ecommerce/shopify-vs-medusa-js-2026/' },
      { label: 'Costs', title: 'Medusa.js implementation and running costs: a buyer’s guide', href: '/blog/ecommerce/medusa-js-implementation-running-costs/' },
      { label: 'Build guide', title: 'Subscriptions with Medusa.js, Razorpay and PhonePe', href: '/blog/ecommerce/building-subscription-ecommerce-medusa-js-india/' },
    ]}
    faqTitle="Medusa.js development FAQs"
    faqs={faqs}
    cta={{ title: 'Plan your Medusa.js project', text: 'Tell us about your products, workflows and systems. We will say honestly whether Medusa, Shopify or another platform fits, and quote the scope in writing.', label: 'Book a consultation' }}
  >
    <section slot="lead" id="work" class="scroll-mt-28" aria-labelledby="work-title">
      <h2 id="work-title" class="font-heading text-2xl font-bold text-[var(--text)] sm:text-3xl">Medusa.js work we have delivered</h2>
      <p class="mt-2 max-w-3xl text-[var(--text-dim)]">What each business needed and what we built. No sales uplift or performance score is claimed here. <a href="/portfolio/#featured-work" class="font-semibold text-[var(--text)] underline underline-offset-4">See our featured portfolio work</a>.</p>
      <div class="mt-6 grid gap-6 lg:grid-cols-2">
        {work.map((w) => (
          <article class="tilt-card tilt-card--lg flex flex-col p-6 sm:p-8" style={`--card-color: var(${w.color});`}>
            <p class="text-xs font-bold uppercase tracking-[0.16em]" style={`color: var(${w.color});`}>{w.label}</p>
            <h3 class="mt-2 font-heading text-2xl font-bold text-[var(--text)]">{w.name}</h3>
            <p class="mt-5 text-xs font-bold uppercase tracking-[0.14em] text-[var(--text-muted)]">What the business needed</p>
            <p class="mt-1.5 leading-relaxed text-[var(--text-dim)]">{w.needed}</p>
            <p class="mt-5 text-xs font-bold uppercase tracking-[0.14em] text-[var(--text-muted)]">What we built</p>
            <ul class="mt-2 space-y-2" role="list">
              {w.built.map((b) => <li class="flex gap-2.5 text-sm font-semibold text-[var(--text)]"><span style={`color: var(${w.color});`} aria-hidden="true">✓</span>{b}</li>)}
            </ul>
            <div class="mt-auto flex flex-wrap gap-x-5 gap-y-2 pt-6">
              <a href={w.href} target="_blank" rel="noopener noreferrer" class="text-sm font-semibold text-[var(--text)] underline underline-offset-4">{w.link} ↗<span class="sr-only"> (opens in a new tab)</span></a>
              {w.guide && <a href={w.guide.href} class="text-sm font-semibold underline underline-offset-4" style={`color: var(${w.color});`}>{w.guide.label} →</a>}
            </div>
          </article>
        ))}
      </div>
    </section>

    <section aria-labelledby="vs-title">
      <h2 id="vs-title" class="font-heading text-2xl font-bold text-[var(--text)] sm:text-3xl">Medusa.js vs Shopify: which fits your store?</h2>
      <div class="mt-5 grid gap-4 md:grid-cols-2">
        <div class="tilt-card p-5 sm:p-6" style="--card-color: var(--svc-medusa);">
          <h3 class="font-heading text-lg font-bold text-[var(--text)]">Choose Medusa.js when</h3>
          <ul class="mt-3 space-y-2 text-sm leading-relaxed text-[var(--text-dim)]" role="list">
            <li>✓ Subscriptions, B2B pricing or fulfilment rules are unusual</li>
            <li>✓ You need owned code, data and hosting</li>
            <li>✓ ERP, PIM or warehouse integrations are central</li>
            <li>✓ Shopify Plus fees or app limits outweigh the hosting work</li>
          </ul>
        </div>
        <div class="tilt-card p-5 sm:p-6" style="--card-color: var(--svc-shopify);">
          <h3 class="font-heading text-lg font-bold text-[var(--text)]">Choose Shopify when</h3>
          <ul class="mt-3 space-y-2 text-sm leading-relaxed text-[var(--text-dim)]" role="list">
            <li>✓ A hosted platform and its apps cover your needs</li>
            <li>✓ You want the fastest launch with least operations</li>
            <li>✓ Your team should not run servers or updates</li>
            <li>✓ <a href="/services/ecommerce/#shopify" class="underline underline-offset-4">See our Shopify development service</a></li>
          </ul>
        </div>
      </div>
    </section>

    <section class="tilt-card tilt-card--lg p-6 sm:p-8" style="--card-color: var(--ac-blue);" aria-labelledby="erp-title">
      <p class="text-xs font-bold uppercase tracking-[0.16em] text-[var(--ac-blue)]">Example: scoping an integration</p>
      <h2 id="erp-title" class="mt-2 font-heading text-2xl font-bold text-[var(--text)]">Your ERP owns inventory. What do we confirm first?</h2>
      <ol class="mt-6 grid gap-5 md:grid-cols-3" role="list">
        {erpSteps.map(([t, d], i) => (
          <li>
            <span class="inline-grid h-8 w-8 place-items-center rounded-lg text-xs font-black text-[var(--ac-blue)]" style="background: color-mix(in srgb, var(--ac-blue) 15%, transparent);">{String(i + 1).padStart(2, '0')}</span>
            <h3 class="mt-3 font-semibold text-[var(--text)]">{t}</h3>
            <p class="mt-1.5 text-sm leading-relaxed text-[var(--text-dim)]">{d}</p>
          </li>
        ))}
      </ol>
      <p class="mt-6 text-sm text-[var(--text-muted)]">The same questions apply to PIM, warehouse and accounting systems. Each integration is scoped and quoted on its own; none is included by default.</p>
    </section>

    <section class="grid gap-4 lg:grid-cols-2" aria-label="Cost, hosting and partnership">
      <div class="tilt-card p-5 sm:p-6" style="--card-color: var(--ac-amber);">
        <h2 class="font-heading text-lg font-bold text-[var(--text)]">What drives Medusa.js cost and hosting</h2>
        <ul class="mt-3 grid gap-1.5 text-sm text-[var(--text-dim)] sm:grid-cols-2" role="list">
          {['Custom modules and workflows', 'Payment and shipping providers', 'ERP, PIM or WMS integrations', 'Data migration and redirects', 'Storefront design', 'Medusa Cloud or self-hosting', 'Monitoring, backups, updates', 'Support after launch'].map((item) => <li>• {item}</li>)}
        </ul>
        <a href="/blog/ecommerce/medusa-js-implementation-running-costs/" class="mt-3 inline-block text-sm font-semibold text-[var(--text)] underline underline-offset-4">Read the full cost breakdown →</a>
      </div>
      <div class="tilt-card p-5 sm:p-6" style="--card-color: var(--ac-indigo);">
        <h2 class="font-heading text-lg font-bold text-[var(--text)]">A Medusa.js partner for agencies and merchants abroad</h2>
        <p class="mt-2 text-sm leading-relaxed text-[var(--text-dim)]">We work remotely, directly with merchants or white-label behind an agency, under NDA where needed. The India working day overlaps the UK and European morning and the US evening. Scope, code ownership, hosting responsibility and handover are agreed in writing before work starts.</p>
      </div>
    </section>
  </ServicePage>
</ServiceLayout>
