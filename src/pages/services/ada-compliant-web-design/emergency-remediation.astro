---
import ServiceLayout from '../../../layouts/ServiceLayout.astro';
import AuditPrice from '../../../components/AuditPrice.astro';
import LocalPrice from '../../../components/LocalPrice.astro';
import { ACCESSIBILITY_PRICES as AP } from '../../../data/auditPricing';
import ServicePage from '../../../components/service/ServicePage.astro';
import RushAssessmentForm from '../../../islands/RushAssessmentForm';
import { breadcrumbSchema, faqSchema } from '../../../utils/schema';

/* ───────────────────────────────────────────────────────────────────────────
   Primary keyword targets (GSC + audit):
   - ada website remediation
   - ada lawsuit website fix
   - shopify accessibility remediation
   - emergency wcag remediation
   - ecommerce accessibility lawsuit
   ─────────────────────────────────────────────────────────────────────────── */

const SITE_URL = 'https://elan-tech.net';
const PAGE_URL = '/services/ada-compliant-web-design/emergency-remediation/';

const breadcrumbs = [
  { name: 'Home', href: '/' },
  { name: 'Services', href: '/services/' },
  { name: 'ADA & WCAG Compliance', href: '/services/ada-compliant-web-design/' },
  { name: 'Emergency Remediation', href: PAGE_URL },
];

// ── FAQ - questions taken from real GSC queries; wording kept close ──────
const faqs = [
  {
    question: 'My scan found 10,000+ accessibility issues - can that be fixed before my deadline?',
    answer:
      "Often, yes. Scanners count every instance on every page, so a handful of repeating template, theme, and component problems inflate into thousands of flags. We fix the underlying source - one corrected component can clear thousands of counted errors. After the rush assessment we'll tell you honestly whether your specific deadline is realistic.",
  },
  {
    question: "What's a realistic budget to remediate a Shopify site before a deadline?",
    answer:
      `A rush quick check costs US$${AP.quickCheck.USD} and a scoped rapid audit starts at US$${AP.audit.USD.toLocaleString('en-US')} (both credited toward the work if you proceed). Full code-level remediation is a fixed price quoted after the audit, with the delivery date agreed at the same time, typically US$${AP.remediationFrom.USD.toLocaleString('en-US')} to US$${AP.remediationTo.USD.toLocaleString('en-US')} for a small Shopify store, based on page count, theme complexity, custom apps and the number of unique issue types, not the raw scanner number. You approve the price before any work starts.`,
  },
  {
    question: 'Will an accessibility overlay or widget make me compliant faster?',
    answer:
      'An overlay cannot establish WCAG conformance by itself. Many barriers must be corrected in the source content, HTML, styles, and interaction design and then verified manually. We preserve evidence, remediate the source, retest the affected journeys, and document the result.',
  },
  {
    question: "Can you help if I've already received a lawsuit or demand letter?",
    answer:
      "Yes - this page exists for exactly that. We prioritise emergency assessment requests and confirm the earliest realistic start after reviewing availability and technical scope. We're not a law firm and don't give legal advice; we work alongside your attorney and provide the technical remediation and documentation they need.",
  },
  {
    question: 'Do you cover standards beyond US ADA?',
    answer:
      "Yes. We can test against WCAG 2.1 or 2.2 AA and map findings to the technical baseline identified by your legal or procurement team. Different laws have different scope, documentation, and sector requirements, so WCAG remediation should not be presented as automatic certification under every framework.",
  },
  {
    question: "I'm in the US - can your team really support my timeline?",
    answer:
      "Yes. We have built websites for clients in the US, Canada and Australia, and have worked with clients remotely since 2002. Our India working day overlaps the US evening, invoices can be in US dollars, and the people on your project, the update schedule and the contact route are agreed in writing before work starts.",
  },
];

// ── Schema: Service (+ Offer from $1,500), FAQPage, BreadcrumbList ────────
const serviceSchemaObj = {
  '@context': 'https://schema.org',
  '@type': 'Service',
  name: 'Emergency ADA & WCAG Website Remediation',
  alternateName: 'ADA Lawsuit Website Fix',
  description:
    'Emergency website accessibility assessment and code-level remediation for Shopify and ecommerce teams facing an ADA demand letter or complaint.',
  url: `${SITE_URL}${PAGE_URL}`,
  provider: {
    '@type': 'Organization',
    name: 'eLan Technology',
    url: SITE_URL,
  },
  areaServed: [
    { '@type': 'Country', name: 'United States' },
    { '@type': 'Country', name: 'Canada' },
    { '@type': 'Country', name: 'United Kingdom' },
    { '@type': 'Country', name: 'Australia' },
  ],
  serviceType: 'Website Accessibility Remediation',
  offers: {
    '@type': 'Offer',
    price: '1500',
    priceCurrency: 'USD',
    description: 'Rapid Audit + Plan - flat fee, with delivery timing confirmed after scope review, credited toward remediation',
  },
};

const schemaBreadcrumbs = breadcrumbs.map((b) => ({ name: b.name, url: b.href }));
const schemas = [serviceSchemaObj, faqSchema(faqs), breadcrumbSchema(schemaBreadcrumbs)];

// ── Section 01 - hero stat chips ──────────────────────────────────────────
const heroChips = [
  'Priority intake for emergencies',
  'Deadline-led remediation planning',
  'WCAG 2.1 / 2.2 AA testing and retest report',
  'Code-level fixes, not overlays',
];

// ── Section 02 - why speed matters cards ─────────────────────────────────
const speedCards = [
  {
    cssVar: '--ac-red',
    title: 'Demand letters escalate fast',
    desc: 'Send the document to counsel, preserve the current technical evidence, and begin a scoped audit of the affected journeys.',
    iconSvg:
      '<svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/></svg>',
  },
  {
    cssVar: '--ac-amber',
    title: '10,000+ issues is normal',
    desc: 'An automated scan flagging thousands of errors usually traces back to a few dozen repeating component and template problems. We fix the source, not each instance.',
    iconSvg:
      '<svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="18" y1="20" x2="18" y2="10"/><line x1="12" y1="20" x2="12" y2="4"/><line x1="6" y1="20" x2="6" y2="14"/></svg>',
  },
  {
    cssVar: '--ac-violet',
    title: 'Overlays make it worse',
    desc: 'We remediate the source code and provide criterion-level findings and retest status for your team and counsel.',
    iconSvg:
      '<svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M10.29 3.86L1.82 18a2 2 0 0 0 1.71 3h16.94a2 2 0 0 0 1.71-3L13.71 3.86a2 2 0 0 0-3.42 0z"/><line x1="12" y1="9" x2="12" y2="13"/><line x1="12" y1="17" x2="12.01" y2="17"/></svg>',
  },
];

// ── Section 03 - overlay vs remediation comparison ────────────────────────
const overlaySide = [
  "Sits on top of broken code - doesn't fix it",
  'Repeatedly named in ADA lawsuits',
  'Fails with the screen readers users actually rely on',
  'No criterion-level remediation evidence',
  'Monthly fee forever; the problem never goes away',
];
const remediationSide = [
  'Fixes the source HTML, ARIA, contrast & keyboard flow',
  'Manual testing with real assistive tech, not just scanners',
  'WCAG 2.1 / 2.2 AA conformance',
  'ACR preparation using a VPAT template when scoped',
  'Fixed price, defined deadline, done once',
];

// ── Section 04 - the emergency process (timeline confirmed after assessment, owner 27 Nov 2026) ─────────────────────────────
const steps = [
  {
    num: '01',
    title: 'Priority rush assessment',
    desc: 'Hybrid automated + manual audit of your store. You get a scoped issue list, timeline, and fixed quote.',
    cssVar: '--ac-cyan',
  },
  {
    num: '02',
    title: 'Prioritized fix sprint',
    desc: 'We fix the highest-risk, most-repeated violations first: templates, checkout, forms, navigation, media.',
    cssVar: '--ac-violet',
  },
  {
    num: '03',
    title: 'Verify with real AT',
    desc: 'Manual testing with screen readers and keyboard-only flows to confirm conformance, not just a passing scan.',
    cssVar: '--ac-amber',
  },
  {
    num: '04',
    title: 'Retest & handoff',
    desc: 'You receive criterion-level retest status, known limitations, and a remediation record to share with counsel - plus optional ongoing monitoring.',
    cssVar: '--ac-emerald',
  },
];

// ── Section 05 - emergency pricing tiers ──────────────────────────────────
const packages = [
  {
    name: 'Rapid Audit + Plan',
    price: 'from US$1,500',
    prices: AP.audit,
    priceNote: 'flat · delivery agreed after intake',
    desc: 'Know exactly where you stand - fast',
    cssVar: '--ac-cyan',
    features: [
      'Hybrid automated + manual audit',
      'Prioritized, scoped remediation plan',
      'Criterion-level findings summary',
      'Credited toward remediation if you proceed',
    ],
    cta: 'Start here',
    href: '#rush-assessment',
  },
  {
    name: 'Shopify Emergency Remediation',
    price: 'custom fixed quote',
    priceNote: 'deadline agreed after assessment',
    desc: 'The full emergency track, end to end',
    cssVar: '--ac-amber',
    features: [
      'Full code-level WCAG 2.1/2.2 AA remediation',
      'Theme, checkout, forms, media, PDFs',
      'Manual AT testing + re-test',
      'ACR preparation when separately scoped',
      'Priority daily-standup communication',
    ],
    cta: 'Get my fixed quote',
    href: '#rush-assessment',
    popular: true,
  },
  {
    name: 'Remediation + Monitoring',
    price: 'custom + monthly',
    priceNote: 'stay compliant after launch',
    desc: 'For stores that keep shipping new pages',
    cssVar: '--ac-violet',
    features: [
      'Everything in the emergency track',
      'Ongoing automated + periodic manual monitoring',
      'Accessibility statement maintained',
      'New-page / new-feature checks',
    ],
    cta: 'Talk to us',
    href: '/schedule-consultation/',
  },
];

const standardsBadges = [
  'WCAG 2.1 & 2.2 AA',
  'ADA Title III',
  'Section 508',
  'EAA (EU)',
  'AODA / ACA (Canada)',
  'DDA (Australia)',
  'VPAT 2.5',
];
---
<ServiceLayout
  title="Emergency ADA Remediation for Shopify & Ecommerce Deadlines | eLan Technology"
  description="ADA demand letter or complaint? Get an urgent accessibility assessment, code-level WCAG remediation, retesting, and criterion-level documentation."
  canonical={`${SITE_URL}${PAGE_URL}`}
  schema={schemas}
  breadcrumbs={breadcrumbs}
>
  <ServicePage
    accentVar="--svc-emergency"
    eyebrow="Emergency ADA remediation · Shopify and ecommerce"
    heading="Urgent Accessibility Help for a Legal Deadline"
    intro="Received a demand letter or lawsuit deadline? We prioritise emergency assessment requests, with a target response within 48 hours, and confirm a realistic start after reviewing availability and technical scope. Then we fix the source code, retest with real assistive technology and document the result for you and your counsel."
    highlights={heroChips}
    primaryCta={{ label: 'Request a rush assessment', href: '#rush-assessment' }}
    secondaryCta={{ label: 'ADA remediation services', href: '/services/ada-compliant-web-design/' }}
    offersTitle="If you've received a letter, the clock is already running"
    offersIntro="Share the document with qualified legal counsel and preserve the current technical evidence. We provide the parallel engineering response: scoped testing, code-level remediation, retesting, and accurate documentation."
    offers={speedCards.map(({ title, desc }) => ({ title, text: desc }))}
    processTitle="The emergency track, with dates confirmed after assessment"
    process={steps.map(({ title, desc }) => ({ title, text: desc }))}
    fit={['You received an ADA demand letter, complaint or lawsuit.', 'A scan found thousands of issues and you need a plan fast.', 'Your Shopify or ecommerce checkout must be fixed before a deadline.', 'You need criterion-level evidence to share with counsel.']}
    note="Our role is technical; your attorney should direct the legal response. This page is general information, not legal advice."
    faqTitle="Questions store owners ask first"
    faqs={faqs}
    cta={{ title: "Don't wait for the deadline to pass", text: 'Send us your store URL and deadline. We will confirm the assessment scope, testing methods, timeline, deliverables, and fixed price before remediation begins.', label: 'Start the rush assessment', href: '#rush-assessment' }}
  >
    <aside slot="lead" class="tilt-card tilt-card--lg flex flex-col gap-4 p-6 sm:flex-row sm:items-center sm:justify-between sm:p-7" style="--card-color: var(--ac-red);" aria-label="Rush assessment">
      <div>
        <p class="font-heading text-xl font-bold text-[var(--text)]">Have a demand letter or a deadline?</p>
        <p class="mt-1 text-sm leading-relaxed text-[var(--text-dim)]">Send the website and the deadline. Target response within 48 hours; scope, price and delivery dates are confirmed after review.</p>
      </div>
      <a href="#rush-assessment" class="inline-flex min-h-11 shrink-0 items-center justify-center rounded-lg bg-[var(--accent)] px-5 py-2.5 text-sm font-bold text-white transition hover:brightness-110">Request a rush assessment</a>
    </aside>

    <section class="grid gap-4 md:grid-cols-2" aria-labelledby="overlay-title">
      <h2 id="overlay-title" class="sr-only">Overlay widget vs. real remediation</h2>
      <div class="tilt-card p-5 sm:p-6" style="--card-color: var(--ac-red);">
        <h3 class="font-heading text-lg font-bold text-[var(--text)]">Overlay widget</h3>
        <ul class="mt-3 space-y-1.5 text-sm text-[var(--text-dim)]" role="list">{overlaySide.map((item) => <li>✕ {item}</li>)}</ul>
      </div>
      <div class="tilt-card p-5 sm:p-6" style="--card-color: var(--ac-emerald);">
        <h3 class="font-heading text-lg font-bold text-[var(--text)]">Real remediation</h3>
        <ul class="mt-3 space-y-1.5 text-sm text-[var(--text-dim)]" role="list">{remediationSide.map((item) => <li>✓ {item}</li>)}</ul>
      </div>
    </section>

    <section aria-labelledby="pricing-title">
      <h2 id="pricing-title" class="font-heading text-2xl font-bold text-[var(--text)] sm:text-3xl">Transparent emergency pricing</h2>
      <ul class="mt-5 grid gap-4 md:grid-cols-3" role="list">
        {packages.map((pkg) => (
          <li class="tilt-card tilt-card--lg flex flex-col p-5 sm:p-6" style={`--card-color: var(${pkg.cssVar});`}>
            <h3 class="font-heading text-lg font-bold text-[var(--text)]">{pkg.name}{pkg.popular && <span class="ml-2 rounded-md px-2 py-0.5 text-xs font-semibold" style="color: var(--card-color); background: color-mix(in srgb, var(--card-color) 15%, transparent);">Most chosen</span>}</h3>
            <p class="mt-0.5 text-sm text-[var(--text-dim)]">{pkg.desc}</p>
            <p class="mt-3 font-heading text-2xl font-bold text-[var(--text)]">{'prices' in pkg && pkg.prices ? <>from <LocalPrice prices={pkg.prices} /></> : pkg.price}</p>
            <p class="text-xs text-[var(--text-muted)]">{pkg.priceNote}</p>
            <ul class="mt-3 space-y-1.5 text-sm text-[var(--text-dim)]" role="list">{pkg.features.map((f) => <li>✓ {f}</li>)}</ul>
            <a href={pkg.href} class="mt-auto pt-4 text-sm font-semibold underline underline-offset-4" style="color: var(--card-color);">{pkg.cta} →</a>
          </li>
        ))}
      </ul>
      <ul class="mt-4 flex flex-wrap gap-1.5" role="list" aria-label="Standards covered">
        {standardsBadges.map((b) => <li class="rounded-md border border-[var(--border)] bg-[var(--bg-card)] px-2 py-1 text-xs font-semibold text-[var(--text)]">{b}</li>)}
      </ul>
    </section>

    <section id="rush-assessment" class="tilt-card tilt-card--lg scroll-mt-28 p-6 sm:p-8" style="--card-color: var(--svc-emergency);" aria-labelledby="rush-form-heading">
      <div class="mx-auto max-w-2xl">
        <h2 id="rush-form-heading" class="font-heading text-2xl font-bold text-[var(--text)] sm:text-3xl">Rush accessibility assessment</h2>
        <p class="mt-2 mb-6 text-[var(--text-dim)]">Share the public website URL and an optional target date. We will review the technical request and contact you with the next available steps. The rush quick check costs <AuditPrice kind="accessibility" from={false} class="font-semibold text-[var(--text)]" />, is credited toward the full audit and is confirmed before any work begins. For US and other international organisations.</p>
        <RushAssessmentForm client:load />
      </div>
    </section>
  </ServicePage>
</ServiceLayout>
