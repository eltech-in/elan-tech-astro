---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import Breadcrumb from '../../../components/Breadcrumb.astro';
import ChapterLabel from '../../../components/ChapterLabel.astro';
import LocationsCloud from '../../../components/LocationsCloud.astro';
import RushAssessmentForm from '../../../islands/RushAssessmentForm';
import { breadcrumbSchema, faqSchema } from '../../../utils/schema';

/* ───────────────────────────────────────────────────────────────────────────
   Primary keyword targets (GSC + audit):
   - ada website remediation
   - ada lawsuit website fix
   - shopify accessibility remediation
   - emergency wcag remediation
   - ecommerce accessibility lawsuit
   ─────────────────────────────────────────────────────────────────────────── */

const SITE_URL = 'https://elan-tech.net';
const PAGE_URL = '/services/ada-compliant-web-design/emergency-remediation/';

const breadcrumbs = [
  { name: 'Home', href: '/' },
  { name: 'Services', href: '/services/' },
  { name: 'ADA & WCAG Compliance', href: '/services/ada-compliant-web-design/' },
  { name: 'Emergency Remediation', href: PAGE_URL },
];

// ── FAQ — questions taken from real GSC queries; wording kept close ──────
const faqs = [
  {
    question: 'My scan found 10,000+ accessibility issues — is that even fixable in 30 days?',
    answer:
      "Almost always, yes. Scanners count every instance on every page, so a handful of repeating template, theme, and component problems inflate into thousands of flags. We fix the underlying source — one corrected component can clear thousands of counted errors. After the rush assessment we'll tell you honestly whether your specific deadline is realistic.",
  },
  {
    question: "What's a realistic budget to remediate a Shopify site before a deadline?",
    answer:
      'A scoped rapid audit starts at a $1,500 flat fee (credited toward the work if you proceed). Full 30-day code-level remediation is a fixed price quoted after the audit — based on page count, theme complexity, custom apps, and the number of unique issue types, not the raw scanner number. You approve the price before any work starts.',
  },
  {
    question: 'Will an accessibility overlay or widget make me compliant faster?',
    answer:
      'No — and it can increase your legal risk. Overlays have themselves been named in ADA lawsuits and are frequently rejected by the assistive-technology users plaintiffs rely on. Courts look for genuine conformance and documentation. We remediate the actual code and give you a defensible VPAT.',
  },
  {
    question: "Can you help if I've already received a lawsuit or demand letter?",
    answer:
      "Yes — this page exists for exactly that. We can begin an emergency assessment within 24 hours and produce a documented remediation plan, often the single most useful thing to show you're acting in good faith. We're not a law firm and don't give legal advice; we work alongside your attorney and provide the technical remediation and documentation they need.",
  },
  {
    question: 'Do you cover standards beyond US ADA?',
    answer:
      "Yes. The same remediation gives multi-standard coverage: WCAG 2.1/2.2 AA, US ADA Title III & Section 508, the EU's European Accessibility Act (EAA), Canada's AODA/ACA, and Australia's DDA. One properly remediated store satisfies all of them.",
  },
  {
    question: "I'm in the US — can your team really support my timeline?",
    answer:
      "Yes. We've delivered for US, Canadian, UK, and Australian clients since 2002, with overlapping US business-hours coverage, USD invoicing, and daily standups during emergency engagements. You get a named team, not a ticket queue.",
  },
];

// ── Schema: Service (+ Offer from $1,500), FAQPage, BreadcrumbList ────────
const serviceSchemaObj = {
  '@context': 'https://schema.org',
  '@type': 'Service',
  name: 'Emergency ADA & WCAG Website Remediation',
  alternateName: 'ADA Lawsuit Website Fix',
  description:
    'Emergency ADA website remediation for Shopify and ecommerce stores facing a demand letter or lawsuit deadline. Code-level WCAG 2.1/2.2 AA fixes in under 30 days, with VPAT 2.5 documentation.',
  url: `${SITE_URL}${PAGE_URL}`,
  provider: {
    '@type': 'Organization',
    name: 'eLan Technology',
    url: SITE_URL,
  },
  areaServed: [
    { '@type': 'Country', name: 'United States' },
    { '@type': 'Country', name: 'Canada' },
    { '@type': 'Country', name: 'United Kingdom' },
    { '@type': 'Country', name: 'Australia' },
  ],
  serviceType: 'Website Accessibility Remediation',
  offers: {
    '@type': 'Offer',
    price: '1500',
    priceCurrency: 'USD',
    description: 'Rapid Audit + Plan — flat fee, delivered in 24–72 hours, credited toward remediation',
  },
};

const schemaBreadcrumbs = breadcrumbs.map((b) => ({ name: b.name, url: b.href }));
const schemas = [serviceSchemaObj, faqSchema(faqs), breadcrumbSchema(schemaBreadcrumbs)];

// ── Section 01 — hero stat chips ──────────────────────────────────────────
const heroChips = [
  '24-hr start on emergencies',
  '<30 days to conformance',
  'WCAG 2.1 / 2.2 AA + VPAT 2.5',
  'Code-level fixes, not overlays',
];

// ── Section 02 — why speed matters cards ─────────────────────────────────
const speedCards = [
  {
    cssVar: '--ac-red',
    title: 'Demand letters escalate fast',
    desc: 'Ignoring a letter, or relying on a quick-fix widget, is what turns a letter into a filed lawsuit. A documented remediation plan is your strongest response.',
    iconSvg:
      '<svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/></svg>',
  },
  {
    cssVar: '--ac-amber',
    title: '10,000+ issues is normal',
    desc: 'An automated scan flagging thousands of errors usually traces back to a few dozen repeating component and template problems. We fix the source, not each instance.',
    iconSvg:
      '<svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="18" y1="20" x2="18" y2="10"/><line x1="12" y1="20" x2="12" y2="4"/><line x1="6" y1="20" x2="6" y2="14"/></svg>',
  },
  {
    cssVar: '--ac-violet',
    title: 'Overlays make it worse',
    desc: 'Accessibility overlay/widget tools have been named in lawsuits themselves. We remediate the actual code and give you a VPAT you can hand to opposing counsel.',
    iconSvg:
      '<svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M10.29 3.86L1.82 18a2 2 0 0 0 1.71 3h16.94a2 2 0 0 0 1.71-3L13.71 3.86a2 2 0 0 0-3.42 0z"/><line x1="12" y1="9" x2="12" y2="13"/><line x1="12" y1="17" x2="12.01" y2="17"/></svg>',
  },
];

// ── Section 03 — overlay vs remediation comparison ────────────────────────
const overlaySide = [
  "Sits on top of broken code — doesn't fix it",
  'Repeatedly named in ADA lawsuits',
  'Fails with the screen readers users actually rely on',
  'No defensible documentation for court',
  'Monthly fee forever; the problem never goes away',
];
const remediationSide = [
  'Fixes the source HTML, ARIA, contrast & keyboard flow',
  'Manual testing with real assistive tech, not just scanners',
  'WCAG 2.1 / 2.2 AA conformance',
  'VPAT 2.5 / ACR documentation for your legal team',
  'Fixed price, defined deadline, done once',
];

// ── Section 04 — the 30-day emergency process ─────────────────────────────
const steps = [
  {
    num: '01',
    title: 'Rush assessment (24–48 hrs)',
    desc: 'Hybrid automated + manual audit of your store. You get a scoped issue list, timeline, and fixed quote.',
    cssVar: '--ac-cyan',
  },
  {
    num: '02',
    title: 'Prioritized fix sprint',
    desc: 'We fix the highest-risk, most-repeated violations first: templates, checkout, forms, navigation, media.',
    cssVar: '--ac-violet',
  },
  {
    num: '03',
    title: 'Verify with real AT',
    desc: 'Manual testing with screen readers and keyboard-only flows to confirm conformance, not just a passing scan.',
    cssVar: '--ac-amber',
  },
  {
    num: '04',
    title: 'VPAT & handoff',
    desc: 'You receive a VPAT 2.5 / ACR and remediation report to share with counsel — plus optional ongoing monitoring.',
    cssVar: '--ac-emerald',
  },
];

// ── Section 05 — emergency pricing tiers ──────────────────────────────────
const packages = [
  {
    name: 'Rapid Audit + Plan',
    price: 'from $1,500',
    priceNote: 'flat · delivered 24–72 hrs',
    desc: 'Know exactly where you stand — fast',
    cssVar: '--ac-cyan',
    features: [
      'Hybrid automated + manual audit',
      'Prioritized, scoped remediation plan',
      'VPAT-ready findings summary',
      'Credited toward remediation if you proceed',
    ],
    cta: 'Start here',
    href: '#rush-assessment',
  },
  {
    name: '30-Day Shopify Remediation',
    price: 'custom fixed quote',
    priceNote: 'conformance in <30 days',
    desc: 'The full emergency track, end to end',
    cssVar: '--ac-amber',
    features: [
      'Full code-level WCAG 2.1/2.2 AA remediation',
      'Theme, checkout, forms, media, PDFs',
      'Manual AT testing + re-test',
      'VPAT 2.5 / ACR documentation',
      'Priority daily-standup communication',
    ],
    cta: 'Get my fixed quote',
    href: '#rush-assessment',
    popular: true,
  },
  {
    name: 'Remediation + Monitoring',
    price: 'custom + monthly',
    priceNote: 'stay compliant after launch',
    desc: 'For stores that keep shipping new pages',
    cssVar: '--ac-violet',
    features: [
      'Everything in the 30-day track',
      'Ongoing automated + periodic manual monitoring',
      'Accessibility statement maintained',
      'New-page / new-feature checks',
    ],
    cta: 'Talk to us',
    href: '/schedule-consultation/',
  },
];

const standardsBadges = [
  'WCAG 2.1 & 2.2 AA',
  'ADA Title III',
  'Section 508',
  'EAA (EU)',
  'AODA / ACA (Canada)',
  'DDA (Australia)',
  'VPAT 2.5',
];
---

<BaseLayout
  title="Emergency ADA & Shopify Remediation in 30 Days | eLan Technology"
  description="ADA demand letter or lawsuit deadline? We remediate Shopify & ecommerce sites with 10,000+ WCAG issues in under 30 days — code-level fixes, VPAT included."
  canonical={`${SITE_URL}${PAGE_URL}`}
  schema={schemas}
>
  <!-- Breadcrumb bar — same sticky pattern as service pages -->
  <div class="sticky top-[68px] sm:top-[76px] z-40 border-b border-[var(--border)] bg-[var(--bg)] px-4 py-3 sm:px-6 lg:px-8">
    <div class="mx-auto max-w-7xl">
      <Breadcrumb items={breadcrumbs} />
    </div>
  </div>

  <!-- ═══════════════════════════════════════════════════════════════════════
       SECTION 01: HERO — kicker pill → H1 → subhead → context → chips → CTAs
  ════════════════════════════════════════════════════════════════════════ -->
  <section aria-labelledby="emergency-hero-heading" class="relative overflow-hidden bg-gradient-to-br from-[var(--bg)] to-[var(--bg-card)] px-4 py-16 md:py-24 sm:px-6 lg:px-8">
    <div
      class="pointer-events-none absolute -top-40 left-1/2 h-96 w-96 -translate-x-1/2 rounded-full bg-[var(--ac-red)]/10 blur-3xl"
      aria-hidden="true"
    ></div>

    <div class="relative mx-auto max-w-4xl text-center">
      <div class="mb-6 inline-flex items-center gap-2 rounded-full border px-4 py-2 text-xs sm:text-sm font-semibold uppercase tracking-widest" style="border-color: color-mix(in srgb, var(--ac-red) 35%, transparent); background: color-mix(in srgb, var(--ac-red) 10%, transparent); color: var(--ac-red);">
        <span class="h-2 w-2 rounded-full bg-[var(--ac-red)] animate-pulse" aria-hidden="true"></span>
        Emergency ADA &amp; WCAG Remediation
      </div>

      <h1 id="emergency-hero-heading" class="font-heading text-4xl font-bold leading-tight text-[var(--text)] sm:text-5xl lg:text-6xl">
        Fix your website accessibility before the deadline — not after the lawsuit.
      </h1>

      <p class="mx-auto mt-5 max-w-3xl text-lg leading-relaxed text-[var(--text-dim)]">
        Facing an ADA demand letter or a lawsuit deadline on your Shopify or ecommerce store? We remediate sites with 10,000+ WCAG issues in under 30 days.
      </p>

      <p class="mt-3 text-sm text-[var(--text-muted)]">
        Real code-level fixes — not an overlay widget that gets you sued anyway. Accessibility-first studio since 2002.
      </p>

      <!-- Stat chips -->
      <ul class="mt-8 flex flex-wrap justify-center gap-3" role="list">
        {heroChips.map((chip) => (
          <li class="inline-flex items-center gap-2 rounded-full border border-[var(--border)] bg-[var(--bg-card)]/60 px-4 py-2 text-sm text-[var(--text)] backdrop-blur-sm">
            <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="var(--accent)" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polyline points="20 6 9 17 4 12"/></svg>
            {chip}
          </li>
        ))}
      </ul>

      <div class="mt-10 flex flex-col items-center gap-4 sm:flex-row sm:justify-center">
        <a
          href="#rush-assessment"
          class="inline-flex items-center gap-2 rounded-full bg-[var(--accent)] px-8 py-3 text-base font-semibold text-[var(--bg)] shadow-lg transition-opacity duration-150 hover:opacity-90 focus-visible:outline focus-visible:outline-2 focus-visible:outline-[var(--accent)] focus-visible:outline-offset-2"
        >
          Request Rush Assessment
          <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><line x1="5" y1="12" x2="19" y2="12"/><polyline points="12 5 19 12 12 19"/></svg>
        </a>
        <a
          href="#pricing"
          class="inline-flex items-center gap-2 rounded-full border border-[var(--border)] bg-[var(--bg-card)] px-8 py-3 text-base font-semibold text-[var(--text)] transition-colors duration-150 hover:border-[var(--accent)] hover:text-[var(--accent)] focus-visible:outline focus-visible:outline-2 focus-visible:outline-[var(--accent)] focus-visible:outline-offset-2"
        >
          See Pricing &amp; Timelines
        </a>
      </div>
    </div>
  </section>

  <!-- Urgency strip — page-specific, directly under the hero -->
  <div class="border-y px-4 py-3 sm:px-6 lg:px-8 text-center" style="border-color: color-mix(in srgb, var(--ac-red) 30%, transparent); background: color-mix(in srgb, var(--ac-red) 8%, var(--bg));">
    <p class="mx-auto max-w-4xl text-sm font-medium text-[var(--text)]">
      Received a demand letter or lawsuit deadline? <strong>We start emergency remediations within 24 hours</strong> — with US business-hours coverage.
    </p>
  </div>

  <!-- ═══════════════════════════════════════════════════════════════════════
       SECTION 02: THE CLOCK IS ALREADY RUNNING
  ════════════════════════════════════════════════════════════════════════ -->
  <section aria-labelledby="clock-heading" class="py-16 md:py-24">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
      <ChapterLabel number="02" label="Why speed matters" class="mb-6" />
      <h2 id="clock-heading" class="font-heading text-3xl sm:text-4xl md:text-5xl font-bold text-[var(--text)] text-center mb-4">
        If you've received a letter, the clock is already running.
      </h2>
      <p class="text-lg text-[var(--text-dim)] text-center mb-12 max-w-3xl mx-auto">
        ADA web-accessibility demand letters typically give a short window to respond before litigation escalates. Overlay widgets won't save you — courts and plaintiffs' firms have repeatedly shown they don't make a site compliant. You need documented, code-level remediation, fast.
      </p>

      <ul class="grid grid-cols-1 md:grid-cols-3 gap-5" role="list">
        {speedCards.map((card) => (
          <li>
            <article
              class="relative flex flex-col h-full overflow-hidden rounded-2xl border border-[var(--border)] p-6 md:p-7 transition-all duration-300 hover:-translate-y-1 hover:shadow-xl"
              style={`background: linear-gradient(135deg, color-mix(in srgb, var(${card.cssVar}) 10%, var(--bg-card)) 0%, var(--bg-card) 65%);`}
            >
              <span
                aria-hidden="true"
                class="pointer-events-none absolute -right-8 -bottom-8 h-36 w-36 rotate-[-20deg] opacity-[0.08]"
                style={`background: var(${card.cssVar});`}
              ></span>
              <div
                class="relative mb-4 flex h-12 w-12 items-center justify-center rounded-xl"
                style={`background: color-mix(in srgb, var(${card.cssVar}) 16%, transparent); color: var(${card.cssVar});`}
                aria-hidden="true"
                set:html={card.iconSvg}
              />
              <h3 class="relative font-heading text-lg font-bold text-[var(--text)] mb-3">{card.title}</h3>
              <p class="relative text-sm text-[var(--text-dim)] leading-relaxed">{card.desc}</p>
            </article>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <!-- ═══════════════════════════════════════════════════════════════════════
       SECTION 03: OVERLAY VS. REAL REMEDIATION
  ════════════════════════════════════════════════════════════════════════ -->
  <section aria-labelledby="overlay-heading" class="bg-[var(--bg-card)] py-16 md:py-24 border-y border-[var(--border)]">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
      <ChapterLabel number="03" label="The difference that holds up" class="mb-6" />
      <h2 id="overlay-heading" class="font-heading text-3xl sm:text-4xl md:text-5xl font-bold text-[var(--text)] text-center mb-12">
        Overlay widget vs. real remediation.
      </h2>

      <div class="grid gap-6 lg:grid-cols-2 max-w-5xl mx-auto">
        <!-- Left: overlay / widget (risk) -->
        <article
          class="relative overflow-hidden rounded-2xl border p-7 md:p-8"
          style="border-color: color-mix(in srgb, var(--ac-red) 35%, var(--border)); background: linear-gradient(135deg, color-mix(in srgb, var(--ac-red) 10%, var(--bg)) 0%, var(--bg) 65%);"
        >
          <span
            aria-hidden="true"
            class="pointer-events-none absolute -right-10 -bottom-10 h-48 w-48 rotate-[-20deg] opacity-[0.07]"
            style="background: var(--ac-red);"
          ></span>
          <h3 class="relative font-heading text-xl font-bold mb-5 flex items-center gap-2" style="color: var(--ac-red);">
            <span aria-hidden="true">❌</span> Overlay / accessibility widget
          </h3>
          <ul class="relative space-y-3" role="list">
            {overlaySide.map((item) => (
              <li class="flex items-start gap-2.5 text-sm text-[var(--text-dim)]">
                <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="var(--ac-red)" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" class="flex-shrink-0 mt-0.5" aria-hidden="true"><line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/></svg>
                {item}
              </li>
            ))}
          </ul>
        </article>

        <!-- Right: eLan code-level remediation (brand) -->
        <article
          class="relative overflow-hidden rounded-2xl border p-7 md:p-8"
          style="border-color: color-mix(in srgb, var(--ac-emerald) 40%, var(--border)); background: linear-gradient(135deg, color-mix(in srgb, var(--ac-emerald) 10%, var(--bg)) 0%, var(--bg) 65%);"
        >
          <span
            aria-hidden="true"
            class="pointer-events-none absolute -right-10 -bottom-10 h-48 w-48 rotate-[-20deg] opacity-[0.07]"
            style="background: var(--ac-emerald);"
          ></span>
          <h3 class="relative font-heading text-xl font-bold mb-5 flex items-center gap-2" style="color: var(--ac-emerald);">
            <span aria-hidden="true">✅</span> eLan code-level remediation
          </h3>
          <ul class="relative space-y-3" role="list">
            {remediationSide.map((item) => (
              <li class="flex items-start gap-2.5 text-sm text-[var(--text-dim)]">
                <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="var(--ac-emerald)" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" class="flex-shrink-0 mt-0.5" aria-hidden="true"><polyline points="20 6 9 17 4 12"/></svg>
                {item}
              </li>
            ))}
          </ul>
        </article>
      </div>
    </div>
  </section>

  <!-- ═══════════════════════════════════════════════════════════════════════
       SECTION 04: THE 30-DAY EMERGENCY PROCESS
  ════════════════════════════════════════════════════════════════════════ -->
  <section aria-labelledby="process-heading" class="py-16 md:py-24">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
      <ChapterLabel number="04" label="How it works" class="mb-6" />
      <h2 id="process-heading" class="font-heading text-3xl sm:text-4xl md:text-5xl font-bold text-[var(--text)] text-center mb-4">
        The 30-day emergency track.
      </h2>
      <p class="text-lg text-[var(--text-dim)] text-center mb-12 max-w-2xl mx-auto">
        A compressed, deadline-driven version of our standard remediation process.
      </p>

      <ol class="grid gap-5 sm:grid-cols-2 lg:grid-cols-4" role="list">
        {steps.map((s) => (
          <li>
            <article
              class="relative h-full overflow-hidden rounded-2xl border border-[var(--border)] bg-[var(--bg-card)] p-6 md:p-7 transition-all duration-300 hover:-translate-y-1 hover:shadow-xl"
              style={`--step-color: var(${s.cssVar});`}
            >
              <span
                aria-hidden="true"
                class="pointer-events-none absolute top-2 right-3 font-heading font-black leading-none select-none text-[5rem]"
                style={`color: var(${s.cssVar}); opacity: 0.16;`}
              >
                {s.num}
              </span>
              <span
                aria-hidden="true"
                class="pointer-events-none absolute -left-6 -bottom-6 h-28 w-28 rotate-[-20deg] opacity-[0.08]"
                style={`background: var(${s.cssVar});`}
              ></span>
              <span class="relative text-[10px] font-bold uppercase tracking-[0.22em]" style={`color: var(${s.cssVar});`}>
                Phase · {s.num}
              </span>
              <h3 class="relative mt-3 font-heading font-bold text-[var(--text)] text-lg mb-2">
                {s.title}
              </h3>
              <p class="relative text-sm text-[var(--text-dim)] leading-relaxed">
                {s.desc}
              </p>
            </article>
          </li>
        ))}
      </ol>
    </div>
  </section>

  <!-- ═══════════════════════════════════════════════════════════════════════
       SECTION 05: TRANSPARENT EMERGENCY PRICING
  ════════════════════════════════════════════════════════════════════════ -->
  <section id="pricing" aria-labelledby="pricing-heading" class="bg-[var(--bg-card)] py-16 md:py-24 border-y border-[var(--border)] scroll-mt-24">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
      <ChapterLabel number="05" label="Investment" class="mb-6" />
      <h2 id="pricing-heading" class="font-heading text-3xl sm:text-4xl md:text-5xl font-bold text-[var(--text)] text-center mb-4">
        Transparent emergency pricing.
      </h2>
      <p class="text-lg text-[var(--text-dim)] text-center mb-12 max-w-2xl mx-auto">
        Fixed-scope pricing so you know the cost and the deadline up front. Final quote follows the free rush assessment; ranges below are typical for ecommerce stores.
      </p>

      <ul class="grid gap-6 sm:grid-cols-3" role="list">
        {packages.map((pkg) => (
          <li class:list={[pkg.popular ? 'sm:-translate-y-2' : '']}>
            <article
              class:list={[
                'relative h-full overflow-hidden rounded-2xl border p-8 transition-all duration-300 hover:-translate-y-1 hover:shadow-xl',
                pkg.popular ? 'border-[var(--accent)] shadow-lg shadow-[var(--accent)]/10' : 'border-[var(--border)]',
              ]}
              style={`background: linear-gradient(135deg, color-mix(in srgb, var(${pkg.cssVar}) 12%, var(--bg)) 0%, var(--bg) 70%);`}
            >
              {pkg.popular && (
                <div
                  class="absolute -top-3 left-1/2 -translate-x-1/2 rounded-full px-4 py-1 text-xs font-bold text-[var(--bg)]"
                  style={`background: var(${pkg.cssVar});`}
                >
                  Most urgent
                </div>
              )}
              <span
                aria-hidden="true"
                class="pointer-events-none absolute -right-10 -bottom-10 h-48 w-48 rotate-[-20deg] opacity-[0.07]"
                style={`background: var(${pkg.cssVar});`}
              ></span>

              <div class="relative">
                <span class="text-[10px] font-bold uppercase tracking-[0.22em]" style={`color: var(${pkg.cssVar});`}>
                  Emergency track
                </span>
                <h3 class="font-heading text-2xl font-bold text-[var(--text)] mt-2 mb-1">
                  {pkg.name}
                </h3>
                <p class="text-sm text-[var(--text-muted)] mb-5">{pkg.desc}</p>
                <div class="mb-1 font-heading text-3xl font-black" style={`color: var(${pkg.cssVar});`}>
                  {pkg.price}
                </div>
                <p class="text-xs text-[var(--text-muted)] mb-6">{pkg.priceNote}</p>
                <ul class="space-y-3 mb-8" role="list">
                  {pkg.features.map((f) => (
                    <li class="flex items-start gap-2 text-sm text-[var(--text-dim)]">
                      <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" class="shrink-0 mt-0.5" aria-hidden="true" style={`color: var(${pkg.cssVar});`}>
                        <polyline points="20 6 9 17 4 12" />
                      </svg>
                      {f}
                    </li>
                  ))}
                </ul>
                <a
                  href={pkg.href}
                  class:list={[
                    'block w-full rounded-full py-3 text-center font-semibold transition-opacity',
                    pkg.popular ? 'text-[var(--bg)] hover:opacity-90' : 'border border-[var(--border)] hover:opacity-90',
                  ]}
                  style={pkg.popular ? `background: var(${pkg.cssVar}); color: #fff;` : `color: var(${pkg.cssVar}); border-color: color-mix(in srgb, var(${pkg.cssVar}) 50%, var(--border));`}
                >
                  {pkg.cta}
                </a>
              </div>
            </article>
          </li>
        ))}
      </ul>

