---
import ServiceLayout from '../../layouts/ServiceLayout.astro';
import ServicePage from '../../components/service/ServicePage.astro';
import { services } from '../../data/services';
import { serviceSchema, faqSchema, breadcrumbSchema } from '../../utils/schema';

// Rewritten 27 Nov 2026: compact, search-literal page in the shared service layout.
const service = services.find((s) => s.slug === 'digital-marketing')!;
const title = "Digital Marketing Agency in Nagpur | Google Ads, SEO & Social Media";
const description = "Digital marketing from Nagpur for businesses across India: Google Ads, SEO, social media, content and email marketing, with GA4 tracking and plain-English monthly reporting.";

const serviceFaqs = [
  {
    question: 'How long before I see SEO results?',
    answer: 'SEO is normally a medium-to-long-term activity. Timing depends on the website, competition, demand, content, technical constraints and search-engine changes. We agree baseline measures and reporting, but do not guarantee a ranking, traffic level or fixed results date.',
  },
  {
    question: 'Do you manage Google Ads campaigns?',
    answer: 'Google Ads work can include Search, Display, Performance Max, Shopping or YouTube where suitable. The proposal identifies campaign types, account ownership, approvals, media budget, landing-page responsibility, tracking configuration and reporting. Platform spend and third-party tools are separate unless expressly included.',
  },
  {
    question: "What's included in an SEO audit?",
    answer: "Our SEO audit covers four pillars: technical SEO (crawlability, site speed, Core Web Vitals, mobile-friendliness, structured data), on-page SEO (title tags, meta descriptions, heading structure, content gaps, keyword targeting), backlink analysis (quality, toxicity, opportunities), and competitive analysis (what your top competitors rank for and how). You receive a prioritised action plan, not just a report.",
  },
  {
    question: 'Can you help with social media marketing?',
    answer: 'Yes. We manage organic social media presence and paid social advertising across Facebook, Instagram, LinkedIn, and YouTube. Our social media services include content strategy, creative production (graphics and short-form video), community management, influencer outreach, and paid campaign management with detailed performance reporting.',
  },
  {
    question: 'Do you provide monthly reports?',
    answer: 'The selected retainer states the reporting frequency and review meetings. Reports can cover agreed organic and paid measures, spend, attributed actions, completed work and next priorities. Attribution and ROAS depend on the approved measurement setup and should not be treated as a guaranteed business outcome.',
  },
];

const breadcrumbs = [
  { name: 'Home', href: '/' },
  { name: 'Services', href: '/services/' },
  { name: service.title, href: `/services/${service.slug}/` },
];
const schemas = [
  serviceSchema(title, description, `/services/${service.slug}/`),
  faqSchema(serviceFaqs),
  breadcrumbSchema(breadcrumbs.map((b) => ({ name: b.name, url: b.href }))),
];
---
<ServiceLayout title={title} description={description} breadcrumbs={breadcrumbs} schema={schemas}>
  <ServicePage
    accentVar={service.cssVar}
    highlights={service.features.slice(0, 6)}
    eyebrow={"Digital marketing agency · Nagpur, serving India"}
    heading={"Digital Marketing Agency in Nagpur Focused on Real Enquiries"}
    intro={"We plan and run Google Ads, SEO, social media, content and email marketing around one goal: more qualified enquiries and sales. Tracking is set up first, so every rupee and every result is visible."}
    offersTitle={"What our digital marketing service includes"}
    offers={[{"title": "Google Ads (PPC)", "text": "Search, Display, Shopping and Performance Max with keyword research, ad copy and conversion tracking."}, {"title": "SEO", "text": "Technical, on-page and content SEO aimed at high-intent searches."}, {"title": "Social media marketing", "text": "Organic and paid campaigns on Facebook, Instagram, LinkedIn and YouTube."}, {"title": "Content marketing", "text": "Landing pages, blog posts and case studies that educate and rank."}, {"title": "Email marketing", "text": "Drip sequences, campaigns and abandoned-cart flows on Mailchimp, Klaviyo or your platform."}, {"title": "Local SEO", "text": "Google Business Profile, citations, reviews and city targeting."}, {"title": "Analytics and tracking", "text": "GA4, Google Tag Manager, conversion goals and dashboards."}, {"title": "Conversion optimisation", "text": "Landing-page tests, form improvements and clearer calls to action."}]}
    process={[{"title": "Discovery and audit", "text": "Website, rankings, ad accounts, social channels and analytics reviewed."}, {"title": "90-day plan", "text": "Targets, content, campaigns and budgets approved before any spend."}, {"title": "Execution", "text": "SEO, ads, content and social run together, with weekly updates."}, {"title": "Report and optimise", "text": "Monthly reports and calls; scale what works, pause what does not."}]}
    fit={["You want enquiries, not just likes or impressions.", "Ads run without proper conversion tracking.", "You need one team across search, ads and social.", "You serve Nagpur, central India or customers nationwide."]}
    faqTitle={"Digital marketing FAQs"}
    cta={{"title": "Grow enquiries you can measure", "text": "Tell us your goals and budget. We will propose a 90-day plan with tracking set up before any spend."}}
    note={"Media spend, platform charges and third-party tools are separate unless expressly included. Reach, leads, sales and ROAS are not guaranteed."}
    guides={[{"label": "Local SEO", "title": "SEO guide for small businesses in Nagpur", "href": "/blog/seo/seo-guide-small-business-nagpur/"}, {"label": "Nagpur", "title": "Why every Nagpur business needs a website", "href": "/blog/nagpur-business/why-nagpur-business-needs-website/"}, {"label": "AI search", "title": "Generative engine optimisation for AI search", "href": "/blog/technology-trends/generative-engine-optimization-ai-search-2026/"}]}
    faqs={serviceFaqs}
  ></ServicePage>
</ServiceLayout>
