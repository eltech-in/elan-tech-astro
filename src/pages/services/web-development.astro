---
import ServiceLayout from '../../layouts/ServiceLayout.astro';
import ServicePage from '../../components/service/ServicePage.astro';
import ServiceExplainer from '../../components/service/ServiceExplainer.astro';
import { services } from '../../data/services';
import { serviceSchema, faqSchema, breadcrumbSchema } from '../../utils/schema';

// Rewritten 27 Nov 2026: compact, search-literal page in the shared service layout.
const service = services.find((s) => s.slug === 'web-development')!;
const title = 'Web Development Company in India: Websites, Portals & Web Apps';
const description = 'Custom web development from India: business websites, customer portals, booking systems, dashboards and web applications with React, Next.js, Astro, Node.js, WordPress and headless CMS.';

const serviceFaqs = [
  {
    question: "What's the difference between website design and web development?",
    answer: "Website design focuses on how a site looks and feels - layouts, colours, typography, imagery, and user experience. Web development covers how it works - writing code, building functionality, integrating databases, setting up APIs, and ensuring everything performs reliably. Most projects require both; eLan Technology handles both disciplines in-house for a seamless result.",
  },
  {
    question: 'Do you build on WordPress or custom frameworks?',
    answer: "Both - and we recommend the right tool for each project rather than defaulting to one. WordPress suits content-heavy sites, blogs, and businesses that need easy self-management. Custom frameworks like React/Next.js are better for web applications, portals, SaaS products, and performance-critical projects. We'll advise you on the best fit during discovery.",
  },
  {
    question: 'Can you build a web application with user logins?',
    answer: 'Yes. Depending on the agreed architecture, an application can include email/password or third-party sign-in, role-based access, account recovery and multi-factor authentication. Identity providers, personal-data fields, session handling, administrative access and account deletion are confirmed during discovery.',
  },
  {
    question: 'Do you provide the source code?',
    answer: 'Source-code delivery, intellectual-property ownership, reusable eLan components, third-party or open-source software, credentials, deployment configuration and handover materials depend on the accepted proposal and payment terms. These points are stated explicitly before development begins.',
  },
  {
    question: 'Can you integrate third-party APIs?',
    answer: 'Yes - API integration is a core part of our development practice. We regularly integrate payment gateways (Razorpay, Stripe, PayPal), CRM systems (Salesforce, HubSpot, Zoho), ERP systems, mapping services (Google Maps), shipping APIs, marketing platforms, and custom enterprise APIs via REST or GraphQL.',
  },
];

const breadcrumbs = [
  { name: 'Home', href: '/' },
  { name: 'Services', href: '/services/' },
  { name: service.title, href: `/services/${service.slug}/` },
];
const schemas = [
  serviceSchema(title, description, `/services/${service.slug}/`),
  faqSchema(serviceFaqs),
  breadcrumbSchema(breadcrumbs.map((b) => ({ name: b.name, url: b.href }))),
];
const stack = ['React', 'Next.js', 'Astro', 'Node.js', 'Express.js', 'TypeScript', 'PostgreSQL', 'MySQL', 'MongoDB', 'Supabase', 'WordPress', 'Payload CMS', 'Directus', 'REST APIs', 'GraphQL', 'PHP', 'Laravel', 'Docker', 'AWS', 'Tailwind CSS'];
---
<ServiceLayout title={title} description={description} breadcrumbs={breadcrumbs} schema={schemas}>
  <ServicePage
    accentVar={service.cssVar}
    eyebrow="Web development company · websites, portals and web apps"
    heading="Custom Web Development for Websites, Portals and Web Apps"
    intro="We build websites, customer and staff portals, booking systems, dashboards and online tools that are fast, easy to manage and ready to grow. We recommend the stack for your project instead of defaulting to one."
    highlights={service.features.slice(0, 6)}
    offersTitle="What our web development service covers"
    offers={[
      { title: 'React and Next.js applications', text: 'Fast, interactive front ends and production apps with server rendering and static generation.' },
      { title: 'Full-stack and MERN builds', text: 'Complete applications with Node.js, databases, authentication and real-time features.' },
      { title: 'WordPress development', text: 'Custom themes and plugins, careful customisation, or WordPress as a headless CMS.' },
      { title: 'APIs and integrations', text: 'REST and GraphQL APIs, payment gateways, CRMs, ERPs, maps and shipping services.' },
      { title: 'Headless CMS', text: 'Payload, Directus, Strapi or Sanity with Astro or Next.js for structured content.' },
      { title: 'Portals and dashboards', text: 'Customer and staff portals, bookings, reports and role-based access.' },
      { title: 'Performance optimisation', text: 'Core Web Vitals (LCP, CLS, INP), images, caching and CDN configuration.' },
      { title: 'Code audits', text: 'Technical debt, security and performance reviewed with prioritised fixes.' },
      { title: 'Security-aware development', text: 'Validation, parameterised queries, CSRF protection, rate limiting and headers.' },
    ]}
    process={[
      { title: 'Discovery and specification', text: 'Requirements, journeys, stack, data model and success criteria agreed.' },
      { title: 'Architecture and planning', text: 'API contracts, data models and components, planned in milestones.' },
      { title: 'Build and test', text: 'TypeScript, code review, automated tests, performance and accessibility checks.' },
      { title: 'Launch and support', text: 'CI/CD, deployment and monitoring, with 30 days of post-launch support.' },
    ]}
    fit={['You need more than a brochure site: logins, bookings, dashboards or data.', 'Your current site is slow, hard to update or built on outdated code.', 'You want to connect the website to the tools your team already uses.', 'You want honest advice on WordPress versus a custom framework.']}
    guides={[
      { label: 'Platform', title: 'WordPress vs a custom website', href: '/blog/web-design/wordpress-vs-custom-website/' },
      { label: 'Portals', title: 'Custom business portal development: features and costs', href: '/blog/web-design/custom-business-portal-development/' },
      { label: 'Astro', title: 'What is Astro 7? A plain-English guide', href: '/blog/technology-trends/what-is-astro-7-business-guide/' },
    ]}
    faqTitle="Web development FAQs"
    faqs={serviceFaqs}
    cta={{ title: 'Not sure which stack is right?', text: 'Book a 30-minute call to discuss your requirements and get honest advice before any quote.' }}
  >
    <ServiceExplainer
      id="fit"
      color="--ac-indigo"
      eyebrow="Which service fits your project"
      title="Web development, or a more specialist service?"
      intro="This page covers technical builds: websites and web applications with logins, data, integrations and custom features. Some projects are better served by a specialist page."
      columns={[{"title": "Web development (this page)", "text": "Customer portals, dashboards, booking and enquiry systems, member areas, APIs and custom website functionality."}, {"title": "Custom CRM and ERP", "text": "Internal operations: leads, approvals, inventory, HR and reporting, including ERPNext customisation."}, {"title": "Headless CMS", "text": "Content-heavy websites and apps where editors publish to several channels through Payload CMS or Directus."}, {"title": "Website design", "text": "When the main need is how the site looks and reads: custom design, redesigns and landing pages."}]}
      links={[{"href": "/services/custom-crm-erp-solutions/", "label": "Custom CRM and ERP development"}, {"href": "/services/headless-cms-development/", "label": "Headless CMS development"}, {"href": "/services/website-design/", "label": "Website design services"}]}
    />

    <section class="grid gap-4 lg:grid-cols-[1.2fr_0.8fr]" aria-label="Choosing the stack and technologies">
      <div class="grid gap-4 sm:grid-cols-2">
        <div class="tilt-card p-5" style="--card-color: var(--ac-indigo);">
          <h2 class="font-heading text-lg font-bold text-[var(--text)]">When we recommend React or Next.js</h2>
          <ul class="mt-2 space-y-1.5 text-sm text-[var(--text-dim)]" role="list">
            <li>✓ Web apps with complex interactions</li><li>✓ Live dashboards, notifications or chat</li><li>✓ One API for web and mobile</li><li>✓ A team that can maintain JavaScript</li>
          </ul>
        </div>
        <div class="tilt-card p-5" style="--card-color: var(--ac-blue);">
          <h2 class="font-heading text-lg font-bold text-[var(--text)]">When we recommend WordPress</h2>
          <ul class="mt-2 space-y-1.5 text-sm text-[var(--text-dim)]" role="list">
            <li>✓ Content-heavy sites updated often</li><li>✓ Budget projects using proven plugins</li><li>✓ Teams wanting a familiar CMS</li><li>✓ Headless WordPress with a fast front end</li>
          </ul>
        </div>
      </div>
      <div class="tilt-card p-5" style="--card-color: var(--ac-violet);">
        <h2 class="font-heading text-lg font-bold text-[var(--text)]">Technologies we use</h2>
        <ul class="mt-3 flex flex-wrap gap-1.5" role="list">
          {stack.map((t) => <li class="rounded-md border border-[var(--border)] bg-[var(--bg)] px-2 py-1 text-xs font-semibold text-[var(--text)]">{t}</li>)}
        </ul>
        <p class="mt-3 text-sm"><a href="/technologies/" class="font-semibold text-[var(--text)] underline underline-offset-4">See where we have used each →</a> · <a href="/services/headless-cms-development/" class="font-semibold text-[var(--text)] underline underline-offset-4">Headless CMS</a></p>
      </div>
    </section>
  </ServicePage>
</ServiceLayout>
