---
import ServiceLayout from '../../layouts/ServiceLayout.astro';
import ServicePage from '../../components/service/ServicePage.astro';
import ServiceExplainer from '../../components/service/ServiceExplainer.astro';
import { integrations } from '../../data/integrations';
import { breadcrumbSchema, serviceSchema, faqSchema } from '../../utils/schema';

// Rewritten 27 Nov 2026: compact, search-literal page in the shared service layout.
const title = 'API Integration Services: Payments, Shipping, CRM & ERP';
const description = 'API integration services from India: payment gateways, shipping and courier APIs, ecommerce platforms, Zoho, CRM and ERP systems connected to your website with secure, monitored workflows.';

const serviceFaqs = [
  {
    question: 'How long does a typical integration take?',
    answer: 'Simple integrations like a payment gateway or shipping API typically take 1–2 weeks. Complex integrations involving custom middleware, data transformation, or multi-system synchronisation can take 3–6 weeks. We provide a timeline estimate during discovery after understanding your specific requirements.',
  },
  {
    question: 'Can you integrate with APIs not listed on this page?',
    answer: 'We can assess documented REST, GraphQL and other supported interfaces, including internal or legacy systems. Feasibility depends on API capability, authentication, rate limits, sandbox access, provider terms, data quality and the client’s authority to connect the systems.',
  },
  {
    question: 'Do you handle ongoing maintenance for integrations?',
    answer: 'Ongoing monitoring, provider-change updates, error recovery and response targets can be included in a maintenance plan. No integration can be guaranteed continuously available because provider APIs, credentials, networks, quotas and connected systems can change or fail.',
  },
  {
    question: 'How do you ensure security in payment integrations?',
    answer: 'We prefer hosted or tokenised payment flows where suitable, protect secrets, verify supported webhook signatures and test agreed journeys in the provider sandbox. PCI DSS scope and responsibility depend on the selected gateway, integration method, merchant environment and parties involved; this service page does not claim certification.',
  },
  {
    question: 'Can you connect multiple systems together?',
    answer: 'Yes - we frequently build middleware that connects your website to your CRM, ERP, accounting software, shipping provider, and payment gateway simultaneously. We design these integrations with proper error handling, retry logic, and logging so you have full visibility into data flow.',
  },
];

const breadcrumbs = [
  { name: 'Home', href: '/' },
  { name: 'Services', href: '/services/' },
  { name: 'Integrations', href: '/services/integrations/' },
];
const schemas = [
  serviceSchema(title, description, '/services/integrations/'),
  faqSchema(serviceFaqs),
  breadcrumbSchema(breadcrumbs.map((b) => ({ name: b.name, url: b.href }))),
];
const categories = [...new Set(integrations.map((i) => i.category))];
const colors = ['--ac-cyan', '--ac-emerald', '--ac-indigo', '--ac-amber', '--ac-pink'];
---
<ServiceLayout title={title} description={description} breadcrumbs={breadcrumbs} schema={schemas}>
  <ServicePage
    accentVar="--svc-integrations"
    eyebrow="API integration services"
    heading="API Integration Services for Payments, Shipping, CRM and ERP"
    intro="We connect your website or store to the tools your business runs on: payment gateways, couriers, ecommerce platforms, Zoho, CRMs and ERPs. Data moves automatically, failures are caught and your team stops re-typing orders."
    highlights={['Payment gateways: UPI, cards, wallets, international', 'Shipping and courier APIs with tracking', 'Ecommerce, marketplace and Zoho connections', 'CRM and ERP synchronisation', 'Secure webhooks, retries and logging', 'Monitoring and documentation for your team']}
    offersTitle="What our integration service includes"
    offers={[
      { title: 'Payment integration', text: 'Razorpay, PhonePe, Stripe, PayPal and other gateways, with refunds and webhooks.' },
      { title: 'Shipping and logistics', text: 'Courier rates, serviceability, labels and real-time tracking.' },
      { title: 'Ecommerce and ERP', text: 'Inventory, orders and catalogues synced between store and back office.' },
      { title: 'CRM and marketing tools', text: 'Leads and customers flowing into Zoho, HubSpot, Salesforce or email tools.' },
      { title: 'Custom APIs', text: 'REST or GraphQL connections to any documented system.' },
      { title: 'Reliability', text: 'Error handling, retries, reconciliation and alerts when something fails.' },
    ]}
    process={[
      { title: 'Discovery and scoping', text: 'Requirements, API documentation, data flows and architecture.' },
      { title: 'Sandbox build', text: 'Built and tested with mock data, error handling and webhook checks.' },
      { title: 'Testing', text: 'Success and failure flows, edge cases and load checks.' },
      { title: 'Go live and monitor', text: 'Monitoring, alerts and documentation for your team.' },
    ]}
    fit={['Orders, leads or stock are copied between systems by hand.', 'You are adding a payment gateway or courier.', 'Your store must sync with an ERP, CRM or Zoho.', 'An existing integration fails silently.']}
    note="PCI DSS scope and payment-data responsibilities depend on the selected payment flow and parties. eLan does not claim certification for a client environment unless separately assessed and documented."
    faqTitle="API integration FAQs"
    faqs={serviceFaqs}
    cta={{ title: 'Connect the tools your business uses', text: 'List the systems you use and what should move between them. We will map the integration and quote it in writing.' }}
  >
    <ServiceExplainer
      id="workflow"
      color="--svc-integrations"
      eyebrow="Example: an order-to-courier integration"
      title="Your store takes the order. Who owns what?"
      intro="Before building an integration we agree, field by field, which system owns the data, how updates move and what happens when they fail. Here is how that looks for a store sending orders to a courier platform such as Shiprocket."
      columns={[{"title": "Which system owns the data", "text": "The store owns the order and the customer. The courier platform owns the shipment, the AWB number and the tracking status."}, {"title": "How updates sync", "text": "A paid order creates a shipment straight away. Tracking updates come back by webhook and update the order, so customers see one status."}, {"title": "What happens when it fails", "text": "Failed calls are retried, then logged and sent to a named person. The order is flagged so nobody ships it twice or forgets it."}]}
      numbered
      note="Each integration is scoped and quoted on its own. Full CRM or ERP builds have their own page."
      links={[{"href": "/services/custom-crm-erp-solutions/", "label": "Custom CRM and ERP development"}]}
    />

    <section aria-labelledby="catalogue-title">
      <h2 id="catalogue-title" class="font-heading text-2xl font-bold text-[var(--text)] sm:text-3xl">Integrations we work with</h2>
      <div class="mt-5 grid gap-4 lg:grid-cols-3">
        {categories.map((category, i) => (
          <div class="tilt-card p-6" style={`--card-color: var(${colors[i % colors.length]});`}>
            <h3 class="font-heading text-lg font-bold text-[var(--text)]">{category}</h3>
            <ul class="mt-4 flex flex-wrap gap-2" role="list">
              {integrations.filter((item) => item.category === category).map((item) => (
                <li class="rounded-md border border-[var(--border)] bg-[var(--bg)] px-3 py-1.5 text-sm font-semibold text-[var(--text)]" title={item.description}>{item.name}</li>
              ))}
            </ul>
          </div>
        ))}
      </div>
    </section>
  </ServicePage>
</ServiceLayout>
