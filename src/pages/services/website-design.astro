---
import ServiceLayout from '../../layouts/ServiceLayout.astro';
import ServicePage from '../../components/service/ServicePage.astro';
import ServiceExplainer from '../../components/service/ServiceExplainer.astro';
import { services } from '../../data/services';
import { serviceSchema, faqSchema, breadcrumbSchema } from '../../utils/schema';

// Rewritten 27 Nov 2026: compact, search-literal page in the shared service layout.
const service = services.find((s) => s.slug === 'website-design')!;
const title = 'Website Design Services in India: Custom Websites & Redesigns';
const description = 'Custom website design and redesign services from India: mobile-friendly, accessible, fast websites with clear navigation, landing pages and clickable previews before development.';

const serviceFaqs = [
  {
    question: 'How long does a website design project take?',
    answer: 'A website design project can often take 4–8 weeks, but the agreed schedule depends on page count, content readiness, review turnaround, integrations, accessibility evidence and functional scope. The proposal records the working timeline, client dependencies and change process before work begins.',
  },
  {
    question: 'Do you use templates or custom designs?',
    answer: 'We can provide an original interface and component system, customise an appropriate theme or work within an existing platform when that is the better business decision. The proposal states whether the engagement includes custom design, a licensed theme, page-builder work or adaptation of an existing system, together with relevant licence terms.',
  },
  {
    question: 'Will my website be mobile-responsive?',
    answer: 'Responsive behaviour is included in the agreed design and tested across the representative browsers, devices and viewport sizes listed for the project. No website can be guaranteed flawless on every historic or future device, so required browser support and acceptance criteria are confirmed in the scope.',
  },
  {
    question: 'Do you offer website redesign services?',
    answer: 'Yes. A redesign can begin with a review of the current website’s content, accessibility, performance, search visibility and user journeys. The resulting priorities inform the proposed design, but traffic, ranking, enquiry and conversion outcomes depend on many factors and are not guaranteed.',
  },
  {
    question: 'What happens after the website is launched?',
    answer: 'The accepted proposal defines any included defect-support window, content adjustments, response route and exclusions. Ongoing maintenance can be quoted separately for updates, backups, monitoring, security work and agreed content changes.',
  },
];

const breadcrumbs = [
  { name: 'Home', href: '/' },
  { name: 'Services', href: '/services/' },
  { name: service.title, href: `/services/${service.slug}/` },
];
const schemas = [
  serviceSchema(title, description, `/services/${service.slug}/`),
  faqSchema(serviceFaqs),
  breadcrumbSchema(breadcrumbs.map((b) => ({ name: b.name, url: b.href }))),
];
const work = [
  { client: 'Trimit Architects', href: 'https://www.trimitarch.com/', text: 'Portfolio website for a Nagpur architecture firm, redesigned and rebuilt in Astro with project galleries.' },
  { client: 'Aasthaa Hospital', href: '/portfolio/#selected-work', text: 'Healthcare website designed for clarity and patient trust: departments, doctors and appointment enquiries.' },
  { client: 'CIPL', href: '/portfolio/#selected-work', text: 'B2B corporate website for an industrial products company with a filterable product catalogue.' },
];
---
<ServiceLayout title={title} description={description} breadcrumbs={breadcrumbs} schema={schemas}>
  <ServicePage
    accentVar={service.cssVar}
    eyebrow="Website design services · custom and redesign"
    heading="Website Design Services for Businesses That Want to Be Chosen"
    intro="We design custom websites that look like your business, work on every screen and make it easy for visitors to call, enquire or buy. You see a clickable preview before any development starts."
    highlights={service.features.slice(0, 6)}
    offersTitle="What our website design service includes"
    offersIntro="The accepted proposal confirms which of these are included for your project."
    offers={[
      { title: 'UI and UX design', text: 'Interfaces planned around your audience, content and the journeys that lead to an enquiry.' },
      { title: 'Responsive design', text: 'Layouts designed and tested for mobile, tablet, laptop and wide screens.' },
      { title: 'Wireframes and clickable previews', text: 'Structure and user flows confirmed before development begins.' },
      { title: 'Landing pages', text: 'Campaign, product-launch and lead pages with one clear action.' },
      { title: 'Design systems', text: 'Reusable Figma components, type scales, colours and spacing for growing teams.' },
      { title: 'Accessibility-first design', text: 'Contrast, keyboard use, clear labels and screen-reader behaviour considered throughout.' },
      { title: 'Website redesigns', text: 'A review of your current site’s content, speed, search visibility and journeys, then a better design.' },
      { title: 'Custom design or a chosen template', text: 'Custom for brand differentiation; a well-customised template when time or budget matter more.' },
    ]}
    process={[
      { title: 'Discovery and strategy', text: 'Audiences, content, comparable websites, sitemap and success measures.' },
      { title: 'Design and preview', text: 'Wireframes, then high-fidelity designs and a clickable prototype to review.' },
      { title: 'Build and test', text: 'Approved designs implemented and tested on agreed browsers and devices.' },
      { title: 'Launch and support', text: 'Deployment, redirects, backups and post-launch checks, with support as agreed.' },
    ]}
    fit={['Your current website looks dated or does not bring enquiries.', 'You are launching a new business, product or campaign.', 'You want a design that is clearly yours, not a template look.', 'Your team needs to update content without a developer.']}
    note="Accessibility-first and privacy-aware design reduce avoidable barriers and data collection, but do not by themselves guarantee WCAG, ADA, DPDP, GDPR or other legal compliance."
    guides={[
      { label: 'Choosing', title: 'WordPress vs a custom website', href: '/blog/web-design/wordpress-vs-custom-website/' },
      { label: 'Budget', title: 'What should a website quote include?', href: '/blog/web-design/what-should-a-website-quote-include/' },
      { label: 'Audit', title: 'Website audit findings explained: what to fix first', href: '/blog/web-design/website-audit-findings-explained/' },
    ]}
    faqTitle="Website design FAQs"
    faqs={serviceFaqs}
    cta={{ title: 'Ready for a website that works harder?', text: 'Share your current website or reference examples. We will recommend an approach and quote it in writing.' }}
  >
    <ServiceExplainer
      id="included"
      color="--ac-pink"
      eyebrow="Design, content and revisions"
      title="What a website design project includes"
      intro="Custom design for a new website or a redesign of the one you have. The proposal lists the pages, templates and review rounds before work starts."
      columns={[{"title": "Design", "items": ["Sitemap and wireframes for the key pages", "Clickable previews of the main journeys", "Visual design of each page template, on mobile and desktop", "Accessibility checks for contrast, keyboard use and labels"]}, {"title": "Content", "items": ["Page structure and headings planned around what customers search for", "Your text and images placed, formatted and optimised", "Copywriting, translation and photography added when you need them, and listed in the proposal"]}, {"title": "Revisions", "items": ["Review rounds at the wireframe and design stages, agreed in the proposal", "Feedback collected in one place, with each change confirmed", "Changes after approval handled through written change control"]}]}
      links={[{"href": "/services/web-development/", "label": "Need logins, portals or custom features? Web development"}, {"href": "/services/branding/", "label": "Need a logo and identity first? Branding"}]}
    />

    <section aria-labelledby="work-title">
      <h2 id="work-title" class="font-heading text-2xl font-bold text-[var(--text)] sm:text-3xl">Recent website design work</h2>
      <ul class="mt-5 grid gap-4 md:grid-cols-3" role="list">
        {work.map((w) => (
          <li class="tilt-card p-5" style={`--card-color: var(${service.cssVar});`}>
            <h3 class="font-heading text-base font-bold text-[var(--text)]">{w.client}</h3>
            <p class="mt-1.5 text-sm leading-relaxed text-[var(--text-dim)]">{w.text}</p>
            <a href={w.href} target={w.href.startsWith('http') ? '_blank' : undefined} rel={w.href.startsWith('http') ? 'noopener noreferrer' : undefined} class="mt-2 inline-block text-sm font-semibold text-[var(--text)] underline underline-offset-4">{w.href.startsWith('http') ? 'Visit website ↗' : 'See the portfolio →'}</a>
          </li>
        ))}
      </ul>
    </section>
  </ServicePage>
</ServiceLayout>
