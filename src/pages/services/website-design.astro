---
import ServiceLayout from '../../layouts/ServiceLayout.astro';
import { services } from '../../data/services';
import { cities } from '../../data/cities';
import { serviceSchema, faqSchema, breadcrumbSchema } from '../../utils/schema';

const service = services.find((s) => s.slug === 'website-design')!;

const serviceFaqs = [
  {
    question: 'How long does a website design project take?',
    answer: 'A website design project can often take 4–8 weeks, but the agreed schedule depends on page count, content readiness, review turnaround, integrations, accessibility evidence and functional scope. The proposal records the working timeline, client dependencies and change process before work begins.',
  },
  {
    question: 'Do you use templates or custom designs?',
    answer: 'We can provide an original interface and component system, customise an appropriate theme or work within an existing platform when that is the better business decision. The proposal states whether the engagement includes custom design, a licensed theme, page-builder work or adaptation of an existing system, together with relevant licence terms.',
  },
  {
    question: 'Will my website be mobile-responsive?',
    answer: 'Responsive behaviour is included in the agreed design and tested across the representative browsers, devices and viewport sizes listed for the project. No website can be guaranteed flawless on every historic or future device, so required browser support and acceptance criteria are confirmed in the scope.',
  },
  {
    question: 'Do you offer website redesign services?',
    answer: 'Yes. A redesign can begin with a review of the current website’s content, accessibility, performance, search visibility and user journeys. The resulting priorities inform the proposed design, but traffic, ranking, enquiry and conversion outcomes depend on many factors and are not guaranteed.',
  },
  {
    question: 'What happens after the website is launched?',
    answer: 'The accepted proposal defines any included defect-support window, content adjustments, response route and exclusions. Ongoing maintenance can be quoted separately for updates, backups, monitoring, security work and agreed content changes.',
  },
];

const breadcrumbs = [
  { name: 'Home', href: '/' },
  { name: 'Services', href: '/services/' },
  { name: service.title, href: `/services/${service.slug}/` },
];

const schemaBreadcrumbs = breadcrumbs.map((b) => ({ name: b.name, url: b.href }));

const schemas = [
  serviceSchema(service.title, service.description, `/services/${service.slug}/`),
  faqSchema(serviceFaqs),
  breadcrumbSchema(schemaBreadcrumbs),
];

const featuredCities = cities.filter((c) => c.isFeatured).slice(0, 6);
---
<ServiceLayout
  title={`${service.title} Services | eLan Technology`}
  description={service.description}
  breadcrumbs={breadcrumbs}
  schema={schemas}
>

  <!-- ── HERO ─────────────────────────────────────────────────────────────── -->
  <section class="service-card relative mb-12 overflow-hidden rounded-2xl border border-[var(--border)] p-8 md:p-12" style="background: linear-gradient(135deg, color-mix(in srgb, var(--ac-pink) 12%, var(--bg-card)) 0%, var(--bg-card) 65%);">
    <span aria-hidden="true" class="service-card__num pointer-events-none absolute top-4 right-6 font-heading font-black leading-none select-none" style="color: var(--ac-pink); font-size: 7rem;">01</span>
    <span aria-hidden="true" class="service-card__stripe pointer-events-none absolute -left-12 -bottom-12 h-60 w-60 rotate-[-20deg] opacity-[0.08]" style="background: var(--ac-pink);"></span>
    <div class="relative">
    <div class="grid gap-10 md:grid-cols-2 md:items-center">
      <div>
        <p class="mb-2 text-sm font-semibold uppercase tracking-widest" style="color: var(--ac-pink);">{service.tagline}</p>
        <h1 class="font-heading text-3xl font-bold leading-tight text-[var(--text)] md:text-4xl lg:text-5xl">Website Design That Fits Your Business</h1>
        <p class="mt-4 text-base text-[var(--text-muted)] md:text-lg">
          {service.description} You will see and approve the design before development begins, so there are no surprises later.
        </p>
        <div class="mt-6 flex flex-wrap gap-3">
          <a href="/schedule-consultation/" class="inline-flex items-center rounded-lg px-5 py-2.5 text-sm font-semibold text-white shadow transition hover:opacity-90" style="background: var(--ac-pink);">
            Get Free Consultation
          </a>
          <a href="/get-quote/" class="inline-flex items-center rounded-lg border border-[var(--border)] px-5 py-2.5 text-sm font-semibold text-[var(--text)] transition hover:bg-[var(--bg)]">
            Get a Quote
          </a>
        </div>
      </div>
      <ul class="space-y-3">
        {service.features.map((f) => (
          <li class="flex items-center gap-3 rounded-lg bg-[var(--bg)] px-4 py-3 border border-[var(--border)] text-sm font-medium text-[var(--text)]">
            <span class="text-green-400 font-bold">✓</span> {f}
          </li>
        ))}
      </ul>
    </div>
  </div>
  </section>

  <!-- ── WHAT'S INCLUDED ───────────────────────────────────────────────────── -->
  <section class="mb-16">
    <h2 class="font-heading text-2xl font-bold text-[var(--text)] md:text-3xl mb-2">What's Included in Our {service.shortTitle} Services</h2>
    <p class="text-[var(--text-muted)] mb-8">Every engagement is tailored to your goals. The accepted proposal confirms which of these capabilities, deliverables and review stages are included.</p>
    <div class="grid grid-cols-1 gap-5 md:grid-cols-2 lg:grid-cols-3">
      {[
        { icon: '<svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 19l7-7 3 3-7 7-3-3z"/><path d="M18 13l-1.5-7.5L2 2l3.5 14.5L13 18l5-5z"/><path d="M2 2l7.586 7.586"/><circle cx="11" cy="11" r="2"/></svg>', name: 'UI/UX Design', desc: 'We design interfaces around the agreed audience, content and user journeys. Where research or testing is included, its participants, method, personal-data use and success measures are documented in advance.' },
        { icon: '<svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="5" y="2" width="14" height="20" rx="2" ry="2"/><line x1="12" y1="18" x2="12.01" y2="18"/></svg>', name: 'Responsive Design', desc: 'Layouts are designed for representative mobile, tablet, laptop and wide-screen contexts. The proposal identifies supported browsers, viewports and any device-specific journeys requiring additional testing.' },
        { icon: '<svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M2 3h6a4 4 0 014 4v14a3 3 0 00-3-3H2z"/><path d="M22 3h-6a4 4 0 00-4 4v14a3 3 0 013-3h7z"/></svg>', name: 'Wireframing & Prototyping', desc: 'Where included, wireframes and interactive prototypes help confirm information architecture and user flows before development. Client review and approval points are defined in the project plan.' },
        { icon: '<svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="2" y="3" width="20" height="14" rx="2"/><path d="M8 21h8M12 17v4"/></svg>', name: 'Landing Page Design', desc: 'Landing pages can support campaigns, product launches or lead generation with clear actions and appropriate disclosures. Advertising return, enquiries and conversion improvements depend on the offer, audience, traffic and campaign operation.' },
        { icon: '<svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21.5 2v6h-6M2.5 22v-6h6M2 11.5a10 10 0 0118.8-4.3M22 12.5a10 10 0 01-18.8 4.2"/></svg>', name: 'Redesign & Revamp', desc: "A redesign can include a scoped review of the existing website’s user experience, accessibility, search foundations and performance. Existing content, URLs, analytics and integrations are migrated only as agreed." },
        { icon: '<svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="3" width="7" height="7"/><rect x="14" y="3" width="7" height="7"/><rect x="14" y="14" width="7" height="7"/><rect x="3" y="14" width="7" height="7"/></svg>', name: 'Design Systems', desc: 'For growing businesses and products, we build scalable design systems in Figma - consistent component libraries, typography scales, colour tokens, and spacing guidelines that keep your brand coherent across every touchpoint.' },
        { icon: '<svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"/><circle cx="12" cy="12" r="3"/></svg>', name: 'Accessibility-First Design', desc: 'We consider colour contrast, keyboard use, clear labels and screen-reader behaviour throughout the design process. Formal WCAG conformance testing can be included when the project requires documented evidence.' },
        { icon: '<svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 20h9"/><path d="M16.5 3.5a2.121 2.121 0 013 3L7 19l-4 1 1-4L16.5 3.5z"/></svg>', name: 'Brand-Aligned Visual Design', desc: 'We don\'t just design websites - we design brand experiences. Your website will reflect your visual identity, tone of voice, and values, creating a cohesive impression across every page and interaction.' },
      ].map(({ icon, name, desc }) => (
        <div class="rounded-xl border border-[var(--border)] bg-[var(--bg-card)] p-5">
          <div class="mb-3 inline-flex h-11 w-11 items-center justify-center rounded-xl" style="background: color-mix(in srgb, var(--ac-pink) 18%, transparent); color: var(--ac-pink);" set:html={icon} />
          <h3 class="font-heading text-base font-semibold text-[var(--text)] mb-2">{name}</h3>
          <p class="text-sm text-[var(--text-muted)] leading-relaxed">{desc}</p>
        </div>
      ))}
    </div>
  </section>

  <!-- ── WHY CUSTOM BEATS TEMPLATES ────────────────────────────────────────── -->
  <section class="mb-16 rounded-2xl border border-[var(--border)] bg-[var(--bg-card)] p-8 md:p-10">
    <h2 class="font-heading text-2xl font-bold text-[var(--text)] md:text-3xl mb-4">Custom Design or a Carefully Chosen Template?</h2>
    <p class="text-[var(--text-muted)] mb-8">Both can be valid. We recommend the approach that fits the approved budget, brand needs, content, required ownership, accessibility work and future change requirements.</p>
    <div class="grid gap-6 md:grid-cols-3">
      <div class="rounded-xl bg-[var(--bg)] border border-[var(--border)] p-5">
        <h3 class="font-heading text-base font-semibold text-[var(--text)] mb-2">Brand Differentiation</h3>
        <p class="text-sm text-[var(--text-muted)]">Custom design offers more control over visual identity and user journeys. A well-selected and properly customised template can still be appropriate when time, budget or platform constraints are more important than complete visual differentiation.</p>
      </div>
      <div class="rounded-xl bg-[var(--bg)] border border-[var(--border)] p-5">
        <h3 class="font-heading text-base font-semibold text-[var(--text)] mb-2">Performance & Speed</h3>
        <p class="text-sm text-[var(--text-muted)]">Some themes include unused code or plugins, while others are efficient. Performance depends on implementation, hosting, media, scripts and ongoing content—not simply whether a template was used. Performance targets should be agreed and tested.</p>
      </div>
      <div class="rounded-xl bg-[var(--bg)] border border-[var(--border)] p-5">
        <h3 class="font-heading text-base font-semibold text-[var(--text)] mb-2">Scalability & Control</h3>
        <p class="text-sm text-[var(--text-muted)]">A custom system may provide greater architectural control, while a maintained commercial theme can reduce initial effort. We identify licences, vendor dependencies, ownership, update responsibilities and foreseeable integration limits before recommending either route.</p>
      </div>
    </div>
  </section>

  <!-- ── PORTFOLIO TEASER ──────────────────────────────────────────────────── -->
  <section class="mb-16">
    <h2 class="font-heading text-2xl font-bold text-[var(--text)] md:text-3xl mb-2">Projects We're Proud Of</h2>
    <p class="text-[var(--text-muted)] mb-8">Examples of delivered work. Each description reflects that project’s scope and is not a promise of identical outcomes.</p>
    <div class="grid gap-6 md:grid-cols-3">
      {[
        { client: 'Trimit Architects', outcome: 'A portfolio website for a Nagpur-based architecture firm, featuring project galleries, page transitions and a visual system designed around the studio’s work.' },
        { client: 'Aasthaa Hospital', outcome: 'A healthcare website designed for clarity and patient trust, with department pages, doctor profiles, appointment enquiries and health information.' },
        { client: 'CIPL', outcome: 'A B2B corporate website for an industrial products company, designed to communicate technical expertise and support a national sales team. Custom product catalogue with filtering, downloadable spec sheets, and a lead generation system integrated with CRM.' },
      ].map(({ client, outcome }) => (
        <div class="rounded-xl border border-[var(--border)] bg-[var(--bg-card)] p-6">
          <h3 class="font-heading text-base font-semibold text-[var(--text)] mb-3">{client}</h3>
          <p class="text-sm text-[var(--text-muted)] leading-relaxed">{outcome}</p>
        </div>
      ))}
    </div>
  </section>

  <!-- ── OUR PROCESS ────────────────────────────────────────────────────────── -->
  <section class="mb-16">
    <h2 class="font-heading text-2xl font-bold text-[var(--text)] md:text-3xl mb-2">Our {service.shortTitle} Process</h2>
    <p class="text-[var(--text-muted)] mb-8">A clear, collaborative four-phase approach that keeps you informed and in control throughout the project.</p>
    <div class="grid gap-4 sm:grid-cols-2 lg:grid-cols-4">
      {[
        { n: '1', title: 'Discovery & Strategy', desc: 'The agreed discovery can cover stakeholder input, comparable websites, audiences, content, sitemap and success measures. Personal data used for research or testing must have a documented purpose and appropriate participant notice.' },
        { n: '2', title: 'Design & Planning', desc: 'Wireframes establish information architecture and user flows. High-fidelity Figma mockups follow, complete with interactive prototypes you can click through and share with stakeholders for feedback.' },
        { n: '3', title: 'Development & Testing', desc: 'Approved designs are implemented for the selected platform. The scope identifies responsive, browser, accessibility and performance testing, along with the acceptance criteria and any documented evidence required.' },
        { n: '4', title: 'Launch & Support', desc: 'The agreed launch can cover deployment, redirects, DNS, backups and post-launch checks. Included defect support, content changes and any continuing maintenance are defined in the proposal.' },
      ].map(({ n, title, desc }) => (
        <div class="relative rounded-xl border border-[var(--border)] bg-[var(--bg-card)] p-5">
          <div class="mb-3 inline-flex h-9 w-9 items-center justify-center rounded-full font-heading text-sm font-bold text-white" style="background: var(--ac-pink);">{n}</div>
          <h3 class="font-heading text-sm font-semibold text-[var(--text)] mb-2">{title}</h3>
          <p class="text-sm text-[var(--text-muted)]">{desc}</p>
        </div>
      ))}
    </div>
  </section>

  <!-- ── DESIGN DATA & CONTENT RESPONSIBILITIES ──────────────────────────── -->
  <section class="rounded-2xl border border-[var(--border)] bg-[var(--bg-card)] p-6 md:p-9" aria-labelledby="design-privacy-title">
    <div class="grid gap-8 lg:grid-cols-[0.8fr_1.2fr] lg:items-start">
      <div>
        <p class="text-xs font-bold uppercase tracking-[0.18em]" style="color: var(--ac-pink);">Privacy-aware website design</p>
        <h2 id="design-privacy-title" class="mt-3 font-heading text-2xl font-bold leading-tight text-[var(--text)] md:text-3xl">Content, forms and tracking need decisions before design approval.</h2>
        <p class="mt-4 text-sm leading-relaxed text-[var(--text-muted)]">
          Visual approval alone is not enough. Before development, the project should identify what personal data the finished website will request, why it is needed, where it goes and how visitors can understand their choices.
        </p>
        <a href="/privacy-policy/" class="mt-5 inline-flex min-h-11 items-center gap-2 rounded-xl border border-[var(--border)] bg-[var(--bg)] px-5 py-2.5 text-sm font-bold text-[var(--text)] transition-colors hover:border-[var(--ac-pink)]" style="color: var(--ac-pink);">
          Read eLan Technology’s privacy policy <span aria-hidden="true">→</span>
        </a>
      </div>

      <ul class="grid gap-4 sm:grid-cols-2" role="list">
        {[
          { title: 'People and supplied content', text: 'The client confirms it is authorised to provide staff profiles, photographs, testimonials, customer logos and other identifiable content. Private or unnecessary information should not be supplied.' },
          { title: 'Forms and user journeys', text: 'For each form, define required and optional fields, purpose, recipient, storage location, retention period, acknowledgement, security controls and the appropriate privacy notice.' },
          { title: 'Analytics, embeds and cookies', text: 'Analytics, advertising tags, videos, maps, booking widgets, chat tools and other third-party content should be inventoried and gated by an appropriate user choice where required.' },
          { title: 'Research and test data', text: 'User interviews and usability tests should use informed participants and only necessary information. Prototypes, screenshots and test environments should avoid live customer or employee records.' },
          { title: 'Assets, fonts and licences', text: 'Images, copy, video, fonts, themes and plugins need an identified source and suitable licence. Third-party subscriptions and continuing usage charges are recorded separately.' },
          { title: 'Handover and future changes', text: 'Handover should identify account ownership, authorised administrators, consent settings, deletion or retention of working files, and who reviews new forms, scripts or integrations added later.' },
        ].map(item => (
          <li class="rounded-xl border border-[var(--border)] bg-[var(--bg)] p-5">
            <h3 class="font-heading text-sm font-bold text-[var(--text)]">{item.title}</h3>
            <p class="mt-2 text-sm leading-relaxed text-[var(--text-muted)]">{item.text}</p>
          </li>
        ))}
      </ul>
    </div>
    <p class="mt-6 border-t border-[var(--border)] pt-5 text-xs leading-relaxed text-[var(--text-muted)]">
      Accessibility-first and privacy-aware design reduce avoidable barriers and data collection, but do not by themselves guarantee WCAG, ADA, DPDP, GDPR or other legal compliance. Formal testing, legal review and documented operational processes may need separate scope.
    </p>
  </section>

  <!-- ── FAQ ───────────────────────────────────────────────────────────────── -->
  <section class="mb-16">
    <h2 class="font-heading text-2xl font-bold text-[var(--text)] md:text-3xl mb-8">Frequently Asked Questions</h2>
    <div class="divide-y divide-[var(--border)] rounded-xl border border-[var(--border)] overflow-hidden">
      {serviceFaqs.map(({ question, answer }) => (
        <details class="bg-[var(--bg-card)] py-0">
          <summary class="cursor-pointer font-medium text-[var(--text)] flex items-center justify-between px-6 py-4 hover:bg-[var(--bg)] transition-colors list-none">
            <span>{question}</span>
            <span class="ml-4 shrink-0 text-[var(--text-muted)] text-lg">+</span>
          </summary>
          <p class="px-6 pb-5 pt-1 text-sm text-[var(--text-muted)] leading-relaxed" set:html={answer} />
        </details>
      ))}
    </div>
  </section>

  <!-- ── CITY LINKS ─────────────────────────────────────────────────────────── -->
  <section class="mb-16">
    <h2 class="font-heading text-xl font-bold text-[var(--text)] md:text-2xl mb-2">Website Design Services Across India</h2>
    <p class="text-sm text-[var(--text-muted)] mb-6">We serve clients across Indian cities from our Nagpur studio, with the remote delivery and review process agreed before work begins.</p>
    <div class="grid grid-cols-2 sm:grid-cols-4 gap-3">
      {featuredCities.map((city) => (
        <a
          href={city.hasLandingPage ? `/web-design-company-${city.slug}/` : `/services/website-design/`}
          class="rounded-lg border border-[var(--border)] bg-[var(--bg-card)] px-4 py-3 hover:border-[var(--accent)]/50 transition-colors"
        >
          <p class="font-medium text-sm text-[var(--text)]">{city.name}</p>
          <p class="text-xs text-[var(--text-muted)] mt-0.5">Services available</p>
        </a>
      ))}
    </div>
  </section>

  <!-- ── DOUBLE CTA ─────────────────────────────────────────────────────────── -->
  <section class="grid gap-5 md:grid-cols-2 mb-4">
    <div class="rounded-2xl border border-[var(--border)] bg-[var(--bg-card)] p-7 flex flex-col">
      <h3 class="font-heading text-xl font-bold text-[var(--text)] mb-2">Ready to Get Started?</h3>
      <p class="text-sm text-[var(--text-muted)] mb-5 flex-1">Let us audit your current website for free and show you exactly how we'd improve it. No obligation, no pushy sales calls. * Conditions apply.</p>
      <a href="/free-website-audit/" class="inline-flex items-center justify-center rounded-lg px-5 py-2.5 text-sm font-semibold text-white transition hover:opacity-90" style="background: var(--ac-pink);">
        Get Free Audit
      </a>
    </div>
    <div class="rounded-2xl border border-[var(--border)] bg-[var(--bg-card)] p-7 flex flex-col">
      <h3 class="font-heading text-xl font-bold text-[var(--text)] mb-2">Have Questions?</h3>
      <p class="text-sm text-[var(--text-muted)] mb-5 flex-1">Not sure if custom design is right for your budget? Speak to one of our strategists and we'll help you find the best approach for your business.</p>
      <a href="/schedule-consultation/" class="inline-flex items-center justify-center rounded-lg border border-[var(--border)] px-5 py-2.5 text-sm font-semibold text-[var(--text)] transition hover:bg-[var(--bg)]">
        Schedule a Call
      </a>
    </div>
  </section>

</ServiceLayout>
