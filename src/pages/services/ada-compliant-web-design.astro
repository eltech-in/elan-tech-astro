---
import ServiceLayout from '../../layouts/ServiceLayout.astro';
import { breadcrumbSchema, faqSchema } from '../../utils/schema';

const SITE_URL = 'https://elan-tech.net';

const faqs = [
  {
    question: 'What is ADA website remediation?',
    answer: 'ADA website remediation is the work of finding and fixing barriers that make a website difficult or impossible for people with disabilities to use. It normally includes an accessibility audit, updates to the design, content and source code, testing of important tasks, and a clear record of what was fixed.',
  },
  {
    question: 'What should I look for in ADA website remediation providers?',
    answer: 'Choose a provider that combines automated checks with manual testing, fixes the website itself instead of relying on an overlay, tests complete customer journeys, and retests completed work. The provider should explain the scope, results and remaining limitations in plain language.',
  },
  {
    question: 'How quickly can eLan Technology respond to an emergency assessment request?',
    answer: 'Our target response time for emergency assessment requests is 48 hours. Once we review the website, deadline and required journeys, we confirm the audit scope, delivery date and remediation plan before work begins.',
  },
  {
    question: 'How much does an ADA website audit cost?',
    answer: 'A rapid accessibility audit and remediation plan starts at $1,500 USD. The final price depends on the number of page types, user journeys, documents and third-party tools that need to be tested. Code-level remediation is quoted after the audit scope is understood.',
  },
  {
    question: 'Is an automated accessibility scan enough?',
    answer: 'No. Automated tools are useful for finding some problems, but they cannot judge the full experience. Manual keyboard testing, screen-reader review and task-based testing are needed to find issues with menus, forms, focus order, error messages, checkout and other interactions.',
  },
  {
    question: 'Do accessibility widgets or overlays make a website compliant?',
    answer: 'An overlay cannot establish accessibility or WCAG conformance by itself. Many barriers must be fixed in the content, design and source code. A sustainable approach combines source-level fixes, manual testing, retesting and an ongoing process that prevents new problems.',
  },
  {
    question: 'Can you remediate Shopify and ecommerce websites?',
    answer: 'Yes. We audit and remediate Shopify, WooCommerce, Medusa.js and custom ecommerce websites. Testing can cover product discovery, navigation, product options, cart, checkout, account access, subscriptions, payment steps, form errors and customer support journeys.',
  },
  {
    question: 'Does WCAG 2.2 AA guarantee ADA compliance?',
    answer: 'No technical audit can guarantee legal compliance in every situation. The correct legal requirement depends on the organisation, jurisdiction and service. We use WCAG Level AA as the technical foundation, document the version used, and recommend that legal counsel confirms the obligations that apply to your organisation.',
  },
  {
    question: 'Do you provide WCAG audits for Canadian organisations?',
    answer: 'Yes. We provide WCAG audits and remediation for Canadian businesses and organisations. Canada has federal and provincial accessibility requirements, so the required standard and reporting scope depend on where the organisation operates and whether it is federally regulated. We confirm the required baseline before testing begins.',
  },
  {
    question: 'What is the current DOJ Title II website accessibility timeline?',
    answer: 'The DOJ Title II web rule requires covered state and local government web content and mobile apps to meet WCAG 2.1 Level AA, subject to the rule\'s exceptions. In April 2026, the DOJ extended the compliance dates to April 26, 2027 for entities serving 50,000 or more people, and April 26, 2028 for smaller entities and special district governments.',
  },
  {
    question: 'Can you prepare a VPAT or Accessibility Conformance Report?',
    answer: 'Yes, when procurement documentation is included in the scope. A VPAT is a reporting template. The completed document is called an Accessibility Conformance Report, or ACR. It records how the evaluated product supports the applicable accessibility criteria and identifies known gaps.',
  },
];

const breadcrumbs = [
  { name: 'Home', href: '/' },
  { name: 'Services', href: '/services/' },
  { name: 'ADA Website Remediation', href: '/services/ada-compliant-web-design/' },
];

const serviceSchemaObj = {
  '@context': 'https://schema.org',
  '@type': 'Service',
  name: 'ADA Website Remediation and WCAG Audit Services',
  alternateName: 'Accessible Web Design and Development',
  description:
    'ADA website remediation, WCAG accessibility audits, code-level fixes, ecommerce journey testing, retesting and accessibility documentation for organisations in the United States and Canada.',
  url: `${SITE_URL}/services/ada-compliant-web-design/`,
  provider: {
    '@type': 'Organization',
    name: 'eLan Technology',
    url: SITE_URL,
  },
  areaServed: [
    { '@type': 'Country', name: 'United States' },
    { '@type': 'Country', name: 'Canada' },
  ],
  serviceType: ['ADA Website Remediation', 'WCAG Accessibility Audit', 'Accessible Web Development'],
  offers: {
    '@type': 'Offer',
    price: '1500',
    priceCurrency: 'USD',
    description: 'Rapid accessibility audit and remediation plan starting price',
  },
};

const schemaBreadcrumbs = breadcrumbs.map(b => ({ name: b.name, url: b.href }));
const schemas = [serviceSchemaObj, faqSchema(faqs), breadcrumbSchema(schemaBreadcrumbs)];
---

<ServiceLayout
  title="ADA Website Remediation Services & WCAG Audits"
  description="ADA website remediation and WCAG audits for businesses and ecommerce stores in the US and Canada. Source-code fixes, retesting and clear reports. Emergency response within 48 hours."
  canonical="/services/ada-compliant-web-design/"
  schema={schemas}
  breadcrumbs={breadcrumbs}
>
  <section class="service-card relative mb-12 overflow-hidden rounded-2xl border border-[var(--border)] p-8 md:p-12" style="background: linear-gradient(135deg, color-mix(in srgb, var(--ac-blue) 12%, var(--bg-card)) 0%, var(--bg-card) 65%);">
    <span aria-hidden="true" class="service-card__num pointer-events-none absolute top-4 right-6 font-heading font-black leading-none select-none" style="color: var(--ac-blue); font-size: 7rem;">10</span>
    <span aria-hidden="true" class="service-card__stripe pointer-events-none absolute -left-12 -bottom-12 h-60 w-60 rotate-[-20deg] opacity-[0.08]" style="background: var(--ac-blue);"></span>
    <div class="relative max-w-4xl">
      <p class="mb-3 text-sm font-semibold uppercase tracking-widest text-red-500">ADA website remediation and WCAG audits</p>
      <h1 class="font-heading text-3xl font-bold leading-tight text-[var(--text)] md:text-5xl">
        ADA Website Remediation and WCAG Audit Services
      </h1>
      <p class="mt-5 max-w-3xl text-base leading-relaxed text-[var(--text-muted)] md:text-lg">
        We find the barriers that stop people from using your website, fix them in the website itself, and retest the journeys that matter. You receive clear findings, practical priorities and a record of the work completed. Emergency assessment requests receive a response within 48 hours.
      </p>
      <div class="mt-7 flex flex-wrap gap-3">
        <a href="/get-quote/?service=ada-audit" class="inline-flex items-center rounded-lg bg-red-500 px-5 py-2.5 text-sm font-semibold text-white shadow transition hover:bg-red-600">
          Request an ADA / WCAG Audit
        </a>
        <a href="/services/ada-compliant-web-design/emergency-remediation/" class="inline-flex items-center rounded-lg border border-[var(--border)] px-5 py-2.5 text-sm font-semibold text-[var(--text)] transition hover:bg-[var(--bg)]">
          Emergency Help Within 48 Hours
        </a>
      </div>
      <ul class="mt-7 grid max-w-3xl gap-2 text-sm text-[var(--text-muted)] sm:grid-cols-2" role="list">
        <li class="flex gap-2"><span class="text-green-500" aria-hidden="true">✓</span>Manual and automated testing</li>
        <li class="flex gap-2"><span class="text-green-500" aria-hidden="true">✓</span>Source-code and content fixes</li>
        <li class="flex gap-2"><span class="text-green-500" aria-hidden="true">✓</span>Shopify and ecommerce testing</li>
        <li class="flex gap-2"><span class="text-green-500" aria-hidden="true">✓</span>Reports written for real teams</li>
      </ul>
    </div>
  </section>

  <section class="mb-16 grid gap-6 lg:grid-cols-[1.1fr_0.9fr]">
    <div>
      <p class="text-base leading-relaxed text-[var(--text-muted)] md:text-lg">
        A website may look fine and still be difficult to use without a mouse, with a screen reader, at high zoom, or with reduced vision or dexterity. We test the real experience, not only a scanner score. Then we fix shared templates and components so improvements carry across the website.
      </p>
      <p class="mt-4 text-base leading-relaxed text-[var(--text-muted)] md:text-lg">
        eLan Technology has designed and developed websites since 2002. Our accessibility work brings design, development, content and testing together, so you do not have to coordinate several suppliers to solve one problem.
      </p>
    </div>
    <aside class="rounded-2xl border border-[var(--border)] bg-[var(--bg-card)] p-6" aria-labelledby="service-fit-heading">
      <h2 id="service-fit-heading" class="font-heading text-xl font-bold text-[var(--text)]">This service is a good fit if you need to</h2>
      <ul class="mt-4 space-y-3 text-sm text-[var(--text-muted)]" role="list">
        <li class="flex gap-3"><span class="text-red-500" aria-hidden="true">01</span>Respond to an ADA demand letter or urgent deadline</li>
        <li class="flex gap-3"><span class="text-red-500" aria-hidden="true">02</span>Audit a website before launch, redesign or procurement</li>
        <li class="flex gap-3"><span class="text-red-500" aria-hidden="true">03</span>Fix an ecommerce store, checkout or account journey</li>
        <li class="flex gap-3"><span class="text-red-500" aria-hidden="true">04</span>Prepare a WCAG report or ACR for a client or buyer</li>
      </ul>
    </aside>
  </section>

  <section class="mb-16">
    <h2 class="font-heading text-2xl font-bold text-[var(--text)] md:text-3xl">What You Receive</h2>
    <p class="mt-3 max-w-3xl text-[var(--text-muted)]">The scope is agreed before testing starts. Every engagement is shaped around the pages, features and customer tasks that matter to your organisation.</p>
    <div class="mt-7 grid gap-4 md:grid-cols-2 lg:grid-cols-3">
      {[
        { title: 'A useful audit', desc: 'Problems are grouped by impact and connected to the relevant WCAG requirement, affected pages and user journey.' },
        { title: 'A clear action plan', desc: 'You see what should be fixed first, what can follow later, and which shared components will solve the most problems.' },
        { title: 'Code-level remediation', desc: 'We update templates, components, styles, forms and content instead of covering the website with a widget.' },
        { title: 'Journey testing', desc: 'We test complete tasks such as finding a product, completing a form, creating an account or checking out.' },
        { title: 'Retesting evidence', desc: 'Completed fixes are checked again. The final record states what passed, what remains and any known limitation.' },
        { title: 'Handover and prevention', desc: 'Your team receives practical guidance for content, design and development so new barriers are less likely to return.' },
      ].map(({ title, desc }) => (
        <article class="rounded-xl border border-[var(--border)] bg-[var(--bg-card)] p-6">
          <h3 class="font-heading text-base font-semibold text-[var(--text)]">{title}</h3>
          <p class="mt-2 text-sm leading-relaxed text-[var(--text-muted)]">{desc}</p>
        </article>
      ))}
    </div>
  </section>

  <section class="mb-16 rounded-2xl border border-red-500/35 bg-red-500/5 p-8 md:p-10">
    <div class="grid gap-8 lg:grid-cols-[1fr_auto] lg:items-start">
      <div>
        <p class="text-sm font-semibold uppercase tracking-widest text-red-500">Urgent ADA assessment</p>
        <h2 class="mt-2 font-heading text-2xl font-bold text-[var(--text)] md:text-3xl">Received a Demand Letter or Working to a Deadline?</h2>
        <p class="mt-4 max-w-3xl text-[var(--text-muted)]">Share the document with qualified legal counsel and start recording the technical condition of the website. We can assess the affected journeys, prepare a practical remediation plan and begin the highest-priority fixes. Our role is technical. Your attorney should direct the legal response.</p>
      </div>
      <div class="rounded-xl border border-red-500/30 bg-[var(--bg-card)] px-7 py-5 text-center">
        <p class="font-heading text-3xl font-bold text-red-500">48 hrs</p>
        <p class="mt-1 max-w-40 text-xs text-[var(--text-muted)]">Target response for emergency assessment requests</p>
      </div>
    </div>
    <ol class="mt-8 grid gap-4 md:grid-cols-2 lg:grid-cols-4">
      {[
        { n: '1', title: 'Confirm the scope', desc: 'We review the deadline, affected URLs and critical customer tasks.' },
        { n: '2', title: 'Capture the evidence', desc: 'We record repeatable barriers before changes are made.' },
        { n: '3', title: 'Fix the priorities', desc: 'Shared components and blocked journeys are addressed first.' },
        { n: '4', title: 'Retest and report', desc: 'We verify the work and document the current status.' },
      ].map(({ n, title, desc }) => (
        <li class="rounded-xl border border-[var(--border)] bg-[var(--bg-card)] p-5">
          <span class="text-xs font-bold text-red-500">STEP {n}</span>
          <h3 class="mt-2 font-heading text-base font-semibold text-[var(--text)]">{title}</h3>
          <p class="mt-2 text-sm text-[var(--text-muted)]">{desc}</p>
        </li>
      ))}
    </ol>
    <div class="mt-7 flex flex-wrap items-center gap-4">
      <a href="/get-quote/?service=ada-emergency" class="inline-flex items-center rounded-lg bg-red-500 px-5 py-2.5 text-sm font-semibold text-white transition hover:bg-red-600">Request Emergency Assessment</a>
      <a href="/services/ada-compliant-web-design/emergency-remediation/" class="text-sm font-semibold text-red-500 underline hover:no-underline">View the emergency remediation service</a>
    </div>
  </section>

  <section class="mb-16">
    <h2 class="font-heading text-2xl font-bold text-[var(--text)] md:text-3xl">Our Accessibility Audit and Remediation Process</h2>
    <p class="mt-3 max-w-3xl text-[var(--text-muted)]">The process is straightforward. We agree what matters, test it, fix it and check it again.</p>
    <div class="mt-7 grid gap-4 sm:grid-cols-2 lg:grid-cols-5">
      {[
        { n: '01', title: 'Scope', desc: 'Pages, templates, journeys, documents and required standard.' },
        { n: '02', title: 'Audit', desc: 'Automated checks plus manual keyboard and assistive technology testing.' },
        { n: '03', title: 'Prioritise', desc: 'Barriers ranked by user impact, reach and urgency.' },
        { n: '04', title: 'Remediate', desc: 'Design, content and code updated at the source.' },
        { n: '05', title: 'Retest', desc: 'Fixes verified and final status documented.' },
      ].map(({ n, title, desc }) => (
        <article class="rounded-xl border border-[var(--border)] bg-[var(--bg-card)] p-5">
          <p class="text-xs font-bold text-red-500">{n}</p>
          <h3 class="mt-2 font-heading text-base font-semibold text-[var(--text)]">{title}</h3>
          <p class="mt-2 text-sm text-[var(--text-muted)]">{desc}</p>
        </article>
      ))}
    </div>
  </section>

  <section class="mb-16 grid gap-8 lg:grid-cols-2">
    <div>
      <h2 class="font-heading text-2xl font-bold text-[var(--text)] md:text-3xl">Ecommerce Accessibility That Covers the Whole Sale</h2>
      <p class="mt-4 text-[var(--text-muted)]">An accessible product page is not enough if a customer cannot choose an option, apply a coupon, understand an error or complete payment. We test the connected journey across your storefront and the third-party services it relies on.</p>
      <p class="mt-4 text-[var(--text-muted)]">We work with Shopify, WooCommerce, Medusa.js and custom commerce websites. Testing can include subscriptions, account access, payment gateways, delivery options, customer support and post-purchase pages.</p>
      <a href="/services/ecommerce/" class="mt-5 inline-flex text-sm font-semibold text-red-500 underline hover:no-underline">Explore our ecommerce development services</a>
    </div>
    <div class="grid gap-3 sm:grid-cols-2">
      {['Navigation and product search', 'Product media and options', 'Cart and checkout', 'Forms and error messages', 'Accounts and subscriptions', 'Payments and shipping'].map(item => (
        <div class="flex items-center gap-3 rounded-xl border border-[var(--border)] bg-[var(--bg-card)] px-4 py-4 text-sm font-medium text-[var(--text)]">
          <span class="text-green-500" aria-hidden="true">✓</span>{item}
        </div>
      ))}
    </div>
  </section>

  <section class="mb-16">
    <h2 class="font-heading text-2xl font-bold text-[var(--text)] md:text-3xl">ADA and WCAG Services for the United States and Canada</h2>
    <p class="mt-3 max-w-3xl text-[var(--text-muted)]">The same accessible design principles help users everywhere, but the legal and reporting requirements are not identical. We confirm the applicable standard at the start instead of applying one label to every organisation.</p>
    <div class="mt-7 grid gap-5 md:grid-cols-2">
      <article class="rounded-xl border border-[var(--border)] bg-[var(--bg-card)] p-6">
        <h3 class="font-heading text-lg font-semibold text-[var(--text)]">United States</h3>
        <p class="mt-3 text-sm leading-relaxed text-[var(--text-muted)]">The ADA applies to state and local governments under Title II and to businesses open to the public under Title III. The DOJ Title II web rule names WCAG 2.1 Level AA for covered public entities. Private-sector obligations depend on the organisation and circumstances, so legal counsel should confirm what applies.</p>
      </article>
      <article class="rounded-xl border border-[var(--border)] bg-[var(--bg-card)] p-6">
        <h3 class="font-heading text-lg font-semibold text-[var(--text)]">Canada</h3>
        <p class="mt-3 text-sm leading-relaxed text-[var(--text-muted)]">Canadian organisations may need to consider the Accessible Canada Act, provincial requirements such as Ontario's AODA, contracts and sector-specific rules. We provide WCAG audits and remediation using the standard required for the engagement.</p>
      </article>
    </div>
    <p class="mt-5 text-sm text-[var(--text-muted)]">For a broader comparison, read our <a href="/blog/accessibility/ada-wcag-compliance-us-canada-2026/" class="text-red-500 underline hover:no-underline">2026 guide to ADA and WCAG compliance in the US and Canada</a>.</p>
  </section>

  <section class="mb-16">
    <h2 class="font-heading text-2xl font-bold text-[var(--text)] md:text-3xl">Accessibility Service Options and Starting Costs</h2>
    <p class="mt-3 max-w-3xl text-[var(--text-muted)]">Pricing is based on the website's unique page types, journeys, documents and integrations. You receive a written scope before work begins.</p>
    <div class="mt-7 overflow-x-auto rounded-xl border border-[var(--border)]">
      <table class="w-full min-w-[640px] text-left text-sm">
        <thead class="bg-[var(--bg-card)] text-[var(--text)]">
          <tr>
            <th scope="col" class="px-5 py-3 font-semibold">Service</th>
            <th scope="col" class="px-5 py-3 font-semibold">Best for</th>
            <th scope="col" class="px-5 py-3 text-right font-semibold">Starting point</th>
          </tr>
        </thead>
        <tbody class="divide-y divide-[var(--border)] text-[var(--text-muted)]">
          <tr class="bg-green-500/5"><td class="px-5 py-4 font-medium text-[var(--text)]">Rapid WCAG audit</td><td class="px-5 py-4">Priorities and remediation plan</td><td class="px-5 py-4 text-right font-semibold text-green-500">From $1,500</td></tr>
          <tr><td class="px-5 py-4 font-medium text-[var(--text)]">Code-level remediation</td><td class="px-5 py-4">Fixing an existing website</td><td class="px-5 py-4 text-right">Quoted after scope</td></tr>
          <tr><td class="px-5 py-4 font-medium text-[var(--text)]">Accessible redesign or rebuild</td><td class="px-5 py-4">Replacing an outdated experience</td><td class="px-5 py-4 text-right">$3,000 to $12,000</td></tr>
          <tr><td class="px-5 py-4 font-medium text-[var(--text)]">ACR preparation</td><td class="px-5 py-4">Procurement and client reviews</td><td class="px-5 py-4 text-right">Scoped by product</td></tr>
          <tr><td class="px-5 py-4 font-medium text-[var(--text)]">Ongoing retesting</td><td class="px-5 py-4">Preventing regressions</td><td class="px-5 py-4 text-right">Monthly or quarterly</td></tr>
        </tbody>
      </table>
    </div>
  </section>

  <section class="mb-16 rounded-2xl border border-[var(--border)] bg-gradient-to-br from-green-500/10 via-[var(--bg-card)] to-[var(--bg-card)] p-8 md:p-10">
    <h2 class="font-heading text-2xl font-bold text-[var(--text)] md:text-3xl">Get Your ADA Compliance Audit: Results Delivered in 48 Hours</h2>
    <p class="mt-3 max-w-3xl text-[var(--text-muted)]">We confirm the pages and journeys to be tested, then deliver a clear report with priorities, affected WCAG criteria and recommended next steps. Rapid audits start at $1,500 USD.</p>
    <ul class="mt-6 grid gap-3 text-sm text-[var(--text-muted)] sm:grid-cols-2" role="list">
      <li class="flex gap-2"><span class="text-green-500" aria-hidden="true">✓</span>Manual and automated testing</li>
      <li class="flex gap-2"><span class="text-green-500" aria-hidden="true">✓</span>Critical journeys reviewed</li>
      <li class="flex gap-2"><span class="text-green-500" aria-hidden="true">✓</span>Problems ranked by impact</li>
      <li class="flex gap-2"><span class="text-green-500" aria-hidden="true">✓</span>Remediation effort estimated</li>
      <li class="flex gap-2"><span class="text-green-500" aria-hidden="true">✓</span>WCAG criteria clearly mapped</li>
      <li class="flex gap-2"><span class="text-green-500" aria-hidden="true">✓</span>Practical next steps for your team</li>
    </ul>
    <a href="/get-quote/?service=ada-audit" class="mt-7 inline-flex items-center rounded-lg bg-green-500 px-6 py-3 text-sm font-semibold text-white shadow transition hover:bg-green-600">Request My ADA / WCAG Audit</a>
    <p class="mt-3 text-xs text-[var(--text-muted)]">Turnaround begins after the scope and access requirements are confirmed.</p>
  </section>

  <section class="mb-16 grid gap-8 lg:grid-cols-[0.9fr_1.1fr]">
    <div>
      <h2 class="font-heading text-2xl font-bold text-[var(--text)] md:text-3xl">How to Compare Accessibility Providers</h2>
      <p class="mt-4 text-[var(--text-muted)]">A credible provider should be able to explain how people were affected, where the problem lives and how the fix will be verified. Be cautious of instant compliance promises, a scanner-only report or a badge that does not show what was tested.</p>
    </div>
    <ul class="grid gap-3 sm:grid-cols-2 text-sm text-[var(--text-muted)]" role="list">
      <li class="rounded-xl border border-[var(--border)] bg-[var(--bg-card)] p-4"><strong class="block text-[var(--text)]">Ask about manual testing</strong><span class="mt-1 block">Keyboard, screen reader, zoom and complete tasks.</span></li>
      <li class="rounded-xl border border-[var(--border)] bg-[var(--bg-card)] p-4"><strong class="block text-[var(--text)]">Ask who fixes the code</strong><span class="mt-1 block">Reports alone do not remove barriers.</span></li>
      <li class="rounded-xl border border-[var(--border)] bg-[var(--bg-card)] p-4"><strong class="block text-[var(--text)]">Ask what gets retested</strong><span class="mt-1 block">Completed work should be checked again.</span></li>
      <li class="rounded-xl border border-[var(--border)] bg-[var(--bg-card)] p-4"><strong class="block text-[var(--text)]">Ask what remains</strong><span class="mt-1 block">Honest reports include limitations and exclusions.</span></li>
    </ul>
  </section>

  <section class="mb-16">
    <h2 class="font-heading text-2xl font-bold text-[var(--text)] md:text-3xl">Why Work With eLan Technology?</h2>
    <div class="mt-7 grid gap-4 sm:grid-cols-2 lg:grid-cols-4">
      {[
        { title: 'Since 2002', desc: 'Long-term web design and development experience across business websites and applications.' },
        { title: 'One practical team', desc: 'Design, development, content and testing work together through the same project.' },
        { title: 'Source-level fixes', desc: 'We improve the website itself and verify the customer experience after changes.' },
        { title: 'Clear documentation', desc: 'Reports state what was tested, fixed, retested and still needs attention.' },
      ].map(({ title, desc }) => (
        <article class="rounded-xl border border-[var(--border)] bg-[var(--bg-card)] p-5">
          <h3 class="font-heading text-base font-semibold text-[var(--text)]">{title}</h3>
          <p class="mt-2 text-sm text-[var(--text-muted)]">{desc}</p>
        </article>
      ))}
    </div>
    <p class="mt-5 text-sm text-[var(--text-muted)]">Related reading: <a href="/blog/accessibility/ada-compliance-checklist/" class="text-red-500 underline hover:no-underline">ADA website checklist</a> · <a href="/blog/accessibility/wcag-explained-business-owners/" class="text-red-500 underline hover:no-underline">WCAG explained for business owners</a> · <a href="/free-website-audit/" class="text-red-500 underline hover:no-underline">free website audit</a> · <a href="/accessibility-statement/" class="text-red-500 underline hover:no-underline">our accessibility statement</a></p>
  </section>

  <section class="mb-16 border-y border-[var(--border)] py-8">
    <div class="flex flex-wrap items-end justify-between gap-3">
      <h2 class="font-heading text-xl font-bold text-[var(--text)]">Standards and Official Guidance</h2>
      <p class="text-xs text-[var(--text-muted)]">Page reviewed 31 July 2026</p>
    </div>
