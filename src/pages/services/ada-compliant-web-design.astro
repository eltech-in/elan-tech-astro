---
import ServiceLayout from '../../layouts/ServiceLayout.astro';
import { breadcrumbSchema, faqSchema } from '../../utils/schema';
import ServicePage from '../../components/service/ServicePage.astro';
import LocalPrice from '../../components/LocalPrice.astro';
import { ACCESSIBILITY_PRICES as AP } from '../../data/auditPricing';
const usd = (n: number) => `US$${n.toLocaleString('en-US')}`;

const SITE_URL = 'https://elan-tech.net';

// FAQs follow the remediation searches in Search Console (27 Nov 2026): "website accessibility
// remediation", "ADA remediation", "WCAG remediation services", "ecommerce WCAG remediation".
const faqs = [
  {
    question: 'What is website accessibility remediation?',
    answer: 'Website accessibility remediation is the work of fixing the barriers that stop people with disabilities from using a website. It normally starts with an audit, then updates the design, content and source code, tests the important tasks again and records what was fixed and what remains.',
  },
  {
    question: 'What is the difference between an accessibility audit and remediation?',
    answer: 'An audit finds and explains the barriers, mapped to WCAG criteria and ranked by impact. Remediation fixes them in the website itself. Many organisations need both: the audit sets the priorities, remediation removes the barriers, and retesting confirms the result.',
  },
  {
    question: 'What does ADA remediation include?',
    answer: 'ADA website remediation usually covers keyboard access, focus order and visibility, screen-reader labels, headings and landmarks, colour contrast, forms and error messages, images and media alternatives, menus and dialogs, and complete journeys such as search, checkout or booking. We fix shared templates and components first so improvements carry across the site.',
  },
  {
    question: 'Do you offer WCAG remediation services for ecommerce stores?',
    answer: 'Yes. We audit and remediate Shopify, WooCommerce, Medusa.js and custom stores. Testing covers product discovery, product options, cart, checkout, coupons, account access, subscriptions, payment and delivery steps, form errors and post-purchase pages, including the third-party services the store relies on.',
  },
  {
    question: 'How quickly can you respond to an ADA demand letter or deadline?',
    answer: 'Our target response time for emergency assessment requests is 48 hours. After reviewing the website, deadline and affected journeys, we confirm the audit scope, delivery date and remediation plan before work begins. Your attorney should direct the legal response; our role is technical.',
  },
  {
    question: 'How much does an ADA website audit and remediation cost?',
    answer: `An accessibility quick check costs ${usd(AP.quickCheck.USD)}. A full WCAG 2.2 AA audit and remediation plan starts at ${usd(AP.audit.USD)} for up to about 10 page templates and 2 to 3 journeys; it identifies and prioritises the fixes, and implementing them is quoted separately. Larger sites are quoted to scope. Code-level remediation is quoted after the audit and is typically ${usd(AP.remediationFrom.USD)} to ${usd(AP.remediationTo.USD)} for a small website or Shopify store. Prices are also shown in your local currency. These services are offered to US and other international organisations.`,
  },
  {
    question: 'Is an automated accessibility scan or overlay enough?',
    answer: 'No. Automated tools find only some problems, and an overlay cannot establish WCAG conformance by itself. Manual keyboard testing, screen-reader review and task-based testing find issues with menus, forms, focus order, errors and checkout, and most barriers must be fixed in the content, design and code.',
  },
  {
    question: 'Do you provide accessibility audits for Canadian organisations?',
    answer: 'Yes. We provide WCAG audits and remediation for Canadian businesses and organisations. The required standard and reporting scope depend on where the organisation operates and whether it is federally regulated, so we confirm the baseline (for example AODA or the Accessible Canada Act) before testing.',
  },
  {
    question: 'Does WCAG 2.2 AA guarantee ADA compliance?',
    answer: 'No technical audit can guarantee legal compliance in every situation. We use WCAG Level AA as the technical foundation and record the version used; legal counsel should confirm the obligations that apply to your organisation.',
  },
  {
    question: 'What is the current DOJ Title II website accessibility timeline?',
    answer: "The DOJ Title II web rule requires covered state and local government web content and mobile apps to meet WCAG 2.1 Level AA, subject to the rule's exceptions. In April 2026 the DOJ extended the compliance dates to April 26, 2027 for entities serving 50,000 or more people, and April 26, 2028 for smaller entities and special district governments.",
  },
  {
    question: 'Can you prepare a VPAT or Accessibility Conformance Report?',
    answer: 'Yes, when procurement documentation is in scope. A VPAT is a reporting template; the completed document is an Accessibility Conformance Report (ACR). It records how the evaluated product supports the applicable criteria and identifies known gaps.',
  },
];

const breadcrumbs = [
  { name: 'Home', href: '/' },
  { name: 'Services', href: '/services/' },
  { name: 'ADA Website Remediation', href: '/services/ada-compliant-web-design/' },
];

const serviceSchemaObj = {
  '@context': 'https://schema.org',
  '@type': 'Service',
  name: 'Website Accessibility Remediation: ADA and WCAG Audits',
  alternateName: 'Accessible Web Design and Development',
  description:
    'Website accessibility remediation for ADA and WCAG: audits, code-level fixes, ecommerce journey testing, retesting and accessibility documentation for organisations in the United States and Canada.',
  url: `${SITE_URL}/services/ada-compliant-web-design/`,
  provider: {
    '@type': 'Organization',
    name: 'eLan Technology',
    url: SITE_URL,
  },
  areaServed: [
    { '@type': 'Country', name: 'United States' },
    { '@type': 'Country', name: 'Canada' },
  ],
  serviceType: ['Website Accessibility Remediation', 'ADA Website Remediation', 'WCAG Remediation', 'WCAG Accessibility Audit', 'Accessible Web Development'],
  offers: [
    { '@type': 'Offer', price: String(AP.quickCheck.USD), priceCurrency: 'USD', description: 'Accessibility quick check (one domain)' },
    { '@type': 'Offer', price: String(AP.audit.USD), priceCurrency: 'USD', description: 'WCAG 2.2 AA audit and remediation plan for up to about 10 templates and 2 to 3 journeys; implementation quoted separately' },
  ],
};

const schemaBreadcrumbs = breadcrumbs.map(b => ({ name: b.name, url: b.href }));
const schemas = [serviceSchemaObj, faqSchema(faqs), breadcrumbSchema(schemaBreadcrumbs)];

const standards = [
  ['W3C Web Content Accessibility Guidelines 2.2', 'https://www.w3.org/TR/WCAG22/'],
  ['US DOJ guidance on web accessibility and the ADA', 'https://www.ada.gov/resources/web-guidance/'],
  ['US DOJ 2026 Title II compliance date extension', 'https://www.ada.gov/assets/pdfs/2026-ifr.pdf'],
  ['FTC case concerning automated accessibility claims', 'https://www.ftc.gov/legal-library/browse/cases-proceedings/2223156-accessibe-inc'],
  ['Government of Canada federal accessibility law overview', 'https://www.canada.ca/en/government/publicservice/wellness-inclusion-diversity-public-service/diversity-inclusion-public-service/accessibility-public-service/about-canada-federal-accessibility-law.html'],
  ['Accessibility Standards Canada web requirements', 'https://accessible.canada.ca/creating-accessibility-standards/canasc-en-301-5492024-accessibility-requirements-ict-products-and-services/9-web'],
];
// Price ladder (owner, 27 Nov 2026): international only, shown in the visitor's currency, never INR.
// Illustrative finding (owner, 27 Nov 2026): shows the format of a finding; clearly labelled, not a client report.
const example = [
  ['The barrier', 'Using only a keyboard, a customer opens the cart drawer but cannot close it, and focus stays on the page behind it.', 'WCAG 2.1.1, 2.4.3, 4.1.2'],
  ['How we reproduced it', 'Tested with the keyboard alone, then with NVDA and Chrome and VoiceOver and Safari. The close control has no name and Escape does nothing.', ''],
  ['The fix', 'The close control becomes a real button named “Close cart”. Escape closes the drawer, focus moves into it on open and returns to the cart button on close.', ''],
  ['The retest', 'Opening, closing and returning focus pass with the keyboard and both screen readers. The finding is marked resolved with the date and build tested.', ''],
];
const options = [
  { service: 'Accessibility quick check', best: 'A limited review: automated scan plus manual checks of the homepage and one journey', from: AP.quickCheck },
  { service: 'WCAG 2.2 AA audit and remediation plan', best: 'Finds and prioritises the fixes for up to about 10 templates and 2 to 3 journeys; fixes quoted separately', from: AP.audit, prefix: 'from' },
  { service: 'Code-level remediation', best: 'Fixing an existing website or store, quoted after the audit', from: AP.remediationFrom, to: AP.remediationTo, prefix: 'typically' },
  { service: 'Accessible redesign or rebuild', best: 'Replacing an outdated experience', from: AP.redesignFrom, to: AP.redesignTo },
  { service: 'ACR / VPAT', best: 'Procurement and client reviews, after an audit', from: AP.acr, prefix: 'from' },
  { service: 'Monitoring and retesting', best: 'Preventing regressions after launch', from: AP.monitoring, suffix: 'a month', alt: AP.retest },
];

---

<ServiceLayout
  title="ADA Website Remediation Services & WCAG Audits"
  description="Website accessibility remediation for ADA and WCAG: audits, source-code fixes, ecommerce checkout testing and retesting for businesses in the US and Canada. Target response within 48 hours for urgent requests."
  canonical="/services/ada-compliant-web-design/"
  schema={schemas}
  breadcrumbs={breadcrumbs}
>
  <ServicePage
    accentVar="--ac-blue"
    eyebrow="ADA and WCAG remediation services"
    heading="Website Accessibility Remediation for ADA & WCAG"
    intro="We find the barriers that stop people using your website, fix them in the code and content, and retest the journeys that matter. You get clear findings, priorities and a record of the work. Urgent requests get a target response within 48 hours."
    highlights={['Manual and automated WCAG testing', 'Source-code fixes, not overlays', 'Shopify and ecommerce checkout testing', 'Retesting and a written record', 'US and Canada (ADA, AODA, ACA)', 'Designing and building websites since 2002']}
    primaryCta={{ label: 'Discuss remediation', href: '/schedule-consultation/' }}
    secondaryCta={{ label: 'Urgent? Target response in 48 hours', href: '/services/ada-compliant-web-design/emergency-remediation/#rush-assessment' }}
    offersTitle="What our remediation service includes"
    offersIntro="The scope is agreed before testing starts, around the pages, features and customer tasks that matter to you."
    offers={[
      { title: 'Accessibility audit', text: 'Barriers grouped by impact and mapped to the WCAG criterion, affected pages and user journey.' },
      { title: 'Prioritised action plan', text: 'What to fix first, what can follow, and which shared components remove the most barriers.' },
      { title: 'Code-level remediation', text: 'Templates, components, styles, forms and content fixed at the source instead of covered by a widget.' },
      { title: 'Journey testing', text: 'Complete tasks tested: finding a product, completing a form, creating an account, checking out.' },
      { title: 'Retesting evidence', text: 'Completed fixes checked again; the record states what passed, what remains and known limitations.' },
      { title: 'Handover and prevention', text: 'Practical guidance for content, design and development so new barriers are less likely to return.' },
    ]}
    processTitle="Audit, remediate, retest"
    process={[
      { title: 'Scope', text: 'Pages, templates, journeys, documents and the required standard.' },
      { title: 'Audit', text: 'Automated checks plus manual keyboard and assistive-technology testing.' },
      { title: 'Remediate', text: 'Barriers ranked by impact, then fixed in design, content and code.' },
      { title: 'Retest', text: 'Fixes verified and the final status documented.' },
    ]}
    fit={['You received an ADA demand letter or face an accessibility deadline.', 'A launch, redesign or procurement review needs a WCAG audit first.', 'An ecommerce store, checkout or account journey has to be fixed.', 'A client or buyer asks for a WCAG report or ACR.']}
    note="This page provides general technical information, not legal advice. Ask qualified legal counsel which laws and standards apply to your organisation."
    guides={[
      { label: 'Explainer', title: 'Accessibility audit vs remediation: what your website needs', href: '/blog/accessibility/accessibility-audit-vs-remediation/' },
      { label: 'Checklist', title: 'ADA website checklist: 30 WCAG checks', href: '/blog/accessibility/ada-compliance-checklist/' },
      { label: 'US and Canada', title: 'ADA and WCAG compliance in the US and Canada, 2026', href: '/blog/accessibility/ada-wcag-compliance-us-canada-2026/' },
      { label: 'Canada', title: 'What a website accessibility audit should deliver in Canada', href: '/blog/accessibility/website-accessibility-audit-deliverables-canada/' },
      { label: 'Plain English', title: 'WCAG explained for business owners', href: '/blog/accessibility/wcag-explained-business-owners/' },
      { label: 'EU sellers', title: 'European Accessibility Act guide for non-EU businesses', href: '/blog/accessibility/european-accessibility-act-eaa-compliance-guide/' },
    ]}
    faqTitle="Accessibility remediation FAQs"
    faqs={faqs}
    cta={{ title: 'Talk to us about remediation', text: 'Tell us the website, the deadline and the journeys that matter. We confirm the scope and price in writing before testing or fixes start.', label: 'Discuss remediation', href: '/schedule-consultation/' }}
  >
    <section class="tilt-card tilt-card--lg p-6 sm:p-8" style="--card-color: var(--ac-blue);" aria-labelledby="example-title">
      <p class="text-xs font-bold uppercase tracking-[0.16em] text-[var(--ac-blue)]">Illustrative example · how a finding is fixed and verified</p>
      <h2 id="example-title" class="mt-2 font-heading text-2xl font-bold text-[var(--text)] sm:text-3xl">A keyboard user cannot close the cart drawer</h2>
      <p class="mt-2 max-w-3xl text-sm text-[var(--text-muted)]">This shows the format of our findings. It is an illustrative example, not taken from a client report.</p>
      <ol class="mt-6 grid gap-5 sm:grid-cols-2 lg:grid-cols-4" role="list">
        {example.map(([t, d, ref], i) => (
          <li>
            <span class="inline-grid h-8 w-8 place-items-center rounded-lg text-xs font-black text-[var(--ac-blue)]" style="background: color-mix(in srgb, var(--ac-blue) 15%, transparent);">{String(i + 1).padStart(2, '0')}</span>
            <h3 class="mt-3 font-semibold text-[var(--text)]">{t}</h3>
            <p class="mt-1.5 text-sm leading-relaxed text-[var(--text-dim)]">{d}</p>
            {ref && <p class="mt-2 text-xs font-semibold text-[var(--text-muted)]">{ref}</p>}
          </li>
        ))}
      </ol>
    </section>

    <section aria-labelledby="paths-title">
      <h2 id="paths-title" class="font-heading text-2xl font-bold text-[var(--text)] sm:text-3xl">Three ways to start</h2>
      <div class="mt-6 grid gap-5 lg:grid-cols-3">
        <div class="tilt-card flex flex-col p-6" style="--card-color: var(--ac-blue);">
          <p class="text-xs font-bold uppercase tracking-[0.14em] text-[var(--ac-blue)]">Most clients start here</p>
          <h3 class="mt-2 font-heading text-lg font-bold text-[var(--text)]">Discuss remediation</h3>
          <p class="mt-2 text-sm leading-relaxed text-[var(--text-dim)]">You know the site has barriers, or you have a letter or a deadline. We look at the site and agree the scope, priorities and price of the fixes in writing.</p>
          <a href="/schedule-consultation/" class="mt-auto inline-flex min-h-11 w-fit items-center rounded-lg bg-[var(--accent)] px-5 py-2.5 text-sm font-bold text-white transition hover:brightness-110">Discuss remediation</a>
        </div>
        <div class="tilt-card flex flex-col p-6" style="--card-color: var(--ac-teal);">
          <p class="text-xs font-bold uppercase tracking-[0.14em] text-[var(--ac-teal)]">Quick check · <LocalPrice prices={AP.quickCheck} /></p>
          <h3 class="mt-2 font-heading text-lg font-bold text-[var(--text)]">A limited first look</h3>
          <p class="mt-2 text-sm leading-relaxed text-[var(--text-dim)]">An automated scan plus manual checks of the homepage and one journey. It is not a full audit. The fee is credited toward the audit.</p>
          <a href="/website-audit/#paid-wcag-audit" class="mt-auto pt-4 text-sm font-semibold text-[var(--text)] underline underline-offset-4">Book the quick check →</a>
        </div>
        <div class="tilt-card flex flex-col p-6" style="--card-color: var(--ac-indigo);">
          <p class="text-xs font-bold uppercase tracking-[0.14em] text-[var(--ac-indigo)]">Audit and remediation plan · from <LocalPrice prices={AP.audit} /></p>
          <h3 class="mt-2 font-heading text-lg font-bold text-[var(--text)]">A scoped WCAG 2.2 AA audit</h3>
          <p class="mt-2 text-sm leading-relaxed text-[var(--text-dim)]">Tests up to about 10 templates and 2 to 3 journeys, then identifies and prioritises the fixes. Implementing them is quoted separately; larger sites are quoted to scope.</p>
          <a href="#options-title" class="mt-auto pt-4 text-sm font-semibold text-[var(--text)] underline underline-offset-4">See all prices →</a>
        </div>
      </div>
    </section>

    <section class="tilt-card tilt-card--lg p-6 sm:p-8" style="--card-color: var(--ac-red);" aria-labelledby="urgent-title">
      <div class="grid gap-6 lg:grid-cols-[1fr_auto] lg:items-center">
        <div>
          <p class="text-xs font-bold uppercase tracking-[0.16em] text-[var(--ac-red)]">Urgent ADA assessment</p>
          <h2 id="urgent-title" class="mt-2 font-heading text-2xl font-bold text-[var(--text)] sm:text-3xl">Received a demand letter or working to a deadline?</h2>
          <p class="mt-3 max-w-3xl leading-relaxed text-[var(--text-dim)]">Share the document with qualified legal counsel and start recording the technical condition of the website. We assess the affected journeys, prepare a remediation plan and begin the highest-priority fixes: confirm the scope, capture the evidence, fix the priorities, retest and report.</p>
        </div>
        <div class="flex flex-col gap-2">
          <p class="font-heading text-4xl font-black text-[var(--ac-red)]">48 hrs</p>
          <p class="max-w-[14rem] text-xs text-[var(--text-muted)]">Target response for emergency assessment requests; delivery is confirmed after scope review</p>
          <a href="/services/ada-compliant-web-design/emergency-remediation/" class="mt-1 text-sm font-semibold text-[var(--text)] underline underline-offset-4">View the emergency remediation service →</a>
        </div>
      </div>
    </section>

    <section class="grid gap-4 lg:grid-cols-2" aria-labelledby="ecom-title">
      <div class="tilt-card p-6 sm:p-8" style="--card-color: var(--ac-cyan);">
        <h2 id="ecom-title" class="font-heading text-xl font-bold text-[var(--text)]">Ecommerce accessibility that covers the whole sale</h2>
        <p class="mt-2 text-sm leading-relaxed text-[var(--text-dim)]">An accessible product page is not enough if a customer cannot choose an option, apply a coupon, understand an error or pay. We test the connected journey on Shopify, WooCommerce, Medusa.js and custom stores, including the third-party services they rely on.</p>
        <ul class="mt-4 grid gap-x-4 gap-y-2 text-sm text-[var(--text)] sm:grid-cols-2" role="list">
          {['Navigation and search', 'Product media and options', 'Cart and checkout', 'Forms and errors', 'Accounts and subscriptions', 'Payments and shipping'].map((item) => <li>✓ {item}</li>)}
        </ul>
        <a href="/services/ecommerce/" class="mt-3 inline-block text-sm font-semibold text-[var(--ac-cyan)] underline underline-offset-4">Our ecommerce development services →</a>
      </div>
      <div class="tilt-card p-6 sm:p-8" style="--card-color: var(--ac-indigo);">
        <h2 class="font-heading text-xl font-bold text-[var(--text)]">ADA and WCAG for the United States and Canada</h2>
        <p class="mt-3 text-sm leading-relaxed text-[var(--text-dim)]"><strong class="block text-[var(--text)]">United States:</strong> the ADA covers state and local governments (Title II) and businesses open to the public (Title III). The DOJ Title II web rule names WCAG 2.1 Level AA for covered public entities; private-sector obligations depend on the circumstances.</p>
        <p class="mt-3 text-sm leading-relaxed text-[var(--text-dim)]"><strong class="block text-[var(--text)]">Canada:</strong> organisations may need to consider the Accessible Canada Act, provincial rules such as Ontario's AODA, contracts and sector requirements. We confirm the applicable standard before testing.</p>
      </div>
    </section>

    <section aria-labelledby="options-title">
      <h2 id="options-title" class="font-heading text-2xl font-bold text-[var(--text)] sm:text-3xl">Service options and starting costs</h2>
      <p class="mt-2 text-[var(--text-dim)]">For US and other international organisations, shown in your currency. Pricing follows the website's unique page types, journeys, documents and integrations, and you receive a written scope before work begins. The quick check fee is credited toward the full audit.</p>
      <div class="tilt-card mt-5 overflow-x-auto" style="--card-color: var(--ac-blue);">
        <table class="w-full min-w-[40rem] text-left text-sm">
          <thead><tr class="border-b border-[var(--border)] text-xs uppercase tracking-wider text-[var(--text-muted)]"><th scope="col" class="px-5 py-3 font-semibold">Service</th><th scope="col" class="px-5 py-3 font-semibold">Best for</th><th scope="col" class="px-5 py-3 font-semibold">Price</th></tr></thead>
          <tbody>
            {options.map((o) => (
              <tr class="border-b border-[var(--border)] last:border-0">
                <th scope="row" class="px-5 py-3 font-semibold text-[var(--text)]">{o.service}</th>
                <td class="px-5 py-3 text-[var(--text-dim)]">{o.best}</td>
                <td class="whitespace-nowrap px-5 py-3 font-semibold text-[var(--text)]">
                  {o.prefix && <span class="font-normal text-[var(--text-muted)]">{o.prefix} </span>}<LocalPrice prices={o.from} />{o.to && <> to <LocalPrice prices={o.to} /></>}{o.suffix && <span class="font-normal text-[var(--text-muted)]"> {o.suffix}</span>}
                  {o.alt && <span class="block text-xs font-normal text-[var(--text-muted)]">or <LocalPrice prices={o.alt} /> a quarterly retest</span>}
                </td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    </section>

    <section class="tilt-card p-5 sm:p-6" style="--card-color: var(--ac-violet);" aria-labelledby="standards-title">
      <h2 id="standards-title" class="font-heading text-lg font-bold text-[var(--text)]">Standards and official guidance <span class="text-xs font-normal text-[var(--text-muted)]">· page reviewed 31 July 2026</span></h2>
      <ul class="mt-3 grid gap-1.5 text-sm sm:grid-cols-2" role="list">
        {standards.map(([label, href]) => <li><a href={href} target="_blank" rel="noopener noreferrer" class="text-[var(--text-dim)] underline underline-offset-4 hover:text-[var(--text)]">{label}<span class="sr-only"> (opens in a new tab)</span></a></li>)}
      </ul>
      <p class="mt-3 text-xs text-[var(--text-muted)]">See also our <a href="/website-audit/" class="underline underline-offset-4">website audit</a> and <a href="/accessibility-statement/" class="underline underline-offset-4">accessibility statement</a>.</p>
    </section>
  </ServicePage>
</ServiceLayout>
