---
import ServiceLayout from '../../layouts/ServiceLayout.astro';
import ServicePage from '../../components/service/ServicePage.astro';
import ServiceExplainer from '../../components/service/ServiceExplainer.astro';
import { services } from '../../data/services';
import { serviceSchema, faqSchema, breadcrumbSchema } from '../../utils/schema';

// Rewritten 27 Nov 2026: compact, search-literal page in the shared service layout.
const service = services.find((s) => s.slug === 'mobile-app-development')!;
const title = "Mobile App Development Company in India: iOS, Android & React Native";
const description = "Mobile app development from India: React Native cross-platform apps, native iOS and Android, progressive web apps, app UI/UX design, API integration and App Store and Play Store release.";

const serviceFaqs = [
  {
    question: 'How long does it take to build a mobile app?',
    answer: 'Timing depends on the approved features, platforms, backend, integrations, content, privacy and security work, testing, client review and store requirements. Discovery produces a milestone plan with dependencies and change control; a general page cannot promise a delivery date for an unscoped app.',
  },
  {
    question: 'Do you build for both iOS and Android?',
    answer: 'Yes. We build cross-platform mobile apps using React Native, which produces native-quality apps for both iOS and Android from a single codebase. This significantly reduces development time and cost compared to building two separate native apps. For projects requiring deep platform-specific features, we also build native iOS (Swift) or Android (Kotlin) apps.',
  },
  {
    question: 'Can you publish the app to the App Store and Play Store?',
    answer: 'Submission support can be included for Apple App Store and Google Play, covering agreed metadata, screenshots, signing and review responses. Developer accounts should normally remain client-controlled. Apple and Google make the final approval decision, so acceptance and review timing cannot be guaranteed.',
  },
  {
    question: 'Do you provide app maintenance after launch?',
    answer: 'Yes. Mobile apps require ongoing maintenance - OS updates from Apple and Google can break functionality, and user feedback often surfaces improvements. We offer structured maintenance plans covering monthly dependency updates, OS compatibility testing, bug fixes, performance monitoring, and crash reporting via tools like Sentry or Firebase Crashlytics.',
  },
  {
    question: 'Can you integrate the app with our existing website or backend?',
    answer: 'Yes. Depending on the selected architecture, the app can connect to an existing backend through REST, GraphQL or another supported interface, or include a new backend in the agreed scope. Data fields, authentication, permissions, hosting and third-party providers are reviewed before integration.',
  },
];

const breadcrumbs = [
  { name: 'Home', href: '/' },
  { name: 'Services', href: '/services/' },
  { name: service.title, href: `/services/${service.slug}/` },
];
const schemas = [
  serviceSchema(title, description, `/services/${service.slug}/`),
  faqSchema(serviceFaqs),
  breadcrumbSchema(breadcrumbs.map((b) => ({ name: b.name, url: b.href }))),
];
---
<ServiceLayout title={title} description={description} breadcrumbs={breadcrumbs} schema={schemas}>
  <ServicePage
    accentVar={service.cssVar}
    highlights={service.features.slice(0, 6)}
    eyebrow={"Mobile app development · iOS, Android, React Native"}
    heading={"Mobile App Development for iOS and Android"}
    intro={"We design and build mobile apps people enjoy using: cross-platform React Native, native iOS and Android when the device demands it, or a progressive web app when an app store is not needed. We connect the app to your website and backend and handle store release."}
    offersTitle={"What our mobile app service includes"}
    offers={[{"title": "React Native apps", "text": "One codebase for iOS and Android that looks and feels native."}, {"title": "Native iOS", "text": "Swift and SwiftUI for deep Apple features such as Apple Pay, Face ID and HealthKit."}, {"title": "Native Android", "text": "Kotlin and Jetpack Compose for NFC, Bluetooth and background services."}, {"title": "Progressive web apps", "text": "Installable, offline-capable apps with push notifications and no store friction."}, {"title": "App UI and UX design", "text": "Platform-specific design and clickable prototypes before development."}, {"title": "API and backend integration", "text": "REST or GraphQL backends, payments, maps, authentication and notifications."}, {"title": "Store submission", "text": "App Store and Play Store listings, privacy labels and release management."}, {"title": "Security", "text": "Secure storage, biometric sign-in, encryption and privacy-aware permissions."}]}
    process={[{"title": "Discovery and scope", "text": "Goals, users, MVP versus full release, stack and backend."}, {"title": "Design and prototype", "text": "User flows, wireframes and clickable screens tested before build."}, {"title": "Build in sprints", "text": "Two-week sprints with working demos, device and beta testing."}, {"title": "Release and support", "text": "Store submission, crash monitoring and a maintenance plan."}]}
    fit={["You need an app for customers, staff or field teams.", "Your website or backend should power the app too.", "You want to start with an MVP and grow it.", "You are unsure whether you need a native app or a PWA."]}
    faqTitle={"Mobile app development FAQs"}
    cta={{"title": "Have an app idea?", "text": "Share the idea or the problem. We will recommend React Native, native or a PWA and scope an MVP in writing."}}
    note={"App-store approval, review timing and third-party SDK behaviour depend on Apple, Google and provider policies and cannot be guaranteed."}
    faqs={serviceFaqs}
  >
    <ServiceExplainer
      id="app-or-web"
      color="--ac-violet"
      eyebrow="Before you build"
      title="Do you need a mobile app or a responsive web app?"
      columns={[{"title": "A mobile app makes sense when", "items": ["People use it often, such as staff, field teams or loyal customers", "It needs the camera, Bluetooth, NFC, location in the background or offline work", "Push notifications are central to the service", "Customers expect to find it in the App Store or Google Play"]}, {"title": "A responsive web app is often enough when", "items": ["People use it occasionally, or arrive from search and ads", "It mainly shows information, forms, bookings or accounts", "You want one product to update without store reviews", "Budget is better spent on one channel first"]}]}
      note="A progressive web app sits in between: installable, works offline for agreed screens, and needs no store listing."
    />
    <ServiceExplainer
      id="release"
      color="--ac-violet"
      eyebrow="Release, handover and support"
      title="What happens at release and after"
      columns={[{"title": "Release", "text": "Submission support for the App Store and Google Play: metadata, screenshots, signing and review responses. Developer accounts stay in your name, and Apple and Google make the final approval decision."}, {"title": "Handover", "text": "Source code, build and release notes, environment details and the accounts and credentials listed in the proposal, so another team could take over."}, {"title": "Support", "text": "An optional maintenance plan: dependency and OS updates, compatibility testing, bug fixes, crash reporting and performance monitoring."}]}
      numbered
    />
  </ServicePage>
</ServiceLayout>
