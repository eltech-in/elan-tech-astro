---
import ServiceLayout from '../../layouts/ServiceLayout.astro';
import ServicePage from '../../components/service/ServicePage.astro';
import { serviceSchema, faqSchema, breadcrumbSchema } from '../../utils/schema';

// One eCommerce page (owner, 27 Nov 2026): Medusa.js and Shopify lead, with WooCommerce and Zoho Commerce.
// The Shopify page now redirects here (#shopify); the Medusa.js page stays as its own deep page because it
// is the service page Search Console shows for agency and implementation-partner searches.
const title = 'eCommerce Development Company: Medusa.js & Shopify Experts';
const description =
  'eCommerce website development with Medusa.js and custom Shopify stores, plus WooCommerce and Zoho Commerce: design, payments, subscriptions, shipping, integrations and SEO-safe migration.';

const breadcrumbs = [
  { name: 'Home', href: '/' },
  { name: 'Services', href: '/services/' },
  { name: 'eCommerce Development', href: '/services/ecommerce/' },
];

const faqs = [
  {
    question: 'Should I choose Shopify, Medusa.js, WooCommerce or Zoho Commerce?',
    answer: 'Choose Shopify for a hosted platform with familiar admin and the fastest launch. Choose Medusa.js when custom commerce logic, integrations or owned code and hosting matter. Choose WooCommerce when WordPress content and hosting control are central. Choose Zoho Commerce when a hosted store should connect to Zoho business tools. We recommend after understanding what you sell and how your team works.',
  },
  {
    question: 'Do you build custom Shopify themes or customise templates?',
    answer: 'We prefer a custom, modular theme designed around your brand, catalogue and customer journey, built with Liquid sections and blocks so your team can edit content in the theme editor. When improving an existing theme is the more sensible option, we do that instead.',
  },
  {
    question: 'Do you support Shopify Plus, B2B and headless Shopify?',
    answer: 'Yes. We implement Shopify Plus storefronts, company and buyer experiences, market-specific content, checkout extensions and integrations. Shopify can also power a custom headless storefront; we recommend it only when the benefit justifies the extra engineering.',
  },
  {
    question: 'What can you build with Medusa.js?',
    answer: 'Custom storefronts, subscriptions, B2B pricing, marketplaces, payment and shipping modules, and ERP or PIM integrations. Our launched Medusa.js work includes subscription commerce with Razorpay, PhonePe and shipping modules. See our Medusa.js development page for costs, hosting and migration.',
  },
  {
    question: 'Can you migrate my store without losing SEO?',
    answer: 'Yes. We inventory valuable URLs, products, collections, content and metadata, create a redirect map, migrate structured content, preserve canonical signals and monitor Search Console after launch. Rankings cannot be guaranteed, but careful migration avoids most avoidable loss.',
  },
  {
    question: 'Do you design and develop WooCommerce stores?',
    answer: 'Yes. We design custom WooCommerce storefronts for businesses that want WordPress content management alongside ecommerce: theme design, product and checkout UX, subscriptions, Indian and international payments, shipping, performance and security.',
  },
  {
    question: 'Can eLan Technology implement and customise Zoho Commerce?',
    answer: 'Yes. We scope store setup, supported theme customisation, product and content migration, and integrations with sales, inventory and accounting tools. Availability depends on the Zoho plan, theme, region and supported APIs. Platform subscriptions, provider charges, custom-code rights, maintenance and delivery are agreed in the proposal; Zoho remains a hosted third-party platform.',
  },
  {
    question: 'Do you provide support after launch?',
    answer: 'Yes. Support can include monitoring, security updates, feature development, conversion optimisation, catalogue help, analytics and ongoing technical SEO. The right plan depends on the platform and how complex the store is.',
  },
];

const schemas = [
  serviceSchema(title, description, '/services/ecommerce/'),
  faqSchema(faqs),
  breadcrumbSchema(breadcrumbs.map(({ name, href }) => ({ name, url: href }))),
];

const shopifyServices = [
  ['Custom storefront design', 'Original mobile-first home, collection, product, cart and search journeys.'],
  ['Liquid theme development', 'Reusable sections and blocks, metafields and accessible components.'],
  ['Shopify Plus and B2B', 'Company accounts, markets, checkout extensibility and automation.'],
  ['Apps and integrations', 'Payments, shipping, ERP, CRM, subscriptions, reviews and email.'],
  ['Migration and SEO', 'Redirect maps, product data, structured data and Merchant Center.'],
  ['Speed and conversion', 'Core Web Vitals, analytics and post-launch optimisation.'],
];
const medusaServices = [
  ['Custom modules and workflows', 'Business-specific data models, events and automations.'],
  ['Subscriptions and payments', 'Razorpay, PhonePe and other gateways, recurring orders, refunds.'],
  ['B2B and marketplaces', 'Company accounts, quotes, account pricing, vendors, commissions.'],
  ['ERP, PIM and WMS', 'Inventory, product data, accounting and warehouse integrations.'],
  ['Shopify to Medusa migration', 'Products, customers, orders and URLs moved in stages.'],
  ['Hosting and support', 'Medusa Cloud or your own cloud, monitoring and releases.'],
];
const compare = [
  ['Best fit', 'Fast, dependable D2C and omnichannel launches', 'Differentiated, complex or composable commerce', 'Content-led stores on WordPress', 'Stores run alongside Zoho tools'],
  ['Operations', 'Hosted platform, familiar merchant tools', 'Custom application, owned code and hosting', 'Self-hosted WordPress with extensions', 'Hosted Zoho platform'],
  ['Customisation', 'Themes, apps, Functions, APIs, headless', 'Data models, modules, workflows, admin, APIs', 'Themes, plugins, hooks, checkout', 'Supported themes, sections and APIs'],
];
---

<ServiceLayout
  title={title}
  description={description}
  canonical="/services/ecommerce/"
  breadcrumbs={breadcrumbs}
  schema={schemas}
>
  <ServicePage
    accentVar="--ac-pink"
    eyebrow="eCommerce development · Medusa.js and Shopify"
    heading="eCommerce Website Development: Medusa.js and Shopify Experts"
    intro="We plan, design and build online stores on Medusa.js and Shopify, plus WooCommerce and Zoho Commerce, with the payments, subscriptions, shipping and business tools your team needs. You don't need to arrive with a platform in mind."
    highlights={['Custom Shopify stores and Shopify Plus', 'Medusa.js custom and owned commerce', 'WooCommerce and Zoho Commerce', 'Payments, subscriptions and shipping', 'Migration that protects your SEO', 'Launched: Rangresha and Healthy Genie']}
    primaryCta={{ label: 'Plan your store', href: '/schedule-consultation/' }}
    secondaryCta={{ label: 'View commerce work', href: '/portfolio/#ecommerce-work' }}
    offersTitle="Everything needed to launch and run your store"
    offers={[
      { title: 'Planning and platform choice', text: 'What you sell, how orders are handled and what your team needs, before recommending a platform.' },
      { title: 'Store design', text: 'An original, mobile-friendly shopping experience that fits your products and brand.' },
      { title: 'Payments and repeat orders', text: 'Payment options, refunds, subscriptions, repeat deliveries and clear customer messages.' },
      { title: 'Shipping and delivery', text: 'Shipping services, rates, service areas, tracking and your fulfilment steps.' },
      { title: 'Your business tools', text: 'Inventory, accounting, support, email marketing, analytics and the tools you already use.' },
      { title: 'Search, accessibility and speed', text: 'Fast, findable on Google, and accessible on every device and assistive tool.' },
    ]}
    processTitle="A commerce process built to reduce launch risk"
    process={[
      { title: 'Discover', text: 'Goals, catalogue, operations, integrations, migration risks and measures.' },
      { title: 'Design', text: 'Prototype the key journeys and a reusable storefront design system.' },
      { title: 'Engineer', text: 'Platform, integrations, content, analytics, SEO and accessibility.' },
      { title: 'Launch and improve', text: 'Real transactions tested, safe migration, monitoring and optimisation.' },
    ]}
    fit={['You are launching a new store or replacing one that holds you back.', 'You sell D2C, B2B, by subscription or across countries.', 'Your store must connect to inventory, accounting or shipping tools.', 'You want a partner who recommends the platform, not a fixed package.']}
    guides={[
      { label: 'Comparison', title: 'Shopify vs Medusa.js in 2026', href: '/blog/ecommerce/shopify-vs-medusa-js-2026/' },
      { label: 'Platform choice', title: 'Shopify, WooCommerce or Medusa: which platform?', href: '/blog/ecommerce/shopify-woocommerce-medusa-which-platform/' },
      { label: 'Shopify SEO', title: 'Shopify SEO checklist for Indian stores', href: '/blog/ecommerce/shopify-seo-checklist-india/' },
      { label: 'Subscriptions', title: 'Subscriptions with Medusa.js, Razorpay and PhonePe', href: '/blog/ecommerce/building-subscription-ecommerce-medusa-js-india/' },
      { label: 'AI commerce', title: 'Is your Shopify store ready for AI shopping agents?', href: '/blog/ecommerce/is-your-shopify-store-ready-for-ai-shopping-agents/' },
      { label: 'UAE', title: 'UAE ecommerce implementation checklist', href: '/blog/ecommerce/uae-ecommerce-implementation-checklist/' },
    ]}
    faqTitle="eCommerce development FAQs"
    faqs={faqs}
    cta={{ title: 'Bring us the commerce problem, not a pre-selected platform', text: 'We will help you decide whether Shopify, Medusa.js or another platform best supports your customers, team and growth plans.', label: 'Schedule a consultation' }}
  >
    <section class="grid gap-4 xl:grid-cols-2" aria-label="Our two main commerce platforms">
      <article id="shopify" class="tilt-card tilt-card--lg scroll-mt-28 p-6 sm:p-7" style="--card-color: var(--svc-shopify);" aria-labelledby="shopify-title">
        <p class="text-xs font-bold uppercase tracking-[0.16em] text-[var(--svc-shopify)]">Custom Shopify development</p>
        <h2 id="shopify-title" class="mt-2 font-heading text-2xl font-bold text-[var(--text)] sm:text-3xl">A Shopify store that feels like your brand</h2>
        <p class="mt-3 text-sm leading-relaxed text-[var(--text-dim)]">We design the store around your products and customers, then build a custom theme your team can update without a developer for every change. Best when a hosted platform covers your needs and you want a fast, dependable launch.</p>
        <ul class="mt-4 grid gap-2 sm:grid-cols-2" role="list">
          {shopifyServices.map(([t, d]) => <li class="text-sm"><strong class="block text-[var(--text)]">{t}</strong><span class="text-[var(--text-dim)]">{d}</span></li>)}
        </ul>
        <div class="mt-5 rounded-lg border border-[var(--border)] bg-[var(--bg)] p-4">
          <p class="text-[11px] font-bold uppercase tracking-[0.14em] text-[var(--svc-shopify)]">Recent Shopify launch</p>
          <p class="mt-1 text-sm text-[var(--text-dim)]"><strong class="text-[var(--text)]">Rangresha - custom storefront</strong> for a sustainable-handicrafts brand: product discovery, storytelling, mobile shopping and corporate gifting.</p>
          <a href="https://rangresha.com/" target="_blank" rel="noopener noreferrer" class="mt-2 inline-block text-sm font-semibold text-[var(--text)] underline underline-offset-4">Visit the Rangresha store ↗<span class="sr-only"> (opens in a new tab)</span></a>
        </div>
      </article>

      <article id="medusa" class="tilt-card tilt-card--lg scroll-mt-28 p-6 sm:p-7" style="--card-color: var(--svc-medusa);" aria-labelledby="medusa-title">
        <p class="text-xs font-bold uppercase tracking-[0.16em] text-[var(--svc-medusa)]">Medusa.js development</p>
        <h2 id="medusa-title" class="mt-2 font-heading text-2xl font-bold text-[var(--text)] sm:text-3xl">Custom commerce when standard stores fall short</h2>
        <p class="mt-3 text-sm leading-relaxed text-[var(--text-dim)]">Medusa.js is open-source commerce we extend for unusual products, subscriptions, special pricing and integrations. You own the code, data and hosting. Available to merchants and, white-label, to agencies abroad.</p>
        <ul class="mt-4 grid gap-2 sm:grid-cols-2" role="list">
          {medusaServices.map(([t, d]) => <li class="text-sm"><strong class="block text-[var(--text)]">{t}</strong><span class="text-[var(--text-dim)]">{d}</span></li>)}
        </ul>
        <div class="mt-5 rounded-lg border border-[var(--border)] bg-[var(--bg)] p-4">
          <p class="text-[11px] font-bold uppercase tracking-[0.14em] text-[var(--svc-medusa)]">Recent Medusa.js launch</p>
          <p class="mt-1 text-sm text-[var(--text-dim)]"><strong class="text-[var(--text)]">Healthy Genie - meal plans and subscriptions</strong> on a Medusa.js backend with a Next.js storefront.</p>
          <div class="mt-2 flex flex-wrap gap-x-4 gap-y-1">
            <a href="/services/ecommerce/medusa-js-development/" class="text-sm font-semibold text-[var(--svc-medusa)] underline underline-offset-4">Medusa.js development agency: costs, hosting, migration →</a>
            <a href="https://healthygenie.in/" target="_blank" rel="noopener noreferrer" class="text-sm font-semibold text-[var(--text)] underline underline-offset-4">Visit Healthy Genie ↗<span class="sr-only"> (opens in a new tab)</span></a>
          </div>
        </div>
      </article>
    </section>

    <section class="grid gap-4 lg:grid-cols-2" aria-label="More commerce platforms">
      <article id="woocommerce" class="tilt-card scroll-mt-28 p-6" style="--card-color: #96588a;" aria-labelledby="woo-title">
        <p class="text-xs font-bold uppercase tracking-[0.16em] text-[#96588a]">WooCommerce</p>
        <h2 id="woo-title" class="mt-2 font-heading text-xl font-bold text-[var(--text)]">Flexible stores built around WordPress content</h2>
        <p class="mt-2 text-sm leading-relaxed text-[var(--text-dim)]">Custom WooCommerce themes, product and checkout UX, subscriptions, Indian and international payments, shipping, speed and security, for businesses that want WordPress content alongside their store.</p>
        <p class="mt-3 text-sm text-[var(--text-dim)]"><strong class="text-[var(--text)]">Larisha</strong> - custom wellness store. <a href="https://larishaayurved.com/" target="_blank" rel="noopener noreferrer" class="font-semibold text-[var(--text)] underline underline-offset-4">Visit ↗<span class="sr-only"> (opens in a new tab)</span></a></p>
      </article>

      <article id="zoho-commerce" class="tilt-card scroll-mt-28 p-6" style="--card-color: var(--ac-red);" aria-labelledby="zoho-title">
        <p class="text-xs font-bold uppercase tracking-[0.16em] text-[var(--ac-red)]">Zoho Commerce implementation &amp; customisation</p>
        <h2 id="zoho-title" class="mt-2 font-heading text-xl font-bold text-[var(--text)]">A storefront connected to the business behind it</h2>
        <p class="mt-2 text-sm leading-relaxed text-[var(--text-dim)]">Store setup and catalogue structure, theme and brand styling, connections to Zoho CRM, Books and Inventory through supported integrations and APIs, then migration, order-flow testing and handover.</p>
        <p class="mt-3 text-xs leading-relaxed text-[var(--text-muted)]">Features and integrations depend on the selected Zoho plan, theme, region and APIs. Subscriptions and provider fees are separate unless expressly included; custom-code rights, migration scope and support follow the accepted proposal; neither platform choice nor implementation guarantees legal compliance. References: <a href="https://www.zoho.com/commerce/help/storefront/" target="_blank" rel="noopener noreferrer" class="underline underline-offset-2">Zoho storefront customisation</a> · <a href="https://www.zoho.com/commerce/api/introduction.html" target="_blank" rel="noopener noreferrer" class="underline underline-offset-2">Zoho Commerce APIs</a>. Zoho trademarks belong to their respective owner; no partner or certification status is implied.</p>
      </article>
    </section>

    <section aria-labelledby="compare-title">
      <h2 id="compare-title" class="font-heading text-2xl font-bold text-[var(--text)] sm:text-3xl">Compare the platforms</h2>
      <div class="tilt-card mt-5 overflow-x-auto" style="--card-color: var(--ac-pink);">
        <table class="w-full min-w-[44rem] text-left text-sm">
          <thead><tr class="border-b border-[var(--border)] text-xs uppercase tracking-wider text-[var(--text-muted)]"><th scope="col" class="px-4 py-3 font-semibold">Decision</th><th scope="col" class="px-4 py-3 font-semibold">Shopify</th><th scope="col" class="px-4 py-3 font-semibold">Medusa.js</th><th scope="col" class="px-4 py-3 font-semibold">WooCommerce</th><th scope="col" class="px-4 py-3 font-semibold">Zoho Commerce</th></tr></thead>
          <tbody>
            {compare.map((row) => (
              <tr class="border-b border-[var(--border)] last:border-0"><th scope="row" class="px-4 py-3 font-semibold text-[var(--text)]">{row[0]}</th>{row.slice(1).map((c) => <td class="px-4 py-3 text-[var(--text-dim)]">{c}</td>)}</tr>
            ))}
          </tbody>
        </table>
      </div>
      <p class="mt-3 text-sm text-[var(--text-muted)]">We also work with Magento / Adobe Commerce, BigCommerce, Wix, OpenCart, PrestaShop, Squarespace and custom headless builds. <a href="/schedule-consultation/" class="font-semibold text-[var(--text)] underline underline-offset-4">Discuss your platform →</a></p>
    </section>
  </ServicePage>
</ServiceLayout>
