---
import ServiceLayout from '../../layouts/ServiceLayout.astro';
import { serviceSchema, faqSchema, breadcrumbSchema } from '../../utils/schema';

const title = 'eCommerce Website Development Company';
const description =
  'Custom ecommerce design and development for ambitious brands. eLan Technology builds Shopify, WooCommerce, Medusa.js, headless, and custom commerce solutions with payments, subscriptions, shipping, and integrations.';

const breadcrumbs = [
  { name: 'Home', href: '/' },
  { name: 'Services', href: '/services/' },
  { name: 'eCommerce Development', href: '/services/ecommerce/' },
];

const faqs = [
  {
    question: 'Should I choose Shopify, WooCommerce, or Medusa.js?',
    answer:
      'Choose Shopify when you want a dependable hosted platform, a familiar admin experience, and a faster route to market. Choose WooCommerce when WordPress content flexibility, open hosting, and extension control are central to the business. Choose Medusa.js when you need custom commerce logic, complete code ownership, specialised subscriptions, complex B2B workflows, marketplaces, or deep operational integrations. We run a platform-fit workshop before recommending an approach.',
  },
  {
    question: 'Can eLan Technology create a completely custom Shopify design?',
    answer:
      'Yes. We design the customer experience around your brand and catalogue, then build a modular Shopify theme using Liquid, sections, blocks, CSS, and JavaScript. The result is editable by your team without looking like an off-the-shelf template.',
  },
  {
    question: 'Do you design and develop WooCommerce stores?',
    answer:
      'Yes. We design custom WooCommerce storefronts for businesses that want flexible WordPress content management alongside ecommerce. Our work can include original theme design, product and checkout UX, subscriptions, Indian and international payments, shipping integrations, performance optimisation, security, and migration from another platform.',
  },
  {
    question: 'What can you customise in Medusa.js?',
    answer:
      'Medusa.js lets us extend data models, workflows, APIs, admin tools, payments, fulfilment, pricing, promotions, subscriptions, and integrations. Our Puritas implementation includes a custom storefront, subscription commerce, Razorpay and PhonePe modules, and purpose-built shipping workflows.',
  },
  {
    question: 'Do you handle migration and ecommerce SEO?',
    answer:
      'Yes. We plan product, collection, customer, order, content, and URL migration; preserve valuable URLs with permanent redirects; implement canonical tags and structured data; and validate analytics, merchant feeds, checkout, and indexing after launch.',
  },
  {
    question: 'Do you provide support after launch?',
    answer:
      'Yes. Support can include monitoring, security updates, feature development, conversion optimisation, catalogue assistance, analytics, and ongoing technical SEO. The right plan depends on the platform and operational complexity.',
  },
];

const schemas = [
  serviceSchema(title, description, '/services/ecommerce/'),
  faqSchema(faqs),
  breadcrumbSchema(breadcrumbs.map(({ name, href }) => ({ name, url: href }))),
];

const capabilities = [
  {
    title: 'Planning and platform choice',
    text: 'We understand what you sell, how orders are handled, and what your team needs before recommending a platform or project plan.',
  },
  {
    title: 'Store design',
    text: 'We create an original, mobile-friendly shopping experience that suits your products and feels consistent with your brand.',
  },
  {
    title: 'Payments and repeat orders',
    text: 'We set up suitable payment options, refunds, subscriptions, repeat deliveries, and clear customer communication.',
  },
  {
    title: 'Shipping and delivery',
    text: 'We connect shipping services, delivery rates, service areas, order tracking, and the steps your team follows to fulfil an order.',
  },
  {
    title: 'Your business tools',
    text: 'We connect the store to inventory, accounting, customer support, email marketing, analytics, and other tools you already use.',
  },
  {
    title: 'Search, accessibility, and speed',
    text: 'We make the store quick to use, easier to find on Google, and accessible to customers using different devices and assistive tools.',
  },
];

const commerceGoals = [
  ['Launch a new store', 'Plan, design, build, and launch'],
  ['Improve an existing store', 'Make shopping simpler and faster'],
  ['Move to a better platform', 'Migrate products, customers, and SEO'],
  ['Build something custom', 'Support unusual products or workflows'],
];

const commercePlatforms = [
  { name: 'Shopify', fit: 'A dependable hosted store that is easy for your team to manage', cssVar: '--ac-emerald', href: '/services/ecommerce/shopify-development/' },
  { name: 'WooCommerce', fit: 'A flexible online store built around WordPress content', cssVar: '--ac-violet', href: '/portfolio/case-study/larisha/' },
  { name: 'Medusa.js', fit: 'A custom store when standard platforms cannot support the way you sell', cssVar: '--ac-cyan', href: '/services/ecommerce/medusa-js-development/' },
  { name: 'Magento / Adobe Commerce', fit: 'Large catalogues, multiple stores, and established retail operations', cssVar: '--ac-red', href: '/schedule-consultation/' },
  { name: 'BigCommerce', fit: 'Hosted commerce with strong catalogue and business selling features', cssVar: '--ac-blue', href: '/schedule-consultation/' },
  { name: 'Wix eCommerce', fit: 'A straightforward store for smaller catalogues and service businesses', cssVar: '--ac-pink', href: '/schedule-consultation/' },
  { name: 'OpenCart', fit: 'An open-source store with control over hosting and extensions', cssVar: '--ac-amber', href: '/schedule-consultation/' },
  { name: 'PrestaShop', fit: 'Flexible open-source commerce for growing product catalogues', cssVar: '--ac-indigo', href: '/schedule-consultation/' },
  { name: 'Squarespace Commerce', fit: 'A design-led store for focused catalogues and creative brands', cssVar: '--ac-teal', href: '/schedule-consultation/' },
  { name: 'Custom / Headless', fit: 'A tailored storefront connected to the systems you already use', cssVar: '--ac-cyan', href: '/schedule-consultation/' },
];
---

<ServiceLayout
  title="eCommerce Development | Shopify, WooCommerce & Medusa.js"
  description={description}
  canonical="/services/ecommerce/"
  ogImage="/images/ecommerce-og-2026.png"
  breadcrumbs={breadcrumbs}
  schema={schemas}
>
  <section class="relative mb-14 overflow-hidden rounded-3xl border border-[var(--border)] bg-[var(--bg-card)] p-8 md:p-12">
    <div class="absolute -right-20 -top-20 h-72 w-72 rounded-full bg-amber-500/10 blur-3xl" aria-hidden="true"></div>
    <div class="service-hero-grid relative">
      <div>
        <p class="mb-3 text-sm font-semibold uppercase tracking-[0.18em] text-amber-500">Online store design and development</p>
        <h1 class="font-heading text-4xl font-bold leading-tight text-[var(--text)] md:text-5xl lg:text-6xl">
          Online stores made for your business
        </h1>
        <p class="mt-6 max-w-3xl text-lg leading-relaxed text-[var(--text-dim)]">
          We help you choose the right platform, create a store that feels like your brand, and set up the payments, shipping, repeat orders, and everyday tools your team needs.
        </p>
        <div class="mt-8 flex flex-wrap gap-3">
          <a href="/schedule-consultation/" class="rounded-full bg-amber-500 px-6 py-3 text-sm font-bold text-slate-950 transition hover:brightness-110">
            Plan Your eCommerce Build
          </a>
          <a href="/portfolio/" class="rounded-full border border-[var(--border)] px-6 py-3 text-sm font-semibold text-[var(--text)] transition hover:border-amber-500">
            View Commerce Work
          </a>
        </div>
      </div>

      <aside class="service-hero-aside" aria-label="eCommerce platforms and business models">
        <div class="flex items-center justify-between gap-4">
          <div>
            <p class="text-[10px] font-bold uppercase tracking-[0.2em] text-amber-500">Start with the goal</p>
            <h2 class="mt-1 font-heading text-xl font-bold text-[var(--text)]">What do you want to achieve?</h2>
          </div>
        </div>
        <div class="mt-5 grid gap-2 sm:grid-cols-2">
          {commerceGoals.map(([name, fit], index) => (
            <div class="rounded-xl border border-[var(--border)] bg-[var(--bg-card)] p-3">
              <span class="mb-2 block text-[10px] font-bold text-amber-500">0{index + 1}</span>
              <strong class="block text-sm text-[var(--text)]">{name}</strong>
              <span class="mt-1 block text-xs leading-snug text-[var(--text-muted)]">{fit}</span>
            </div>
          ))}
        </div>
      </aside>
    </div>

    <div class="relative mt-7 grid gap-3 border-t border-[var(--border)] pt-5 sm:grid-cols-3">
        <a href="/portfolio/case-study/rangresha/" class="rounded-2xl border border-[var(--border)] bg-[var(--bg)] p-4 transition hover:border-amber-500">
          <span class="text-xs font-semibold uppercase tracking-wider text-amber-500">Recent Shopify launch</span>
          <strong class="mt-1 block text-[var(--text)]">Rangresha - custom storefront</strong>
        </a>
        <a href="/portfolio/case-study/puritas/" class="rounded-2xl border border-[var(--border)] bg-[var(--bg)] p-4 transition hover:border-emerald-400">
          <span class="text-xs font-semibold uppercase tracking-wider text-emerald-400">Recent Medusa.js launch</span>
          <strong class="mt-1 block text-[var(--text)]">Puritas - subscriptions, payments, shipping</strong>
        </a>
        <a href="/portfolio/case-study/larisha/" class="rounded-2xl border border-[var(--border)] bg-[var(--bg)] p-4 transition hover:border-violet-400">
          <span class="text-xs font-semibold uppercase tracking-wider text-violet-400">WooCommerce experience</span>
          <strong class="mt-1 block text-[var(--text)]">Larisha - custom wellness store</strong>
        </a>
    </div>
  </section>

  <section class="mb-16" aria-labelledby="commerce-platforms">
    <div class="mb-8 max-w-3xl">
      <p class="text-sm font-semibold uppercase tracking-wider text-[var(--accent)]">Platforms we work with</p>
      <h2 id="commerce-platforms" class="mt-2 font-heading text-3xl font-bold text-[var(--text)]">One clear way to compare your options</h2>
      <p class="mt-3 text-[var(--text-dim)]">You do not need to arrive with a platform in mind. Tell us what you sell, how your team works, and where the current problems are. We will help narrow the choices.</p>
    </div>
    <div class="grid gap-4 sm:grid-cols-2 lg:grid-cols-3 xl:grid-cols-5">
      {commercePlatforms.map((platform) => (
        <a
          href={platform.href}
          class="group flex min-h-44 flex-col rounded-2xl border border-[var(--border)] bg-[var(--bg-card)] p-5 transition hover:-translate-y-1"
          style={`--platform-color: var(${platform.cssVar});`}
        >
          <span class="block h-1.5 w-10 rounded-full bg-[var(--platform-color)]" aria-hidden="true"></span>
          <h3 class="mt-5 font-heading text-lg font-bold text-[var(--text)]">{platform.name}</h3>
          <p class="mt-2 flex-1 text-sm leading-relaxed text-[var(--text-muted)]">{platform.fit}</p>
          <span class="mt-4 text-xs font-bold text-[var(--platform-color)]">Discuss this option →</span>
        </a>
      ))}
    </div>
  </section>

  <section class="mb-16">
    <div class="mb-8 max-w-3xl">
      <p class="text-sm font-semibold uppercase tracking-wider text-[var(--accent)]">What we can help with</p>
      <h2 class="mt-2 font-heading text-3xl font-bold text-[var(--text)]">Everything needed to launch and run your store</h2>
    </div>
    <div class="grid gap-5 md:grid-cols-2 xl:grid-cols-3">
      {capabilities.map((item) => (
        <article class="rounded-2xl border border-[var(--border)] bg-[var(--bg-card)] p-6">
          <h3 class="font-heading text-lg font-bold text-[var(--text)]">{item.title}</h3>
          <p class="mt-3 text-sm leading-relaxed text-[var(--text-dim)]">{item.text}</p>
        </article>
      ))}
    </div>
  </section>

  <section class="mb-16 rounded-3xl border border-[var(--border)] bg-[var(--bg-card)] p-7 md:p-10">
    <h2 class="font-heading text-3xl font-bold text-[var(--text)]">Compare the core commerce approaches</h2>
    <div class="mt-7 overflow-x-auto">
      <table class="w-full min-w-[860px] text-left text-sm">
        <thead>
          <tr class="border-b border-[var(--border)] text-[var(--text)]">
            <th class="p-4">Decision</th>
            <th class="p-4">Shopify</th>
            <th class="p-4">WooCommerce</th>
            <th class="p-4">Medusa.js</th>
          </tr>
        </thead>
        <tbody class="text-[var(--text-dim)]">
          <tr class="border-b border-[var(--border)]"><th class="p-4 font-semibold text-[var(--text)]">Best fit</th><td class="p-4">Fast, dependable D2C and omnichannel launches</td><td class="p-4">Content-led stores and WordPress-centred businesses</td><td class="p-4">Differentiated, complex, or composable commerce</td></tr>
          <tr class="border-b border-[var(--border)]"><th class="p-4 font-semibold text-[var(--text)]">Operations</th><td class="p-4">Hosted platform with familiar merchant tools</td><td class="p-4">Self-hosted WordPress with configurable extensions</td><td class="p-4">Custom application with owned infrastructure and code</td></tr>
          <tr class="border-b border-[var(--border)]"><th class="p-4 font-semibold text-[var(--text)]">Customisation</th><td class="p-4">Themes, apps, Functions, APIs, and custom storefronts</td><td class="p-4">Themes, plugins, hooks, checkout, content, and APIs</td><td class="p-4">Data models, modules, workflows, APIs, admin, and storefront</td></tr>
          <tr><th class="p-4 font-semibold text-[var(--text)]">Typical reason to choose</th><td class="p-4">Lower operational overhead and shorter launch path</td><td class="p-4">Strong content-commerce flexibility and platform control</td><td class="p-4">Business logic that must not be forced into platform constraints</td></tr>
        </tbody>
      </table>
    </div>
  </section>

  <section class="mb-16">
    <h2 class="font-heading text-3xl font-bold text-[var(--text)]">A commerce process built to reduce launch risk</h2>
    <div class="mt-8 grid gap-5 md:grid-cols-2 xl:grid-cols-4">
      {[
        ['01', 'Discover', 'Map commercial goals, catalogue, operations, integrations, migration risks, and success measures.'],
        ['02', 'Design', 'Prototype the critical journeys and create a reusable storefront design system.'],
        ['03', 'Engineer', 'Build the platform, integrations, content model, analytics, SEO, and accessibility foundations.'],
        ['04', 'Launch & improve', 'Test real transactions, migrate safely, monitor production, and optimise from evidence.'],
      ].map(([number, heading, text]) => (
        <article class="rounded-2xl border border-[var(--border)] bg-[var(--bg-card)] p-6">
          <span class="font-heading text-2xl font-bold text-amber-500">{number}</span>
          <h3 class="mt-4 font-heading text-lg font-bold text-[var(--text)]">{heading}</h3>
          <p class="mt-2 text-sm leading-relaxed text-[var(--text-dim)]">{text}</p>
        </article>
      ))}
    </div>
  </section>

  <section class="mb-16">
    <div class="mb-7 flex flex-col gap-3 md:flex-row md:items-end md:justify-between">
      <div>
        <p class="text-sm font-semibold uppercase tracking-wider text-[var(--accent)]">Commerce knowledge</p>
        <h2 class="mt-2 font-heading text-3xl font-bold text-[var(--text)]">Guides for better platform decisions</h2>
      </div>
      <a href="/blog/category/ecommerce/" class="text-sm font-semibold text-[var(--accent)] hover:underline">Browse ecommerce articles →</a>
    </div>
    <div class="grid gap-4 md:grid-cols-2">
      <a href="/blog/ecommerce/shopify-vs-medusa-js-2026/" class="rounded-2xl border border-[var(--border)] bg-[var(--bg-card)] p-6 transition hover:border-[var(--accent)]">
        <span class="text-xs font-semibold uppercase text-[var(--accent)]">Platform guide</span>
        <strong class="mt-2 block text-lg text-[var(--text)]">Shopify vs Medusa.js in 2026</strong>
      </a>
      <a href="/blog/ecommerce/building-subscription-ecommerce-medusa-js-india/" class="rounded-2xl border border-[var(--border)] bg-[var(--bg-card)] p-6 transition hover:border-[var(--accent)]">
        <span class="text-xs font-semibold uppercase text-[var(--accent)]">Engineering guide</span>
        <strong class="mt-2 block text-lg text-[var(--text)]">Subscriptions, Razorpay, PhonePe, and shipping with Medusa.js</strong>
      </a>
    </div>
  </section>

  <section class="mb-16">
    <h2 class="font-heading text-3xl font-bold text-[var(--text)]">Frequently asked questions</h2>
    <div class="mt-7 divide-y divide-[var(--border)] overflow-hidden rounded-2xl border border-[var(--border)]">
      {faqs.map((faq) => (
        <details class="bg-[var(--bg-card)] p-6">
          <summary class="cursor-pointer font-semibold text-[var(--text)]">{faq.question}</summary>
          <p class="mt-3 max-w-4xl text-sm leading-relaxed text-[var(--text-dim)]">{faq.answer}</p>
        </details>
      ))}
    </div>
  </section>

  <section class="rounded-3xl bg-gradient-to-br from-amber-500 to-orange-600 p-8 text-slate-950 md:p-12">
    <p class="text-sm font-bold uppercase tracking-wider">Start with the right questions</p>
    <h2 class="mt-2 max-w-3xl font-heading text-3xl font-bold md:text-4xl">Bring us the commerce problem - not a pre-selected platform.</h2>
    <p class="mt-4 max-w-2xl leading-relaxed text-slate-900">We will help you decide whether Shopify, Medusa.js, or another architecture best supports your customers, team, and growth plans.</p>
    <a href="/schedule-consultation/" class="mt-7 inline-flex rounded-full bg-slate-950 px-6 py-3 text-sm font-bold text-white">Schedule a consultation</a>
  </section>
</ServiceLayout>
