---
import ServiceLayout from '../../layouts/ServiceLayout.astro';
import ServicePage from '../../components/service/ServicePage.astro';
import { services } from '../../data/services';
import { serviceSchema, faqSchema, breadcrumbSchema } from '../../utils/schema';

// Rewritten 27 Nov 2026: compact, search-literal page in the shared service layout.
const service = services.find((s) => s.slug === 'maintenance-security')!;
const title = "Website Maintenance & Security Services: Monthly Care Plans";
const description = "Website maintenance and security from India: monthly care plans with backups, updates, malware scanning and removal, uptime monitoring, SSL, speed optimisation and security hardening.";

const serviceFaqs = [
  {
    question: 'What does a monthly maintenance plan include?',
    answer: 'Coverage depends on the selected plan and the accepted condition of the website. The proposal identifies backup frequency and location, monitoring, update process, included content time, reporting, support hours, response targets, exclusions and any third-party charges. A plan name alone does not create 24/7 coverage.',
  },
  {
    question: 'How quickly do you respond to security incidents?',
    answer: 'Response targets, coverage hours and escalation contacts depend on the accepted maintenance plan and start after a valid alert reaches the agreed channel. Automated containment is not assumed for every hosting environment. Incident investigation, recovery, evidence and reporting are limited by available access, logs, backups and third-party cooperation.',
  },
  {
    question: 'Do you offer one-time security audits?',
    answer: 'Yes. Our one-time website security audit covers: vulnerability scanning across all files and directories, plugin and theme security review, user account and permissions audit, server configuration review, SSL and HTTPS implementation check, Content Security Policy analysis, review of admin access controls and 2FA status, database security review, and a prioritised written report with remediation recommendations. Ideal for businesses that have never had a professional security review or that have recently experienced issues.',
  },
  {
    question: 'Can you take over maintenance of a website not built by you?',
    answer: 'Yes - this is one of our most common engagements. We begin with an onboarding audit: a thorough review of the codebase, hosting environment, plugin/theme versions, backup status, security posture, and performance. We then produce a condition report and remediation plan. Once any critical issues are resolved, we onboard the site to our maintenance platform for ongoing support. We charge a one-time onboarding fee for sites not built by us.',
  },
  {
    question: 'What security measures do you implement?',
    answer: 'Our security hardening covers: SSL/TLS installation and renewal, HTTP Strict Transport Security (HSTS), Content Security Policy (CSP) headers, X-Frame-Options, X-Content-Type-Options, Referrer-Policy, forced strong passwords and two-factor authentication for admin accounts, malware scanning and removal, firewall rules at server and application level, login attempt limiting and IP blocking, database prefix randomisation, file permission hardening, and weekly vulnerability scans via dedicated security tools.',
  },
];

const breadcrumbs = [
  { name: 'Home', href: '/' },
  { name: 'Services', href: '/services/' },
  { name: service.title, href: `/services/${service.slug}/` },
];
const schemas = [
  serviceSchema(title, description, `/services/${service.slug}/`),
  faqSchema(serviceFaqs),
  breadcrumbSchema(breadcrumbs.map((b) => ({ name: b.name, url: b.href }))),
];
const plans = [
  { name: 'Basic', price: '₹3,999/mo', features: ['Daily automated backups', 'Weekly malware scans', 'Monthly core and plugin updates', 'Uptime monitoring', 'SSL management', '1 hr content updates a month', 'Monthly report', 'Email support (48h response)'] },
  { name: 'Standard', price: '₹7,999/mo', features: ['Everything in Basic', 'Real-time malware monitoring', 'Weekly core and plugin updates', 'Staging environment testing', 'Security hardening audit', '3 hrs content updates a month', 'Quarterly performance optimisation', 'Priority support (8h response)', 'Emergency support (business hours)'] },
  { name: 'Premium', price: '₹14,999/mo', features: ['Everything in Standard', 'Advanced security firewall', 'Daily core and plugin updates', 'Core Web Vitals monitoring', 'CDN management', '6 hrs content and dev updates a month', 'Monthly strategy call', '24/7 emergency support (4h response)', 'Annual security penetration test'] },
];
---
<ServiceLayout title={title} description={description} breadcrumbs={breadcrumbs} schema={schemas}>
  <ServicePage
    accentVar={service.cssVar}
    highlights={service.features.slice(0, 6)}
    eyebrow={"Website maintenance and security"}
    heading={"Website Maintenance and Security Without the Worry"}
    intro={"We keep your website updated, backed up, monitored and secure, and fix it fast if something goes wrong. Updates are tested before they go live, and every month you get a plain-English report."}
    offersTitle={"What our maintenance service includes"}
    offers={[{"title": "Monthly care plans", "text": "Core, plugin and theme updates tested on staging, plus content updates."}, {"title": "Daily backups", "text": "Automated off-site backups of files and databases, with restore checks."}, {"title": "Security hardening", "text": "Security headers, 2FA for admins, login throttling and admin restrictions."}, {"title": "Malware removal", "text": "Infections cleaned, backdoors removed and blacklist reviews requested."}, {"title": "Uptime monitoring", "text": "Round-the-clock checks with alerts and root-cause reports."}, {"title": "SSL and HTTPS", "text": "Certificates, HTTPS enforcement, HSTS and mixed-content checks."}, {"title": "Speed optimisation", "text": "PageSpeed audits, image compression, caching and Core Web Vitals."}, {"title": "Security audits", "text": "Vulnerability scans, file integrity, permissions and OWASP Top 10 review."}]}
    process={[{"title": "Audit", "text": "Security, performance, versions, backups and server reviewed."}, {"title": "Onboard and harden", "text": "Critical issues fixed; monitoring and backups set up."}, {"title": "Maintain", "text": "Tested monthly updates, scans and backup checks."}, {"title": "Report and review", "text": "Monthly reports and quarterly scope reviews."}]}
    fit={["Nobody on your team owns website updates.", "Your site was hacked, slow or went down recently.", "We did not build your site, but you need it looked after.", "You want predictable monthly costs for website care."]}
    faqTitle={"Website maintenance FAQs"}
    cta={{"title": "Keep your website safe and up to date", "text": "Start with a short audit of your current site. We will recommend a plan and fix anything critical first."}}
    note={"No website or monitoring service can promise absolute security or uninterrupted availability. Response times and included work apply as recorded in the accepted plan."}
    faqs={serviceFaqs}
  >
    <section aria-labelledby="plans-title">
      <h2 id="plans-title" class="font-heading text-2xl font-bold text-[var(--text)] sm:text-3xl">Monthly maintenance plans</h2>
      <ul class="mt-5 grid gap-4 md:grid-cols-3" role="list">
        {plans.map((plan, i) => (
          <li class="tilt-card tilt-card--lg p-5 sm:p-6" style={`--card-color: var(${['--ac-teal', '--ac-indigo', '--ac-amber'][i]});`}>
            <h3 class="font-heading text-lg font-bold text-[var(--text)]">{plan.name}{i === 1 && <span class="ml-2 rounded-md bg-[var(--card-color)]/15 px-2 py-0.5 text-xs font-semibold" style="color: var(--card-color);">Most chosen</span>}</h3>
            <p class="mt-1 font-heading text-2xl font-bold text-[var(--text)]">{plan.price}</p>
            <ul class="mt-3 space-y-1.5 text-sm text-[var(--text-dim)]" role="list">{plan.features.map((f) => <li>✓ {f}</li>)}</ul>
          </li>
        ))}
      </ul>
    </section>
  </ServicePage>
</ServiceLayout>
