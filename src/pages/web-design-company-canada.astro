---
import InternationalLayout from '../layouts/InternationalLayout.astro';
import InternationalMarketFocus from '../components/international/InternationalMarketFocus.astro';
import InternationalDeliveryPlan from '../components/international/InternationalDeliveryPlan.astro';
import InternationalProjectProof from '../components/international/InternationalProjectProof.astro';
import InternationalAgencyPartner from '../components/international/InternationalAgencyPartner.astro';
import InternationalFAQ from '../components/international/InternationalFAQ.astro';
import InternationalContact from '../components/international/InternationalContact.astro';
import { getCountryBySlug } from '../data/countries';

const country = getCountryBySlug('canada')!;
---

<InternationalLayout country={country}
  title="WCAG Audits, Reporting & Remediation for Canadian Organisations | eLan Technology"
  description="WCAG audits with clear reporting, code-level remediation and retesting for Canadian organisations, plus the website work behind them, delivered remotely from India."
  heading="WCAG audits, reporting and remediation for Canadian organisations"
  introduction="Find out where your website falls short of WCAG, get a report your team and procurement can use, then have the barriers fixed in the code and retested. Applicable Canadian requirements, such as AODA or the Accessible Canada Act, are confirmed for your organisation first."
  primaryAction={{ href: '/services/ada-compliant-web-design/#options-title', label: 'See audit and remediation prices' }}>
  <Fragment slot="market-introduction">
    <InternationalMarketFocus market="canada" />
    <InternationalProjectProof country={country} />
  </Fragment>
  <InternationalDeliveryPlan market="canada" />
  <InternationalAgencyPartner market="canada" />
  <section class="px-4 pb-14 sm:px-6 lg:px-8" aria-labelledby="canada-audit-guide">
    <div class="mx-auto max-w-6xl rounded-xl border border-[var(--border)] bg-[var(--bg-card)] p-6 sm:p-8">
      <p class="text-xs font-bold uppercase tracking-widest text-[var(--accent)]">A practical buyer’s guide</p>
      <h2 id="canada-audit-guide" class="mt-3 font-heading text-2xl font-bold sm:text-3xl">What should your accessibility audit actually deliver?</h2>
      <p class="mt-4 max-w-3xl leading-7 text-[var(--text-dim)]">Compare scope, manual testing, reproducible findings and retesting terms, not just scanner scores. Our Canada guide separates the technical evaluation target from jurisdiction-specific legal requirements.</p>
      <a href="/blog/accessibility/website-accessibility-audit-deliverables-canada/" class="mt-5 inline-flex min-h-11 items-center font-semibold text-[var(--accent)]">Read the audit-deliverables checklist →</a>
    </div>
  </section>
  <InternationalFAQ country={country} />
  <InternationalContact country={country} />
</InternationalLayout>
