    </div>
  </dialog>

  <script>
    const dialog = document.querySelector('[data-qr-dialog]');
    const openButtons = document.querySelectorAll('[data-qr-open]');
    const closeButton = document.querySelector('[data-qr-close]');
    const shareButton = document.querySelector('[data-share-card]');
    const shareStatus = document.querySelector('[data-share-status]');
    const shareLive = document.querySelector('[data-share-live]');
    if (dialog instanceof HTMLDialogElement) {
      openButtons.forEach((openButton) => {
        if (openButton instanceof HTMLButtonElement) openButton.addEventListener('click', () => dialog.showModal());
      });
      closeButton?.addEventListener('click', () => dialog.close());
      dialog.addEventListener('click', (event) => {
        if (event.target === dialog) dialog.close();
      });
    }
    if (shareButton instanceof HTMLButtonElement) {
      shareButton.addEventListener('click', async () => {
        const shareData = {
          title: 'Nishant Barde | Digital Growth Consultant',
          text: 'Connect with Nishant Barde at eLan Technology.',
          url: window.location.href,
        };
        try {
          if (navigator.share) {
            await navigator.share(shareData);
          } else {
            await navigator.clipboard.writeText(shareData.url);
            if (shareStatus) shareStatus.textContent = 'Profile link copied';
            if (shareLive) shareLive.textContent = 'Profile link copied to clipboard.';
          }
        } catch (error) {
          if (error instanceof DOMException && error.name === 'AbortError') return;
          if (shareStatus) shareStatus.textContent = 'Copy the address from your browser';
          if (shareLive) shareLive.textContent = 'Sharing is unavailable. Copy the address from your browser.';
        }
      });
    }
  </script>
