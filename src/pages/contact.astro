---
import BaseLayout from "../layouts/BaseLayout.astro";
import { breadcrumbSchema, localBusinessSchema } from "../utils/schema";
import ContactForm from "../islands/ContactForm";
import { COMPANY } from "../data/company";

const schema = [
  breadcrumbSchema([
    { name: "Home", url: "/" },
    { name: "Contact", url: "/contact/" },
  ]),
  localBusinessSchema("Nagpur"),
];

// Compact contact page (owner, 27 Nov 2026): same layout as /get-quote/, one list of contact routes.
const icon = (d: string) => `<svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">${d}</svg>`;
const routes = [
  { label: 'WhatsApp', tag: 'Fastest', value: '+91 87888 34630', note: 'Monitored during business hours', href: 'https://wa.me/918788834630', external: true, color: '#22c55e', svg: icon('<path d="M21 11.5a8.38 8.38 0 01-.9 3.8 8.5 8.5 0 01-7.6 4.7 8.38 8.38 0 01-3.8-.9L3 21l1.9-5.7a8.38 8.38 0 01-.9-3.8 8.5 8.5 0 014.7-7.6 8.38 8.38 0 013.8-.9h.5a8.48 8.48 0 018 8v.5z"/>') },
  { label: 'Phone', tag: '', value: '+91 98222 31642', note: 'Office hours below', href: 'tel:+919822231642', external: false, color: 'var(--ac-amber)', svg: icon('<path d="M22 16.92v3a2 2 0 01-2.18 2 19.79 19.79 0 01-8.63-3.07 19.5 19.5 0 01-6-6 19.79 19.79 0 01-3.07-8.67A2 2 0 014.11 2h3a2 2 0 012 1.72 12.84 12.84 0 00.7 2.81 2 2 0 01-.45 2.11L8.09 9.91a16 16 0 006 6l1.27-1.27a2 2 0 012.11-.45 12.84 12.84 0 002.81.7A2 2 0 0122 16.92z"/>') },
  { label: 'Email', tag: '', value: 'info@elan-tech.net', note: 'Normally within one business day', href: 'mailto:info@elan-tech.net', external: false, color: 'var(--ac-indigo)', svg: icon('<path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"/><polyline points="22,6 12,13 2,6"/>') },
  { label: 'Schedule a call', tag: '', value: '30-minute discovery call', note: 'Pick a time that suits you', href: '/schedule-consultation/', external: false, color: 'var(--ac-pink)', svg: icon('<rect x="3" y="4" width="18" height="18" rx="2" ry="2"/><line x1="16" y1="2" x2="16" y2="6"/><line x1="8" y1="2" x2="8" y2="6"/><line x1="3" y1="10" x2="21" y2="10"/>') },
];
---

<BaseLayout
  title="Contact Web Design Company in Nagpur | WhatsApp · Call · Email | eLan Technology"
  description="Reach eLan Technology in Nagpur. Call +91 98222 31642, WhatsApp +91 87888 34630, visit our Gayatri Nagar office, or send a private website enquiry."
  ogImage="/images/og/contact.png"
  schema={schema}
>
  <section class="relative bg-gradient-to-br from-[var(--bg)] to-[var(--bg-card)] py-12 md:py-16" aria-labelledby="contact-heading">
    <div class="contact-grid mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
      <div class="area-intro">
        <p class="text-xs font-bold uppercase tracking-[0.18em] text-[var(--accent)]">Get in Touch</p>
        <h1 id="contact-heading" class="mt-3 font-heading text-4xl font-bold leading-tight text-[var(--text)] sm:text-5xl">Let's Start a Conversation</h1>
        <p class="mt-4 text-lg leading-relaxed text-[var(--text-dim)]">Have a project in mind or a question about our services? Choose whichever route suits you. Website enquiries are normally reviewed within one business day.</p>
      </div>

      <div class="area-info">
        <h2 class="sr-only">Contact Form and Details</h2>
        <ul class="grid gap-3 sm:grid-cols-2" role="list">
          {routes.map((r) => (
            <li>
              <a href={r.href} target={r.external ? '_blank' : undefined} rel={r.external ? 'noopener noreferrer' : undefined} class="tilt-card flex h-full items-start gap-3 p-4" style={`--card-color: ${r.color};`}>
                <span class="tilt-card__icon" set:html={r.svg} />
                <span class="min-w-0">
                  <span class="block text-sm font-semibold text-[var(--text)]">{r.label}{r.tag && <span class="ml-1 text-xs font-normal text-[var(--text-muted)]">({r.tag})</span>}</span>
                  <span class="block break-words text-sm font-medium" style={`color: ${r.color};`}>{r.value}</span>
                  <span class="block text-xs text-[var(--text-muted)]">{r.note}{r.external && <span class="sr-only"> (opens in a new tab)</span>}</span>
                </span>
              </a>
            </li>
          ))}
        </ul>

        <div class="mt-3 grid gap-3 text-sm sm:grid-cols-2">
          <div class="tilt-card p-4" style="--card-color: var(--ac-cyan);">
            <p class="font-semibold text-[var(--text)]">Office</p>
            <address class="mt-1 not-italic leading-relaxed text-[var(--text-dim)]">
              Basement Floor, PTG IT Park<br />
              Plot No. 21, IT Park Rd<br />
              Gayatri Nagar, Nagpur - 440022
            </address>
            <a href="https://share.google/PklD3tFGBBqsPHjli" target="_blank" rel="noopener noreferrer" class="mt-1 inline-block font-semibold text-[var(--accent)] underline underline-offset-2">View on Google Maps<span class="sr-only"> (opens in a new tab)</span></a>
          </div>
          <div class="tilt-card p-4" style="--card-color: var(--ac-violet);">
            <p class="font-semibold text-[var(--text)]">Business Hours</p>
            <p class="mt-1 text-[var(--text-dim)]">{COMPANY.hours.weekdayLabel}</p>
            <p class="text-[var(--text-dim)]">{COMPANY.hours.saturdayLabel}</p>
            <p class="mt-0.5 text-xs text-[var(--text-muted)]">{COMPANY.hours.sundayLabel}. Holiday hours may vary.</p>
          </div>
        </div>

        <!-- Google Maps is click-to-load so no request is made before the visitor chooses it. -->
        <div id="contact-map" class="tilt-card mt-3" style="--card-color: var(--ac-cyan);">
          <div class="flex flex-col gap-3 p-4 sm:flex-row sm:items-center sm:justify-between">
            <p class="text-xs leading-relaxed text-[var(--text-dim)]"><strong class="text-[var(--text)]">Office map.</strong> Disabled by default: loading it sends your IP address and browser information to Google under Google's privacy terms.</p>
            <button id="load-contact-map" type="button" class="min-h-10 shrink-0 rounded-lg border border-[var(--border)] bg-[var(--bg)] px-4 py-2 text-sm font-semibold text-[var(--text)] transition hover:border-[var(--accent)] focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-[var(--accent)]">Load Google Map</button>
          </div>
        </div>
      </div>

      <div class="area-form tilt-card tilt-card--lg p-5 shadow-sm sm:p-8" style="--card-color: var(--ac-indigo);">
        <span aria-hidden="true" class="pointer-events-none absolute right-5 top-3 select-none font-heading text-[5rem] font-black leading-none opacity-[0.07]" style="color: var(--ac-indigo);">✉</span>
        <p class="relative text-xs font-bold uppercase tracking-[0.18em]" style="color: var(--ac-indigo);">Message Us</p>
        <h2 class="relative mb-6 mt-1 font-heading text-2xl font-bold text-[var(--text)]">Send Us a Message</h2>
        <ContactForm client:load />
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .contact-grid { display: grid; gap: 2rem; grid-template-areas: "intro" "form" "info"; }
  .area-intro { grid-area: intro; } .area-form { grid-area: form; } .area-info { grid-area: info; }
  @media (min-width: 1024px) {
    .contact-grid { grid-template-columns: 0.95fr 1.05fr; grid-template-rows: auto 1fr; column-gap: 2.5rem; row-gap: 2rem; grid-template-areas: "intro form" "info form"; align-items: start; }
    .area-form { position: sticky; top: 7rem; }
  }
</style>

<script is:inline>
  (function () {
    var button = document.getElementById('load-contact-map');
    var container = document.getElementById('contact-map');
    if (!button || !container) return;

    button.addEventListener('click', function () {
      var iframe = document.createElement('iframe');
      iframe.title = 'eLan Technology office location on Google Maps - PTG IT Park, Gayatri Nagar, Nagpur';
      iframe.src = 'https://www.google.com/maps/embed?pb=!1m18!1m12!1m3!1d3721.8085545685517!2d79.047923!3d21.1201974!2m3!1f0!2f0!3f0!3m2!1i1024!1i768!4f13.1!3m3!1m2!1s0x3bd4c0631dd904b9%3A0x53f590ec4fbc7077!2seLan%20Technology!5e0!3m2!1sen!2sin!4v1778759240433!5m2!1sen!2sin';
      iframe.width = '100%';
      iframe.height = '280';
      iframe.style.border = '0';
      iframe.style.display = 'block';
      iframe.loading = 'lazy';
      iframe.referrerPolicy = 'no-referrer-when-downgrade';
      iframe.allowFullscreen = true;
      container.replaceChildren(iframe);
    }, { once: true });
  })();
</script>
