---
import BaseLayout from "../layouts/BaseLayout.astro";
import { breadcrumbSchema, localBusinessSchema } from "../utils/schema";
import ContactForm from "../islands/ContactForm";

const schema = [
  breadcrumbSchema([
    { name: "Home", url: "/" },
    { name: "Contact", url: "/contact/" },
  ]),
  localBusinessSchema("Nagpur"),
];
---

<BaseLayout
  title="Contact Web Design Company in Nagpur | WhatsApp · Call · Email | eLan Technology"
  description="Reach eLan Technology in Nagpur. Call +91 98222 31642, WhatsApp +91 87888 34630, visit our Gayatri Nagar office, or send a private website enquiry."
  ogImage="/images/og/contact.png"
  schema={schema}
>
  <!-- Hero -->
  <section class="relative overflow-hidden bg-[var(--bg)] py-20 sm:py-28">
    <div class="pointer-events-none absolute inset-0 opacity-[0.04] dark:opacity-[0.06]" aria-hidden="true"
      style="background-image: radial-gradient(var(--text) 1px, transparent 1px); background-size: 28px 28px;"></div>
    <div class="pointer-events-none absolute -top-40 left-1/2 -translate-x-1/2 h-96 w-[40rem] rounded-full opacity-[0.12]"
      aria-hidden="true"
      style="background: radial-gradient(ellipse at center, var(--accent), transparent 70%); filter: blur(60px);"></div>
    <div class="relative mx-auto max-w-5xl px-4 sm:px-6 lg:px-8 text-center">
      <p class="text-sm font-semibold uppercase tracking-widest text-[var(--accent)] mb-4">Get in Touch</p>
      <h1 class="font-heading text-4xl sm:text-5xl font-bold text-[var(--text)] leading-tight">
        Let's Start a Conversation
      </h1>
      <p class="mt-6 max-w-2xl mx-auto text-lg text-[var(--text-dim)] leading-relaxed">
        Whether you have a project in mind or a question about our services, choose the contact method that suits you. Website enquiries are normally reviewed within one business day.
      </p>
    </div>
  </section>

  <!-- Contact bento grid -->
  <section class="py-16 md:py-20 border-t border-[var(--border)]" aria-labelledby="contact-heading">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
      <h2 id="contact-heading" class="sr-only">Contact Form and Details</h2>
      <div class="grid grid-cols-1 lg:grid-cols-6 gap-6">

        <!-- Contact form (4 cols) -->
        <div class="lg:col-span-4 relative overflow-hidden rounded-2xl border border-[var(--border)] p-8 md:p-10"
          style="background: linear-gradient(135deg, color-mix(in srgb, var(--ac-indigo) 8%, var(--bg-card)) 0%, var(--bg-card) 60%);">
          <span aria-hidden="true" class="pointer-events-none absolute -right-10 -bottom-10 h-48 w-48 rotate-[-20deg] opacity-[0.05]"
            style="background: var(--ac-indigo);"></span>
          <span aria-hidden="true" class="pointer-events-none absolute top-3 right-5 font-heading font-black leading-none select-none text-[5rem] opacity-[0.06]"
            style="color: var(--ac-indigo);">✉</span>
          <div class="relative mb-6">
            <p class="text-xs font-bold uppercase tracking-widest mb-2" style="color: var(--ac-indigo);">Message Us</p>
            <h2 class="font-heading text-2xl font-bold text-[var(--text)]">Send Us a Message</h2>
          </div>
          <div class="relative">
            <ContactForm client:visible />
          </div>
        </div>

        <!-- Contact details (2 cols) -->
        <div class="lg:col-span-2 flex flex-col gap-4">

          <!-- WhatsApp -->
          <a href="https://wa.me/918788834630" target="_blank" rel="noopener noreferrer"
            class="relative overflow-hidden flex items-start gap-4 rounded-2xl border border-[var(--border)] p-5 transition-all duration-200 hover:-translate-y-0.5 hover:shadow-lg group"
            style="background: linear-gradient(135deg, color-mix(in srgb, #22c55e 10%, var(--bg-card)) 0%, var(--bg-card) 65%);">
            <span aria-hidden="true" class="pointer-events-none absolute -right-4 -bottom-4 h-20 w-20 rotate-[-20deg] opacity-[0.08]"
              style="background: #22c55e;"></span>
            <div class="w-10 h-10 rounded-xl flex items-center justify-center flex-shrink-0 relative"
              style="background: color-mix(in srgb, #22c55e 16%, transparent);" aria-hidden="true">
              <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="#22c55e" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <path d="M21 11.5a8.38 8.38 0 01-.9 3.8 8.5 8.5 0 01-7.6 4.7 8.38 8.38 0 01-3.8-.9L3 21l1.9-5.7a8.38 8.38 0 01-.9-3.8 8.5 8.5 0 014.7-7.6 8.38 8.38 0 013.8-.9h.5a8.48 8.48 0 018 8v.5z"/>
              </svg>
            </div>
            <div class="relative">
              <p class="font-semibold text-[var(--text)] text-sm mb-0.5">WhatsApp <span class="text-xs font-normal text-[var(--text-muted)]">(Fastest)</span></p>
              <p class="font-medium text-sm" style="color: #22c55e;">+91 87888 34630</p>
              <p class="text-xs text-[var(--text-muted)] mt-0.5">Monitored during business hours</p>
            </div>
          </a>

          <!-- Email -->
          <a href="mailto:info@elan-tech.net"
            class="relative overflow-hidden flex items-start gap-4 rounded-2xl border border-[var(--border)] p-5 transition-all duration-200 hover:-translate-y-0.5 hover:shadow-lg group"
            style="background: linear-gradient(135deg, color-mix(in srgb, var(--ac-indigo) 10%, var(--bg-card)) 0%, var(--bg-card) 65%);">
            <span aria-hidden="true" class="pointer-events-none absolute -right-4 -bottom-4 h-20 w-20 rotate-[-20deg] opacity-[0.07]"
              style="background: var(--ac-indigo);"></span>
            <div class="w-10 h-10 rounded-xl flex items-center justify-center flex-shrink-0 relative"
              style="background: color-mix(in srgb, var(--ac-indigo) 16%, transparent); color: var(--ac-indigo);" aria-hidden="true">
              <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"/>
                <polyline points="22,6 12,13 2,6"/>
              </svg>
            </div>
            <div class="relative">
              <p class="font-semibold text-[var(--text)] text-sm mb-0.5">Email</p>
              <p class="font-medium text-sm" style="color: var(--ac-indigo);">info@elan-tech.net</p>
              <p class="text-xs text-[var(--text-muted)] mt-0.5">Normally within one business day</p>
            </div>
          </a>

          <!-- Phone -->
          <a href="tel:+919822231642"
            class="relative overflow-hidden flex items-start gap-4 rounded-2xl border border-[var(--border)] p-5 transition-all duration-200 hover:-translate-y-0.5 hover:shadow-lg group"
            style="background: linear-gradient(135deg, color-mix(in srgb, var(--ac-amber) 10%, var(--bg-card)) 0%, var(--bg-card) 65%);">
            <span aria-hidden="true" class="pointer-events-none absolute -right-4 -bottom-4 h-20 w-20 rotate-[-20deg] opacity-[0.07]"
              style="background: var(--ac-amber);"></span>
            <div class="w-10 h-10 rounded-xl flex items-center justify-center flex-shrink-0 relative"
              style="background: color-mix(in srgb, var(--ac-amber) 16%, transparent); color: var(--ac-amber);" aria-hidden="true">
              <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <path d="M22 16.92v3a2 2 0 01-2.18 2 19.79 19.79 0 01-8.63-3.07 19.5 19.5 0 01-6-6 19.79 19.79 0 01-3.07-8.67A2 2 0 014.11 2h3a2 2 0 012 1.72 12.84 12.84 0 00.7 2.81 2 2 0 01-.45 2.11L8.09 9.91a16 16 0 006 6l1.27-1.27a2 2 0 012.11-.45 12.84 12.84 0 002.81.7A2 2 0 0122 16.92z"/>
              </svg>
            </div>
            <div class="relative">
              <p class="font-semibold text-[var(--text)] text-sm mb-0.5">Phone</p>
              <p class="font-medium text-sm" style="color: var(--ac-amber);">+91 98222 31642</p>
              <p class="text-xs text-[var(--text-muted)] mt-0.5">10:00 AM – 7:00 PM IST</p>
            </div>
          </a>

          <!-- Address -->
          <a href="https://share.google/PklD3tFGBBqsPHjli" target="_blank" rel="noopener noreferrer"
            class="relative overflow-hidden flex items-start gap-4 rounded-2xl border border-[var(--border)] p-5 transition-all duration-200 hover:-translate-y-0.5 hover:shadow-lg group"
            style="background: linear-gradient(135deg, color-mix(in srgb, var(--ac-cyan) 10%, var(--bg-card)) 0%, var(--bg-card) 65%);">
            <span aria-hidden="true" class="pointer-events-none absolute -right-4 -bottom-4 h-20 w-20 rotate-[-20deg] opacity-[0.07]"
              style="background: var(--ac-cyan);"></span>
            <div class="w-10 h-10 rounded-xl flex items-center justify-center flex-shrink-0 relative"
              style="background: color-mix(in srgb, var(--ac-cyan) 16%, transparent); color: var(--ac-cyan);" aria-hidden="true">
              <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0118 0z"/>
                <circle cx="12" cy="10" r="3"/>
              </svg>
            </div>
            <div class="relative">
              <p class="font-semibold text-[var(--text)] text-sm mb-0.5">Office Address</p>
              <address class="not-italic text-xs text-[var(--text-dim)] leading-relaxed">
                Basement Floor, PTG IT Park<br />
                Plot No. 21, IT Park Rd<br />
                Gayatri Nagar, Nagpur - 440022
              </address>
              <p class="text-xs mt-1" style="color: var(--ac-cyan);">View on Google Maps →</p>
            </div>
          </a>

          <!-- Google Maps is click-to-load so no request is made before the visitor chooses it. -->
          <div id="contact-map" class="relative min-h-[280px] overflow-hidden rounded-2xl border border-[var(--border)] bg-[var(--bg-card)]">
            <div class="flex min-h-[280px] flex-col items-center justify-center p-6 text-center"
              style="background: radial-gradient(circle at 50% 10%, color-mix(in srgb, var(--ac-cyan) 16%, transparent), transparent 58%);">
              <div class="mb-4 flex h-12 w-12 items-center justify-center rounded-2xl"
                style="background: color-mix(in srgb, var(--ac-cyan) 16%, transparent); color: var(--ac-cyan);" aria-hidden="true">
                <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                  <path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0118 0z"/><circle cx="12" cy="10" r="3"/>
                </svg>
              </div>
              <p class="font-heading text-lg font-bold text-[var(--text)]">Office map</p>
              <p class="mt-2 max-w-xs text-xs leading-relaxed text-[var(--text-dim)]">
                The Google map is disabled by default. Loading it sends your IP address and browser information to Google under Google's privacy terms.
              </p>
              <button id="load-contact-map" type="button"
                class="mt-5 min-h-11 rounded-xl bg-[var(--accent)] px-5 py-2.5 text-sm font-bold text-[var(--bg)] transition hover:opacity-90 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-[var(--accent)]">
                Load Google Map
              </button>
              <a href="https://share.google/PklD3tFGBBqsPHjli" target="_blank" rel="noopener noreferrer"
                class="mt-3 text-xs font-semibold text-[var(--accent)] underline underline-offset-2">Open address in a new tab instead</a>
            </div>
          </div>

          <!-- Business hours -->
          <div class="relative overflow-hidden flex items-start gap-4 rounded-2xl border border-[var(--border)] p-5"
            style="background: linear-gradient(135deg, color-mix(in srgb, var(--ac-violet) 10%, var(--bg-card)) 0%, var(--bg-card) 65%);">
            <span aria-hidden="true" class="pointer-events-none absolute -right-4 -bottom-4 h-20 w-20 rotate-[-20deg] opacity-[0.07]"
              style="background: var(--ac-violet);"></span>
            <div class="w-10 h-10 rounded-xl flex items-center justify-center flex-shrink-0 relative"
              style="background: color-mix(in srgb, var(--ac-violet) 16%, transparent); color: var(--ac-violet);" aria-hidden="true">
              <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <circle cx="12" cy="12" r="10"/>
                <polyline points="12 6 12 12 16 14"/>
              </svg>
            </div>
            <div class="relative">
              <p class="font-semibold text-[var(--text)] text-sm mb-0.5">Business Hours</p>
              <p class="text-xs text-[var(--text-dim)]">Monday – Saturday</p>
              <p class="text-sm font-semibold text-[var(--text)]">10:00 AM – 7:00 PM IST</p>
              <p class="text-xs text-[var(--text-muted)] mt-0.5">Closed Sundays & public holidays</p>
            </div>
          </div>

        </div>
      </div>
    </div>
  </section>

  <!-- Other ways to reach us -->
  <section class="py-16 md:py-20 bg-[var(--bg-card)] border-t border-[var(--border)]" aria-labelledby="other-contact-heading">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
      <div class="text-center mb-10">
        <p class="text-xs font-bold uppercase tracking-widest text-[var(--accent)] mb-3">Quick Connect</p>
        <h2 id="other-contact-heading" class="font-heading text-2xl sm:text-3xl font-bold text-[var(--text)]">
          Other Ways to Reach Us
        </h2>
      </div>
      <ul class="grid grid-cols-1 sm:grid-cols-3 gap-6" role="list">
        <!-- WhatsApp -->
        <li>
          <a href="https://wa.me/+918788834630" target="_blank" rel="noopener noreferrer"
            class="relative overflow-hidden flex flex-col items-center text-center rounded-2xl border border-[var(--border)] p-8 transition-all duration-200 hover:-translate-y-1 hover:shadow-lg h-full"
            style="background: linear-gradient(135deg, color-mix(in srgb, #22c55e 10%, var(--bg)) 0%, var(--bg) 65%);">
            <span aria-hidden="true" class="pointer-events-none absolute -left-6 -bottom-6 h-28 w-28 rotate-[-20deg] opacity-[0.07]"
              style="background: #22c55e;"></span>
            <div class="w-14 h-14 rounded-2xl flex items-center justify-center mb-5 relative"
              style="background: color-mix(in srgb, #22c55e 16%, transparent);" aria-hidden="true">
              <svg xmlns="http://www.w3.org/2000/svg" width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="#22c55e" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <path d="M21 11.5a8.38 8.38 0 01-.9 3.8 8.5 8.5 0 01-7.6 4.7 8.38 8.38 0 01-3.8-.9L3 21l1.9-5.7a8.38 8.38 0 01-.9-3.8 8.5 8.5 0 014.7-7.6 8.38 8.38 0 013.8-.9h.5a8.48 8.48 0 018 8v.5z"/>
              </svg>
            </div>
            <h3 class="relative font-heading font-bold text-lg text-[var(--text)] mb-2">WhatsApp</h3>
            <p class="relative text-sm text-[var(--text-dim)] mb-3">Monitored during business hours</p>
            <span class="relative text-sm font-semibold" style="color: #22c55e;">Message Now →</span>
          </a>
        </li>

        <!-- Email -->
        <li>
          <a href="mailto:info@elan-tech.net"
            class="relative overflow-hidden flex flex-col items-center text-center rounded-2xl border border-[var(--border)] p-8 transition-all duration-200 hover:-translate-y-1 hover:shadow-lg h-full"
            style="background: linear-gradient(135deg, color-mix(in srgb, var(--ac-indigo) 10%, var(--bg)) 0%, var(--bg) 65%);">
            <span aria-hidden="true" class="pointer-events-none absolute -left-6 -bottom-6 h-28 w-28 rotate-[-20deg] opacity-[0.07]"
              style="background: var(--ac-indigo);"></span>
            <div class="w-14 h-14 rounded-2xl flex items-center justify-center mb-5 relative"
              style="background: color-mix(in srgb, var(--ac-indigo) 16%, transparent); color: var(--ac-indigo);" aria-hidden="true">
              <svg xmlns="http://www.w3.org/2000/svg" width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"/>
                <polyline points="22,6 12,13 2,6"/>
              </svg>
            </div>
            <h3 class="relative font-heading font-bold text-lg text-[var(--text)] mb-2">Email</h3>
            <p class="relative text-sm text-[var(--text-dim)] mb-3">info@elan-tech.net · normally within one business day</p>
            <span class="relative text-sm font-semibold" style="color: var(--ac-indigo);">Send Email →</span>
          </a>
        </li>

        <!-- Schedule a Call -->
        <li>
          <a href="/schedule-consultation/"
            class="relative overflow-hidden flex flex-col items-center text-center rounded-2xl border border-[var(--border)] p-8 transition-all duration-200 hover:-translate-y-1 hover:shadow-lg h-full"
            style="background: linear-gradient(135deg, color-mix(in srgb, var(--ac-amber) 10%, var(--bg)) 0%, var(--bg) 65%);">
            <span aria-hidden="true" class="pointer-events-none absolute -left-6 -bottom-6 h-28 w-28 rotate-[-20deg] opacity-[0.07]"
              style="background: var(--ac-amber);"></span>
            <div class="w-14 h-14 rounded-2xl flex items-center justify-center mb-5 relative"
              style="background: color-mix(in srgb, var(--ac-amber) 16%, transparent); color: var(--ac-amber);" aria-hidden="true">
              <svg xmlns="http://www.w3.org/2000/svg" width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <rect x="3" y="4" width="18" height="18" rx="2" ry="2"/>
                <line x1="16" y1="2" x2="16" y2="6"/>
                <line x1="8" y1="2" x2="8" y2="6"/>
                <line x1="3" y1="10" x2="21" y2="10"/>
              </svg>
            </div>
            <h3 class="relative font-heading font-bold text-lg text-[var(--text)] mb-2">Schedule a Call</h3>
            <p class="relative text-sm text-[var(--text-dim)] mb-3">Book a free 30-minute discovery call</p>
            <span class="relative text-sm font-semibold" style="color: var(--ac-amber);">Book a Call →</span>
          </a>
        </li>
      </ul>
    </div>
  </section>
</BaseLayout>

<script is:inline>
  (function () {
    var button = document.getElementById('load-contact-map');
    var container = document.getElementById('contact-map');
    if (!button || !container) return;

    button.addEventListener('click', function () {
      var iframe = document.createElement('iframe');
      iframe.title = 'eLan Technology office location on Google Maps - PTG IT Park, Gayatri Nagar, Nagpur';
      iframe.src = 'https://www.google.com/maps/embed?pb=!1m18!1m12!1m3!1d3721.8085545685517!2d79.047923!3d21.1201974!2m3!1f0!2f0!3f0!3m2!1i1024!1i768!4f13.1!3m3!1m2!1s0x3bd4c0631dd904b9%3A0x53f590ec4fbc7077!2seLan%20Technology!5e0!3m2!1sen!2sin!4v1778759240433!5m2!1sen!2sin';
      iframe.width = '100%';
      iframe.height = '280';
      iframe.style.border = '0';
      iframe.style.display = 'block';
      iframe.loading = 'lazy';
      iframe.referrerPolicy = 'no-referrer-when-downgrade';
      iframe.allowFullscreen = true;
      container.replaceChildren(iframe);
    }, { once: true });
  })();
</script>
