---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';
import { breadcrumbSchema } from '../../utils/schema';
import { Image } from 'astro:assets';
import { isPublishedPost } from '../../utils/blog';
import BlogPrivacyNotice from '../../components/BlogPrivacyNotice.astro';
import BlogCard from '../../components/blog/BlogCard.astro';
import BlogFilter from '../../components/blog/BlogFilter.astro';
import BlogSidebar from '../../components/blog/BlogSidebar.astro';
import { blogCategoryColor, blogCategoryLabel } from '../../data/blogCategories';

const allPosts = await getCollection('blog');
const posts = allPosts
  .filter((p) => isPublishedPost(p.data))
  .sort((a, b) => new Date(b.data.publishDate).getTime() - new Date(a.data.publishDate).getTime());

const schema = breadcrumbSchema([
  { name: 'Home', url: '/' },
  { name: 'Blog', url: '/blog/' },
]);

// Blog index (owner, 27 Nov 2026): featured article in the hero, sticky filter, card grid with a
// right sidebar. The first ten cards show; the rest open with "Show all".
const categories = [...new Set(posts.map((p) => p.data.category))];
const counts = Object.fromEntries(categories.map((c) => [c, posts.filter((p) => p.data.category === c).length]));
const [featured, ...rest] = posts;
const FIRST = 10;
const firstPosts = rest.slice(0, FIRST);
const morePosts = rest.slice(FIRST);
const featuredHref = featured ? `/blog/${featured.data.category}/${featured.id}/` : '';
---

<BaseLayout
  ogImage="/images/og/blog.png"
  title="Web Design & Digital Marketing Blog - eLan Technology"
  description="Insights, guides and tips on web design, SEO, accessibility, eCommerce, and digital marketing from the eLan Technology team."
  canonical="/blog/"
  schema={schema}
>
  <section class="bg-gradient-to-br from-[var(--bg)] to-[var(--bg-card)] py-10 md:py-14">
    <div class="mx-auto grid max-w-7xl gap-8 px-4 sm:px-6 lg:grid-cols-[0.85fr_1.15fr] lg:items-center lg:px-8">
      <div>
        <p class="text-xs font-bold uppercase tracking-[0.18em] text-[var(--accent)]">Our Blog</p>
        <h1 class="mt-3 font-heading text-4xl font-bold leading-tight tracking-tight text-[var(--text)] md:text-5xl">Insights on Web Design, SEO &amp; Accessibility</h1>
        <p class="mt-4 max-w-xl text-lg text-[var(--text-dim)]">Practical guides from the eLan Technology team, written to support better-informed website and digital decisions.</p>
        <dl class="mt-6 flex flex-wrap gap-x-8 gap-y-3">
          <div><dt class="text-xs uppercase tracking-wider text-[var(--text-muted)]">Articles</dt><dd class="font-heading text-2xl font-bold text-[var(--text)]">{posts.length}</dd></div>
          <div><dt class="text-xs uppercase tracking-wider text-[var(--text-muted)]">Topics</dt><dd class="font-heading text-2xl font-bold text-[var(--text)]">{categories.length}</dd></div>
          <div><dt class="text-xs uppercase tracking-wider text-[var(--text-muted)]">Newsletter</dt><dd class="font-heading text-2xl font-bold text-[var(--text)]">None</dd></div>
        </dl>
      </div>

      {featured && (
        <article class="tilt-card tilt-card--lg tilt-card--hover group grid overflow-hidden sm:grid-cols-[1.05fr_1fr]" style={`--card-color: ${blogCategoryColor(featured.data.category)};`} aria-labelledby="featured-title">
          {featured.data.featuredImage?.src && (
            <a href={featuredHref} aria-hidden="true" tabindex="-1" class="block aspect-video overflow-hidden sm:aspect-auto">
              <Image
                src={featured.data.featuredImage.src}
                alt={featured.data.featuredImage.alt}
                widths={[480, 720, 960]}
                sizes="(max-width: 639px) 100vw, 30vw"
                format="avif"
                loading="eager"
                decoding="async"
                class="h-full w-full object-cover transition-transform duration-700 group-hover:scale-105"
              />
            </a>
          )}
          <div class="flex flex-col justify-center p-6">
            <p class="text-[11px] font-bold uppercase tracking-[0.16em]" style="color: var(--card-color);">Latest · {blogCategoryLabel(featured.data.category)}</p>
            <h2 id="featured-title" class="mt-2 font-heading text-xl font-bold leading-snug text-[var(--text)] sm:text-2xl">
              <a href={featuredHref} class="transition-colors hover:text-[var(--card-color)]">{featured.data.title}</a>
            </h2>
            <p class="mt-3 text-sm leading-relaxed text-[var(--text-dim)]">{featured.data.description}</p>
            <p class="mt-4 text-xs text-[var(--text-muted)]"><time datetime={new Date(featured.data.publishDate).toISOString()}>{new Date(featured.data.publishDate).toLocaleDateString('en-IN', { year: 'numeric', month: 'long', day: 'numeric' })}</time> · {featured.data.readTime} min read</p>
            <a href={featuredHref} aria-label={`Read article: ${featured.data.title}`} class="mt-5 inline-flex min-h-10 items-center self-start rounded-lg bg-[var(--accent)] px-4 py-2 text-sm font-semibold text-white transition hover:brightness-110">Read Article →</a>
          </div>
        </article>
      )}
    </div>
  </section>

  <BlogFilter categories={categories} counts={counts} total={posts.length} />

  <section class="mx-auto max-w-7xl px-4 py-10 sm:px-6 lg:px-8" aria-labelledby="posts-heading">
    <div class="grid items-start gap-10 lg:grid-cols-[1fr_300px]">
      <div>
        <h2 id="posts-heading" class="font-heading text-xl font-bold text-[var(--text)]">All Posts</h2>
        {posts.length === 0 ? (
          <p class="py-16 text-center text-lg text-[var(--text-dim)]">No posts published yet. Check back soon!</p>
        ) : (
          <>
            <ul class="mt-5 grid gap-5 sm:grid-cols-2" role="list">
              {firstPosts.map((post) => <li><BlogCard post={post} /></li>)}
            </ul>
            {morePosts.length > 0 && (
              <details class="more-posts mt-5">
                <summary class="inline-flex min-h-11 cursor-pointer list-none items-center gap-2 rounded-lg border border-[var(--border)] bg-[var(--bg-card)] px-5 py-2.5 text-sm font-semibold text-[var(--text)] transition hover:border-[var(--accent)]">
                  <span class="when-closed">Show {morePosts.length} more articles</span><span class="when-open">Show fewer articles</span>
                  <svg class="chev" xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polyline points="6 9 12 15 18 9"/></svg>
                </summary>
                <ul class="mt-5 grid gap-5 sm:grid-cols-2" role="list">
                  {morePosts.map((post) => <li><BlogCard post={post} /></li>)}
                </ul>
              </details>
            )}
          </>
        )}
      </div>
      <BlogSidebar posts={posts} categories={categories} counts={counts} />
    </div>
  </section>

  <BlogPrivacyNotice context="index" />
</BaseLayout>

<style>
  .more-posts summary::-webkit-details-marker { display: none; }
  .more-posts .when-open { display: none; }
  .more-posts[open] .when-open { display: inline; }
  .more-posts[open] .when-closed { display: none; }
  .chev { transition: transform .2s; }
  .more-posts[open] .chev { transform: rotate(180deg); }
</style>
