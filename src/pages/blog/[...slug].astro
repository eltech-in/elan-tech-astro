---
import { getCollection, render } from 'astro:content';
import BlogLayout from '../../layouts/BlogLayout.astro';
import { articleSchema, breadcrumbSchema, speakableSchema, howToSchema, faqSchema } from '../../utils/schema';
import { isPublishedPost } from '../../utils/blog';

export async function getStaticPaths() {
  const posts = await getCollection('blog');
  return posts
    .filter((p) => isPublishedPost(p.data))
    .map((post) => ({
      // URL pattern: /blog/<category>/<slug>
      params: { slug: `${post.data.category}/${post.id}` },
      props: { post },
    }));
}

const { post } = Astro.props;
const { Content } = await render(post);

const toISO = (d: unknown) => (d instanceof Date ? d.toISOString() : String(d));
const publishDateStr = toISO(post.data.publishDate);
const updatedDateStr = post.data.updatedDate ? toISO(post.data.updatedDate) : publishDateStr;

const postUrl = `/blog/${post.data.category}/${post.id}/`;

const breadcrumbs = [
  { name: 'Home', url: '/' },
  { name: 'Blog', url: '/blog/' },
  {
    name: post.data.category === 'accessibility' ? 'Accessibility' : post.data.category,
    url: `/blog/category/${post.data.category}/`,
  },
  { name: post.data.title, url: postUrl },
];

const schemas = [
  articleSchema({
    title: post.data.title,
    description: post.data.description,
    url: postUrl,
    datePublished: publishDateStr,
    dateModified: updatedDateStr,
    authorName: post.data.author ?? 'eLan Technology Team',
    imageUrl: post.data.featuredImage?.src,
  }),
  breadcrumbSchema(breadcrumbs),
  // AEO: H1, lede, summary box, and structured-answer blocks are speakable.
  speakableSchema(postUrl, ['h1', '.lede', '[data-speakable]', '.tldr']),
  // AEO: emit HowTo only when the post is a procedural guide.
  ...(post.data.howTo
    ? [
        howToSchema({
          name: post.data.howTo.name,
          description: post.data.howTo.description,
          url: postUrl,
          totalTime: post.data.howTo.totalTime,
          steps: post.data.howTo.steps,
        }),
      ]
    : []),
  // AEO: emit FAQPage when the post declares an faq block.
  ...(post.data.faq && post.data.faq.length > 0 ? [faqSchema(post.data.faq)] : []),
];
---

<BlogLayout
  title={post.data.seo?.metaTitle ?? post.data.title}
  description={post.data.seo?.metaDescription ?? post.data.description}
  canonical={postUrl}
  publishDate={publishDateStr}
  author={post.data.author}
  readTime={`${post.data.readTime} min read`}
  coverImage={post.data.featuredImage?.src}
  coverAlt={post.data.featuredImage?.alt}
  category={post.data.category}
  tags={post.data.tags}
  schema={schemas}
>
  <Content />
</BlogLayout>
