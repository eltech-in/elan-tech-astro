---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';
import { breadcrumbSchema } from '../../../utils/schema';
import { isPublishedPost } from '../../../utils/blog';
import BlogPrivacyNotice from '../../../components/BlogPrivacyNotice.astro';
import BlogCard from '../../../components/blog/BlogCard.astro';
import BlogFilter from '../../../components/blog/BlogFilter.astro';
import BlogSidebar from '../../../components/blog/BlogSidebar.astro';
import { blogCategoryColor } from '../../../data/blogCategories';

export async function getStaticPaths() {
  const allPosts = await getCollection('blog');
  const published = allPosts.filter((p) => isPublishedPost(p.data));
  const categories = [...new Set(published.map((p) => p.data.category))];
  return categories.map((category) => ({ params: { category } }));
}

const { category } = Astro.params;

const allPosts = await getCollection('blog');
const posts = allPosts
  .filter((p) => isPublishedPost(p.data) && p.data.category === category)
  .sort((a, b) => new Date(b.data.publishDate).getTime() - new Date(a.data.publishDate).getTime());

const allPublished = allPosts.filter((p) => isPublishedPost(p.data));
const categories = [...new Set(allPublished.map((p) => p.data.category))];

const categoryLabels: Record<string, string> = {
  'web-design': 'Web Design',
  'seo': 'SEO',
  'ecommerce': 'eCommerce',
  'digital-marketing': 'Digital Marketing',
  'nagpur-business': 'Nagpur Business',
  'accessibility': 'Accessibility',
  'technology-trends': 'Technology',
  'company-news': 'Company News',
};

const categoryLabel = categoryLabels[category] ?? category;
const isAccessibility = category === 'accessibility';
// Thin archives duplicate their article cards without adding enough independent
// search value. Keep them useful to visitors while withholding them from the
// index until the category contains at least three published articles.
const noindexCategory = posts.length < 3;

// SEO descriptions: each category page needs real prose above the post grid
// or Google treats it as thin content and skips indexing.
const categoryHeadings: Record<string, { h1: string; intro: string }> = {
  'web-design': {
    h1: 'Web Design Resources - Design That Converts',
    intro:
      "Guides on building websites that look great and actually convert visitors into customers. Topics include WordPress vs custom development, mobile-first design principles, UX best practices for Indian businesses, conversion rate optimisation, colour theory and branding, and real-world case studies from the eLan Technology portfolio. Practical design advice for business owners and marketing managers.",
  },
  'seo': {
    h1: 'SEO Guides for Small & Mid-Size Businesses',
    intro:
      "Search engine optimisation guidance for businesses across India and international markets. Topics include keyword research, local SEO for Nagpur and other Indian cities, technical audits, Google Business Profile improvements and measurement for competitive searches. Rankings depend on relevance, authority, demand, competitors and search-engine changes and cannot be guaranteed.",
  },
  'technology-trends': {
    h1: 'Web Technology Trends - What Matters for Your Business',
    intro:
      "Cutting through the hype to explain which web technology trends actually matter for business owners in 2026 and beyond. Covering AI in web development, Core Web Vitals and page speed, modern frameworks like Astro and Next.js, progressive web apps, and what the latest Google updates mean for your website's visibility. Written for business owners, not just developers.",
  },
  'nagpur-business': {
    h1: 'Nagpur Business Blog - Web Design & Digital Growth',
    intro:
      "Practical guides and insights for Nagpur businesses looking to grow online. Covering web design costs in Nagpur, why local businesses need professional websites, the best web design companies in Central India, and how Nagpur's business landscape is evolving digitally. From MIDC industrialists to Dharampeth retailers - real advice for real Nagpur businesses.",
  },
  'accessibility': {
    h1: 'Accessibility - ADA & WCAG Compliance for Websites',
    intro:
      "Plain-English guides to website accessibility, ADA compliance, and WCAG 2.1/2.2 standards. Why accessibility matters for SEO, the business case for inclusive design, lawsuit-driven remediation playbooks, and step-by-step audits you can run on your own website. Written for business owners and product managers - not just developers.",
  },
  'ecommerce': {
    h1: 'eCommerce Strategy & Implementation',
    intro:
      "Build, optimise and scale your online store. Guides on platform selection (Shopify, WooCommerce, Magento, custom), product page conversion tactics, checkout optimisation, payment gateway integrations, and cross-border eCommerce for Indian sellers targeting global markets.",
  },
  'digital-marketing': {
    h1: 'Digital Marketing for Service Businesses',
    intro:
      "Performance marketing, content strategy, and lead generation for B2B and service businesses. Real playbooks on Google Ads, LinkedIn, content marketing funnels, and attribution. Less theory, more numbers you can act on.",
  },
  'company-news': {
    h1: 'eLan Technology News & Milestones',
    intro:
      'Company milestones, launches, partnerships, and behind-the-scenes stories from eLan Technology. Follow our journey from a freelance and startup unit founded in 2002 to a web, ecommerce, accessibility, and digital technology company serving clients in India and internationally.',
  },
};

const heading = categoryHeadings[category];

const categorySeo: Record<string, { title: string; description: string }> = {
  accessibility: {
    title: 'ADA & WCAG Accessibility Resource Center | eLan Technology',
    description:
      'Practical ADA and WCAG guidance covering accessibility audits, WCAG 2.2, remediation, overlays, demand letters and international requirements.',
  },
  ecommerce: {
    title: 'Shopify, Medusa.js & eCommerce Development Guides',
    description:
      'Practical ecommerce guides covering Shopify, Medusa.js, subscriptions, payments, shipping, AI shopping, platform selection and conversion.',
  },
  'company-news': {
    title: 'eLan Technology News, Launches & Milestones',
    description:
      'Company milestones, project launches and updates from eLan Technology, founded as a freelance startup unit in 2002 and officially launched in 2005.',
  },
};
const seo = categorySeo[category] ?? {
  title: `${categoryLabel} Articles | eLan Technology Blog`,
  description: `Browse all ${categoryLabel} articles from the eLan Technology team - practical guides, tips and insights.`,
};

const accessibilityPaths = [
  {
    label: 'Understand',
    title: 'Learn WCAG in plain English',
    description: 'Start with the standard, conformance levels, and the practical meaning of accessible design.',
    href: '/blog/accessibility/wcag-explained-business-owners/',
    linkLabel: 'Read the WCAG guide',
  },
  {
    label: 'Assess',
    title: 'Check your current website',
    description: 'Use the 30-point checklist, then request a hybrid audit for barriers automated scans cannot detect.',
    href: '/blog/accessibility/ada-compliance-checklist/',
    linkLabel: 'Use the checklist',
  },
  {
    label: 'Remediate',
    title: 'Fix barriers in the source code',
    description: 'Plan code-level remediation, verification, documentation, and ongoing accessibility regression checks.',
    href: '/services/ada-compliant-web-design/',
    linkLabel: 'Explore audit & remediation',
  },
];


const counts = Object.fromEntries(categories.map((c) => [c, allPublished.filter((p) => p.data.category === c).length]));

const schema = breadcrumbSchema([
  { name: 'Home', url: '/' },
  { name: 'Blog', url: '/blog/' },
  { name: categoryLabel, url: `/blog/category/${category}/` },
]);
---

<BaseLayout
  ogImage="/images/og/blog.png"
  title={seo.title}
  description={seo.description}
  canonical={`/blog/category/${category}/`}
  schema={schema}
  noindex={noindexCategory}
>

  <!-- HERO -->
  <section class="bg-gradient-to-br from-[var(--bg)] to-[var(--bg-card)] py-10 md:py-14">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
      <p class="text-xs font-bold uppercase tracking-[0.18em]" style={`color: ${blogCategoryColor(category)};`}>{isAccessibility ? 'Accessibility resource center' : 'Category'} · {posts.length} article{posts.length !== 1 ? 's' : ''}</p>
      <h1 class="mt-3 font-heading text-4xl font-bold leading-tight tracking-tight text-[var(--text)] md:text-5xl">{heading?.h1 ?? categoryLabel}</h1>
      {heading?.intro && <p class="mt-4 max-w-3xl text-lg leading-relaxed text-[var(--text-dim)]">{heading.intro}</p>}
    </div>
  </section>

  {isAccessibility && (
    <section class="border-t border-[var(--border)] bg-[var(--bg-card)] py-10">
      <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
        <div class="mb-6 flex flex-col gap-3 md:flex-row md:items-end md:justify-between">
          <div class="max-w-3xl">
            <h2 class="font-heading text-2xl font-bold text-[var(--text)]">Choose the right accessibility path</h2>
            <p class="mt-1 text-[var(--text-dim)]">Learn the standard, assess your risk, or move directly into code-level remediation.</p>
          </div>
          <a href="/services/ada-compliant-web-design/emergency-remediation/" class="text-sm font-semibold text-[var(--ac-red)] hover:underline">Facing a demand-letter deadline? Emergency response →</a>
        </div>
        <div class="grid gap-4 md:grid-cols-3">
          {accessibilityPaths.map((path, i) => (
            <article class="tilt-card tilt-card--bg p-5" style={`--card-color: var(${['--ac-indigo', '--ac-cyan', '--ac-emerald'][i % 3]});`}>
              <p class="text-xs font-bold uppercase tracking-[0.14em]" style="color: var(--card-color);">{path.label}</p>
              <h3 class="mt-2 font-heading text-lg font-bold text-[var(--text)]">{path.title}</h3>
              <p class="mt-2 text-sm leading-relaxed text-[var(--text-dim)]">{path.description}</p>
              <a href={path.href} class="mt-4 inline-flex text-sm font-semibold hover:underline" style="color: var(--card-color);">{path.linkLabel} →</a>
            </article>
          ))}
        </div>
      </div>
    </section>
  )}

  <BlogFilter categories={categories} counts={counts} total={allPublished.length} current={category} />

  <section class="mx-auto max-w-7xl px-4 py-10 sm:px-6 lg:px-8">
    <div class="grid items-start gap-10 lg:grid-cols-[1fr_300px]">
      <div>
        {posts.length === 0 ? (
          <div class="py-16 text-center">
            <p class="text-lg text-[var(--text-dim)]">No posts in this category yet.</p>
            <a href="/blog/" class="mt-4 inline-flex items-center gap-2 font-semibold text-[var(--accent)] hover:underline">← Back to all posts</a>
          </div>
        ) : (
          <ul class="grid gap-5 sm:grid-cols-2" role="list">
            {posts.map((post, i) => <li><BlogCard post={post} heading="h2" eager={i < 2} /></li>)}
          </ul>
        )}
      </div>
      <BlogSidebar posts={allPublished} categories={categories} counts={counts} current={category} />
    </div>
  </section>

  <BlogPrivacyNotice context="category" category={category} />

</BaseLayout>
