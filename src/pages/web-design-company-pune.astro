---
// Pune (27 Nov 2026): leads with ecommerce implementation and integrations. Pune proof: Healthy Genie (Medusa.js
// meal commerce) and ASBIM Consulting (B2B service website; Pune address confirmed on the client's live site).
import CityLayout from '../layouts/CityLayout.astro';
import CityIntro from '../components/city/CityIntro.astro';
import CityServices from '../components/city/CityServices.astro';
import CityProcess from '../components/city/CityProcess.astro';
import CityQuoteFactors from '../components/city/CityQuoteFactors.astro';
import CityFAQ from '../components/city/CityFAQ.astro';
import CityContact from '../components/city/CityContact.astro';
import CityAlsoServing from '../components/city/CityAlsoServing.astro';
import { getCityBySlug } from '../data/cities';

const city = getCityBySlug('pune')!;
const implement = [
  { title: 'Store platform', text: 'Shopify for a fast hosted launch; Medusa.js when subscriptions, pricing rules or integrations need owned code.' },
  { title: 'Payments and subscriptions', text: 'Razorpay, PhonePe and other gateways, recurring orders, refunds and customer messages.' },
  { title: 'Shipping and inventory', text: 'Courier platforms such as Shiprocket, stock sync and order status back to the customer.' },
  { title: 'Business systems', text: 'ERP, accounting, CRM and WhatsApp, with an agreed owner for each piece of data.' },
];
---

<CityLayout city={city} heroHeading="Ecommerce & Web Design Serving Pune">
  <section class="py-14 md:py-20" aria-labelledby="pune-proof-heading">
    <div class="mx-auto grid max-w-7xl gap-6 px-4 sm:px-6 lg:grid-cols-[1.1fr_0.9fr] lg:items-start lg:px-8">
      <div class="space-y-6">
      <article class="tilt-card tilt-card--lg p-6 sm:p-8" style="--card-color: var(--svc-medusa);">
        <p class="text-xs font-bold uppercase tracking-[0.16em] text-[var(--svc-medusa)]">Pune work · Medusa.js meal commerce</p>
        <h2 id="pune-proof-heading" class="mt-2 font-heading text-3xl font-bold text-[var(--text)]">Healthy Genie</h2>
        <p class="mt-3 leading-relaxed text-[var(--text-dim)]">We redesigned and rebuilt the website for Healthy Genie, a Pune meal-commerce brand, on Medusa.js with a Next.js storefront.</p>
        <ul class="mt-4 grid gap-2 sm:grid-cols-2" role="list">
          {['Meal discovery and menus', 'Subscription plans', 'Customer accounts and cart', 'Corporate meal enquiries'].map((item) => <li class="flex gap-2.5 text-sm font-semibold text-[var(--text)]"><span class="text-[var(--svc-medusa)]" aria-hidden="true">✓</span>{item}</li>)}
        </ul>
        <p class="mt-4 text-xs text-[var(--text-muted)]">No sales or performance figures are claimed.</p>
        <div class="mt-5 flex flex-wrap gap-x-5 gap-y-2">
          <a href="/services/ecommerce/medusa-js-development/" class="text-sm font-semibold text-[var(--text)] underline underline-offset-4">Medusa.js development service →</a>
          <a href="https://healthygenie.in/" target="_blank" rel="noopener noreferrer" class="text-sm font-semibold text-[var(--text-dim)] underline underline-offset-4">Visit the Healthy Genie website ↗<span class="sr-only"> (opens in a new tab)</span></a>
        </div>
      </article>
        <article class="tilt-card p-6 sm:p-8" style="--card-color: var(--ac-indigo);">
          <p class="text-xs font-bold uppercase tracking-[0.16em] text-[var(--ac-indigo)]">Pune work · B2B service website</p>
          <h2 class="mt-2 font-heading text-2xl font-bold text-[var(--text)]">ASBIM Consulting</h2>
          <p class="mt-2 leading-relaxed text-[var(--text-dim)]">A structured service website for a Pune BIM consultancy, presenting its architectural, structural and MEP BIM expertise with clear routes to explore services and make an enquiry.</p>
          <div class="mt-4 flex flex-wrap gap-x-5 gap-y-2">
            <a href="/services/website-design/" class="text-sm font-semibold text-[var(--text)] underline underline-offset-4">Website design service →</a>
            <a href="https://asbimconsulting.com/" target="_blank" rel="noopener noreferrer" class="text-sm font-semibold text-[var(--text-dim)] underline underline-offset-4">Visit the ASBIM Consulting website ↗<span class="sr-only"> (opens in a new tab)</span></a>
          </div>
        </article>
      </div>
      <div class="tilt-card p-6 sm:p-8" style="--card-color: var(--ac-amber);">
        <h2 class="font-heading text-xl font-bold text-[var(--text)]">What we implement for Pune stores</h2>
        <ul class="mt-4 space-y-4" role="list">
          {implement.map((m) => <li><h3 class="font-semibold text-[var(--text)]">{m.title}</h3><p class="mt-1 text-sm leading-relaxed text-[var(--text-dim)]">{m.text}</p></li>)}
        </ul>
        <p class="mt-5 text-sm text-[var(--text-dim)]"><strong class="text-[var(--text)]">Where delivery is based:</strong> our team works from Nagpur, in the same state and timezone, with reviews by video and shared links.</p>
        <a href="/services/ecommerce/" class="mt-4 inline-block text-sm font-semibold text-[var(--text)] underline underline-offset-4">Our ecommerce development service →</a>
      </div>
    </div>
  </section>
  <CityIntro city={city} />
  <CityServices city={city} />
  <CityProcess city={city} />
  <CityQuoteFactors cityName="Pune" />
  <CityFAQ city={city} />
  <CityContact city={city} />
  <CityAlsoServing currentSlug="pune" />
</CityLayout>
