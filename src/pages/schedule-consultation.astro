---
import BaseLayout from '../layouts/BaseLayout.astro';
import { breadcrumbSchema } from '../utils/schema';

const schema = breadcrumbSchema([
  { name: 'Home', url: '/' },
  { name: 'Schedule Consultation', url: '/schedule-consultation/' },
]);

const coverPoints = [
  'Your business goals and digital challenges',
  'Review of your current website (if any)',
  'Recommended solutions and technologies',
  'Project timeline and budget estimate',
];

const afterSteps = [
  { step: '1', title: 'Discovery Call', desc: 'We listen, understand your needs, and ask the right questions.' },
  { step: '2', title: 'Proposal & Next Steps', desc: 'When a proposal is appropriate, it sets out the agreed scope, timeline, and pricing.' },
  { step: '3', title: 'Project Kickoff', desc: 'Once approved, we begin with an onboarding session and project plan.' },
];
---

<BaseLayout
  ogImage="/images/og/contact.png"
  title="Schedule a Free Strategy Consultation - eLan Technology"
  description="Book a free 30-minute strategy consultation with eLan Technology. We'll review your goals, current website, and recommend the right digital solutions."
  schema={schema}
  noindex={true}
>

  <!-- ═══════════════════════════════════════════════════════════════════════
       HERO
  ════════════════════════════════════════════════════════════════════════ -->
  <section aria-labelledby="consult-hero-heading" class="relative overflow-hidden bg-gradient-to-br from-[var(--bg)] to-[var(--bg-card)] py-24 md:py-32">
    <div aria-hidden="true" class="pointer-events-none absolute inset-0 overflow-hidden">
      <div class="absolute -top-40 left-1/2 -translate-x-1/2 h-[500px] w-[500px] rounded-full bg-[var(--accent)]/6 blur-[120px]"></div>
    </div>

    <div class="relative mx-auto max-w-7xl px-4 sm:px-6 lg:px-8 text-center">
      <div class="mb-6 inline-flex items-center gap-2 rounded-full border border-[var(--border)] bg-[var(--bg-card)]/60 px-4 py-2 text-sm text-[var(--text-muted)] backdrop-blur-sm">
        <span class="h-2 w-2 rounded-full bg-[var(--accent)] animate-pulse" aria-hidden="true"></span>
        100% Free - No Obligation
      </div>

      <h1
        id="consult-hero-heading"
        class="font-heading text-4xl sm:text-5xl font-bold text-[var(--text)] mb-6"
      >
        Let's Talk About Your Project
      </h1>
      <p class="mx-auto max-w-2xl text-lg text-[var(--text-dim)] leading-relaxed">
        Free 30-minute strategy call with our experts. No sales pitch - just honest advice about what will work for your business.
      </p>
    </div>
  </section>


  <!-- ═══════════════════════════════════════════════════════════════════════
       WHAT WE COVER
  ════════════════════════════════════════════════════════════════════════ -->
  <section aria-labelledby="cover-heading" class="bg-[var(--bg-card)] border-y border-[var(--border)] py-16 md:py-20">
    <div class="mx-auto max-w-4xl px-4 sm:px-6 lg:px-8">
      <div class="grid grid-cols-1 md:grid-cols-2 gap-12 items-center">
        <div>
          <p class="text-sm font-semibold uppercase tracking-widest text-[var(--accent)] mb-3">What We Cover</p>
          <h2 id="cover-heading" class="font-heading text-2xl sm:text-3xl font-bold text-[var(--text)] mb-8">
            A Focused, Productive 30 Minutes
          </h2>
          <ul class="space-y-4" role="list">
            {coverPoints.map((point) => (
              <li class="flex items-start gap-3">
                <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="#00E5A0" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" class="mt-0.5 shrink-0" aria-hidden="true"><polyline points="20 6 9 17 4 12"/></svg>
                <span class="text-[var(--text-dim)]">{point}</span>
              </li>
            ))}
          </ul>
        </div>

        <div class="rounded-2xl border border-[var(--border)] bg-[var(--bg)] p-8">
          <div class="flex items-center gap-3 mb-4">
            <div class="flex h-12 w-12 items-center justify-center rounded-full bg-[var(--accent)]/10">
              <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="#00E5A0" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/></svg>
            </div>
            <div>
              <p class="font-semibold text-[var(--text)]">30-Minute Session</p>
              <p class="text-sm text-[var(--text-muted)]">Video call via Google Meet or Zoom</p>
            </div>
          </div>
          <ul class="space-y-2 text-sm text-[var(--text-dim)]">
            <li class="flex items-center gap-2">
              <span class="text-[var(--accent)]">→</span> Available Mon–Sat, 10am–6pm IST
            </li>
            <li class="flex items-center gap-2">
              <span class="text-[var(--accent)]">→</span> International clients welcome
            </li>
            <li class="flex items-center gap-2">
              <span class="text-[var(--accent)]">→</span> No obligation to proceed
            </li>
          </ul>
        </div>
      </div>
    </div>
  </section>


  <!-- ═══════════════════════════════════════════════════════════════════════
       BOOKING SECTION
  ════════════════════════════════════════════════════════════════════════ -->
  <section aria-labelledby="booking-heading" class="bg-[var(--bg)] py-16 md:py-20">
    <div class="mx-auto max-w-2xl px-4 sm:px-6 lg:px-8">
      <div class="rounded-2xl border border-[var(--border)] bg-[var(--bg-card)] p-4 sm:p-8 text-center">
        <h2 id="booking-heading" class="font-heading text-2xl font-bold text-[var(--text)] mb-4">Book Your Free Call</h2>
        <p class="text-[var(--text-dim)] mb-6">Pick a time that works for you:</p>

        <div
          id="calendly-consent-panel"
          class="rounded-2xl border border-[var(--border)] bg-[var(--bg)] p-6 sm:p-8 text-left"
        >
          <div class="mx-auto flex h-12 w-12 items-center justify-center rounded-2xl bg-[var(--accent)]/10 text-[var(--accent)]" aria-hidden="true">
            <svg viewBox="0 0 24 24" width="24" height="24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <rect x="3" y="5" width="18" height="16" rx="2"></rect>
              <path d="M16 3v4M8 3v4M3 10h18"></path>
              <path d="m9 15 2 2 4-4"></path>
            </svg>
          </div>
          <h3 class="mt-4 text-center font-heading text-xl font-bold text-[var(--text)]">Load the secure booking calendar</h3>
          <p id="calendly-privacy-notice" class="mt-3 text-sm leading-relaxed text-[var(--text-dim)]">
            The calendar is provided by Calendly and is blocked until you choose to load it. If you continue,
            Calendly will receive your IP address and browser/device information, may set its own cookies, and
            will process the contact and scheduling details you enter. We use those details only to arrange and
            communicate about your requested consultation.
          </p>
          <p class="mt-3 text-xs leading-relaxed text-[var(--text-muted)]">
            Review our <a href="/privacy-policy/" class="font-semibold text-[var(--accent)] underline underline-offset-2">Privacy Policy</a>
            and <a href="https://calendly.com/privacy" target="_blank" rel="noopener noreferrer" class="font-semibold text-[var(--accent)] underline underline-offset-2">Calendly's Privacy Notice</a>.
            You can use the direct contact options below without loading Calendly.
          </p>
          <button
            type="button"
            id="load-calendly"
            aria-describedby="calendly-privacy-notice"
            class="mt-5 inline-flex min-h-12 w-full items-center justify-center gap-2 rounded-xl bg-[var(--accent)] px-6 py-3 text-sm font-bold text-[var(--bg)] shadow-lg transition hover:-translate-y-0.5 hover:opacity-90 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-[var(--accent)] disabled:cursor-wait disabled:opacity-70"
          >
            Load Calendly &amp; Choose a Time
            <svg viewBox="0 0 24 24" width="17" height="17" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m9 18 6-6-6-6"/></svg>
          </button>
          <p class="mt-3 text-center text-xs text-[var(--text-muted)]">
            Prefer a separate tab?
            <a href="https://calendly.com/elantech/biz-meet" target="_blank" rel="noopener noreferrer" class="font-semibold text-[var(--accent)] underline underline-offset-2">Open Calendly directly</a>.
          </p>
          <p id="calendly-load-status" class="mt-3 text-center text-xs text-[var(--text-muted)]" aria-live="polite"></p>
        </div>

        <div id="calendly-widget-host" class="w-full" style="min-width:0;height:700px;" hidden tabindex="-1" aria-label="Calendly appointment booking calendar"></div>

        <p class="mt-4 text-sm text-[var(--text-muted)]">Or reach us directly:</p>
        <div class="flex flex-col sm:flex-row gap-3 justify-center mt-3">
          <a
            href="https://wa.me/918788834630"
            class="inline-flex items-center justify-center gap-2 rounded-full border border-[var(--border)] bg-[var(--bg-card)] px-8 py-3 text-sm font-semibold text-[var(--text)] hover:border-[var(--accent)] hover:text-[var(--accent)] transition-colors"
          >
            WhatsApp
          </a>
          <a
            href="mailto:info@elan-tech.net"
            class="inline-flex items-center justify-center gap-2 rounded-full border border-[var(--border)] bg-[var(--bg-card)] px-8 py-3 text-sm font-semibold text-[var(--text)] hover:border-[var(--accent)] hover:text-[var(--accent)] transition-colors"
          >
            Email Us
          </a>
          <a
            href="tel:+919822231642"
            class="inline-flex items-center justify-center gap-2 rounded-full border border-[var(--border)] bg-[var(--bg-card)] px-8 py-3 text-sm font-semibold text-[var(--text)] hover:border-[var(--accent)] hover:text-[var(--accent)] transition-colors"
          >
            Call Us
          </a>
        </div>
      </div>
    </div>
  </section>

  <script is:inline>
    (function () {
      var loadButton = document.getElementById('load-calendly');
      var consentPanel = document.getElementById('calendly-consent-panel');
      var widgetHost = document.getElementById('calendly-widget-host');
      var status = document.getElementById('calendly-load-status');
      var calendlyUrl = 'https://calendly.com/elantech/biz-meet?hide_event_type_details=1';

      if (!loadButton || !consentPanel || !widgetHost || !status) return;

      function showLoadError() {
        widgetHost.hidden = true;
        consentPanel.hidden = false;
        loadButton.disabled = false;
        loadButton.textContent = 'Try Loading Calendly Again';
        status.textContent = 'The booking calendar could not be loaded. Please use WhatsApp, email, phone, or open Calendly directly.';
      }

      function initialiseCalendar() {
        if (!window.Calendly || typeof window.Calendly.initInlineWidget !== 'function') {
          showLoadError();
          return;
        }
        consentPanel.hidden = true;
        widgetHost.hidden = false;
        widgetHost.replaceChildren();
        window.Calendly.initInlineWidget({
          url: calendlyUrl,
          parentElement: widgetHost
        });
        widgetHost.focus({ preventScroll: true });
      }

      loadButton.addEventListener('click', function () {
        loadButton.disabled = true;
        loadButton.textContent = 'Loading Calendly…';
        status.textContent = 'Connecting to Calendly. This may take a moment.';

        if (window.Calendly && typeof window.Calendly.initInlineWidget === 'function') {
          initialiseCalendar();
          return;
        }

        var existingScript = document.querySelector('script[data-elan-calendly]');
        if (existingScript) {
          existingScript.addEventListener('load', initialiseCalendar, { once: true });
          existingScript.addEventListener('error', showLoadError, { once: true });
          return;
        }

        var script = document.createElement('script');
        script.src = 'https://assets.calendly.com/assets/external/widget.js';
        script.async = true;
        script.dataset.elanCalendly = 'true';
        script.addEventListener('load', initialiseCalendar, { once: true });
        script.addEventListener('error', showLoadError, { once: true });
        document.head.appendChild(script);
      });
    })();
  </script>


  <!-- ═══════════════════════════════════════════════════════════════════════
       WHAT HAPPENS AFTER
  ════════════════════════════════════════════════════════════════════════ -->
  <section aria-labelledby="after-heading" class="bg-[var(--bg-card)] border-t border-[var(--border)] py-16 md:py-20">
    <div class="mx-auto max-w-4xl px-4 sm:px-6 lg:px-8">
      <p class="text-center text-sm font-semibold uppercase tracking-widest text-[var(--accent)] mb-3">After the Call</p>
      <h2 id="after-heading" class="font-heading text-2xl sm:text-3xl font-bold text-[var(--text)] text-center mb-12">
        What Happens Next
      </h2>

      <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
        {afterSteps.map((s) => (
          <div class="rounded-2xl border border-[var(--border)] bg-[var(--bg)] p-6 text-center">
            <div class="mx-auto mb-4 flex h-12 w-12 items-center justify-center rounded-full bg-[var(--accent)]/10 font-bold text-[var(--accent)] font-heading text-lg">
              {s.step}
            </div>
            <h3 class="font-semibold text-[var(--text)] mb-2">{s.title}</h3>
            <p class="text-sm text-[var(--text-dim)] leading-relaxed">{s.desc}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

</BaseLayout>
