---
import BaseLayout from '../layouts/BaseLayout.astro';
import { breadcrumbSchema } from '../utils/schema';
import { COMPANY } from '../data/company';

const schema = breadcrumbSchema([
  { name: 'Home', url: '/' },
  { name: 'Schedule Consultation', url: '/schedule-consultation/' },
]);

const coverPoints = [
  'Your business goals and digital challenges',
  'Review of your current website (if any)',
  'Recommended solutions and technologies',
  'Project timeline and budget estimate',
];

// Compact consultation page (owner, 27 Nov 2026): explanation beside the booking calendar.
const afterSteps = [
  { step: '1', title: 'Discovery Call', desc: 'We listen, understand your needs, and ask the right questions.' },
  { step: '2', title: 'Proposal & Next Steps', desc: 'When a proposal is appropriate, it sets out the agreed scope, timeline, and pricing.' },
  { step: '3', title: 'Project Kickoff', desc: 'Once approved, we begin with an onboarding session and project plan.' },
];
---

<BaseLayout
  ogImage="/images/og/contact.png"
  title="Schedule a Strategy Consultation - eLan Technology"
  description="Book a 30-minute strategy consultation with eLan Technology. We'll review your goals, current website, and recommend the right digital solutions."
  schema={schema}
  noindex={true}
>
  <section class="relative bg-gradient-to-br from-[var(--bg)] to-[var(--bg-card)] py-12 md:py-16" aria-labelledby="consult-hero-heading">
    <div class="consult-grid mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
      <div class="area-intro">
        <p class="text-xs font-bold uppercase tracking-[0.18em] text-[var(--accent)]">30 Minutes · No Obligation</p>
        <h1 id="consult-hero-heading" class="mt-3 font-heading text-4xl font-bold leading-tight text-[var(--text)] sm:text-5xl">Let's Talk About Your Project</h1>
        <p class="mt-4 text-lg leading-relaxed text-[var(--text-dim)]">A 30-minute strategy call with our team. No sales pitch, just honest advice about what will work for your business.</p>
      </div>

      <div class="area-info">
        <h2 id="cover-heading" class="font-heading text-lg font-bold text-[var(--text)]">What we cover</h2>
        <ul class="mt-3 grid gap-2 sm:grid-cols-2" role="list">
          {coverPoints.map((point) => (
            <li class="flex items-start gap-2 text-sm text-[var(--text-dim)]">
              <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" class="mt-0.5 shrink-0 text-[var(--accent)]" aria-hidden="true"><polyline points="20 6 9 17 4 12"/></svg>
              {point}
            </li>
          ))}
        </ul>
        <p class="tilt-card mt-4 p-4 text-sm leading-relaxed text-[var(--text-dim)]" style="--card-color: var(--ac-cyan);"><strong class="text-[var(--text)]">Video call via Google Meet or Zoom.</strong> Business hours: {COMPANY.hours.weekdayLabel}; {COMPANY.hours.saturdayLabel}. Slots are subject to availability. International clients welcome.</p>

        <h2 id="after-heading" class="mt-8 font-heading text-lg font-bold text-[var(--text)]">What happens next</h2>
        <ol class="mt-3 space-y-4" role="list">
          {afterSteps.map((s) => (
            <li class="step">
              <span aria-hidden="true">{s.step}</span>
              <div>
                <h3 class="font-semibold text-[var(--text)]">{s.title}</h3>
                <p class="mt-0.5 text-sm leading-relaxed text-[var(--text-dim)]">{s.desc}</p>
              </div>
            </li>
          ))}
        </ol>
      </div>

      <div class="area-form tilt-card tilt-card--lg p-5 sm:p-8" style="--card-color: var(--ac-violet);" aria-labelledby="booking-heading">
        <h2 id="booking-heading" class="font-heading text-2xl font-bold text-[var(--text)]">Book Your Call</h2>
        <div id="calendly-consent-panel" class="mt-4">
          <p id="calendly-privacy-notice" class="text-sm leading-relaxed text-[var(--text-dim)]">
            The calendar is provided by Calendly and stays blocked until you choose to load it. If you continue,
            Calendly will receive your IP address and browser/device information, may set its own cookies, and
            will process the contact and scheduling details you enter. We use those details only to arrange and
            communicate about your requested consultation.
          </p>
          <p class="mt-2 text-xs leading-relaxed text-[var(--text-muted)]">
            Review our <a href="/privacy-policy/" class="font-semibold text-[var(--accent)] underline underline-offset-2">Privacy Policy</a> and <a href="https://calendly.com/privacy" target="_blank" rel="noopener noreferrer" class="font-semibold text-[var(--accent)] underline underline-offset-2">Calendly's Privacy Notice</a>.
            You can use the direct contact options below without loading Calendly.
          </p>
          <button
            type="button"
            id="load-calendly"
            aria-describedby="calendly-privacy-notice"
            class="mt-5 inline-flex min-h-12 w-full items-center justify-center gap-2 rounded-lg bg-[var(--accent)] px-6 py-3 text-sm font-bold text-[var(--bg)] transition hover:opacity-90 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-[var(--accent)] disabled:cursor-wait disabled:opacity-70"
          >
            Load Calendly &amp; Choose a Time
            <svg viewBox="0 0 24 24" width="17" height="17" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m9 18 6-6-6-6"/></svg>
          </button>
          <p class="mt-3 text-center text-xs text-[var(--text-muted)]">
            Prefer a separate tab? <a href="https://calendly.com/elantech/biz-meet" target="_blank" rel="noopener noreferrer" class="font-semibold text-[var(--accent)] underline underline-offset-2">Open Calendly directly</a>.
          </p>
          <p id="calendly-load-status" class="mt-2 text-center text-xs text-[var(--text-muted)]" aria-live="polite"></p>
        </div>

        <div id="calendly-widget-host" class="mt-4 w-full" style="min-width:0;height:700px;" hidden tabindex="-1" aria-label="Calendly appointment booking calendar"></div>

        <div class="mt-6 border-t border-[var(--border)] pt-5">
          <p class="text-sm text-[var(--text-muted)]">Or reach us directly:</p>
          <div class="mt-3 flex flex-wrap gap-2">
            <a href="https://wa.me/918788834630" class="inline-flex min-h-10 items-center rounded-lg border border-[var(--border)] bg-[var(--bg)] px-4 py-2 text-sm font-semibold text-[var(--text)] transition hover:border-[var(--accent)]">WhatsApp</a>
            <a href="mailto:info@elan-tech.net" class="inline-flex min-h-10 items-center rounded-lg border border-[var(--border)] bg-[var(--bg)] px-4 py-2 text-sm font-semibold text-[var(--text)] transition hover:border-[var(--accent)]">Email Us</a>
            <a href="tel:+919822231642" class="inline-flex min-h-10 items-center rounded-lg border border-[var(--border)] bg-[var(--bg)] px-4 py-2 text-sm font-semibold text-[var(--text)] transition hover:border-[var(--accent)]">Call Us</a>
          </div>
        </div>
      </div>
    </div>
  </section>

  <script is:inline>
    (function () {
      var loadButton = document.getElementById('load-calendly');
      var consentPanel = document.getElementById('calendly-consent-panel');
      var widgetHost = document.getElementById('calendly-widget-host');
      var status = document.getElementById('calendly-load-status');
      var calendlyUrl = 'https://calendly.com/elantech/biz-meet?hide_event_type_details=1';

      if (!loadButton || !consentPanel || !widgetHost || !status) return;

      function showLoadError() {
        widgetHost.hidden = true;
        consentPanel.hidden = false;
        loadButton.disabled = false;
        loadButton.textContent = 'Try Loading Calendly Again';
        status.textContent = 'The booking calendar could not be loaded. Please use WhatsApp, email, phone, or open Calendly directly.';
      }

      function initialiseCalendar() {
        if (!window.Calendly || typeof window.Calendly.initInlineWidget !== 'function') {
          showLoadError();
          return;
        }
        consentPanel.hidden = true;
        widgetHost.hidden = false;
        widgetHost.replaceChildren();
        window.Calendly.initInlineWidget({
          url: calendlyUrl,
          parentElement: widgetHost
        });
        widgetHost.focus({ preventScroll: true });
      }

      loadButton.addEventListener('click', function () {
        loadButton.disabled = true;
        loadButton.textContent = 'Loading Calendly…';
        status.textContent = 'Connecting to Calendly. This may take a moment.';

        if (window.Calendly && typeof window.Calendly.initInlineWidget === 'function') {
          initialiseCalendar();
          return;
        }

        var existingScript = document.querySelector('script[data-elan-calendly]');
        if (existingScript) {
          existingScript.addEventListener('load', initialiseCalendar, { once: true });
          existingScript.addEventListener('error', showLoadError, { once: true });
          return;
        }

        var script = document.createElement('script');
        script.src = 'https://assets.calendly.com/assets/external/widget.js';
        script.async = true;
        script.dataset.elanCalendly = 'true';
        script.addEventListener('load', initialiseCalendar, { once: true });
        script.addEventListener('error', showLoadError, { once: true });
        document.head.appendChild(script);
      });
    })();
  </script>
</BaseLayout>

<style>
  .consult-grid { display: grid; gap: 2rem; grid-template-areas: "intro" "form" "info"; }
  .area-intro { grid-area: intro; } .area-form { grid-area: form; } .area-info { grid-area: info; }
  @media (min-width: 1024px) {
    .consult-grid { grid-template-columns: 0.95fr 1.05fr; grid-template-rows: auto 1fr; column-gap: 2.5rem; row-gap: 2rem; grid-template-areas: "intro form" "info form"; align-items: start; }
    .area-form { position: sticky; top: 7rem; }
  }
  .step { display: grid; grid-template-columns: 2.25rem 1fr; gap: .9rem; }
  .step > span { display: grid; place-items: center; width: 2.25rem; height: 2.25rem; border-radius: var(--radius-lg); background: color-mix(in srgb, var(--accent) 12%, transparent); color: var(--accent); font-weight: 800; }
</style>
