---
import InternationalLayout from '../layouts/InternationalLayout.astro';
import InternationalMarketFocus from '../components/international/InternationalMarketFocus.astro';
import InternationalDeliveryPlan from '../components/international/InternationalDeliveryPlan.astro';
import InternationalProjectProof from '../components/international/InternationalProjectProof.astro';
import InternationalAgencyPartner from '../components/international/InternationalAgencyPartner.astro';
import InternationalFAQ from '../components/international/InternationalFAQ.astro';
import InternationalContact from '../components/international/InternationalContact.astro';
import { getCountryBySlug } from '../data/countries';

const country = getCountryBySlug('usa')!;
---

<InternationalLayout country={country}
  title="ADA & WCAG Remediation and Web Development for US Businesses | eLan Technology"
  description="Code-level ADA and WCAG remediation for US businesses, plus the web development and ecommerce work behind it, delivered remotely from India with written scope and retesting."
  heading="Code-level ADA & WCAG remediation and web development for US businesses"
  introduction="We find the barriers that stop people using your website, fix them in the code and content, and retest the journeys that matter. The same India-based team handles the custom development, ecommerce and integrations a remediation often needs."
  primaryAction={{ href: '/services/ada-compliant-web-design/', label: 'See remediation services' }}>
  <Fragment slot="market-introduction">
    <InternationalMarketFocus market="usa" />
    <InternationalProjectProof country={country} />
  </Fragment>
  <InternationalDeliveryPlan market="usa" />
  <InternationalAgencyPartner market="usa" />
  <InternationalFAQ country={country} />
  <InternationalContact country={country} />
</InternationalLayout>
