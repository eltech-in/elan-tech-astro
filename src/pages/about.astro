---
import BaseLayout from '../layouts/BaseLayout.astro';
import { Image } from 'astro:assets';
import nishantPhoto from '../assets/team/nishant-barde.avif';
import abhishekPhoto from '../assets/team/acharya-abhishek.avif';
import { organizationSchema, breadcrumbSchema } from '../utils/schema';

const schema = [
  organizationSchema(),
  breadcrumbSchema([
    { name: 'Home', url: '/' },
    { name: 'About', url: '/about/' },
  ]),
];

// Official figures (founded 2002, 24+ years, 500+ clients, 1,500+ projects).
const stats = [
  { value: '24+', label: 'Years', sub: 'Since 2002', cssVar: '--ac-indigo' },
  { value: '500+', label: 'Clients', sub: 'India and abroad', cssVar: '--ac-amber' },
  { value: '1,500+', label: 'Projects', sub: 'Delivered', cssVar: '--ac-emerald' },
  { value: '10+', label: 'Countries', sub: 'Served remotely', cssVar: '--ac-cyan' },
];

const journey = [
  { year: '2002', title: 'Freelance and startup roots in Nagpur' },
  { year: '2005', title: 'Official launch on 15 August' },
  { year: '2006', title: 'Dynamic PHP and MySQL web applications' },
  { year: '2009', title: 'Mobile-first design; first USA and UK clients' },
  { year: '2014', title: 'Full-stack JavaScript, SEO, marketing and branding' },
  { year: '2019', title: 'Association portals; more clients in Canada and Australia' },
  { year: '2023', title: 'Custom commerce, accessibility, Astro and AI-assisted engineering' },
];

const principles = [
  { title: 'Accessibility first', desc: 'Considered from design through development and testing; formal conformance work is scoped to the standard and evidence each project needs.', cssVar: '--ac-indigo', icon: '<svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="4.5" r="1.5"/><path d="M5 8l7 1.5L19 8M12 9.5V15m0 0-3 6m3-6 3 6"/></svg>' },
  { title: 'Transparent pricing', desc: 'Fixed-price projects with milestone billing and a detailed breakdown before work begins. No surprise invoices.', cssVar: '--ac-amber', icon: '<svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M14 2H6a2 2 0 00-2 2v16a2 2 0 002 2h12a2 2 0 002-2V8z"/><polyline points="14 2 14 8 20 8"/><line x1="16" y1="13" x2="8" y2="13"/><line x1="16" y1="17" x2="8" y2="17"/></svg>' },
  { title: 'Built to perform', desc: 'Performance, security, maintainability and search visibility are planned in, then tested on the agreed journeys before launch.', cssVar: '--ac-emerald', icon: '<svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="23 6 13.5 15.5 8.5 10.5 1 18"/><polyline points="17 6 23 6 23 12"/></svg>' },
  { title: 'One consistent team', desc: 'You work with people who know your project, and you always know who is responsible for each stage.', cssVar: '--ac-pink', icon: '<svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M17 21v-2a4 4 0 00-4-4H5a4 4 0 00-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M23 21v-2a4 4 0 00-3-3.87M16 3.13a4 4 0 010 7.75"/></svg>' },
  { title: 'Long-term partnership', desc: 'Post-launch support on every package and ongoing maintenance plans. Many client relationships span years.', cssVar: '--ac-cyan', icon: '<svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/></svg>' },
  { title: 'Always learning', desc: 'From Astro and Next.js to AI-assisted tooling, so your site is built for today’s web, not yesterday’s.', cssVar: '--ac-violet', icon: '<svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M2 3h6a4 4 0 014 4v14a3 3 0 00-3-3H2z"/><path d="M22 3h-6a4 4 0 00-4 4v14a3 3 0 013-3h7z"/></svg>' },
];
---

<BaseLayout
  title="About eLan Technology | Web Design Company in Nagpur Since 2002"
  description="eLan Technology began as a freelance startup unit in 2002 and officially launched on 15 August 2005. Web design, custom ecommerce, accessibility and digital technology from Nagpur."
  schema={schema}
>
  <!-- Hero: who we are, key figures, founder -->
  <section class="relative bg-gradient-to-br from-[var(--bg)] to-[var(--bg-card)] py-12 md:py-16" aria-labelledby="about-heading">
    <div class="mx-auto grid max-w-6xl gap-8 px-4 sm:px-6 lg:grid-cols-[1.35fr_0.65fr] lg:items-start lg:px-8">
      <div>
        <p class="text-xs font-bold uppercase tracking-[0.18em] text-[var(--accent)]">Since 2002</p>
        <h1 id="about-heading" class="mt-3 font-heading text-4xl font-bold leading-tight text-[var(--text)] sm:text-5xl">About eLan Technology</h1>
        <p class="mt-4 max-w-2xl text-lg leading-relaxed text-[var(--text-dim)]">A web design, commerce and accessibility studio from Nagpur, India. For 24+ years we have designed, built and looked after websites and business software for clients across India and around the world.</p>
        <ul class="mt-7 grid grid-cols-2 gap-3 sm:grid-cols-4" role="list">
          {stats.map((s) => (
            <li class="stat relative overflow-hidden rounded-xl border border-[var(--border)] p-4" style={`background: linear-gradient(135deg, color-mix(in srgb, var(${s.cssVar}) 12%, var(--bg-card)) 0%, var(--bg-card) 70%);`}>
              <span aria-hidden="true" class="pointer-events-none absolute -bottom-6 -left-6 h-20 w-20 rotate-[-20deg] opacity-[0.07]" style={`background: var(${s.cssVar});`}></span>
              <p class="relative font-heading text-3xl font-black" style={`color: var(${s.cssVar});`}>{s.value}</p>
              <p class="relative text-sm font-semibold text-[var(--text)]">{s.label}</p>
              <p class="relative text-xs text-[var(--text-muted)]">{s.sub}</p>
            </li>
          ))}
        </ul>
      </div>

      <aside class="founder relative overflow-hidden rounded-xl border border-[var(--border)] p-6" aria-labelledby="founder-name">
        <span aria-hidden="true" class="pointer-events-none absolute -bottom-8 -right-8 h-36 w-36 rotate-[-20deg] opacity-[0.07]" style="background: var(--ac-amber);"></span>
        <div class="relative flex items-center gap-4">
          <div class="h-16 w-16 shrink-0 overflow-hidden rounded-full border-2" style="border-color: color-mix(in srgb, var(--ac-amber) 40%, transparent);">
            <Image src={nishantPhoto} alt="Nishant Barde" width={200} height={200} format="avif" class="h-full w-full object-cover" loading="eager" decoding="async" />
          </div>
          <div>
            <p class="text-[10px] font-bold uppercase tracking-[0.18em]" style="color: var(--ac-amber);">Founder</p>
            <h2 id="founder-name" class="font-heading text-xl font-bold text-[var(--text)]">Nishant Barde</h2>
            <p class="text-sm text-[var(--text-muted)]">Founder &amp; Director</p>
          </div>
        </div>
        <blockquote class="relative mt-4 border-l-2 pl-3 text-sm italic leading-relaxed text-[var(--text-dim)]" style="border-color: var(--ac-amber);">"Great technology should be accessible to every business, not just the Fortune 500."</blockquote>
        <a href="/about/nishant-barde/" target="_blank" rel="noopener noreferrer" class="founder-card-cta group relative mt-5 flex w-full items-center gap-3 rounded-lg px-4 py-3 text-left text-white">
          <span class="min-w-0 flex-1">
            <small class="block text-[9px] font-extrabold uppercase tracking-[0.16em] text-emerald-200">Call • WhatsApp • Save</small>
            <strong class="mt-0.5 block text-sm font-extrabold">View Nishant’s digital card</strong>
          </span>
          <span class="flex h-8 w-8 shrink-0 items-center justify-center rounded-md bg-white text-[#123d36] transition-transform group-hover:translate-x-1" aria-hidden="true">→</span>
        </a>
      </aside>
    </div>
  </section>

  <!-- Story + compact timeline -->
  <section class="border-y border-[var(--border)] bg-[var(--bg-card)] py-12 md:py-16" aria-labelledby="story-heading">
    <div class="mx-auto grid max-w-6xl gap-10 px-4 sm:px-6 lg:grid-cols-[1fr_1fr] lg:px-8">
      <div>
        <p class="text-xs font-bold uppercase tracking-[0.18em] text-[var(--accent)]">Our story</p>
        <h2 id="story-heading" class="mt-2 font-heading text-3xl font-bold text-[var(--text)]">24 Years of Building the Web</h2>
        <div class="mt-5 space-y-4 leading-relaxed text-[var(--text-dim)]">
          <p>Operations began in Nagpur in 2002 as a freelance and startup unit, when a website was still a novelty for most Indian businesses. Founder <strong class="text-[var(--text)]">Nishant Barde</strong> helped local businesses get a credible online presence, and eLan Technology officially launched on <strong class="text-[var(--text)]">15 August 2005</strong>.</p>
          <p>Since then the work has grown into web applications, portals, custom Shopify and Medusa.js commerce, accessibility, marketing and branding, for clients across India and in the USA, Canada, Australia, the UK and Japan. One principle has stayed constant: <strong class="text-[var(--text)]">accessibility first</strong>.</p>
        </div>
        <p class="mt-5 rounded-xl border border-[var(--border)] bg-[var(--bg)] p-4 text-sm leading-relaxed text-[var(--text-dim)]"><strong class="text-[var(--text)]">Mission:</strong> websites and digital solutions that are beautiful, accessible, fast and built for real results, within reach of every business. <strong class="text-[var(--text)]">Vision:</strong> Central India’s most trusted technology partner, recognised globally for accessible, performance-driven web development.</p>
      </div>
      <ol class="timeline" role="list" aria-label="Milestones">
        {journey.map((j) => (
          <li><span class="yr">{j.year}</span><span class="tx">{j.title}</span></li>
        ))}
      </ol>
    </div>
  </section>

  <!-- What we stand for: values + why clients choose us, merged -->
  <section class="py-12 md:py-16" aria-labelledby="values-heading">
    <div class="mx-auto max-w-6xl px-4 sm:px-6 lg:px-8">
      <p class="text-xs font-bold uppercase tracking-[0.18em] text-[var(--accent)]">What we stand for</p>
      <h2 id="values-heading" class="mt-2 font-heading text-3xl font-bold text-[var(--text)]">Why Businesses Choose eLan</h2>
      <ul class="mt-7 grid gap-4 sm:grid-cols-2 lg:grid-cols-3" role="list">
        {principles.map((p, i) => (
          <li class="service-card relative overflow-hidden rounded-xl border border-[var(--border)] p-5" style={`background: linear-gradient(135deg, color-mix(in srgb, var(${p.cssVar}) 10%, var(--bg-card)) 0%, var(--bg-card) 65%); --card-color: var(${p.cssVar});`}>
            <span aria-hidden="true" class="service-card__num pointer-events-none absolute right-4 top-3 select-none font-heading font-black leading-none" style={`color: var(${p.cssVar}); font-size: 3rem;`}>{String(i + 1).padStart(2, '0')}</span>
            <span aria-hidden="true" class="service-card__stripe pointer-events-none absolute -bottom-8 -left-8 h-32 w-32 rotate-[-20deg] opacity-[0.08]" style={`background: var(${p.cssVar});`}></span>
            <span class="relative flex h-10 w-10 items-center justify-center rounded-md" style={`background: color-mix(in srgb, var(${p.cssVar}) 16%, transparent); color: var(${p.cssVar});`} aria-hidden="true" set:html={p.icon} />
            <h3 class="relative mt-3 font-heading text-lg font-bold text-[var(--text)]">{p.title}</h3>
            <p class="relative mt-1.5 text-sm leading-relaxed text-[var(--text-dim)]">{p.desc}</p>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <!-- Leadership -->
  <section class="border-t border-[var(--border)] bg-[var(--bg-card)] py-12 md:py-16" aria-labelledby="team-heading">
    <div class="mx-auto max-w-6xl px-4 sm:px-6 lg:px-8">
      <p class="text-xs font-bold uppercase tracking-[0.18em] text-[var(--accent)]">People</p>
      <h2 id="team-heading" class="mt-2 font-heading text-3xl font-bold text-[var(--text)]">Leadership Team</h2>
      <div class="mt-7 grid gap-4 sm:grid-cols-2">
        <div class="flex items-start gap-4 rounded-xl border border-[var(--border)] bg-[var(--bg)] p-5">
          <div class="h-14 w-14 shrink-0 overflow-hidden rounded-full border-2" style="border-color: color-mix(in srgb, var(--ac-indigo) 40%, transparent);">
            <Image src={nishantPhoto} alt="Nishant Barde" width={200} height={200} format="avif" class="h-full w-full object-cover" loading="lazy" decoding="async" />
          </div>
          <div>
            <h3 class="font-heading text-lg font-bold text-[var(--text)]">Nishant Barde</h3>
            <p class="text-sm font-medium" style="color: var(--ac-indigo);">Founder &amp; Director</p>
            <p class="mt-2 text-sm leading-relaxed text-[var(--text-dim)]">Technology entrepreneur who grew eLan from a local web studio into a partner for businesses in India and overseas.</p>
          </div>
        </div>
        <div class="flex items-start gap-4 rounded-xl border border-[var(--border)] bg-[var(--bg)] p-5">
          <div class="h-14 w-14 shrink-0 overflow-hidden rounded-full border-2" style="border-color: color-mix(in srgb, var(--ac-violet) 40%, transparent);">
            <Image src={abhishekPhoto} alt="Abhishek Acharya" width={200} height={200} format="avif" class="h-full w-full object-cover" loading="lazy" decoding="async" />
          </div>
          <div>
            <h3 class="font-heading text-lg font-bold text-[var(--text)]">Abhishek Acharya</h3>
            <p class="text-sm font-medium" style="color: var(--ac-violet);">Mentor &amp; Training Lead</p>
            <p class="mt-2 text-sm leading-relaxed text-[var(--text-dim)]">Guides learners with practical knowledge and keeps the team current through continuous training.</p>
          </div>
        </div>
      </div>
      <details id="leadership-publication-note" class="note mt-4 rounded-xl border border-[var(--border)] bg-[var(--bg)]">
        <summary class="flex cursor-pointer list-none items-center justify-between gap-4 px-5 py-3 text-sm font-semibold text-[var(--text)]">
          About these profiles
          <svg class="chev shrink-0 text-[var(--text-muted)]" xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polyline points="6 9 12 15 18 9"/></svg>
        </summary>
        <div class="border-t border-[var(--border)] px-5 py-4 text-sm leading-relaxed text-[var(--text-dim)]">
          <p>These profiles use only work-related names, photographs, roles and short biographies. They do not publish private addresses, personal phone numbers or unrelated family information, and they are reviewed when responsibilities change. A featured person may request a correction, updated role, different photograph or removal; we may verify the request first.</p>
          <a href="mailto:privacy@elan-tech.net?subject=Leadership%20profile%20correction%20or%20removal" class="mt-2 inline-flex text-xs font-bold text-[var(--text)] underline decoration-[var(--ac-indigo)] underline-offset-4">Request a profile update or removal</a>
        </div>
      </details>
    </div>
  </section>

  <!-- CTA -->
  <section class="py-12 md:py-16" aria-labelledby="about-cta-heading">
    <div class="mx-auto max-w-4xl px-4 text-center sm:px-6 lg:px-8">
      <h2 id="about-cta-heading" class="font-heading text-3xl font-bold text-[var(--text)] sm:text-4xl">Ready to work with us?</h2>
      <p class="mt-3 text-lg text-[var(--text-dim)]">Let us bring our 24 years of experience to your next project.</p>
      <div class="mt-7 flex flex-col justify-center gap-3 sm:flex-row">
        <a href="/get-quote/" class="inline-flex items-center justify-center rounded-lg bg-[var(--accent)] px-7 py-3.5 font-semibold text-white transition hover:brightness-110">Start Your Project</a>
        <a href="/schedule-consultation/" class="inline-flex items-center justify-center rounded-lg border border-[var(--border)] px-7 py-3.5 font-semibold text-[var(--text)] transition hover:border-[var(--accent)]">Schedule a Meeting</a>
        <a href="/portfolio/" class="inline-flex items-center justify-center rounded-lg border border-[var(--border)] px-7 py-3.5 font-semibold text-[var(--text)] transition hover:border-[var(--accent)]">See Our Work</a>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .founder { background: linear-gradient(135deg, color-mix(in srgb, var(--ac-amber) 12%, var(--bg-card)) 0%, var(--bg-card) 70%); }
  .founder-card-cta { background: linear-gradient(115deg, #075e52 0%, #047857 54%, #1d4ed8 135%); box-shadow: 0 12px 24px rgba(4, 120, 87, .22); transition: transform 180ms ease, box-shadow 180ms ease; }
  .founder-card-cta:hover { transform: translateY(-2px); box-shadow: 0 16px 30px rgba(4, 120, 87, .28); }
  .founder-card-cta:focus-visible { outline: 3px solid var(--ac-amber); outline-offset: 3px; }
  .timeline { position: relative; display: grid; gap: .25rem; margin: 0; padding: 0 0 0 1.4rem; list-style: none; }
  .timeline::before { content: ''; position: absolute; left: .35rem; top: .5rem; bottom: .5rem; width: 2px; background: linear-gradient(var(--ac-indigo), var(--ac-pink)); opacity: .35; }
  .timeline li { position: relative; display: grid; grid-template-columns: 3.4rem 1fr; gap: .75rem; align-items: baseline; padding: .6rem .8rem; border-radius: var(--radius-xl); }
  .timeline li::before { content: ''; position: absolute; left: -1.25rem; top: 1.05rem; width: .7rem; height: .7rem; border-radius: 999px; background: var(--bg-card); border: 2px solid var(--accent); }
  .timeline li:hover { background: var(--bg); }
  .timeline .yr { font-family: var(--font-heading); font-weight: 800; color: var(--accent); }
  .timeline .tx { color: var(--text); font-size: .95rem; }
  .note[open] .chev { transform: rotate(180deg); } .chev { transition: transform .2s; }
  .note summary::-webkit-details-marker { display: none; }
  @media (prefers-reduced-motion: reduce) { .founder-card-cta { transition: none; } }
</style>
