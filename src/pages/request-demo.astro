---
// Product walkthrough request (27 Nov 2026): the form sits beside a short explanation so it is visible
// without scrolling. Products come from the catalogue; a product page link preselects its product.
import BaseLayout from '../layouts/BaseLayout.astro';
import RequestDemoForm from '../islands/RequestDemoForm';
import { breadcrumbSchema } from '../utils/schema';
import { products, hasPublicDemo } from '../data/products';
import { COMPANY } from '../data/company';

const demoProducts = products.map((p) => ({ value: p.slug, label: p.title, publicDemo: hasPublicDemo(p) }));
const publicDemo = products.find((p) => hasPublicDemo(p));

const schema = breadcrumbSchema([
  { name: 'Home', url: '/' },
  { name: 'Products', url: '/products/' },
  { name: 'Request a Walkthrough', url: '/request-demo/' },
]);

const steps = [
  { title: 'Send the request', desc: 'Choose a product and tell us what you want to see.' },
  { title: 'We agree a time', desc: 'We reply to confirm a time that suits you, usually by WhatsApp or phone.' },
  { title: 'Guided walkthrough', desc: 'About 30 minutes with sample data, shaped around your workflow, with time for questions.' },
];
const youSee = [
  'The modules that match your workflow',
  'What is configurable, and what is set in the proposal',
  'How your team and your customers would use it',
  'Hosting, support and source-code options',
];
---

<BaseLayout
  ogImage="/images/og/contact.png"
  title="Request a Product Walkthrough - eLan Technology"
  description="Request a guided walkthrough of an eLan Technology product: Central CMS, real estate portal, medical conference portal, IMA society portal, resort management, project management or insurance agency management."
  schema={schema}
  noindex={true}
>
  <section class="relative overflow-hidden bg-gradient-to-br from-[var(--bg)] to-[var(--bg-card)] py-10 md:py-14" aria-labelledby="demo-hero-heading">
    <div class="mx-auto grid max-w-7xl gap-8 px-4 sm:px-6 lg:grid-cols-[0.85fr_1.15fr] lg:grid-rows-[auto_1fr] lg:items-start lg:gap-x-12 lg:px-8">
      <div class="lg:col-start-1 lg:row-start-1">
        <p class="text-xs font-bold uppercase tracking-[0.18em] text-[var(--accent)]">Guided product walkthrough</p>
        <h1 id="demo-hero-heading" class="mt-3 font-heading text-4xl font-bold leading-tight text-[var(--text)] sm:text-5xl">Request a Product Walkthrough</h1>
        <p class="mt-4 text-lg leading-relaxed text-[var(--text-dim)]">See the product with sample data and your own workflow in mind. No commitment and no sales pressure.</p>
      </div>

      <div class="rounded-xl border border-[var(--border)] bg-[var(--bg-card)] p-5 shadow-xl shadow-black/5 sm:p-7 lg:col-start-2 lg:row-span-2 lg:row-start-1" aria-labelledby="demo-form-heading">
        <h2 id="demo-form-heading" class="font-heading text-2xl font-bold text-[var(--text)]">Book your walkthrough</h2>
        <p class="mt-1 mb-6 text-sm text-[var(--text-dim)]">Fields marked * are required. We reply to agree a suitable time.</p>
        <RequestDemoForm client:load products={demoProducts} />
      </div>

      <div class="lg:col-start-1 lg:row-start-2">
        <ol class="space-y-4" role="list">
          {steps.map((s, i) => (
            <li class="flex gap-3">
              <span class="grid h-8 w-8 shrink-0 place-items-center rounded-lg bg-[color-mix(in_srgb,var(--accent)_14%,transparent)] text-xs font-black text-[var(--accent)]" aria-hidden="true">{String(i + 1).padStart(2, '0')}</span>
              <div>
                <p class="font-semibold text-[var(--text)]">{s.title}</p>
                <p class="mt-0.5 text-sm leading-relaxed text-[var(--text-dim)]">{s.desc}</p>
              </div>
            </li>
          ))}
        </ol>

        <div class="tilt-card mt-8 p-5" style="--card-color: var(--accent);">
          <h2 class="font-heading text-lg font-bold text-[var(--text)]">In the walkthrough you will see</h2>
          <ul class="mt-3 space-y-2" role="list">
            {youSee.map((item) => <li class="flex gap-2.5 text-sm text-[var(--text-dim)]"><span class="text-[var(--accent)]" aria-hidden="true">✓</span>{item}</li>)}
          </ul>
          {publicDemo && (
            <p class="mt-4 text-sm text-[var(--text-dim)]">Want a look first? The <a href={`/products/${publicDemo.slug}/`} class="font-semibold text-[var(--text)] underline underline-offset-4">{publicDemo.title}</a> also has a public demo.</p>
          )}
        </div>

        <p class="mt-6 text-sm text-[var(--text-dim)]">
          Prefer to talk now? WhatsApp <a href={`${COMPANY.whatsapp.href}?text=${encodeURIComponent('Hi eLan Technology, I would like a product walkthrough.')}`} target="_blank" rel="noopener noreferrer" class="font-semibold text-[var(--text)] underline underline-offset-4">{COMPANY.whatsapp.display}</a>{' '}
          or call <a href={COMPANY.officePhone.href} class="font-semibold text-[var(--text)] underline underline-offset-4">{COMPANY.officePhone.display}</a>.
        </p>
      </div>
    </div>
  </section>

  <section class="border-t border-[var(--border)] bg-[var(--bg-card)] py-10" aria-labelledby="demo-products-heading">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
      <h2 id="demo-products-heading" class="font-heading text-xl font-bold text-[var(--text)]">Not sure which product fits?</h2>
      <ul class="mt-4 flex flex-wrap gap-2" role="list">
        {products.map((p) => (
          <li><a href={`/products/${p.slug}/`} class="inline-flex min-h-10 items-center rounded-lg border border-[var(--border)] bg-[var(--bg)] px-4 py-2 text-sm font-semibold text-[var(--text)] transition hover:border-[var(--accent)]">{p.title}</a></li>
        ))}
        <li><a href="/products/" class="inline-flex min-h-10 items-center rounded-lg px-4 py-2 text-sm font-semibold text-[var(--accent)] underline underline-offset-4">Compare all products</a></li>
      </ul>
    </div>
  </section>
</BaseLayout>
