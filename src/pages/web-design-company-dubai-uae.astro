---
// UAE market page. A self-contained design (dark "night sky" hero, product screens in
// perspective, stacked product cards) that still keeps the page's honesty rules:
// no UAE client, office or deployment is claimed, Arabic needs a qualified specialist,
// and integrations are validated before they are promised. Copy that verify-build.mjs
// checks is marked "(checked)". Product screens are designed mock-ups with sample data.
import BaseLayout from '../layouts/BaseLayout.astro';
import Breadcrumb from '../components/Breadcrumb.astro';
import ServicesCloud from '../components/ServicesCloud.astro';
import InternationalFAQ from '../components/international/InternationalFAQ.astro';
import InternationalPrivacyNotice from '../components/international/InternationalPrivacyNotice.astro';
import JurisdictionCompliance from '../components/international/JurisdictionCompliance.astro';
import { Image } from 'astro:assets';
import { getCountryBySlug } from '../data/countries';
import { isIndexedLocationSlug } from '../data/indexPolicy';
import { products } from '../data/products';
import { serviceSchema, faqSchema, breadcrumbSchema } from '../utils/schema';

import shotInsurance from '../assets/uae/insurance.png';
import shotRealEstate from '../assets/uae/real-estate.png';
import shotResort from '../assets/uae/resort.png';
import shotConference from '../assets/uae/conference.png';
import shotSociety from '../assets/uae/society.png';
import shotPms from '../assets/uae/pms.png';
import shotCms from '../assets/uae/central-cms.png';
import visCommerce from '../assets/uae/vis-ecommerce.png';
import visCrm from '../assets/uae/vis-crm.png';
import visIntegrations from '../assets/uae/vis-integrations.png';
import siteHealthyGenie from '../assets/uae/site-healthygenie.png';
import siteRangresha from '../assets/uae/site-rangresha.png';
import videoPoster from '../assets/uae/dubai-video-poster.jpg';

const country = getCountryBySlug('dubai-uae')!;
const pageUrl = `/web-design-company-${country.slug}/`;
const title = 'Ecommerce & Business-System Implementation for UAE | eLan Technology';
const description = 'Shopify, Medusa.js, Zoho Commerce and custom CRM/ERP implementation for UAE businesses. India-based delivery with scoped Arabic/English interfaces and integrations.';
const introduction = 'Build a storefront and business workflows that work together. Our Nagpur studio delivers remotely, with Arabic/English scope, integrations, approvals and support agreed before development.';

const breadcrumbs = [
  { name: 'Home', href: '/' },
  { name: 'International', href: '/services/' },
  { name: country.name, href: pageUrl },
];
const schema = [
  serviceSchema(
    `Web Design & Development Services for ${country.name}`,
    `Web design, development, ecommerce and accessibility services for ${country.name} businesses, delivered remotely from eLan Technology's India studio.`,
    `https://elan-tech.net${pageUrl}`,
    country.name,
    'Country'
  ),
  breadcrumbSchema(breadcrumbs.map((b) => ({ name: b.name, url: b.href }))),
  ...(country.faq.length > 0 ? [faqSchema(country.faq)] : []),
];

// The Dubai visit band shows until the end of the trip (12 December 2026, noon in Dubai).
// A small script also hides it in the browser after that time, between deploys.
const TRIP_END = '2026-12-12T08:00:00Z';
const showTrip = Date.now() < Date.parse(TRIP_END);

// The Dubai introduction video. Paste the YouTube video ID here (the part after "v=" or
// after "youtu.be/") to play it from YouTube; YouTube loads only when the visitor presses
// play, through the privacy-enhanced youtube-nocookie.com player. While it is empty the
// page plays the self-hosted copy in public/videos/ instead.
const YOUTUBE_ID = '';

const whatsapp = 'https://wa.me/918788834630';
const platforms = ['Shopify', 'Medusa.js', 'Zoho Commerce', 'Payload CMS', 'Directus', 'ERPNext', 'Next.js', 'Astro', 'Node.js', 'NestJS', 'PostgreSQL', 'MySQL'];

const capabilities = [
  { title: 'Ecommerce that fits the operation', href: '/services/ecommerce/', text: 'Shopify, Medusa.js or Zoho Commerce implementation and customisation, selected around catalogue complexity, checkout requirements, subscriptions and the team maintaining the store.', image: visCommerce, span: 'lg:col-span-7' },
  { title: 'Business systems that connect the work', href: '/services/custom-crm-erp-solutions/', text: 'Custom CRM and ERP workflows, ERPNext customisation and scoped integrations for enquiries, approvals, stock and reporting. Discovery establishes which existing systems should remain.', image: visCrm, span: 'lg:col-span-5' },
  { title: 'Content across languages and channels', href: '/services/headless-cms-development/', text: 'Payload CMS or Directus for structured content and publishing permissions. English and Arabic content architecture, language switching and right-to-left interfaces can be separately scoped.', image: null, span: 'lg:col-span-5' },
  { title: 'Integrations, validated first', href: '/services/integrations/', text: 'Payment gateways, shipping, accounting and CRM connections are confirmed with each provider before a feature is promised.', image: visIntegrations, span: 'lg:col-span-7' },
];

// Which UAE buyers each product suits. Titles, links and stacks come from products.ts.
const sectorFit: Record<string, { sector: string; fit: string; shot: ImageMetadata; tint: string }> = {
  'insurance-agency-management-portal': { sector: 'Insurance agencies and brokers', fit: 'Policies, renewals, quotations, commissions, sub-agents and customer family records in one system.', shot: shotInsurance, tint: '16 185 129' },
  'real-estate-portal': { sector: 'Property agencies and developers', fit: 'Listings, advanced search, agent dashboards, maps and lead capture on a portal you control.', shot: shotRealEstate, tint: '0 180 140' },
  'resort-management-system': { sector: 'Hotels, resorts and holiday homes', fit: 'Online room booking, an occupancy dashboard, billing, and staff and housekeeping scheduling.', shot: shotResort, tint: '245 158 11' },
  'medical-conference-portal': { sector: 'Medical and professional conferences', fit: 'Delegate registration, abstract submission, speakers, schedules and certificates for conference organisers.', shot: shotConference, tint: '99 102 241' },
  'ima-society-portal': { sector: 'Membership associations and professional societies', fit: 'Memberships and renewals, events with online registration, documents and fee payments.', shot: shotSociety, tint: '236 72 153' },
  'project-management-system': { sector: 'Agencies and service firms', fit: 'Clients, projects, tasks, billing, enquiries and renewal reminders in one workspace.', shot: shotPms, tint: '96 165 250' },
  'elan-central-cms': { sector: 'Marketing and content teams', fit: 'Edit pages, posts and images in one dashboard, and publish fast static pages to your own hosting.', shot: shotCms, tint: '6 182 212' },
};
const productCards = Object.entries(sectorFit)
  .map(([slug, fit]) => {
    const product = products.find((item) => item.slug === slug);
    if (!product) return null;
    const stack = [...new Set((product.stack ?? []).flatMap((group) => group.items))].slice(0, 6);
    return { ...fit, title: product.title, href: `/products/${product.slug}/`, stack };
  })
  .filter((card): card is NonNullable<typeof card> => card !== null);

const workingFacts = [
  { icon: 'clock', title: 'Working hours', text: 'UAE time is 1.5 hours behind India, so most of the working day overlaps. Meeting windows and response times are agreed at kickoff.' },
  { icon: 'coins', title: 'Quoting currency', text: 'Proposals can be quoted in AED or USD. The proposal names the currency, what is included and any recurring charges.' },
  { icon: 'lang', title: 'Languages', text: 'Delivery is in English. Arabic content and right-to-left interfaces are scoped separately and reviewed by a qualified Arabic specialist.' },
  { icon: 'lock', title: 'Confidentiality', text: 'We can review a mutual NDA before sensitive project details are shared. Work delivered under NDA is not named or shown.', href: '/nda-confidentiality-policy/', linkLabel: 'NDA and confidentiality policy' },
];
const steps = [
  ['Discovery call', 'Your systems, languages, markets and the outcome your team needs.'],
  ['Written scope', 'A proposal that separates implementation, licences, hosting and support.'],
  ['Staged demos', 'Working software at agreed checkpoints, in your time zone.'],
  ['Acceptance and handover', 'Tests you sign off, source code, access and documentation.'],
];
const principles = [
  { title: 'Arabic / English: implementation is not translation', text: 'Agree the language coverage of pages, product data, forms, transactional messages and search metadata. We can implement RTL layouts and language switching; a qualified Arabic specialist must supply or approve translation, terminology and cultural review. Arabic-language support staffing is not assumed.' },
  { title: 'Integrations: validate before promising', text: 'Confirm payment-gateway eligibility, merchant onboarding, API access, shipping coverage, tax configuration and accounting or CRM interfaces before committing to a feature. Availability depends on the platform plan and provider. Tax and regulatory decisions remain with your qualified advisers.' },
  { title: 'Remote delivery with written checkpoints', text: 'Agree meeting windows, approval owners, staged demonstrations and acceptance tests at kickoff. Delivery dates depend on signed scope, content readiness and third-party access, not a blanket turnaround promise.' },
  { title: 'A proposal that separates the costs', text: 'Separate implementation, localisation, hosting, licences, API charges, maintenance and upgrades. Confirm source-code rights, application ownership, hosting location, data access and handover against the proposal and payment terms.' },
];
const ICONS: Record<string, string> = {
  clock: '<circle cx="12" cy="12" r="9"/><path d="M12 7v5l3 2"/>',
  coins: '<ellipse cx="9" cy="7" rx="6" ry="3"/><path d="M3 7v5c0 1.7 2.7 3 6 3s6-1.3 6-3V7"/><path d="M9 15v2c0 1.7 2.7 3 6 3s6-1.3 6-3v-5c0-1.7-2.7-3-6-3"/>',
  lang: '<path d="M4 5h8M8 3v2M5.5 5c.8 3 3 5.5 6 7M10.5 5c-.8 3-3 5.5-6 7"/><path d="M13 21l4-9 4 9M14.5 18h5"/>',
  lock: '<rect x="4" y="11" width="16" height="10" rx="2"/><path d="M8 11V7a4 4 0 0 1 8 0v4"/>',
};
---

<BaseLayout
  title={title}
  description={description}
  canonical={`https://elan-tech.net${pageUrl}`}
  ogImage="/images/og/uae.jpg"
  schema={schema}
  noindex={!isIndexedLocationSlug(country.slug)}
>
  <div class="uae">
    <!-- ───────────── Hero ───────────── -->
    <section class="sky hero" aria-labelledby="uae-title">
      <div class="stars" aria-hidden="true"></div>
      <div class="beam" aria-hidden="true"></div>
      <div class="wrap">
        <div class="crumbs"><Breadcrumb items={breadcrumbs} /></div>
        <p class="pill" data-reveal>
          <span aria-hidden="true">{country.flag}</span> Serving United Arab Emirates businesses
          {showTrip && <span class="pill-trip" data-trip> · Meet us in Dubai, 7–12 December</span>}
        </p>
        <h1 id="uae-title" class="display" data-reveal>
          Ecommerce &amp; business-system implementation <span class="grad">for UAE businesses</span>
        </h1>
        <p class="lead" data-reveal>{introduction}</p>
        <div class="ctas" data-reveal>
          <a href="/get-quote/" class="btn-glow">Scope my UAE project <span aria-hidden="true">→</span></a>
          <a href="/schedule-consultation/" class="btn-ghost">Book a call</a>
        </div>
        <ul class="trust" role="list" data-reveal>
          <li><b>24+</b> years in business</li>
          <li><b>500+</b> clients</li>
          <li><b>1,500+</b> projects delivered</li>
          <li><b>1.5 h</b> time difference</li>
        </ul>
      </div>

      <div class="stage" aria-hidden="true">
        <div class="screen-main">
          <Image src={shotInsurance} alt="" widths={[800, 1280, 2080]} sizes="(min-width: 1100px) 1040px, 94vw" loading="eager" fetchpriority="high" />
        </div>
        <div class="float f1"><Image src={shotRealEstate} alt="" widths={[480, 800]} sizes="360px" /></div>
        <div class="tag t1"><i></i>English <span class="ar" lang="ar" dir="rtl">العربية</span></div>
        <div class="tag t2"><i></i>Quoted in AED or USD</div>
        <div class="tag t3"><i></i>Shopify · Medusa.js · Zoho Commerce</div>
      </div>
      <p class="sample-note">Product screens are designed mock-ups with sample data.</p>
    </section>

    <!-- ───────────── Platforms ───────────── -->
    <section class="strip" aria-label="Platforms and technology we implement">
      <p>Platforms and technology we implement</p>
      <div class="marquee"><ul role="list">{[...platforms, ...platforms].map((p, i) => <li aria-hidden={i >= platforms.length ? 'true' : undefined}>{p}</li>)}</ul></div>
    </section>

    <!-- ───────────── Capabilities ───────────── -->
    <section class="band" aria-labelledby="uae-implementation">
      <div class="wrap">
        <p class="eyebrow" data-reveal>India-based implementation · UAE business requirements</p>
        <h2 id="uae-implementation" class="h2" data-reveal>Connect your storefront, content and business workflows.</h2>
        <p class="sub" data-reveal>Work remotely with our Nagpur studio. Start with the systems you operate, the languages your customers use and the outcomes your team needs.</p>
        <div class="bento">
          {capabilities.map((c) => (
            <article class={`card ${c.span}`} data-reveal>
              <div class="card-copy">
                <h3>{c.title}</h3>
                <p>{c.text}</p>
                <a href={c.href} class="more">Explore the service <span aria-hidden="true">→</span></a>
              </div>
              {c.image ? (
                <div class="card-art"><Image src={c.image} alt="" widths={[640, 1040]} sizes="(min-width: 1024px) 560px, 92vw" /></div>
              ) : (
                <div class="card-art bilingual" aria-hidden="true">
                  <div class="bl-bar"><span class="on">English</span><span lang="ar" dir="rtl">العربية</span></div>
                  <div class="bl-cols">
                    <div class="bl-col"><i style="width:70%"></i><i style="width:92%"></i><i style="width:55%"></i><b></b></div>
                    <div class="bl-col rtl"><i style="width:70%"></i><i style="width:92%"></i><i style="width:55%"></i><b></b></div>
                  </div>
                  <p class="bl-cap">Left-to-right and right-to-left layouts from one content model</p>
                </div>
              )}
            </article>
          ))}
        </div>
      </div>
    </section>

    {/* Dubai visit (until 12 December 2026) */}
    {showTrip && (
      <section class="sky visit" aria-labelledby="uae-visit" data-trip>
        <div class="stars" aria-hidden="true"></div>
        <div class="spot" aria-hidden="true"></div>
        <div class="wrap visit-grid">
          <div data-reveal>
            <p class="eyebrow light">In Dubai · 7–12 December 2026</p>
            <h2 id="uae-visit" class="h2 light">Meet us in Dubai.</h2>
            <p class="sub light">We are in Dubai from noon on 7 December to noon on 12 December (Dubai time) for meetings with business owners and teams. Book a time to talk about your store, portal or business system.</p>
            <div class="ctas">
              <a href="/schedule-consultation/" class="btn-glow">Book a meeting in Dubai <span aria-hidden="true">→</span></a>
              <a href={`${whatsapp}?text=${encodeURIComponent('Hi Nishant, I would like to meet in Dubai between 7 and 12 December.')}`} target="_blank" rel="noopener noreferrer" data-analytics-placement="uae-visit" class="btn-ghost">Message on WhatsApp<span class="sr-only"> (opens in a new tab)</span></a>
            </div>
          </div>
          <figure class="video" data-reveal>
            {YOUTUBE_ID ? (
              <a class="yt" href={`https://www.youtube.com/watch?v=${YOUTUBE_ID}`} data-yt={YOUTUBE_ID} target="_blank" rel="noopener noreferrer">
                <Image src={videoPoster} alt="" widths={[640, 1280]} sizes="(min-width: 1024px) 620px, 92vw" />
                <span class="yt-play" aria-hidden="true"><svg viewBox="0 0 24 24"><path d="M8 5.5v13l11-6.5z" /></svg></span>
                <span class="sr-only">Play the 90-second introduction video (YouTube)</span>
              </a>
            ) : (
              <video controls playsinline preload="none" poster="/videos/elan-dubai-introduction.jpg">
                <source src="/videos/elan-dubai-introduction.mp4" type="video/mp4" />
                <a href="/videos/elan-dubai-introduction.mp4">Watch the introduction (MP4)</a>
              </video>
            )}
            <figcaption>Our 90-second introduction: every service and product, built in Nagpur since 2002.</figcaption>
          </figure>
        </div>
      </section>
    )}

    <!-- ───────────── Products ───────────── -->
    <section class="band alt" aria-labelledby="uae-products">
      <div class="wrap">
        <p class="eyebrow" data-reveal>Ready-built foundations</p>
        <h2 id="uae-products" class="h2" data-reveal>Products that fit UAE sectors</h2>
        <p class="sub" data-reveal>Each product is a working foundation that we adapt to the client, so a project starts from tested software and not from a blank page. They were built for Indian businesses first. UAE requirements such as Arabic, VAT, local payment providers, insurer products and sector rules are scoped for each implementation.</p>
        <ul class="stack" role="list">
          {productCards.map((card, i) => (
            <li class="pcard" style={`--tint:${card.tint};--i:${i}`}>
              <div class="pcard-copy">
                <p class="pcard-n">{String(i + 1).padStart(2, '0')} · {card.sector}</p>
                <h3>{card.title}</h3>
                <p class="pcard-fit">{card.fit}</p>
                {card.stack.length > 0 && (
                  <ul class="chips" role="list" aria-label={`${card.title} technology`}>
                    {card.stack.map((item) => <li>{item}</li>)}
                  </ul>
                )}
                <a href={card.href} class="more">See the {card.title} <span aria-hidden="true">→</span></a>
              </div>
              <div class="pcard-shot">
                <Image src={card.shot} alt={`${card.title} screen with sample data`} widths={[640, 1040, 1600]} sizes="(min-width: 1024px) 640px, 92vw" />
              </div>
            </li>
          ))}
        </ul>
      </div>
    </section>

    <!-- ───────────── How we work ───────────── -->
    <section class="band" aria-labelledby="uae-working">
      <div class="wrap">
        <p class="eyebrow" data-reveal>Working with a UAE team</p>
        <h2 id="uae-working" class="h2" data-reveal>What a UAE business can expect from us</h2>
        <ul class="facts" role="list">
          {workingFacts.map((fact) => (
            <li class="fact" data-reveal>
              <span class="ico" aria-hidden="true"><svg viewBox="0 0 24 24" set:html={ICONS[fact.icon]} /></span>
              <h3>{fact.title}</h3>
              <p>{fact.text}</p>
              {fact.href && <a href={fact.href} class="more">{fact.linkLabel} <span aria-hidden="true">→</span></a>}
            </li>
          ))}
        </ul>

        <ol class="steps" role="list" data-reveal>
          {steps.map(([name, text], i) => (
            <li><span class="dot">{i + 1}</span><b>{name}</b><span>{text}</span></li>
          ))}
        </ol>

        <div class="principles">
          {principles.map((p) => (
            <article data-reveal><h3>{p.title}</h3><p>{p.text}</p></article>
          ))}
        </div>
      </div>
    </section>

    <!-- ───────────── Relevant work ───────────── -->
    <section class="band alt" aria-labelledby="uae-work">
      <div class="wrap">
        <p class="eyebrow" data-reveal>Platform experience</p>
        <h2 id="uae-work" class="h2" data-reveal>Relevant work—not UAE client claims</h2>
        <p class="sub" data-reveal>Rangresha’s Shopify storefront and Healthy Genie’s Medusa.js commerce implementation show our platform experience. These projects are not presented as UAE deployments or guarantees of results.</p>
        <div class="work">
          <a href="https://healthygenie.in/" target="_blank" rel="noopener noreferrer" class="wcard" data-reveal>
            <div class="wshot"><Image src={siteHealthyGenie} alt="Healthy Genie website home page" widths={[640, 1040, 1440]} sizes="(min-width: 1024px) 560px, 92vw" /></div>
            <p class="wmeta"><b>Healthy Genie</b> · Medusa.js commerce · meal plans and subscriptions <span aria-hidden="true">↗</span><span class="sr-only"> (opens in a new tab)</span></p>
          </a>
          <a href="https://rangresha.com/" target="_blank" rel="noopener noreferrer" class="wcard" data-reveal>
            <div class="wshot"><Image src={siteRangresha} alt="Rangresha website home page" widths={[640, 1040, 1440]} sizes="(min-width: 1024px) 560px, 92vw" /></div>
            <p class="wmeta"><b>Rangresha</b> · Shopify storefront · handcrafted products <span aria-hidden="true">↗</span><span class="sr-only"> (opens in a new tab)</span></p>
          </a>
        </div>
        <div class="links" data-reveal>
          <a href="/blog/ecommerce/shopify-vs-medusa-js-2026/" class="more">Compare the operating costs of Shopify and Medusa.js <span aria-hidden="true">→</span></a>
          <a href="/blog/ecommerce/uae-ecommerce-implementation-checklist/" class="more">Read the UAE ecommerce checklist <span aria-hidden="true">→</span></a>
        </div>
      </div>
    </section>

    <InternationalFAQ country={country} />

    <!-- ───────────── For legal, privacy and procurement teams ───────────── -->
    <section class="band legal" aria-labelledby="uae-legal">
      <div class="wrap">
        <details>
          <summary>
            <span>
              <span class="eyebrow">For legal, privacy and procurement teams</span>
              <span id="uae-legal" class="legal-title">Privacy, data and compliance details</span>
            </span>
            <span class="plus" aria-hidden="true"></span>
          </summary>
          <div class="legal-body">
            <InternationalPrivacyNotice country={country} />
            <JurisdictionCompliance country={country} />
          </div>
        </details>
      </div>
    </section>

    <!-- ───────────── Final call to action ───────────── -->
    <section class="sky finale" aria-labelledby="uae-cta">
      <div class="stars" aria-hidden="true"></div>
      <div class="spot" aria-hidden="true"></div>
      <div class="wrap center">
        <p class="eyebrow light" data-reveal>eLan Technology · Nagpur, India · since 2002</p>
        <h2 id="uae-cta" class="h2 light big" data-reveal>Let’s scope your UAE project.</h2>
        <p class="sub light center" data-reveal>Tell us what you sell, the systems you use and the languages your customers need. You get a written proposal, quoted per project, before any work starts. Initial replies are normally sent within one business day.</p>
        <div class="ctas center" data-reveal>
          <a href="/get-quote/" class="btn-glow">Scope my UAE project <span aria-hidden="true">→</span></a>
          <a href={whatsapp} target="_blank" rel="noopener noreferrer" data-analytics-placement="uae-final" class="btn-ghost">Message us on WhatsApp<span class="sr-only"> (opens in a new tab)</span></a>
          <a href="/schedule-consultation/" class="btn-ghost">Book a call</a>
        </div>
        <p class="tiny light" data-reveal><a href="/technologies/">Technologies we build with</a> · <a href="/products/">All products</a> · <a href="/portfolio/">Portfolio</a></p>
      </div>
    </section>

    <ServicesCloud location={country.name} />
  </div>

  <script is:inline define:vars={{ TRIP_END }}>
    (function () {
      if (Date.now() >= Date.parse(TRIP_END)) document.querySelectorAll('[data-trip]').forEach(function (el) { el.remove(); });
      // Click-to-play YouTube: swap the preview for the player only when asked.
      document.querySelectorAll('.uae a[data-yt]').forEach(function (link) {
        link.addEventListener('click', function (event) {
          event.preventDefault();
          var frame = document.createElement('iframe');
          frame.src = 'https://www.youtube-nocookie.com/embed/' + encodeURIComponent(link.getAttribute('data-yt')) + '?autoplay=1&rel=0&playsinline=1';
          frame.title = 'eLan Technology: 90-second introduction';
          frame.allow = 'autoplay; encrypted-media; picture-in-picture; fullscreen';
          frame.allowFullscreen = true;
          frame.className = 'yt-frame';
          link.replaceWith(frame);
        });
      });
      var reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
      if (reduce || !('IntersectionObserver' in window)) return;
      document.documentElement.classList.add('uae-reveal');
      var io = new IntersectionObserver(function (entries) {
        entries.forEach(function (e) { if (e.isIntersecting) { e.target.classList.add('is-in'); io.unobserve(e.target); } });
      }, { rootMargin: '0px 0px -8% 0px', threshold: 0.08 });
      document.querySelectorAll('.uae [data-reveal]').forEach(function (el) { io.observe(el); });
    })();
  </script>
</BaseLayout>

<style>
  .uae {
    --ink: #eef0ff;
    --ink-dim: rgba(226, 230, 255, 0.72);
    --indigo: #6366f1;
    --violet: #8b5cf6;
    --sky: #05061a;
    --u-accent: #4f46e5;
    --u-card: var(--bg-card);
  }
  :global(html.dark) .uae { --u-accent: #a5b4fc; }
  .wrap { max-width: 76rem; margin: 0 auto; padding: 0 1rem; position: relative; }
  @media (min-width: 640px) { .wrap { padding: 0 1.5rem; } }
  @media (min-width: 1024px) { .wrap { padding: 0 2rem; } }
  .center { text-align: center; margin-left: auto; margin-right: auto; }

