---
import BaseLayout from '../layouts/BaseLayout.astro';
import { breadcrumbSchema, faqSchema } from '../utils/schema';
import RazorpayPaymentGate from '../components/RazorpayPaymentGate.astro';
import FreeAuditForm from '../islands/FreeAuditForm';
const RAZORPAY_AUDIT_INR = 'pl_Sqm5fZAebJ6xx7';
const RAZORPAY_AUDIT_USD = 'pl_FdcrA4b2oE0mIl';
const faqs = [
  { question: 'What does the free website audit check?', answer: 'We review the public homepage and representative pages for search visibility foundations, mobile usability, loading behaviour, obvious broken journeys and publicly visible HTTPS/security-header signals. Findings are prioritised with suggested next steps. It is an initial review, not an exhaustive crawl, penetration test or formal accessibility certification.' },
  { question: 'How long does it take?', answer: 'We aim to send the initial findings within two business days after reviewing your request and confirming access and scope. If the website is complex or cannot be reached, we will discuss a different schedule. This is a target, not a guaranteed turnaround.' },
  { question: 'Do I need to share a password?', answer: 'No. The free review uses public pages. Do not send passwords, customer records or confidential documents through the form. Any later access to Analytics, Search Console or the CMS is separately authorised and limited to the agreed work.' },
  { question: 'Is it really free?', answer: 'The initial public-page review is free and does not oblige you to buy development or maintenance. One free review per domain every 90 days applies. Remediation, a larger crawl, formal accessibility testing or security testing requires a separate agreed scope and quotation.' },
  { question: 'What happens after I submit?', answer: 'We review your website URL and selected concerns, confirm any scope questions, then send prioritised findings to the email you provide. You may implement them yourself, use your existing developer or request a separate quotation from us.' },
  { question: 'Will the audit guarantee rankings or identify every vulnerability?', answer: 'No. Rankings depend on many factors beyond a technical review. Public-page checks cannot establish that a website is secure, detect every vulnerability or prove legal compliance. Intrusive testing requires explicit written authorisation and a separate scope.' },
  { question: 'Can you review accessibility?', answer: 'The free review may highlight obvious usability or accessibility issues. A formal WCAG review with representative journeys, keyboard and assistive-technology testing and remediation evidence is a separately scoped paid service.' },
];
const checks = [
  { title: 'Search foundations', text: 'Public titles, descriptions, headings, canonical and indexability signals, sitemap/robots availability and representative internal links.', note: 'Search Console history and ranking causes need authorised account data.' },
  { title: 'Speed and mobile journeys', text: 'Representative page loading, image weight, layout shifts, readable content and navigation or enquiry journeys on mobile.', note: 'Lab tests are snapshots. Field data is used when available; it is not available for every site.' },
  { title: 'Public security signals', text: 'HTTPS behaviour and publicly returned security headers, with issues described in context.', note: 'No password testing, exploitation, private-data access or vulnerability-scanning promise.' },
  { title: 'Enquiry friction', text: 'Visible calls to action, form labels, error guidance, contact links and consent choices.', note: 'Inbox delivery requires a separately agreed test, not just a successful-looking form.' },
];
const schemas = [breadcrumbSchema([{name:'Home',url:'/'},{name:'Free Website Audit',url:'/free-website-audit/'}]), faqSchema(faqs), {
  '@context':'https://schema.org', '@type':'Service', name:'Free initial website review',
  provider:{'@type':'Organization',name:'eLan Technology',url:'https://elan-tech.net/'},
  description:'Initial review of public website pages with prioritised findings. Remediation and deeper testing are separately scoped.',
  offers:{'@type':'Offer',price:'0',priceCurrency:'INR',url:'https://elan-tech.net/free-website-audit/'}
}];
---
<BaseLayout ogImage="/images/og/audit.png" title="Free Website Audit: Scope, Findings & Next Steps | eLan Technology" description="Request a free initial review of your website’s SEO foundations, mobile experience, speed and public security signals. See the scope, turnaround and next steps." canonical="/free-website-audit/" schema={schemas}>
  <section class="relative overflow-hidden border-b border-[var(--border)] bg-[var(--bg-card)] py-16 md:py-24">
    <div class="mx-auto grid max-w-7xl gap-10 px-4 sm:px-6 lg:grid-cols-[1.2fr_1fr] lg:px-8">
      <div>
        <p class="text-xs font-bold uppercase tracking-[.2em] text-[var(--accent)]">Clarity before a rebuild</p>
        <h1 class="mt-4 font-heading text-4xl font-bold leading-tight sm:text-5xl">A free website audit with a clear scope—and a useful next step.</h1>
        <p class="mt-6 text-lg leading-relaxed text-[var(--text-dim)]">Tell us what is not working. We review your public homepage and representative pages, then explain the priority issues, why they matter and what to do next. No password required. No obligation to buy.</p>
        <div class="mt-7 flex flex-wrap gap-3">
          <a href="#audit-form" class="rounded-xl bg-[var(--accent)] px-6 py-3 font-semibold text-white">Request my free review</a>
          <a href="#what-you-get" class="rounded-xl border border-[var(--border)] px-6 py-3 font-semibold">See exactly what is checked</a>
        </div>
      </div>
      <aside class="rounded-2xl border border-[var(--border)] bg-[var(--bg)] p-7">
        <h2 class="font-heading text-xl font-bold">What you receive</h2>
        <ul class="mt-5 space-y-4 text-[var(--text-dim)]">
          <li>✓ A short, prioritised findings report sent by email</li>
          <li>✓ Observations, affected pages and practical next steps</li>
          <li>✓ Clear separation between quick fixes and deeper investigations</li>
          <li>✓ An optional, separately scoped implementation quotation</li>
        </ul>
        <p class="mt-6 border-t border-[var(--border)] pt-5 text-sm"><strong>Timing:</strong> we aim for two business days after scope/access confirmation. Complex or unreachable sites may need a revised schedule.</p>
      </aside>
    </div>
  </section>
  <section id="what-you-get" class="py-16">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
      <p class="text-xs font-bold uppercase tracking-widest text-[var(--accent)]">An initial review—not an unlimited audit</p>
      <h2 class="mt-3 font-heading text-3xl font-bold">Four areas that affect a business website</h2>
      <div class="mt-8 grid gap-5 md:grid-cols-2">{checks.map((check,index) => <article class="rounded-2xl border border-[var(--border)] bg-[var(--bg-card)] p-6">
        <p class="text-sm font-bold text-[var(--accent)]">0{index+1}</p><h3 class="mt-2 font-heading text-xl font-bold">{check.title}</h3>
        <p class="mt-3 leading-relaxed text-[var(--text-dim)]">{check.text}</p><p class="mt-4 text-sm text-[var(--text-muted)]">{check.note}</p>
      </article>)}</div>
      <p class="mt-6 rounded-xl border border-[var(--border)] p-5 text-sm leading-relaxed"><strong>Not included:</strong> an exhaustive site crawl, private account access, penetration testing, malware removal, remediation, formal WCAG certification or a promise of higher rankings. Do not submit passwords or personal customer data. These require separate written scope and authorisation.</p>
    </div>
  </section>
  <section class="border-y border-[var(--border)] bg-[var(--bg-card)] py-14">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
      <h2 class="font-heading text-3xl font-bold">From request to a decision</h2>
      <div class="mt-8 grid gap-6 md:grid-cols-3">
        <article><h3 class="font-semibold">1. Share the URL and concern</h3><p class="mt-3 text-[var(--text-dim)]">Select your priorities and provide an email for the findings. Tell us whether you manage the website or are authorised to request the review.</p></article>
        <article><h3 class="font-semibold">2. We review and prioritise</h3><p class="mt-3 text-[var(--text-dim)]">We check representative public pages and flag the scope or access questions that need your input. Findings distinguish evidence from assumptions.</p></article>
        <article><h3 class="font-semibold">3. Choose your next step</h3><p class="mt-3 text-[var(--text-dim)]">Use the findings with your own developer, ask for clarification or request our scoped quotation. Fixes are never billed without agreement.</p></article>
      </div>
      <a class="mt-6 inline-block font-semibold text-[var(--accent)] underline" href="/blog/web-design/website-audit-findings-explained/">How to read and prioritise website audit findings</a>
    </div>
  </section>
  <section id="audit-form" class="scroll-mt-28 py-16">
    <div class="mx-auto max-w-3xl px-4 sm:px-6">
      <h2 class="font-heading text-3xl font-bold">Request your free initial review</h2>
      <p class="mb-8 mt-4 text-[var(--text-dim)]">One free review per domain every 90 days. We use your details to respond to this request—not to enrol you in a newsletter. Read the form notice before submitting.</p>
      <FreeAuditForm client:load />
    </div>
  </section>
  <section id="paid-wcag-audit" class="py-16 md:py-20 bg-[var(--bg-card)] border-t border-[var(--border)] scroll-mt-20" aria-labelledby="ada-heading">
    <div class="mx-auto max-w-5xl px-4 sm:px-6 lg:px-8">
      <article
        class="service-card relative overflow-hidden rounded-2xl border border-[var(--border)] p-8 md:p-12"
        style="background: linear-gradient(135deg, color-mix(in srgb, var(--ac-blue) 12%, var(--bg-card)) 0%, var(--bg-card) 65%);"
      >
        <span aria-hidden="true" class="service-card__num pointer-events-none absolute top-4 right-6 font-heading font-black leading-none select-none" style="color: var(--ac-blue); font-size: 7rem;">+</span>
        <span aria-hidden="true" class="service-card__stripe pointer-events-none absolute -left-12 -bottom-12 h-60 w-60 rotate-[-20deg] opacity-[0.08]" style="background: var(--ac-blue);"></span>

        <div class="relative grid md:grid-cols-2 gap-8 items-start">
          <div>
            <span class="text-[10px] font-bold uppercase tracking-[0.2em]" style="color: var(--ac-blue);">Premium add-on</span>
            <h2 id="ada-heading" class="font-heading text-2xl md:text-3xl font-bold text-[var(--text)] mt-1 mb-3">
              ADA &amp; WCAG 2.2 AA Accessibility Audit
            </h2>
            <p class="text-[var(--text-dim)] mb-5">
              A separately scoped accessibility review of agreed pages and key journeys. Confirm coverage, manual testing, documentation and exclusions before payment. This is technical guidance, not legal advice or a guarantee of compliance.
            </p>
            <ul class="grid grid-cols-1 sm:grid-cols-2 gap-x-5 gap-y-2" role="list">
              {[
                'Colour contrast & typography audit',
                'ARIA, roles & landmark review',
                'Keyboard navigation flow',
                'Screen reader testing (NVDA/JAWS)',
                'Form accessibility',
                'Image alt-text coverage',
                'Video captions & transcripts',
                'VPAT 2.5 documentation',
              ].map((i) => (
                <li class="flex items-start gap-2 text-sm text-[var(--text)]">
                  <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="var(--ac-blue)" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" class="flex-shrink-0 mt-0.5" aria-hidden="true"><polyline points="20 6 9 17 4 12"/></svg>
                  {i}
                </li>
              ))}
            </ul>
          </div>

          <div class="md:pl-6 md:border-l md:border-[var(--border)]">
            <div class="mb-5 text-center">
              <p class="text-xs font-semibold uppercase tracking-[0.2em] text-[var(--text-muted)]">Flat fee · one public domain</p>
              <div class="mt-3 grid grid-cols-2 gap-3">
                <div class="rounded-xl border border-[var(--border)] bg-[var(--bg)] p-3">
                  <p class="font-heading text-2xl font-extrabold" style="color:var(--ac-blue);">₹9,999</p>
                  <p class="mt-1 text-[11px] text-[var(--text-muted)]">Indian billing</p>
                </div>
                <div class="rounded-xl border border-[var(--border)] bg-[var(--bg)] p-3">
                  <p class="font-heading text-2xl font-extrabold" style="color:var(--ac-blue);">$99</p>
                  <p class="mt-1 text-[11px] text-[var(--text-muted)]">International billing</p>
                </div>
              </div>
              <p class="mt-3 text-xs leading-relaxed text-[var(--text-muted)]">Detailed PDF report with WCAG 2.2 AA findings, severity ratings, code-level remediation guidance and a VPAT template.</p>
            </div>
            <RazorpayPaymentGate
              instanceId="paid-accessibility-audit"
              inrButtonId={RAZORPAY_AUDIT_INR}
              usdButtonId={RAZORPAY_AUDIT_USD}
              eyebrow="Paid audit checkout"
              noticeLead="Use this checkout only for the one-domain paid accessibility audit described here. Contact us before payment if the website requires a login, covers multiple domains or needs an urgent schedule."
              currencyHelp="Choose INR for Indian billing or USD for international billing."
              noticeVersion="paid-audit-payment-2026-09-24"
            />
          </div>
        </div>
      </article>
    </div>
  </section>

  <!-- ══════════════════════════════════════════════════════════════════════
       FAQ - schema-backed long-tail question targeting
       ══════════════════════════════════════════════════════════════════════ -->

  <section class="py-16">
    <div class="mx-auto max-w-4xl px-4 sm:px-6">
      <h2 class="mb-8 font-heading text-3xl font-bold">Before you request an audit</h2>
      {faqs.map(faq => <details class="border-b border-[var(--border)] py-5"><summary class="cursor-pointer font-semibold">{faq.question}</summary><p class="mt-4 leading-relaxed text-[var(--text-dim)]">{faq.answer}</p></details>)}
    </div>
  </section>
</BaseLayout>
