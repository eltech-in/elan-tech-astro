---
import BaseLayout from './BaseLayout.astro';
import Breadcrumb from '../components/Breadcrumb.astro';
import LocationsCloud from '../components/LocationsCloud.astro';
import { services as serviceCatalog } from '../data/services';

interface Props {
  title: string;
  description: string;
  canonical?: string;
  ogImage?: string;
  ogType?: string;
  noindex?: boolean;
  schema?: object | object[];
  breadcrumbs: Array<{ name: string; href: string }>;
  accentVar?: string;
  serviceNumber?: string;
  serviceLabel?: string;
}

const {
  title,
  description,
  canonical,
  ogImage,
  ogType,
  noindex,
  schema,
  breadcrumbs,
  accentVar,
  serviceNumber,
  serviceLabel,
} = Astro.props;

const currentPath = Astro.url.pathname;

const navigation = [
  ...serviceCatalog.slice(0, -1).map((service, index) => ({
    label: service.shortTitle,
    fullLabel: service.title,
    href: `/services/${service.slug}/`,
    cssVar: service.cssVar,
    number: String(index + 1).padStart(2, '0'),
    iconSvg: service.iconSvg,
  })),
  {
    label: 'Integrations',
    fullLabel: 'API & Integrations',
    href: '/services/integrations/',
    cssVar: '--ac-cyan',
    number: '09',
    iconSvg: '<svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M21 8a2 2 0 0 0-1-1.73l-7-4a2 2 0 0 0-2 0l-7 4A2 2 0 0 0 3 8v8a2 2 0 0 0 1 1.73l7 4a2 2 0 0 0 2 0l7-4A2 2 0 0 0 21 16Z"/><path d="m3.3 7 8.7 5 8.7-5"/><path d="M12 22V12"/></svg>',
  },
  {
    label: 'Accessibility',
    fullLabel: 'ADA & WCAG Compliance',
    href: '/services/ada-compliant-web-design/',
    cssVar: '--ac-blue',
    number: '10',
    iconSvg: serviceCatalog.at(-1)?.iconSvg ?? '',
  },
];

const specialThemes = [
  {
    path: '/services/ecommerce/shopify-development/',
    label: 'Custom Shopify Development',
    cssVar: '--ac-emerald',
    number: '03A',
  },
  {
    path: '/services/ecommerce/medusa-js-development/',
    label: 'Medusa.js Development',
    cssVar: '--ac-cyan',
    number: '03B',
  },
  {
    path: '/services/ada-compliant-web-design/emergency-remediation/',
    label: 'Emergency ADA Remediation',
    cssVar: '--ac-red',
    number: '10A',
  },
];

const specialTheme = specialThemes.find((theme) => currentPath.startsWith(theme.path));
const activeNavigation = navigation.find((item) => currentPath.startsWith(item.href));
const activeTheme = {
  label: serviceLabel ?? specialTheme?.label ?? activeNavigation?.fullLabel ?? 'Digital Services',
  cssVar: accentVar ?? specialTheme?.cssVar ?? activeNavigation?.cssVar ?? '--accent',
  number: serviceNumber ?? specialTheme?.number ?? activeNavigation?.number ?? '00',
};
---

<BaseLayout
  title={title}
  description={description}
  canonical={canonical}
  ogImage={ogImage}
  ogType={ogType}
  noindex={noindex}
  schema={schema}
>
  <div
    class="service-canvas"
    style={`--service-accent: var(${activeTheme.cssVar});`}
  >
    <div class="service-sticky sticky top-[68px] sm:top-[76px] z-40 border-b border-[var(--border)] bg-[var(--bg)]/95 px-4 py-2 backdrop-blur-xl sm:px-6 lg:px-8">
      <div class="mx-auto max-w-7xl">
        <div class="flex items-center justify-between gap-4">
          <Breadcrumb items={breadcrumbs} />
          <span class="hidden shrink-0 items-center gap-2 text-[9px] font-bold uppercase tracking-[0.16em] text-[var(--text-muted)] md:inline-flex">
            <span class="h-1.5 w-1.5 rounded-full bg-[var(--service-accent)]" aria-hidden="true"></span>
            {activeTheme.number} · {activeTheme.label}
          </span>
        </div>

        <nav aria-label="Explore all services" class="mt-2">
          <ul class="service-switcher grid gap-1 lg:grid-cols-10" role="list">
          {navigation.map((item) => {
            const isActive = currentPath.startsWith(item.href);
            return (
              <li>
                <a
                  href={item.href}
                  aria-current={isActive ? 'page' : undefined}
                  class:list={['service-switcher__item group', isActive && 'is-active']}
                  style={`--item-accent: var(${item.cssVar});`}
                >
                  <span class="service-switcher__icon" aria-hidden="true"><span set:html={item.iconSvg} /></span>
                  <span class="min-w-0">
                    <span class="block text-[8px] font-bold uppercase tracking-[0.14em] text-[var(--item-accent)]">{item.number}</span>
                    <span class="block truncate text-[11px] font-semibold leading-tight text-[var(--text)]">{item.label}</span>
                  </span>
                </a>
              </li>
            );
          })}
          </ul>
        </nav>
      </div>
    </div>

    <div class="mx-auto max-w-7xl px-4 pb-12 pt-6 sm:px-6 lg:px-8 lg:pb-20 lg:pt-8">
      <main class="service-bento-flow" data-service={activeTheme.label}>
        <slot />
      </main>
    </div>
  </div>

  <LocationsCloud
    intro="We deliver this service for businesses across India and internationally - from our Nagpur HQ to clients in the USA, UAE, Canada, Australia and beyond."
  />
</BaseLayout>

<style>
  .service-canvas {
    background:
      radial-gradient(circle at 8% 10%, color-mix(in srgb, var(--service-accent) 8%, transparent), transparent 28rem),
      radial-gradient(circle at 92% 35%, color-mix(in srgb, var(--service-accent) 5%, transparent), transparent 24rem),
      var(--bg);
  }

  .service-switcher__item {
    display: flex;
    min-height: 2.85rem;
    align-items: center;
    gap: 0.45rem;
    overflow: hidden;
    border: 1px solid var(--border);
    border-radius: 0.7rem;
    padding: 0.35rem 0.45rem;
    background: linear-gradient(135deg, color-mix(in srgb, var(--item-accent) 5%, var(--bg-card)), var(--bg-card) 70%);
    box-shadow: 0 8px 22px -22px var(--item-accent);
    transition: border-color 180ms ease, transform 180ms ease, box-shadow 180ms ease;
  }

  .service-switcher__item:hover,
  .service-switcher__item:focus-visible,
  .service-switcher__item.is-active {
    border-color: color-mix(in srgb, var(--item-accent) 55%, var(--border));
    box-shadow: 0 12px 26px -22px var(--item-accent);
    transform: translateY(-1px);
    outline: none;
  }

  .service-switcher__item.is-active {
    background: linear-gradient(135deg, color-mix(in srgb, var(--item-accent) 15%, var(--bg-card)), var(--bg-card) 72%);
  }

  .service-switcher__icon {
    display: inline-flex;
    height: 1.75rem;
    width: 1.75rem;
    flex: 0 0 auto;
    align-items: center;
    justify-content: center;
    border-radius: 0.55rem;
    color: var(--item-accent);
    background: color-mix(in srgb, var(--item-accent) 12%, transparent);
  }

  :global(.service-switcher__icon svg) {
    width: 1rem;
    height: 1rem;
  }

  .service-bento-flow {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: clamp(3rem, 6vw, 5.5rem);
  }

  :global(.service-bento-flow > section) {
    position: relative;
    margin: 0 !important;
  }

  :global(.service-bento-flow > section:first-child) {
    isolation: isolate;
    overflow: hidden;
    min-height: auto;
    border: 1px solid color-mix(in srgb, var(--service-accent) 30%, var(--border)) !important;
    border-radius: clamp(1.4rem, 2.6vw, 2rem) !important;
    padding: clamp(1.5rem, 4vw, 3.5rem) !important;
    border-color: color-mix(in srgb, var(--service-accent) 28%, var(--border)) !important;
    background-image:
      linear-gradient(color-mix(in srgb, var(--service-accent) 4%, transparent) 1px, transparent 1px),
      linear-gradient(90deg, color-mix(in srgb, var(--service-accent) 4%, transparent) 1px, transparent 1px),
      radial-gradient(circle at 90% 5%, color-mix(in srgb, var(--service-accent) 22%, transparent), transparent 22rem),
      linear-gradient(135deg, color-mix(in srgb, var(--service-accent) 8%, var(--bg-card)), var(--bg-card) 66%) !important;
    background-size: 32px 32px, 32px 32px, auto, auto !important;
    box-shadow: 0 36px 80px -66px var(--service-accent);
  }

  :global(.service-bento-flow > section:first-child::after) {
    content: '';
    position: absolute;
    inset: 0 18% auto 18%;
    height: 2px;
    background: linear-gradient(90deg, transparent, var(--service-accent), transparent);
    opacity: 0.9;
  }

  :global(.service-bento-flow > section:first-child .service-card__num),
  :global(.service-bento-flow > section:first-child .service-card__stripe) {
    display: none;
  }

  :global(.service-bento-flow > section:first-child h1) {
    max-width: 20ch;
    font-size: clamp(2.25rem, 4.5vw, 3.75rem);
    line-height: 1.08;
    letter-spacing: -0.035em;
    text-wrap: balance;
  }

  :global(.service-bento-flow > section:first-child .service-hero-grid) {
    display: grid;
    gap: clamp(1.5rem, 4vw, 3.5rem);
    align-items: center;
  }

  :global(.service-bento-flow > section:first-child .service-hero-aside) {
    border: 1px solid color-mix(in srgb, var(--service-accent) 22%, var(--border));
    border-radius: 1.5rem;
    padding: clamp(1rem, 2vw, 1.5rem);
    background: color-mix(in srgb, var(--service-accent) 6%, var(--bg));
    backdrop-filter: blur(12px);
  }

  :global(.service-bento-flow > section > h2),
  :global(.service-bento-flow > section > div > h2) {
    max-width: 48rem;
    text-wrap: balance;
  }

  :global(.service-bento-flow section .grid > :is(div, article, a, li)[class*='rounded'][class*='border']),
  :global(.service-bento-flow section > :is(div, article, a)[class*='rounded'][class*='border']) {
    transition: border-color 180ms ease, transform 180ms ease, box-shadow 180ms ease;
  }

  :global(.service-bento-flow section .grid > :is(div, article, a, li)[class*='rounded'][class*='border']:hover),
  :global(.service-bento-flow section > :is(div, article, a)[class*='rounded'][class*='border']:hover) {
    border-color: color-mix(in srgb, var(--service-accent) 35%, var(--border));
    box-shadow: 0 20px 38px -34px var(--service-accent);
    transform: translateY(-2px);
  }

  :global(.service-bento-flow details) {
    border-color: color-mix(in srgb, var(--service-accent) 12%, var(--border));
  }

  :global(.service-bento-flow summary:focus-visible),
  :global(.service-bento-flow a:focus-visible) {
    outline: 2px solid var(--service-accent);
    outline-offset: 3px;
  }

  @media (max-width: 1023px) {
    .service-switcher {
      display: flex;
      margin-inline: -0.25rem;
      overflow-x: auto;
      padding-inline: 0.25rem;
      padding-bottom: 0.25rem;
      scroll-snap-type: x proximity;
      scrollbar-width: none;
    }

    .service-switcher::-webkit-scrollbar { display: none; }
    .service-switcher > li { min-width: 7.75rem; scroll-snap-align: start; }
  }

  @media (max-width: 639px) {
    .service-switcher > li { min-width: 8.75rem; }
  }

  @media (min-width: 768px) {
    :global(.service-bento-flow > section:first-child .service-hero-grid) {
      grid-template-columns: minmax(0, 1.08fr) minmax(19rem, 0.92fr);
    }

    :global(.service-bento-flow > section:first-child > div > .grid:first-of-type ul) {
      display: grid;
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 0.65rem;
    }

    :global(.service-bento-flow > section:first-child > div > .grid:first-of-type ul > li) {
      margin: 0 !important;
      min-height: 3.25rem;
      padding: 0.75rem !important;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .service-switcher__item,
    :global(.service-bento-flow section .grid > *),
    :global(.service-bento-flow section > *) {
      transition: none !important;
    }
  }
</style>
