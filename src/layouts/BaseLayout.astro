---
import SEOHead from '../components/SEOHead.astro';
import SkipLink from '../components/SkipLink.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import WhatsAppFloat from '../components/WhatsAppFloat.astro';
import StickyContactBar from '../components/StickyContactBar.astro';
import VentureSlideIn from '../components/VentureSlideIn.astro';
import ConsentManager from '../components/ConsentManager.astro';
import '../styles/globals.css';

interface Props {
  title: string;
  description: string;
  canonical?: string;
  ogImage?: string;
  ogType?: string;
  noindex?: boolean;
  schema?: object | object[];
  geo?: { region: string; placename: string; lat: number; lng: number };
  standalone?: boolean;
}

const { title, description, canonical, ogImage, ogType, noindex, schema, geo, standalone = false } = Astro.props;
---
<!DOCTYPE html>
<html lang="en">
  <head>
    <script is:inline>
      (function() {
        var s = localStorage.getItem('theme');
        if (s === 'dark' || s === 'light') {
          document.documentElement.className = s;
        } else if (window.matchMedia('(prefers-color-scheme: dark)').matches) {
          document.documentElement.className = 'dark';
        } else {
          document.documentElement.className = 'light';
        }
        // Pre-hide dismissed announcement bar before paint to prevent CLS
        try { if (localStorage.getItem('lp-bar-ganesh-2026') === '1') document.documentElement.classList.add('lp-ann-hidden'); } catch(e) {}
      })();
    </script>
    <style is:inline>.lp-ann-hidden #ann-bar{display:none!important}</style>
    <SEOHead
      title={title}
      description={description}
      canonical={canonical}
      ogImage={ogImage}
      ogType={ogType}
      noindex={noindex}
      schema={schema}
      geo={geo}
    />
    <!-- Google Site Verification -->
    <meta name="google-site-verification" content="IdIodnKz_eIT0o2_-Gqgs_o-jQTYPXBUu41aalM_E7o" />

    <!-- Optional analytics: denied by default and loaded only after affirmative consent. -->
    <script is:inline>
      (function () {
        var STORAGE_KEY = 'elan:privacy-consent';
        var CONSENT_VERSION = 2;
        var MEASUREMENT_ID = 'G-EC0W1VE3NS';
        var isDevelopment = /^(localhost|127\.0\.0\.1|\[::1\])$/.test(location.hostname);
        window.__elanAnalyticsAllowed = false;
        window.dataLayer = window.dataLayer || [];
        function gtag(){ dataLayer.push(arguments); }
        window.gtag = window.gtag || gtag;

        gtag('consent', 'default', {
          analytics_storage: 'denied',
          ad_storage: 'denied',
          ad_user_data: 'denied',
          ad_personalization: 'denied',
          functionality_storage: 'granted',
          security_storage: 'granted'
        });

        function privacySignalActive() {
          return navigator.globalPrivacyControl === true ||
            navigator.doNotTrack === '1' ||
            window.doNotTrack === '1';
        }

        function clearAnalyticsCookies() {
          ['_ga', '_gid', '_gat', '_clck', '_clsk'].forEach(function (name) {
            document.cookie = name + '=; Max-Age=0; path=/; SameSite=Lax';
            document.cookie = name + '=; Max-Age=0; path=/; domain=.elan-tech.net; SameSite=Lax';
          });
          document.cookie.split(';').forEach(function (cookie) {
            var name = cookie.split('=')[0].trim();
            if (name.indexOf('_ga_') === 0 || name.indexOf('_gat_') === 0) {
              document.cookie = name + '=; Max-Age=0; path=/; SameSite=Lax';
              document.cookie = name + '=; Max-Age=0; path=/; domain=.elan-tech.net; SameSite=Lax';
            }
          });
        }

        window.__elanLoadOptionalAnalytics = function () {
          if (isDevelopment) return;
          window.__elanAnalyticsAllowed = true;
          gtag('consent', 'update', {
            analytics_storage: 'granted',
            ad_storage: 'denied',
            ad_user_data: 'denied',
            ad_personalization: 'denied'
          });
          if (window.__elanAnalyticsLoaded) {
            if (typeof window.clarity === 'function') window.clarity('consentv2', { ad_Storage: 'denied', analytics_Storage: 'granted' });
            window.dispatchEvent(new Event('elan:analytics-ready'));
            return;
          }
          window.__elanAnalyticsLoaded = true;

          // Direct GA4 is the sole Google route: the old GTM container is empty.
          // Keep only campaign parameters; never send form/query-string personal data.
          var page = new URL(location.href);
          var cleanPage = new URL(page.origin + page.pathname);
          ['utm_source', 'utm_medium', 'utm_campaign', 'utm_content', 'utm_term'].forEach(function (key) {
            var value = page.searchParams.get(key);
            if (value && /^[a-zA-Z0-9_.~-]{1,100}$/.test(value)) cleanPage.searchParams.set(key, value);
          });
          var referrer = '';
          try { var ref = new URL(document.referrer); referrer = ref.origin + ref.pathname; } catch (_) {}
          gtag('js', new Date());
          var googleConfig = {
            page_location: cleanPage.href,
            page_referrer: referrer,
            allow_google_signals: false,
            allow_ad_personalization_signals: false
          };
          // Do not populate debug_mode:false: GA's developer filter matches
          // populated debug parameters, not only the boolean true.
          if (page.searchParams.get('analytics_debug') === '1') googleConfig.debug_mode = true;
          gtag('config', MEASUREMENT_ID, googleConfig);
          var googleScript = document.createElement('script');
          googleScript.async = true;
          googleScript.src = 'https://www.googletagmanager.com/gtag/js?id=' + MEASUREMENT_ID;
          document.head.appendChild(googleScript);

          // Microsoft Clarity, with advertising storage permanently denied.
          (function (c, l, a, r, i, t, y) {
            c[a] = c[a] || function () { (c[a].q = c[a].q || []).push(arguments); };
            t = l.createElement(r); t.async = 1; t.src = 'https://www.clarity.ms/tag/' + i;
            y = l.getElementsByTagName(r)[0]; y.parentNode.insertBefore(t, y);
          })(window, document, 'clarity', 'script', 'ff08posqyo');
          window.clarity('consentv2', { ad_Storage: 'denied', analytics_Storage: 'granted' });
          window.dispatchEvent(new Event('elan:analytics-ready'));
        };

        window.__elanRevokeOptionalAnalytics = function () {
          window.__elanAnalyticsAllowed = false;
          gtag('consent', 'update', {
            analytics_storage: 'denied',
            ad_storage: 'denied',
            ad_user_data: 'denied',
            ad_personalization: 'denied'
          });
          if (typeof window.clarity === 'function') {
            window.clarity('consentv2', { ad_Storage: 'denied', analytics_Storage: 'denied' });
            window.clarity('consent', false);
          }
          clearAnalyticsCookies();
        };

        window.__elanTrackEvent = function (name, parameters) {
          if (!window.__elanAnalyticsAllowed || isDevelopment) return false;
          if (['generate_lead', 'whatsapp_click', 'phone_click', 'page_not_found'].indexOf(name) === -1) return false;
          // Callers supply only fixed labels and paths, never contact details.
          gtag('event', name, Object.assign({ send_to: MEASUREMENT_ID }, parameters || {}));
          return true;
        };
        document.addEventListener('click', function (event) {
          var link = event.target instanceof Element ? event.target.closest('a[href]') : null;
          if (!link) return;
          var href = link.getAttribute('href') || '';
          var name = /^tel:/i.test(href) ? 'phone_click' : /^https:\/\/(wa\.me|api\.whatsapp\.com|web\.whatsapp\.com)\//i.test(href) ? 'whatsapp_click' : '';
          if (name) window.__elanTrackEvent(name, { page_path: location.pathname, placement: link.getAttribute('data-analytics-placement') || 'page' });
        });

        try {
          var saved = JSON.parse(localStorage.getItem(STORAGE_KEY) || 'null');
          var signalAllowsSavedChoice = !privacySignalActive() || saved && saved.signalOverride === true;
          if (saved && saved.version === CONSENT_VERSION && saved.analytics === true && signalAllowsSavedChoice) {
            window.__elanLoadOptionalAnalytics();
          } else {
            window.__elanRevokeOptionalAnalytics();
          }
        } catch (_) {
          window.__elanRevokeOptionalAnalytics();
        }
      })();
    </script>
  </head>
  <body class="bg-[var(--bg)] text-[var(--text)] font-sans antialiased">
    {!standalone && <nav aria-label="Skip navigation"><SkipLink /></nav>}
    {!standalone && <Header />}
    <main id="main-content" tabindex="-1">
      <slot />
    </main>
    {!standalone && <Footer />}
    {!standalone && <WhatsAppFloat />}
    {!standalone && <StickyContactBar />}
    {!standalone && <VentureSlideIn />}
    <ConsentManager standalone={standalone} />
    {!standalone && <div class="h-20 lg:hidden" aria-hidden="true"></div>}
  </body>
</html>
