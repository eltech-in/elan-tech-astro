---
import BaseLayout from './BaseLayout.astro';
import Breadcrumb from '../components/Breadcrumb.astro';

interface Props {
  title: string;
  description: string;
  lastUpdated?: string;
}

const { title, description, lastUpdated } = Astro.props;

const breadcrumbs = [
  { name: 'Home', href: '/' },
  { name: title, href: Astro.url.pathname },
];

const formattedDate = lastUpdated
  ? new Date(lastUpdated).toLocaleDateString('en-IN', {
      year: 'numeric',
      month: 'long',
      day: 'numeric',
    })
  : null;
---

<BaseLayout title={title} description={description}>

  <!-- Page hero header -->
  <section class="border-b border-[var(--border)] bg-gradient-to-br from-[var(--bg-card)] to-[var(--bg)] px-4 py-14 sm:px-6 lg:px-8">
    <div class="mx-auto max-w-3xl">
      <Breadcrumb items={breadcrumbs} />
      <h1 class="mt-4 font-heading text-3xl font-bold text-[var(--text)] sm:text-4xl">
        {title}
      </h1>
      {formattedDate && (
        <p class="mt-3 text-sm text-[var(--text-muted)] flex items-center gap-1.5">
          <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="3" y="4" width="18" height="18" rx="2" ry="2"/><line x1="16" y1="2" x2="16" y2="6"/><line x1="8" y1="2" x2="8" y2="6"/><line x1="3" y1="10" x2="21" y2="10"/></svg>
          Last updated: <time datetime={lastUpdated}>{formattedDate}</time>
        </p>
      )}
    </div>
  </section>

  <!-- Legal content body -->
  <div class="bg-[var(--bg)] px-4 py-14 sm:px-6 lg:px-8">
    <div class="mx-auto max-w-3xl legal-content">
      <slot />
    </div>
  </div>

</BaseLayout>

<style>
  /* ── Legal content typography — no prose plugin needed ── */
  .legal-content {
    color: var(--text-dim);
    font-size: 1rem;
    line-height: 1.8;
  }

  /* Headings */
  .legal-content :global(h2) {
    font-family: var(--font-heading, 'Sora', system-ui, sans-serif);
    font-size: 1.35rem;
    font-weight: 700;
    color: var(--text);
    margin-top: 2.5rem;
    margin-bottom: 0.75rem;
    padding-bottom: 0.5rem;
    border-bottom: 1px solid var(--border);
  }

  .legal-content :global(h3) {
    font-family: var(--font-heading, 'Sora', system-ui, sans-serif);
    font-size: 1.1rem;
    font-weight: 600;
    color: var(--text);
    margin-top: 1.75rem;
    margin-bottom: 0.5rem;
  }

  .legal-content :global(h4) {
    font-size: 1rem;
    font-weight: 600;
    color: var(--text);
    margin-top: 1.25rem;
    margin-bottom: 0.4rem;
  }

  /* First h2 — no top margin */
  .legal-content :global(h2:first-of-type) {
    margin-top: 0;
  }

  /* Paragraphs */
  .legal-content :global(p) {
    margin-bottom: 1.1rem;
  }

  /* Links */
  .legal-content :global(a) {
    color: var(--accent);
    text-decoration: none;
    font-weight: 500;
    border-bottom: 1px solid transparent;
    transition: border-color 0.2s;
  }
  .legal-content :global(a:hover) {
    border-bottom-color: var(--accent);
  }

  /* Bold / strong */
  .legal-content :global(strong) {
    color: var(--text);
    font-weight: 600;
  }

  /* Unordered lists */
  .legal-content :global(ul) {
    list-style: none;
    padding-left: 0;
    margin-bottom: 1.25rem;
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }

  .legal-content :global(ul li) {
    display: flex;
    align-items: flex-start;
    gap: 0.6rem;
    padding: 0.65rem 0.9rem;
    background: var(--bg-card);
    border: 1px solid var(--border);
    border-radius: 0.5rem;
    font-size: 0.9375rem;
    line-height: 1.6;
  }

  .legal-content :global(ul li::before) {
    content: "✦";
    color: var(--accent);
    font-size: 0.6rem;
    flex-shrink: 0;
    margin-top: 0.35rem;
  }

  /* Ordered lists */
  .legal-content :global(ol) {
    list-style: none;
    padding-left: 0;
    margin-bottom: 1.25rem;
    counter-reset: legal-counter;
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }

  .legal-content :global(ol li) {
    display: flex;
    align-items: flex-start;
    gap: 0.75rem;
    padding: 0.65rem 0.9rem;
    background: var(--bg-card);
    border: 1px solid var(--border);
    border-radius: 0.5rem;
    font-size: 0.9375rem;
    line-height: 1.6;
    counter-increment: legal-counter;
  }

  .legal-content :global(ol li::before) {
    content: counter(legal-counter);
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-width: 1.5rem;
    height: 1.5rem;
    background: var(--accent);
    color: var(--bg);
    border-radius: 50%;
    font-size: 0.7rem;
    font-weight: 700;
    flex-shrink: 0;
  }

  /* Inline code */
  .legal-content :global(code) {
    font-family: 'ui-monospace', 'SFMono-Regular', monospace;
    font-size: 0.85em;
    background: var(--bg-card);
    color: var(--accent);
    padding: 0.15em 0.45em;
    border-radius: 4px;
    border: 1px solid var(--border);
  }

  /* Blockquote */
  .legal-content :global(blockquote) {
    border-left: 3px solid var(--accent);
    margin: 1.5rem 0;
    padding: 0.75rem 1.25rem;
    background: var(--bg-card);
    border-radius: 0 0.5rem 0.5rem 0;
    font-style: italic;
    color: var(--text-dim);
  }

  /* Horizontal rule */
  .legal-content :global(hr) {
    border: none;
    border-top: 1px solid var(--border);
    margin: 2rem 0;
  }

  /* Tables */
  .legal-content :global(table) {
    width: 100%;
    border-collapse: collapse;
    margin-bottom: 1.5rem;
    font-size: 0.9rem;
    border: 1px solid var(--border);
    border-radius: 0.5rem;
    overflow: hidden;
  }

  .legal-content :global(th) {
    background: var(--bg-card);
    color: var(--text);
    font-weight: 600;
    text-align: left;
    padding: 0.65rem 1rem;
    border-bottom: 1px solid var(--border);
  }

  .legal-content :global(td) {
    padding: 0.6rem 1rem;
    border-bottom: 1px solid var(--border);
    color: var(--text-dim);
  }

  .legal-content :global(tr:last-child td) {
    border-bottom: none;
  }
</style>
